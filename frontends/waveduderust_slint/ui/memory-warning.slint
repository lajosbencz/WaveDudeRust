import { Button, CheckBox } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { Overlay } from "overlay.slint";

// The memory warning's figures (MB or GB) and levers for the boxes ticked.
export struct MemoryWarningData {
    need: string,
    budget: string,
    auto-budget: string,
    cache-shown: bool,
    cache-enabled: bool,
    resolution-enabled: bool,
    frames-enabled: bool,
    samples-enabled: bool,
    cache-ticked: bool,
    resolution-ticked: bool,
    frames-ticked: bool,
    samples-ticked: bool,
    // the ticks' need over their budget, at most 1; `over`: beyond it
    fill: float,
    over: bool,
    figures: string,
    then-need: string,
    // what still goes to disk; empty when the frames fit
    spill: string,
}

// The memory warning's boxes as ticked.
export struct WarningTicks {
    cache: bool,
    resolution: bool,
    frames: bool,
    samples: bool,
}

// The memory warning (docs/ui/60, Memory warning), modal over the main window: Run (Enter) or Cancel (Esc).
export enum WarningAnswer { run, cancel }

// The memory warning's data and answers, filled and served by Rust.
export global MemoryWarning {
    in property <bool> shown;
    in property <MemoryWarningData> data;
    // the boxes as ticked
    callback ticked(ticks: WarningTicks);
    callback answer(answer: WarningAnswer, mute: bool);
}

export component MemoryWarningLayer inherits Overlay {
    property <bool> shown: MemoryWarning.shown;
    property <MemoryWarningData> data: MemoryWarning.data;

    property <bool> mute;
    function tick() {
        MemoryWarning.ticked({ cache: MemoryWarning.data.cache-ticked, resolution: resolution.checked, frames: frames.checked, samples: samples.checked });
    }
    // a click on a box ends its binding: the boxes follow the app's ticks
    function sync() {
        resolution.checked = MemoryWarning.data.resolution-ticked;
        frames.checked = MemoryWarning.data.frames-ticked;
        samples.checked = MemoryWarning.data.samples-ticked;
    }
    changed data => { root.sync(); }

    visible: MemoryWarning.shown;

    changed shown => {
        if (self.shown) {
            root.mute = false;
            root.sync();
            keys.focus();
        }
    }
    // the dialog inside: Esc and Enter bubble up from a focused box
    keys := FocusScope {
        key-pressed(e) => {
            if (e.text == Key.Escape) { MemoryWarning.answer(WarningAnswer.cancel, root.mute); return accept; }
            if (e.text == Key.Return) { MemoryWarning.answer(WarningAnswer.run, root.mute); return accept; }
            reject
        }
        Rectangle {
            width: 500px;
            height: box.preferred-height;
            background: Theme.window-background;
            border-width: 1px;
            border-color: Theme.accent;
            box := VerticalLayout {
                padding: 12px;
                spacing: 8px;
                Text { text: "WaveDude Rust"; font-weight: 700; color: Theme.text; }
                HorizontalLayout {
                    spacing: 12px;
                    Rectangle {
                        width: 32px;
                        height: 32px;
                        border-radius: 16px;
                        background: Theme.accent;
                        Text { text: "?"; color: #ffffff; font-weight: 700; }
                    }
                    Text {
                        text: @tr("The run's frames need {} of memory, and the RAM cache has {}. The frames beyond that go to the cache file on disk, which is slower.", MemoryWarning.data.need, MemoryWarning.data.budget);
                        wrap: word-wrap;
                        color: Theme.text;
                    }
                }
                Text { text: @tr("Settings to change for this and later runs:"); color: Theme.text; }
                if MemoryWarning.data.cache-shown: CheckBox {
                    text: @tr("RAM cache size to Auto: {} for the frames (Settings)", MemoryWarning.data.auto-budget);
                    enabled: MemoryWarning.data.cache-enabled;
                    checked: MemoryWarning.data.cache-ticked;
                    toggled => {
                        MemoryWarning.ticked({ cache: self.checked, resolution: resolution.checked, frames: frames.checked, samples: samples.checked });
                    }
                }
                resolution := CheckBox {
                    text: @tr("Halve the resolution: a quarter of the memory (Settings)");
                    enabled: MemoryWarning.data.resolution-enabled;
                    checked: MemoryWarning.data.resolution-ticked;
                    toggled => { root.tick(); }
                }
                frames := CheckBox {
                    text: @tr("Store half the frames: half the memory (Settings)");
                    enabled: MemoryWarning.data.frames-enabled;
                    checked: MemoryWarning.data.frames-ticked;
                    toggled => { root.tick(); }
                }
                samples := CheckBox {
                    text: @tr("8-bit samples: half the memory (Settings)");
                    enabled: MemoryWarning.data.samples-enabled;
                    checked: MemoryWarning.data.samples-ticked;
                    toggled => { root.tick(); }
                }
                HorizontalLayout {
                    spacing: 8px;
                    height: 16px;
                    Rectangle {
                        border-width: 1px;
                        border-color: Theme.border;
                        Rectangle {
                            x: 1px;
                            y: 1px;
                            height: parent.height - 2px;
                            width: (parent.width - 2px) * MemoryWarning.data.fill;
                            background: MemoryWarning.data.over ? Theme.status-warn : Theme.accent;
                        }
                    }
                    Text { text: MemoryWarning.data.figures; color: Theme.text; vertical-alignment: center; min-width: 150px; }
                }
                Text {
                    text: MemoryWarning.data.spill == "" ? @tr("The frames then need {} and fit in the RAM cache.", MemoryWarning.data.then-need)
                        : @tr("The frames then need {}; {} of them still go to disk.", MemoryWarning.data.then-need, MemoryWarning.data.spill);
                    wrap: word-wrap;
                    color: Theme.text;
                }
                CheckBox {
                    text: @tr("Do not warn me again");
                    checked <=> root.mute;
                }
                HorizontalLayout {
                    alignment: end;
                    spacing: 8px;
                    Button { text: @tr("Run"); primary: true; clicked => { MemoryWarning.answer(WarningAnswer.run, root.mute); } }
                    Button { text: @tr("Cancel"); clicked => { MemoryWarning.answer(WarningAnswer.cancel, root.mute); } }
                }
            }
        }
    }
}
