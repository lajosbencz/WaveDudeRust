import { Theme } from "theme.slint";
// Selawik on every platform, Segoe UI's metric twin (docs/divergences.md, Font).
import "../../../crates/waveduderust/assets/fonts/Selawik-Regular.ttf";
import "../../../crates/waveduderust/assets/fonts/Selawik-Semibold.ttf";
import "../../../crates/waveduderust/assets/fonts/Selawik-Bold.ttf";
export { Palette } from "std-widgets.slint";
import { MenuIcons } from "menu-icons.slint";
import { Pane } from "pane.slint";
import { Splitter } from "splitter.slint";
import { ProjectTree, TreeRow, TreeKind } from "tree.slint";
import { Properties, PropRow, PropKind } from "properties.slint";
import { Preview } from "preview.slint";
import { Timeline, TransportBar, Transport } from "timeline.slint";
import { Messages, LogRow, LogLevel, LevelToggle } from "messages.slint";
import { ModalLayer, Modal, ModalKind } from "modal.slint";
import { SettingsLayer } from "settings.slint";
import { WelcomeLayer } from "welcome.slint";
import { ExamplesLayer, ExampleRow } from "examples.slint";

export { Theme, TreeRow, TreeKind, PropRow, PropKind, Transport, LogRow, LogLevel, LevelToggle, Modal, ModalKind, ExampleRow }

// The main window (docs/ui/00, Main window): menu bar, panes around the preview, status bar.
export component AppWindow inherits Window {
    in property <string> window-title: "WaveDude Rust";
    in property <string> status-text;
    in property <bool> can-undo;
    in property <bool> can-redo;
    in property <bool> run-active;
    in property <[TreeRow]> tree-rows;
    callback tree-select(int);
    callback tree-toggle(int);
    callback tree-shift(int, int);
    callback tree-remove(int);
    in property <image> field;
    in property <image> intensity;
    in property <string> run-status;
    in property <Transport> transport;
    in property <Modal> modal;
    in-out property <bool> examples-shown;
    in property <[string]> example-topics;
    in property <int> example-topic;
    in property <[ExampleRow]> example-rows;
    callback example-topic-picked(int);
    callback example-search(string);
    callback example-open(int);
    in-out property <bool> welcome-shown;
    in property <string> welcome-ram;
    in property <string> welcome-levers;
    in property <bool> welcome-show-startup;
    callback welcome-preset(int);
    callback welcome-action(string);
    callback welcome-show-startup-toggled(bool);
    in-out property <bool> settings-shown;
    in property <[string]> settings-sections;
    in property <int> settings-section;
    in property <[PropRow]> settings-rows;
    callback settings-pick(int);
    callback settings-set(int, string);
    callback modal-answer(int);
    in property <[LogRow]> log-rows;
    in property <[LevelToggle]> log-levels;
    callback log-toggle(LogLevel);
    callback log-search(string);
    callback log-clear();
    callback seek(int);
    callback transport-action(string);
    callback transport-speed(string);
    in property <string> props-heading;
    in property <[PropRow]> props-rows;
    in property <string> props-error;
    callback props-set(int, string);
    in-out property <bool> project-shown: true;
    in-out property <bool> properties-shown: true;
    in-out property <bool> messages-shown: false;
    // A menu entry's action, by its id (docs/ui/10).
    in-out property <bool> preview-stacked: true;
    // The panes' stretches, which the splitters move (docs/ui/00, Panes: 1 : 3, 1 : 2, 3 : 1).
    in-out property <float> left-weight: 1;
    in-out property <float> right-weight: 3;
    in-out property <float> project-weight: 1;
    in-out property <float> properties-weight: 2;
    in-out property <float> preview-weight: 3;
    in-out property <float> messages-weight: 1;
    callback menu(string);
    // The main area takes the keys back once the last overlay closed.
    function overlays-closed() {
        if (!self.welcome-shown && !self.examples-shown && !self.settings-shown && !self.modal.shown) {
            keys.focus();
        }
    }
    changed welcome-shown => { self.overlays-closed(); }
    changed examples-shown => { self.overlays-closed(); }
    changed settings-shown => { self.overlays-closed(); }
    changed modal => { self.overlays-closed(); }

    title: root.window-title;
    icon: @image-url("../assets/icon.svg");
    min-width: 800px;
    min-height: 500px;
    max-width: 100000px;
    max-height: 100000px;
    preferred-width: 1280px;
    preferred-height: 800px;
    background: Theme.window-background;
    default-font-family: "Selawik";
    default-font-size: Theme.font-size;

    MenuBar {
        Menu {
            title: @tr("File");
            MenuItem { title: @tr("New Project"); icon: MenuIcons.note-add; shortcut: @keys(Control + N); activated => { root.menu("new"); } }
            MenuItem { title: @tr("Open Project..."); icon: MenuIcons.folder-open; shortcut: @keys(Control + O); activated => { root.menu("open"); } }
            Menu { title: @tr("Recent Projects"); icon: MenuIcons.history; }
            MenuItem { title: @tr("Examples..."); icon: MenuIcons.list-alt; activated => { root.menu("examples"); } }
            MenuItem { title: @tr("Welcome Page..."); icon: MenuIcons.waving-hand; activated => { root.menu("welcome"); } }
            MenuItem { title: @tr("Settings..."); icon: MenuIcons.settings; shortcut: @keys(Control + ","); activated => { root.menu("settings"); } }
            MenuSeparator { }
            MenuItem { title: @tr("Save"); icon: MenuIcons.save; shortcut: @keys(Control + S); activated => { root.menu("save"); } }
            MenuItem { title: @tr("Save As..."); icon: MenuIcons.save-as; shortcut: @keys(Control + Shift + S); activated => { root.menu("save-as"); } }
            MenuSeparator { }
            Menu {
                title: @tr("Export"); icon: MenuIcons.ios-share;
                MenuItem { title: @tr("Export field..."); icon: MenuIcons.ios-share; shortcut: @keys(Control + Shift + E); activated => { root.menu("export-field"); } }
                MenuItem { title: @tr("Export intensity..."); icon: MenuIcons.ios-share; shortcut: @keys(Control + Shift + I); activated => { root.menu("export-intensity"); } }
                MenuItem { title: @tr("Export both..."); icon: MenuIcons.ios-share; shortcut: @keys(Control + Shift + B); activated => { root.menu("export-both"); } }
                MenuSeparator { }
                MenuItem { title: @tr("Export field frame..."); icon: MenuIcons.image; shortcut: @keys(Control + Shift + F); activated => { root.menu("export-field-frame"); } }
                MenuItem { title: @tr("Export intensity frame..."); icon: MenuIcons.image; shortcut: @keys(Control + Shift + G); activated => { root.menu("export-intensity-frame"); } }
            }
            MenuItem { title: @tr("Export last"); icon: MenuIcons.repeat; shortcut: @keys(Control + E); activated => { root.menu("export-last"); } }
            MenuSeparator { }
            MenuItem { title: @tr("Close Project"); icon: MenuIcons.close; activated => { root.menu("close"); } }
            MenuSeparator { }
            MenuItem { title: @tr("Exit"); icon: MenuIcons.logout; activated => { root.menu("exit"); } }
        }
        Menu {
            title: @tr("Edit");
            MenuItem { title: @tr("Undo"); icon: MenuIcons.undo; enabled: root.can-undo; activated => { root.menu("undo"); } }
            MenuItem { title: @tr("Redo"); icon: MenuIcons.redo; enabled: root.can-redo; activated => { root.menu("redo"); } }
            MenuSeparator { }
            MenuItem { title: @tr("Cut"); icon: MenuIcons.content-cut; activated => { root.menu("cut"); } }
            MenuItem { title: @tr("Copy"); icon: MenuIcons.content-copy; activated => { root.menu("copy"); } }
            MenuItem { title: @tr("Paste"); icon: MenuIcons.content-paste; activated => { root.menu("paste"); } }
            MenuItem { title: @tr("Delete"); icon: MenuIcons.delete; activated => { root.menu("delete"); } }
            MenuSeparator { }
            MenuItem { title: @tr("Select all"); icon: MenuIcons.select-all; activated => { root.menu("select-all"); } }
        }
        Menu {
            title: @tr("View");
            Menu {
                title: @tr("Panes"); icon: MenuIcons.view-sidebar;
                MenuItem { title: @tr("Project"); checkable: true; checked: root.project-shown; activated => { root.project-shown = !root.project-shown; } }
                MenuItem { title: @tr("Properties"); checkable: true; checked: root.properties-shown; activated => { root.properties-shown = !root.properties-shown; } }
                MenuItem { title: @tr("Messages"); checkable: true; checked: root.messages-shown; activated => { root.messages-shown = !root.messages-shown; } }
            }
        }
        Menu {
            title: @tr("Simulation");
            MenuItem { title: @tr("Run"); icon: MenuIcons.play-arrow; enabled: !root.transport.running; shortcut: @keys(F5); activated => { root.menu("run"); } }
            MenuItem { title: @tr("Pause / Resume"); icon: MenuIcons.pause; enabled: root.run-active; shortcut: @keys(F6); activated => { root.menu("pause"); } }
            MenuItem { title: @tr("Stop"); icon: MenuIcons.stop; enabled: root.transport.running; shortcut: @keys(Shift + F5); activated => { root.menu("stop"); } }
            MenuItem { title: @tr("Discard frames"); icon: MenuIcons.delete-sweep; activated => { root.menu("discard"); } }
            MenuSeparator { }
            MenuItem { title: @tr("Play / Pause playback"); icon: MenuIcons.play-arrow; shortcut: @keys(F7); activated => { root.transport-action("play"); } }
        }
        Menu {
            title: @tr("Help");
            MenuItem { title: @tr("About WaveDude Rust"); icon: MenuIcons.info; activated => { root.menu("about"); } }
            MenuItem { title: @tr("Project page on GitHub"); icon: MenuIcons.open-in-new; shortcut: @keys(F1); activated => { root.menu("github"); } }
            MenuItem { title: @tr("Check for updates"); activated => { root.menu("updates"); } }
        }
    }

    // The editing keys a focused editor leaves unhandled (docs/ui/10, Edit): menu shortcuts would take them from
    // the text fields.
    keys := FocusScope {
        init => { self.focus(); }
        key-pressed(e) => {
            if (e.text == Key.Delete && !e.modifiers.control && !e.modifiers.shift) { root.menu("delete"); return accept; }
            if (!e.modifiers.control || e.modifiers.alt) { return reject; }
            if (e.text == "z" && !e.modifiers.shift) { root.menu("undo"); return accept; }
            if (e.text == "y" || (e.text == "z" && e.modifiers.shift)) { root.menu("redo"); return accept; }
            if (e.text == "x") { root.menu("cut"); return accept; }
            if (e.text == "c") { root.menu("copy"); return accept; }
            if (e.text == "v") { root.menu("paste"); return accept; }
            if (e.text == "a") { root.menu("select-all"); return accept; }
            reject
        }
        VerticalLayout {

            columns := HorizontalLayout {
                padding: 4px;
                // a pane's minimum is Next's (DockHost: 60 px, 100 px holding the preview), its content clipped
                if root.project-shown || root.properties-shown: left := VerticalLayout {
                    horizontal-stretch: root.left-weight;
                    preferred-width: 0px;
                    min-width: 60px;
                    if root.project-shown: Pane {
                        title: @tr("Project");
                        vertical-stretch: root.project-weight;
                        preferred-height: 0px;
                        min-height: 60px;
                        close => { root.project-shown = false; }
                        ProjectTree {
                            rows: root.tree-rows;
                            focused: true;
                            select(i) => { keys.focus(); root.tree-select(i); }
                            toggle(i) => { root.tree-toggle(i); }
                            shift(i, by) => { root.tree-shift(i, by); }
                            remove(i) => { root.tree-remove(i); }
                        }
                    }
                    if root.project-shown && root.properties-shown: Splitter {
                        rows: true;
                        span: left.height - 4px;
                        before <=> root.project-weight;
                        after <=> root.properties-weight;
                    }
                    if root.properties-shown: Pane {
                        title: @tr("Properties");
                        vertical-stretch: root.properties-weight;
                        preferred-height: 0px;
                        min-height: 60px;
                        close => { root.properties-shown = false; }
                        Properties {
                            heading: root.props-heading;
                            rows: root.props-rows;
                            error: root.props-error;
                            set(i, v) => { root.props-set(i, v); }
                        }
                    }
                }
                if root.project-shown || root.properties-shown: Splitter {
                    span: columns.width - 12px;
                    start: 4px;
                    minimum-after: 100px;
                    before <=> root.left-weight;
                    after <=> root.right-weight;
                }
                right := VerticalLayout {
                    horizontal-stretch: root.right-weight;
                    preferred-width: 0px;
                    min-width: 100px;
                    Pane {
                        title: @tr("Preview");
                        active: true;
                        vertical-stretch: root.preview-weight;
                        preferred-height: 0px;
                        min-height: 100px;
                        VerticalLayout {
                            Preview {
                                field: root.field;
                                intensity: root.intensity;
                                stacked: root.preview-stacked;
                            }
                            Timeline {
                                t: root.transport;
                                seek(f) => { root.seek(f); }
                                key(k) => { root.transport-action(k); }
                            }
                            TransportBar {
                                t: root.transport;
                                stacked <=> root.preview-stacked;
                                action(a) => { root.transport-action(a); }
                                speed(v) => { root.transport-speed(v); }
                            }
                        }
                    }
                    if root.messages-shown: Splitter {
                        rows: true;
                        span: right.height - 4px;
                        minimum-before: 100px;
                        before <=> root.preview-weight;
                        after <=> root.messages-weight;
                    }
                    if root.messages-shown: Pane {
                        title: @tr("Messages");
                        vertical-stretch: root.messages-weight;
                        preferred-height: 0px;
                        min-height: 60px;
                        close => { root.messages-shown = false; }
                        Messages {
                            rows: root.log-rows;
                            levels: root.log-levels;
                            toggle(l) => { root.log-toggle(l); }
                            search(t) => { root.log-search(t); }
                            clear => { root.log-clear(); }
                        }
                    }
                }
            }
            Rectangle {
                height: Theme.status-height;
                background: Theme.status;
                TouchArea {
                    double-clicked => { root.messages-shown = true; }
                }
                HorizontalLayout {
                    padding-left: 4px;
                    padding-right: 16px;
                    Text {
                        text: root.status-text;
                        color: Theme.selection-text;
                        vertical-alignment: center;
                        overflow: elide;
                        min-width: 0px;
                    }
                    // a Text's width bounds its row; the spacer leaves the window free
                    Rectangle { horizontal-stretch: 1; min-width: 12px; }
                    Text {
                        text: root.run-status;
                        color: Theme.selection-text;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }
    WelcomeLayer {
        // an overlay: its frame sets no bounds on the window
        min-width: 0px;
        max-width: 100000px;
        min-height: 0px;
        max-height: 100000px;
        shown <=> root.welcome-shown;
        ram: root.welcome-ram;
        levers: root.welcome-levers;
        show-startup: root.welcome-show-startup;
        preset(i) => { root.welcome-preset(i); }
        action(a) => { root.welcome-action(a); }
        show-startup-toggled(b) => { root.welcome-show-startup-toggled(b); }
    }
    ExamplesLayer {
        // an overlay: its frame sets no bounds on the window
        min-width: 0px;
        max-width: 100000px;
        min-height: 0px;
        max-height: 100000px;
        shown <=> root.examples-shown;
        topics: root.example-topics;
        topic: root.example-topic;
        rows: root.example-rows;
        pick-topic(i) => { root.example-topic-picked(i); }
        search(t) => { root.example-search(t); }
        open(i) => { root.example-open(i); }
    }
    SettingsLayer {
        // an overlay: its frame sets no bounds on the window
        min-width: 0px;
        max-width: 100000px;
        min-height: 0px;
        max-height: 100000px;
        shown <=> root.settings-shown;
        sections: root.settings-sections;
        section: root.settings-section;
        rows: root.settings-rows;
        pick(i) => { root.settings-pick(i); }
        set(i, v) => { root.settings-set(i, v); }
    }
    ModalLayer {
        // an overlay: its frame sets no bounds on the window
        min-width: 0px;
        max-width: 100000px;
        min-height: 0px;
        max-height: 100000px;
        modal: root.modal;
        answer(i) => { root.modal-answer(i); }
    }
}
