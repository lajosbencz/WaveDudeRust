import { Theme } from "theme.slint";
import { Command, NewItem, TreeKey, Pick, DropPlace, TransportAction, PreviewQuality, RunState, RunStatus, ExportProgress } from "commands.slint";
// Selawik on every platform, Segoe UI's metric twin (docs/divergences.md, Font).
import "../../../crates/waveduderust/assets/fonts/Selawik-Regular.ttf";
import "../../../crates/waveduderust/assets/fonts/Selawik-Semibold.ttf";
import "../../../crates/waveduderust/assets/fonts/Selawik-Bold.ttf";
export { Palette } from "std-widgets.slint";
import { MenuIcons } from "menu-icons.slint";
import { Pane } from "pane.slint";
import { Splitter } from "splitter.slint";
import { ProjectTree, TreeRow, TreeKind, TreeWords } from "tree.slint";
import { Form, NumberParse } from "form.slint";
export { Form, NumberParse }
export { Words, ExportFileFormat } from "words.slint";
import { Properties } from "properties.slint";
import { Preview } from "preview.slint";
import { Timeline, TransportBar, Transport } from "timeline.slint";
import { Messages, LogRow, LogLevel, LevelToggle } from "messages.slint";
import { ModalLayer, Modal, Message, Answer } from "modal.slint";
import { SettingsLayer, SettingsData, ColorTheme, Language, Scale } from "settings.slint";
export { SettingsData, ColorTheme, Language, Scale }
import { WelcomeLayer, Levers } from "welcome.slint";
export { Levers }
import { ExamplesLayer, ExampleRow, ExampleTopic } from "examples.slint";

import { NumberSpec } from "number-box.slint";
export { NumberLogic, NumberSpec } from "number-box.slint";
export { ColorLogic, Hsv } from "color-picker.slint";
export { Command, NewItem, FolderAdd, TreeKey, Pick, DropPlace, TransportAction, PreviewQuality, RunState, RunStatus, ExportProgress } from "commands.slint";
export { Theme, TreeRow, TreeKind, Transport, LogRow, LogLevel, LevelToggle, Modal, Message, Answer, ExampleRow, ExampleTopic }

// The main window (docs/ui/00, Main window): menu bar, panes around the preview, status bar.
// Which menu commands can run (Next's CanExecute rules, docs/ui/10).
export struct Commands {
    can-undo: bool,
    can-redo: bool,
    // an object row is selected
    can-delete: bool,
    can-move-up: bool,
    // any source, part or probe
    can-select-all: bool,
    // the current row is a source, a part or a probe
    can-toggle: bool,
    can-move-down: bool,
    // an object or a settings row is selected
    can-copy: bool,
    // the current scheme among the user's: -1 no scheme row (or no store), 0 not, 1 it is
    mine: int,
    can-run: bool,
    run-active: bool,
    paused: bool,
    // a run or an export is active
    can-stop: bool,
    can-export: bool,
    can-export-last: bool,
    // the project is not the blank one shown at start
    can-close: bool,
    can-play: bool,
    playing: bool,
}

export component AppWindow inherits Window {
    // the project's file: its name (empty without one), its full path, unsaved edits
    in property <string> file-name;
    in property <string> file-path;
    in property <bool> dirty;
    in property <bool> title-full-path;
    in property <string> status-text;
    in property <Commands> commands;
    // The menu bar is Windows' native one (not `Platform.os`, which names a browser's host on the web).
    in property <bool> native-access-keys;
    // Newest first, full paths.
    in property <[string]> recent-files;
    in property <[TreeRow]> tree-rows;
    // the current row's index among them, -1 when hidden
    in property <int> tree-current;
    callback tree-select(int, Pick);
    callback tree-toggle(int);
    callback tree-expand(int);
    callback tree-navigate(TreeKey, bool);
    pure callback tree-drag-data(int) -> data-transfer;
    callback tree-drop-place(int, data-transfer, bool) -> DropPlace;
    callback tree-drop(int, data-transfer, bool);
    callback tree-shift(int, int);
    callback tree-remove(int);
    in property <image> field;
    in property <image> intensity;
    in property <RunStatus> run-status;
    in property <ExportProgress> export-progress;
    in property <Transport> transport;
    in property <Modal> modal;
    in-out property <bool> examples-shown;
    in property <ExampleTopic> example-topic;
    in property <[ExampleRow]> example-rows;
    callback example-topic-picked(ExampleTopic);
    callback example-search(string);
    callback example-open(int);
    in-out property <bool> welcome-shown;
    in property <float> welcome-ram;
    in property <Levers> welcome-levers;
    in property <bool> welcome-show-startup;
    callback welcome-preset(PreviewQuality);
    callback welcome-show-startup-toggled(bool);
    in-out property <bool> settings-shown;
    in-out property <SettingsData> settings;
    in property <NumberSpec> undo-spec;
    callback settings-edited();
    callback modal-answer(Answer);
    in property <[LogRow]> log-rows;
    in property <[LevelToggle]> log-levels;
    callback log-toggle(LogLevel);
    callback log-search(string);
    callback log-clear();
    callback seek(int);
    callback transport-action(TransportAction);
    callback transport-speed(float);
    // the selected row: its kind and an item's name
    in property <TreeKind> props-kind;
    in property <string> props-heading;
    // a folder's item count; -1 for other rows
    in property <int> props-entries: -1;
    in-out property <bool> project-shown: true;
    in-out property <bool> properties-shown: true;
    in-out property <bool> messages-shown: false;
    in-out property <bool> preview-stacked: true;
    // The panes' stretches, which the splitters move (docs/ui/00, Panes: 1 : 3, 1 : 2, 3 : 1).
    in-out property <float> left-weight: 1;
    in-out property <float> right-weight: 3;
    in-out property <float> project-weight: 1;
    in-out property <float> properties-weight: 2;
    in-out property <float> preview-weight: 3;
    in-out property <float> messages-weight: 1;
    // a menu entry's, shortcut's or button's action (docs/ui/10)
    callback command(Command);
    callback add(NewItem);
    // the recent file at an index of `recent-files`
    callback open-recent(int);
    // The main area takes the keys back once the last overlay closed.
    function overlays-closed() {
        if (!self.welcome-shown && !self.examples-shown && !self.settings-shown && self.modal.message == Message.none) {
            keys.focus();
        }
    }
    changed welcome-shown => { self.overlays-closed(); }
    changed examples-shown => { self.overlays-closed(); }
    changed settings-shown => { self.overlays-closed(); }
    changed modal => { self.overlays-closed(); }

    title: "WaveDude Rust - " + (root.title-full-path && root.file-path != "" ? root.file-path : root.file-name != "" ? root.file-name : @tr("Untitled")) + (root.dirty ? "*" : "");
    icon: @image-url("../assets/icon.svg");
    min-width: 800px;
    min-height: 500px;
    max-width: 100000px;
    max-height: 100000px;
    preferred-width: 1280px;
    preferred-height: 800px;
    background: Theme.window-background;
    default-font-family: "Selawik";
    default-font-size: Theme.font-size;

    // A menu title: Windows' native menu bar takes `&` access keys, Slint's own bar would draw them (docs/blockers.md).
    pure function menu-text(keyed: string, plain: string) -> string {
        root.native-access-keys ? keyed : plain
    }

    MenuBar {
        Menu {
            title: root.menu-text(@tr("&File"), @tr("File"));
            MenuItem { title: root.menu-text(@tr("&New Project"), @tr("New Project")); icon: MenuIcons.note-add; shortcut: @keys(Control + N); activated => { root.command(Command.new); } }
            MenuItem { title: root.menu-text(@tr("&Open Project..."), @tr("Open Project...")); icon: MenuIcons.folder-open; shortcut: @keys(Control + O); activated => { root.command(Command.open); } }
            Menu {
                title: root.menu-text(@tr("&Recent Projects"), @tr("Recent Projects")); icon: MenuIcons.history;
                for path[i] in root.recent-files: MenuItem { title: path; activated => { root.open-recent(i); } }
            }
            MenuItem { title: root.menu-text(@tr("Exam&ples"), @tr("Examples")); icon: MenuIcons.list-alt; activated => { root.command(Command.examples); } }
            MenuItem { title: root.menu-text(@tr("&Welcome Page..."), @tr("Welcome Page...")); icon: MenuIcons.waving-hand; activated => { root.command(Command.welcome); } }
            MenuItem { title: root.menu-text(@tr("Se&ttings..."), @tr("Settings...")); icon: MenuIcons.settings; shortcut: @keys(Control + ","); activated => { root.command(Command.settings); } }
            MenuSeparator { }
            MenuItem { title: root.menu-text(@tr("&Save"), @tr("Save")); icon: MenuIcons.save; shortcut: @keys(Control + S); activated => { root.command(Command.save); } }
            MenuItem { title: root.menu-text(@tr("Save &As..."), @tr("Save As...")); icon: MenuIcons.save-as; shortcut: @keys(Control + Shift + S); activated => { root.command(Command.save-as); } }
            MenuSeparator { }
            Menu {
                title: root.menu-text(@tr("&Export"), @tr("Export")); icon: MenuIcons.ios-share;
                MenuItem { title: root.menu-text(@tr("Export &field..."), @tr("Export field...")); enabled: root.commands.can-export; icon: MenuIcons.ios-share; shortcut: @keys(Control + Shift + E); activated => { root.command(Command.export-field); } }
                MenuItem { title: root.menu-text(@tr("Export &intensity..."), @tr("Export intensity...")); enabled: root.commands.can-export; icon: MenuIcons.ios-share; shortcut: @keys(Control + Shift + I); activated => { root.command(Command.export-intensity); } }
                MenuItem { title: root.menu-text(@tr("Export b&oth..."), @tr("Export both...")); enabled: root.commands.can-export; icon: MenuIcons.ios-share; shortcut: @keys(Control + Shift + B); activated => { root.command(Command.export-both); } }
                MenuSeparator { }
                MenuItem { title: root.menu-text(@tr("Export field f&rame..."), @tr("Export field frame...")); enabled: root.commands.can-export; icon: MenuIcons.image; shortcut: @keys(Control + Shift + F); activated => { root.command(Command.export-field-frame); } }
                MenuItem { title: root.menu-text(@tr("Export intensity fra&me..."), @tr("Export intensity frame...")); enabled: root.commands.can-export; icon: MenuIcons.image; shortcut: @keys(Control + Shift + G); activated => { root.command(Command.export-intensity-frame); } }
            }
            MenuItem { title: root.menu-text(@tr("Export &last"), @tr("Export last")); enabled: root.commands.can-export-last; icon: MenuIcons.repeat; shortcut: @keys(Control + E); activated => { root.command(Command.export-last); } }
            MenuSeparator { }
            MenuItem { title: root.menu-text(@tr("&Close Project"), @tr("Close Project")); enabled: root.commands.can-close; icon: MenuIcons.close; activated => { root.command(Command.close); } }
            MenuSeparator { }
            MenuItem { title: root.menu-text(@tr("E&xit"), @tr("Exit")); icon: MenuIcons.logout; activated => { root.command(Command.exit); } }
        }
        Menu {
            title: root.menu-text(@tr("&Edit"), @tr("Edit"));
            MenuItem { title: root.menu-text(@tr("&Undo"), @tr("Undo")); icon: MenuIcons.undo; enabled: root.commands.can-undo; activated => { root.command(Command.undo); } }
            MenuItem { title: root.menu-text(@tr("&Redo"), @tr("Redo")); icon: MenuIcons.redo; enabled: root.commands.can-redo; activated => { root.command(Command.redo); } }
            MenuSeparator { }
            MenuItem { title: root.menu-text(@tr("Cu&t"), @tr("Cut")); icon: MenuIcons.content-cut; enabled: root.commands.can-delete; activated => { root.command(Command.cut); } }
            MenuItem { title: root.menu-text(@tr("&Copy"), @tr("Copy")); icon: MenuIcons.content-copy; enabled: root.commands.can-copy; activated => { root.command(Command.copy); } }
            MenuItem { title: root.menu-text(@tr("&Paste"), @tr("Paste")); icon: MenuIcons.content-paste; enabled: true; activated => { root.command(Command.paste); } }
            MenuItem { title: root.menu-text(@tr("&Delete"), @tr("Delete")); icon: MenuIcons.delete; enabled: root.commands.can-delete; activated => { root.command(Command.delete); } }
            MenuSeparator { }
            MenuItem { title: root.menu-text(@tr("Select &all"), @tr("Select all")); icon: MenuIcons.select-all; enabled: root.commands.can-select-all; activated => { root.command(Command.select-all); } }
        }
        Menu {
            title: root.menu-text(@tr("&View"), @tr("View"));
            Menu {
                title: root.menu-text(@tr("&Panes"), @tr("Panes")); icon: MenuIcons.view-sidebar;
                MenuItem { title: @tr("Project"); checkable: true; checked: root.project-shown; activated => { root.project-shown = !root.project-shown; } }
                MenuItem { title: @tr("Properties"); checkable: true; checked: root.properties-shown; activated => { root.properties-shown = !root.properties-shown; } }
                MenuItem { title: @tr("Messages"); checkable: true; checked: root.messages-shown; activated => { root.messages-shown = !root.messages-shown; } }
            }
        }
        Menu {
            title: root.menu-text(@tr("&Simulation"), @tr("Simulation"));
            MenuItem { title: root.menu-text(@tr("&Run"), @tr("Run")); icon: MenuIcons.play-arrow; enabled: root.commands.can-run; shortcut: @keys(F5); activated => { root.command(Command.run); } }
            MenuItem { title: root.commands.paused ? root.menu-text(@tr("&Resume"), @tr("Resume")) : root.menu-text(@tr("&Pause"), @tr("Pause")); icon: MenuIcons.pause; enabled: root.commands.run-active; shortcut: @keys(F6); activated => { root.command(Command.pause); } }
            MenuItem { title: root.menu-text(@tr("S&top"), @tr("Stop")); icon: MenuIcons.stop; enabled: root.commands.can-stop; shortcut: @keys(Shift + F5); activated => { root.command(Command.stop); } }
            MenuSeparator { }
            MenuItem {
                title: root.commands.playing ? root.menu-text(@tr("Pause pla&yback"), @tr("Pause playback")) : root.menu-text(@tr("Pla&y"), @tr("Play"));
                icon: root.commands.playing ? MenuIcons.pause : MenuIcons.play-arrow;
                enabled: root.commands.can-play;
                shortcut: @keys(F7);
                activated => { root.transport-action(TransportAction.play); }
            }
        }
        Menu {
            title: root.menu-text(@tr("&Help"), @tr("Help"));
            MenuItem { title: root.menu-text(@tr("&About WaveDude Rust"), @tr("About WaveDude Rust")); icon: MenuIcons.info; activated => { root.command(Command.about); } }
            MenuItem { title: root.menu-text(@tr("&Project page on GitHub"), @tr("Project page on GitHub")); icon: MenuIcons.open-in-new; shortcut: @keys(F1); activated => { root.command(Command.github); } }
        }
    }

    // The editing keys a focused editor leaves unhandled (docs/ui/10, Edit): menu shortcuts would take them from
    // the text fields.
    keys := FocusScope {
        init => { self.focus(); }
        key-pressed(e) => {
            if (e.text == Key.Escape && root.commands.can-stop) { root.command(Command.stop); return accept; }
            if (e.text == Key.Delete && !e.modifiers.control && !e.modifiers.shift) { root.command(Command.delete); return accept; }
            if (!e.modifiers.control || e.modifiers.alt) { return reject; }
            if (e.text == "z" && !e.modifiers.shift) { root.command(Command.undo); return accept; }
            if (e.text == "y" || (e.text == "z" && e.modifiers.shift)) { root.command(Command.redo); return accept; }
            if (e.text == "x") { root.command(Command.cut); return accept; }
            if (e.text == "c") { root.command(Command.copy); return accept; }
            if (e.text == "v") { root.command(Command.paste); return accept; }
            if (e.text == "a") { root.command(Command.select-all); return accept; }
            reject
        }
        VerticalLayout {

            columns := HorizontalLayout {
                padding: 4px;
                // a pane's minimum is Next's (DockHost: 60 px, 100 px holding the preview), its content clipped
                if root.project-shown || root.properties-shown: left := VerticalLayout {
                    horizontal-stretch: root.left-weight;
                    preferred-width: 0px;
                    min-width: 60px;
                    if root.project-shown: Pane {
                        title: @tr("Project");
                        vertical-stretch: root.project-weight;
                        preferred-height: 0px;
                        min-height: 60px;
                        close => { root.project-shown = false; }
                        ProjectTree {
                            rows: root.tree-rows;
                            current-row: root.tree-current;
                            select(i, pick) => { root.tree-select(i, pick); }
                            toggle(i) => { root.tree-toggle(i); }
                            expand(i) => { root.tree-expand(i); }
                            shift(i, by) => { root.tree-shift(i, by); }
                            remove(i) => { root.tree-remove(i); }
                            can-move-up: root.commands.can-move-up;
                            can-move-down: root.commands.can-move-down;
                            can-remove: root.commands.can-delete;
                            can-copy: root.commands.can-copy;
                            mine: root.commands.mine;
                            can-select-all: root.commands.can-select-all;
                            can-toggle: root.commands.can-toggle;
                            act(c) => { root.command(c); }
                            add-item(item) => { root.add(item); }
                            navigate(key, extend) => { root.tree-navigate(key, extend); }
                            drag-data(row) => { return root.tree-drag-data(row); }
                            drop-place(row, data, before) => { return root.tree-drop-place(row, data, before); }
                            drop(row, data, before) => { root.tree-drop(row, data, before); }
                        }
                    }
                    if root.project-shown && root.properties-shown: Splitter {
                        rows: true;
                        span: left.height - 4px;
                        before <=> root.project-weight;
                        after <=> root.properties-weight;
                    }
                    if root.properties-shown: Pane {
                        title: @tr("Properties");
                        vertical-stretch: root.properties-weight;
                        preferred-height: 0px;
                        min-height: 60px;
                        close => { root.properties-shown = false; }
                        Properties {
                            heading: TreeWords.label(root.props-kind, root.props-heading);
                            entries: root.props-entries;
                        }
                    }
                }
                if root.project-shown || root.properties-shown: Splitter {
                    span: columns.width - 12px;
                    start: 4px;
                    minimum-after: 100px;
                    before <=> root.left-weight;
                    after <=> root.right-weight;
                }
                right := VerticalLayout {
                    horizontal-stretch: root.right-weight;
                    preferred-width: 0px;
                    min-width: 100px;
                    Pane {
                        title: @tr("Preview");
                        active: true;
                        vertical-stretch: root.preview-weight;
                        preferred-height: 0px;
                        min-height: 100px;
                        // Next's preview keys, its own even when the command cannot run; a click on the pictures
                        // focuses it
                        preview-keys := FocusScope {
                            key-pressed(e) => {
                                if (e.modifiers.control || e.modifiers.alt || e.modifiers.meta || e.modifiers.shift) { return reject; }
                                if (e.text == " ") { root.transport-action(TransportAction.play); return accept; }
                                if (e.text == ",") { root.transport-action(TransportAction.prev); return accept; }
                                if (e.text == ".") { root.transport-action(TransportAction.next); return accept; }
                                if (e.text == "i" || e.text == "I") { root.transport-action(TransportAction.set-in); return accept; }
                                if (e.text == "o" || e.text == "O") { root.transport-action(TransportAction.set-out); return accept; }
                                if (e.text == "x" || e.text == "X") { root.transport-action(TransportAction.clear-range); return accept; }
                                if (e.text == "l" || e.text == "L") { root.transport-action(TransportAction.loop); return accept; }
                                if (e.text == "f" || e.text == "F") { root.transport-action(TransportAction.live); return accept; }
                                if (e.text == Key.Home) { root.seek(root.transport.start); return accept; }
                                if (e.text == Key.End) { root.seek(root.transport.end); return accept; }
                                reject
                            }
                            VerticalLayout {
                                Preview {
                                    field: root.field;
                                    intensity: root.intensity;
                                    stacked: root.preview-stacked;
                                }
                                Timeline {
                                    t: root.transport;
                                    seek(f) => { root.seek(f); }
                                    action(a) => { root.transport-action(a); }
                                }
                                TransportBar {
                                    t: root.transport;
                                    stacked <=> root.preview-stacked;
                                    action(a) => { root.transport-action(a); }
                                    command(c) => { root.command(c); }
                                    speed(v) => { root.transport-speed(v); }
                                }
                            }
                        }
                    }
                    if root.messages-shown: Splitter {
                        rows: true;
                        span: right.height - 4px;
                        minimum-before: 100px;
                        before <=> root.preview-weight;
                        after <=> root.messages-weight;
                    }
                    if root.messages-shown: Pane {
                        title: @tr("Messages");
                        vertical-stretch: root.messages-weight;
                        preferred-height: 0px;
                        min-height: 60px;
                        close => { root.messages-shown = false; }
                        Messages {
                            rows: root.log-rows;
                            levels: root.log-levels;
                            toggle(l) => { root.log-toggle(l); }
                            search(t) => { root.log-search(t); }
                            clear => { root.log-clear(); }
                        }
                    }
                }
            }
            Rectangle {
                height: Theme.status-height;
                background: Theme.status;
                TouchArea {
                    double-clicked => { root.messages-shown = true; }
                }
                HorizontalLayout {
                    padding-left: 4px;
                    padding-right: 16px;
                    Text {
                        text: root.status-text;
                        color: Theme.selection-text;
                        vertical-alignment: center;
                        overflow: elide;
                        min-width: 0px;
                    }
                    // a Text's width bounds its row; the spacer leaves the window free
                    Rectangle { horizontal-stretch: 1; min-width: 12px; }
                    Text {
                        text: root.export-progress.active ? @tr("Exporting {}/{}", root.export-progress.done, root.export-progress.total)
                            : root.run-status.state == RunState.none ? ""
                            : @tr("{}: {} / {} steps, {}", root.run-status.state == RunState.running ? @tr("Running")
                                : root.run-status.state == RunState.paused ? @tr("Paused")
                                : root.run-status.state == RunState.failed ? @tr("Failed")
                                : root.run-status.state == RunState.completed ? @tr("Completed") : @tr("Stopped"),
                                root.run-status.steps-done, root.run-status.steps, root.run-status.engine);
                        color: Theme.selection-text;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }
    WelcomeLayer {
        // an overlay: its frame sets no bounds on the window
        min-width: 0px;
        max-width: 100000px;
        min-height: 0px;
        max-height: 100000px;
        shown <=> root.welcome-shown;
        ram: root.welcome-ram;
        levers: root.welcome-levers;
        show-startup: root.welcome-show-startup;
        preset(i) => { root.welcome-preset(i); }
        command(c) => {
            root.welcome-shown = false;
            root.command(c);
        }
        show-startup-toggled(b) => { root.welcome-show-startup-toggled(b); }
    }
    ExamplesLayer {
        // an overlay: its frame sets no bounds on the window
        min-width: 0px;
        max-width: 100000px;
        min-height: 0px;
        max-height: 100000px;
        shown <=> root.examples-shown;
        topic: root.example-topic;
        rows: root.example-rows;
        pick-topic(i) => { root.example-topic-picked(i); }
        search(t) => { root.example-search(t); }
        open(i) => { root.example-open(i); }
    }
    SettingsLayer {
        // an overlay: its frame sets no bounds on the window
        min-width: 0px;
        max-width: 100000px;
        min-height: 0px;
        max-height: 100000px;
        shown <=> root.settings-shown;
        data <=> root.settings;
        undo-spec: root.undo-spec;
        edited => { root.settings-edited(); }
    }
    ModalLayer {
        // an overlay: its frame sets no bounds on the window
        min-width: 0px;
        max-width: 100000px;
        min-height: 0px;
        max-height: 100000px;
        modal: root.modal;
        answer(i) => { root.modal-answer(i); }
    }
}
