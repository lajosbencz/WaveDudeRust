import { Theme } from "theme.slint";
// Selawik on every platform, Segoe UI's metric twin (docs/divergences.md, Font).
import "../../../crates/waveduderust/assets/fonts/Selawik-Regular.ttf";
import "../../../crates/waveduderust/assets/fonts/Selawik-Semibold.ttf";
import "../../../crates/waveduderust/assets/fonts/Selawik-Bold.ttf";
export { Palette } from "std-widgets.slint";
import { MenuIcons } from "menu-icons.slint";
import { Pane } from "pane.slint";
import { Splitter } from "splitter.slint";
import { ProjectTree, TreeRow, TreeKind } from "tree.slint";
import { Form } from "form.slint";
export { Form }
import { Properties, PropRow, PropKind } from "properties.slint";
import { Preview } from "preview.slint";
import { Timeline, TransportBar, Transport } from "timeline.slint";
import { Messages, LogRow, LogLevel, LevelToggle } from "messages.slint";
import { ModalLayer, Modal, ModalKind } from "modal.slint";
import { SettingsLayer } from "settings.slint";
import { WelcomeLayer } from "welcome.slint";
import { ExamplesLayer, ExampleRow } from "examples.slint";

export { NumberLogic, NumberSpec } from "number-box.slint";
export { Theme, TreeRow, TreeKind, PropRow, PropKind, Transport, LogRow, LogLevel, LevelToggle, Modal, ModalKind, ExampleRow }

// The main window (docs/ui/00, Main window): menu bar, panes around the preview, status bar.
// Which menu commands can run (Next's CanExecute rules, docs/ui/10).
export struct Commands {
    can-undo: bool,
    can-redo: bool,
    // an object row is selected
    can-delete: bool,
    can-move-up: bool,
    // any source, part or probe
    can-select-all: bool,
    // the current row is a source, a part or a probe
    can-toggle: bool,
    can-move-down: bool,
    // an object or a settings row is selected
    can-copy: bool,
    can-run: bool,
    run-active: bool,
    paused: bool,
    // a run or an export is active
    can-stop: bool,
    can-export: bool,
    can-export-last: bool,
    // the project is not the blank one shown at start
    can-close: bool,
    can-play: bool,
    playing: bool,
}

export component AppWindow inherits Window {
    in property <string> window-title: "WaveDude Rust";
    in property <string> status-text;
    in property <Commands> commands;
    // The menu bar is Windows' native one (not `Platform.os`, which names a browser's host on the web).
    in property <bool> native-access-keys;
    // Newest first, full paths.
    in property <[string]> recent-files;
    in property <[TreeRow]> tree-rows;
    // the current row's index among them, -1 when hidden
    in property <int> tree-current;
    // the row and how: 0 alone, 1 toggled (Ctrl), 2 range (Shift)
    callback tree-select(int, int);
    callback tree-toggle(int);
    callback tree-expand(int);
    callback tree-navigate(string, bool);
    pure callback tree-drag-data(int) -> data-transfer;
    callback tree-drop-place(int, data-transfer, bool) -> int;
    callback tree-drop(int, data-transfer, bool);
    callback tree-shift(int, int);
    callback tree-remove(int);
    in property <image> field;
    in property <image> intensity;
    in property <string> run-status;
    in property <Transport> transport;
    in property <Modal> modal;
    in-out property <bool> examples-shown;
    in property <[string]> example-topics;
    in property <int> example-topic;
    in property <[ExampleRow]> example-rows;
    callback example-topic-picked(int);
    callback example-search(string);
    callback example-open(int);
    in-out property <bool> welcome-shown;
    in property <string> welcome-ram;
    in property <string> welcome-levers;
    in property <bool> welcome-show-startup;
    callback welcome-preset(int);
    callback welcome-action(string);
    callback welcome-show-startup-toggled(bool);
    in-out property <bool> settings-shown;
    in property <[string]> settings-sections;
    in property <int> settings-section;
    in property <[PropRow]> settings-rows;
    callback settings-pick(int);
    callback settings-set(int, string) -> bool;
    callback modal-answer(int);
    in property <[LogRow]> log-rows;
    in property <[LevelToggle]> log-levels;
    callback log-toggle(LogLevel);
    callback log-search(string);
    callback log-clear();
    callback seek(int);
    callback transport-action(string);
    callback transport-speed(string);
    in property <string> props-form;
    callback props-action(string);
    in property <string> props-heading;
    // a folder's item count; -1 for other rows
    in property <int> props-entries: -1;
    in property <[PropRow]> props-rows;
    in property <string> props-error;
    callback props-set(form: int, row: int, text: string) -> bool;
    callback props-typed(form: int, row: int, text: string);
    in-out property <bool> project-shown: true;
    in-out property <bool> properties-shown: true;
    in-out property <bool> messages-shown: false;
    // A menu entry's action, by its id (docs/ui/10).
    in-out property <bool> preview-stacked: true;
    // The panes' stretches, which the splitters move (docs/ui/00, Panes: 1 : 3, 1 : 2, 3 : 1).
    in-out property <float> left-weight: 1;
    in-out property <float> right-weight: 3;
    in-out property <float> project-weight: 1;
    in-out property <float> properties-weight: 2;
    in-out property <float> preview-weight: 3;
    in-out property <float> messages-weight: 1;
    callback menu(string);
    // The main area takes the keys back once the last overlay closed.
    function overlays-closed() {
        if (!self.welcome-shown && !self.examples-shown && !self.settings-shown && !self.modal.shown) {
            keys.focus();
        }
    }
    changed welcome-shown => { self.overlays-closed(); }
    changed examples-shown => { self.overlays-closed(); }
    changed settings-shown => { self.overlays-closed(); }
    changed modal => { self.overlays-closed(); }

    title: root.window-title;
    icon: @image-url("../assets/icon.svg");
    min-width: 800px;
    min-height: 500px;
    max-width: 100000px;
    max-height: 100000px;
    preferred-width: 1280px;
    preferred-height: 800px;
    background: Theme.window-background;
    default-font-family: "Selawik";
    default-font-size: Theme.font-size;

    // A menu title: Windows' native menu bar takes `&` access keys, Slint's own bar would draw them (docs/blockers.md).
    pure function menu-text(keyed: string, plain: string) -> string {
        root.native-access-keys ? keyed : plain
    }

    MenuBar {
        Menu {
            title: root.menu-text(@tr("&File"), @tr("File"));
            MenuItem { title: root.menu-text(@tr("&New Project"), @tr("New Project")); icon: MenuIcons.note-add; shortcut: @keys(Control + N); activated => { root.menu("new"); } }
            MenuItem { title: root.menu-text(@tr("&Open Project..."), @tr("Open Project...")); icon: MenuIcons.folder-open; shortcut: @keys(Control + O); activated => { root.menu("open"); } }
            Menu {
                title: root.menu-text(@tr("&Recent Projects"), @tr("Recent Projects")); icon: MenuIcons.history;
                for path[i] in root.recent-files: MenuItem { title: path; activated => { root.menu("recent:" + i); } }
            }
            MenuItem { title: root.menu-text(@tr("Exam&ples"), @tr("Examples")); icon: MenuIcons.list-alt; activated => { root.menu("examples"); } }
            MenuItem { title: root.menu-text(@tr("&Welcome Page..."), @tr("Welcome Page...")); icon: MenuIcons.waving-hand; activated => { root.menu("welcome"); } }
            MenuItem { title: root.menu-text(@tr("Se&ttings..."), @tr("Settings...")); icon: MenuIcons.settings; shortcut: @keys(Control + ","); activated => { root.menu("settings"); } }
            MenuSeparator { }
            MenuItem { title: root.menu-text(@tr("&Save"), @tr("Save")); icon: MenuIcons.save; shortcut: @keys(Control + S); activated => { root.menu("save"); } }
            MenuItem { title: root.menu-text(@tr("Save &As..."), @tr("Save As...")); icon: MenuIcons.save-as; shortcut: @keys(Control + Shift + S); activated => { root.menu("save-as"); } }
            MenuSeparator { }
            Menu {
                title: root.menu-text(@tr("&Export"), @tr("Export")); icon: MenuIcons.ios-share;
                MenuItem { title: root.menu-text(@tr("Export &field..."), @tr("Export field...")); enabled: root.commands.can-export; icon: MenuIcons.ios-share; shortcut: @keys(Control + Shift + E); activated => { root.menu("export-field"); } }
                MenuItem { title: root.menu-text(@tr("Export &intensity..."), @tr("Export intensity...")); enabled: root.commands.can-export; icon: MenuIcons.ios-share; shortcut: @keys(Control + Shift + I); activated => { root.menu("export-intensity"); } }
                MenuItem { title: root.menu-text(@tr("Export b&oth..."), @tr("Export both...")); enabled: root.commands.can-export; icon: MenuIcons.ios-share; shortcut: @keys(Control + Shift + B); activated => { root.menu("export-both"); } }
                MenuSeparator { }
                MenuItem { title: root.menu-text(@tr("Export field f&rame..."), @tr("Export field frame...")); enabled: root.commands.can-export; icon: MenuIcons.image; shortcut: @keys(Control + Shift + F); activated => { root.menu("export-field-frame"); } }
                MenuItem { title: root.menu-text(@tr("Export intensity fra&me..."), @tr("Export intensity frame...")); enabled: root.commands.can-export; icon: MenuIcons.image; shortcut: @keys(Control + Shift + G); activated => { root.menu("export-intensity-frame"); } }
            }
            MenuItem { title: root.menu-text(@tr("Export &last"), @tr("Export last")); enabled: root.commands.can-export-last; icon: MenuIcons.repeat; shortcut: @keys(Control + E); activated => { root.menu("export-last"); } }
            MenuSeparator { }
            MenuItem { title: root.menu-text(@tr("&Close Project"), @tr("Close Project")); enabled: root.commands.can-close; icon: MenuIcons.close; activated => { root.menu("close"); } }
            MenuSeparator { }
            MenuItem { title: root.menu-text(@tr("E&xit"), @tr("Exit")); icon: MenuIcons.logout; activated => { root.menu("exit"); } }
        }
        Menu {
            title: root.menu-text(@tr("&Edit"), @tr("Edit"));
            MenuItem { title: root.menu-text(@tr("&Undo"), @tr("Undo")); icon: MenuIcons.undo; enabled: root.commands.can-undo; activated => { root.menu("undo"); } }
            MenuItem { title: root.menu-text(@tr("&Redo"), @tr("Redo")); icon: MenuIcons.redo; enabled: root.commands.can-redo; activated => { root.menu("redo"); } }
            MenuSeparator { }
            MenuItem { title: root.menu-text(@tr("Cu&t"), @tr("Cut")); icon: MenuIcons.content-cut; enabled: root.commands.can-delete; activated => { root.menu("cut"); } }
            MenuItem { title: root.menu-text(@tr("&Copy"), @tr("Copy")); icon: MenuIcons.content-copy; enabled: root.commands.can-copy; activated => { root.menu("copy"); } }
            MenuItem { title: root.menu-text(@tr("&Paste"), @tr("Paste")); icon: MenuIcons.content-paste; enabled: true; activated => { root.menu("paste"); } }
            MenuItem { title: root.menu-text(@tr("&Delete"), @tr("Delete")); icon: MenuIcons.delete; enabled: root.commands.can-delete; activated => { root.menu("delete"); } }
            MenuSeparator { }
            MenuItem { title: root.menu-text(@tr("Select &all"), @tr("Select all")); icon: MenuIcons.select-all; enabled: root.commands.can-select-all; activated => { root.menu("select-all"); } }
        }
        Menu {
            title: root.menu-text(@tr("&View"), @tr("View"));
            Menu {
                title: root.menu-text(@tr("&Panes"), @tr("Panes")); icon: MenuIcons.view-sidebar;
                MenuItem { title: @tr("Project"); checkable: true; checked: root.project-shown; activated => { root.project-shown = !root.project-shown; } }
                MenuItem { title: @tr("Properties"); checkable: true; checked: root.properties-shown; activated => { root.properties-shown = !root.properties-shown; } }
                MenuItem { title: @tr("Messages"); checkable: true; checked: root.messages-shown; activated => { root.messages-shown = !root.messages-shown; } }
            }
        }
        Menu {
            title: root.menu-text(@tr("&Simulation"), @tr("Simulation"));
            MenuItem { title: root.menu-text(@tr("&Run"), @tr("Run")); icon: MenuIcons.play-arrow; enabled: root.commands.can-run; shortcut: @keys(F5); activated => { root.menu("run"); } }
            MenuItem { title: root.commands.paused ? root.menu-text(@tr("&Resume"), @tr("Resume")) : root.menu-text(@tr("&Pause"), @tr("Pause")); icon: MenuIcons.pause; enabled: root.commands.run-active; shortcut: @keys(F6); activated => { root.menu("pause"); } }
            MenuItem { title: root.menu-text(@tr("S&top"), @tr("Stop")); icon: MenuIcons.stop; enabled: root.commands.can-stop; shortcut: @keys(Shift + F5); activated => { root.menu("stop"); } }
            MenuSeparator { }
            MenuItem {
                title: root.commands.playing ? root.menu-text(@tr("Pause pla&yback"), @tr("Pause playback")) : root.menu-text(@tr("Pla&y"), @tr("Play"));
                icon: root.commands.playing ? MenuIcons.pause : MenuIcons.play-arrow;
                enabled: root.commands.can-play;
                shortcut: @keys(F7);
                activated => { root.transport-action("play"); }
            }
        }
        Menu {
            title: root.menu-text(@tr("&Help"), @tr("Help"));
            MenuItem { title: root.menu-text(@tr("&About WaveDude Rust"), @tr("About WaveDude Rust")); icon: MenuIcons.info; activated => { root.menu("about"); } }
            MenuItem { title: root.menu-text(@tr("&Project page on GitHub"), @tr("Project page on GitHub")); icon: MenuIcons.open-in-new; shortcut: @keys(F1); activated => { root.menu("github"); } }
        }
    }

    // The editing keys a focused editor leaves unhandled (docs/ui/10, Edit): menu shortcuts would take them from
    // the text fields.
    keys := FocusScope {
        init => { self.focus(); }
        key-pressed(e) => {
            if (e.text == Key.Escape && root.commands.can-stop) { root.menu("stop"); return accept; }
            if (e.text == Key.Delete && !e.modifiers.control && !e.modifiers.shift) { root.menu("delete"); return accept; }
            if (!e.modifiers.control || e.modifiers.alt) { return reject; }
            if (e.text == "z" && !e.modifiers.shift) { root.menu("undo"); return accept; }
            if (e.text == "y" || (e.text == "z" && e.modifiers.shift)) { root.menu("redo"); return accept; }
            if (e.text == "x") { root.menu("cut"); return accept; }
            if (e.text == "c") { root.menu("copy"); return accept; }
            if (e.text == "v") { root.menu("paste"); return accept; }
            if (e.text == "a") { root.menu("select-all"); return accept; }
            reject
        }
        VerticalLayout {

            columns := HorizontalLayout {
                padding: 4px;
                // a pane's minimum is Next's (DockHost: 60 px, 100 px holding the preview), its content clipped
                if root.project-shown || root.properties-shown: left := VerticalLayout {
                    horizontal-stretch: root.left-weight;
                    preferred-width: 0px;
                    min-width: 60px;
                    if root.project-shown: Pane {
                        title: @tr("Project");
                        vertical-stretch: root.project-weight;
                        preferred-height: 0px;
                        min-height: 60px;
                        close => { root.project-shown = false; }
                        ProjectTree {
                            rows: root.tree-rows;
                            current-row: root.tree-current;
                            select(i, pick) => { root.tree-select(i, pick); }
                            toggle(i) => { root.tree-toggle(i); }
                            expand(i) => { root.tree-expand(i); }
                            shift(i, by) => { root.tree-shift(i, by); }
                            remove(i) => { root.tree-remove(i); }
                            can-move-up: root.commands.can-move-up;
                            can-move-down: root.commands.can-move-down;
                            can-remove: root.commands.can-delete;
                            can-copy: root.commands.can-copy;
                            can-select-all: root.commands.can-select-all;
                            can-toggle: root.commands.can-toggle;
                            act(id) => { root.menu(id); }
                            navigate(key, extend) => { root.tree-navigate(key, extend); }
                            drag-data(row) => { return root.tree-drag-data(row); }
                            drop-place(row, data, before) => { return root.tree-drop-place(row, data, before); }
                            drop(row, data, before) => { root.tree-drop(row, data, before); }
                        }
                    }
                    if root.project-shown && root.properties-shown: Splitter {
                        rows: true;
                        span: left.height - 4px;
                        before <=> root.project-weight;
                        after <=> root.properties-weight;
                    }
                    if root.properties-shown: Pane {
                        title: @tr("Properties");
                        vertical-stretch: root.properties-weight;
                        preferred-height: 0px;
                        min-height: 60px;
                        close => { root.properties-shown = false; }
                        Properties {
                            form: root.props-form;
                            action(id) => { root.props-action(id); }
                            heading: root.props-heading;
                            entries: root.props-entries;
                            rows: root.props-rows;
                            error: root.props-error;
                            set(form, i, v) => { return root.props-set(form, i, v); }
                            typed(form, i, v) => { root.props-typed(form, i, v); }
                        }
                    }
                }
                if root.project-shown || root.properties-shown: Splitter {
                    span: columns.width - 12px;
                    start: 4px;
                    minimum-after: 100px;
                    before <=> root.left-weight;
                    after <=> root.right-weight;
                }
                right := VerticalLayout {
                    horizontal-stretch: root.right-weight;
                    preferred-width: 0px;
                    min-width: 100px;
                    Pane {
                        title: @tr("Preview");
                        active: true;
                        vertical-stretch: root.preview-weight;
                        preferred-height: 0px;
                        min-height: 100px;
                        // Next's preview keys, its own even when the command cannot run; a click on the pictures
                        // focuses it
                        preview-keys := FocusScope {
                            key-pressed(e) => {
                                if (e.modifiers.control || e.modifiers.alt || e.modifiers.meta || e.modifiers.shift) { return reject; }
                                if (e.text == " ") { root.transport-action("play"); return accept; }
                                if (e.text == ",") { root.transport-action("prev"); return accept; }
                                if (e.text == ".") { root.transport-action("next"); return accept; }
                                if (e.text == "i" || e.text == "I") { root.transport-action("in"); return accept; }
                                if (e.text == "o" || e.text == "O") { root.transport-action("out"); return accept; }
                                if (e.text == "x" || e.text == "X") { root.transport-action("clear-range"); return accept; }
                                if (e.text == "l" || e.text == "L") { root.transport-action("loop"); return accept; }
                                if (e.text == "f" || e.text == "F") { root.transport-action("live"); return accept; }
                                if (e.text == Key.Home) { root.seek(root.transport.start); return accept; }
                                if (e.text == Key.End) { root.seek(root.transport.end); return accept; }
                                reject
                            }
                            VerticalLayout {
                                Preview {
                                    field: root.field;
                                    intensity: root.intensity;
                                    stacked: root.preview-stacked;
                                }
                                Timeline {
                                    t: root.transport;
                                    seek(f) => { root.seek(f); }
                                    key(k) => { root.transport-action(k); }
                                }
                                TransportBar {
                                    t: root.transport;
                                    stacked <=> root.preview-stacked;
                                    action(a) => { root.transport-action(a); }
                                    speed(v) => { root.transport-speed(v); }
                                }
                            }
                        }
                    }
                    if root.messages-shown: Splitter {
                        rows: true;
                        span: right.height - 4px;
                        minimum-before: 100px;
                        before <=> root.preview-weight;
                        after <=> root.messages-weight;
                    }
                    if root.messages-shown: Pane {
                        title: @tr("Messages");
                        vertical-stretch: root.messages-weight;
                        preferred-height: 0px;
                        min-height: 60px;
                        close => { root.messages-shown = false; }
                        Messages {
                            rows: root.log-rows;
                            levels: root.log-levels;
                            toggle(l) => { root.log-toggle(l); }
                            search(t) => { root.log-search(t); }
                            clear => { root.log-clear(); }
                        }
                    }
                }
            }
            Rectangle {
                height: Theme.status-height;
                background: Theme.status;
                TouchArea {
                    double-clicked => { root.messages-shown = true; }
                }
                HorizontalLayout {
                    padding-left: 4px;
                    padding-right: 16px;
                    Text {
                        text: root.status-text;
                        color: Theme.selection-text;
                        vertical-alignment: center;
                        overflow: elide;
                        min-width: 0px;
                    }
                    // a Text's width bounds its row; the spacer leaves the window free
                    Rectangle { horizontal-stretch: 1; min-width: 12px; }
                    Text {
                        text: root.run-status;
                        color: Theme.selection-text;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }
    WelcomeLayer {
        // an overlay: its frame sets no bounds on the window
        min-width: 0px;
        max-width: 100000px;
        min-height: 0px;
        max-height: 100000px;
        shown <=> root.welcome-shown;
        ram: root.welcome-ram;
        levers: root.welcome-levers;
        show-startup: root.welcome-show-startup;
        preset(i) => { root.welcome-preset(i); }
        action(a) => { root.welcome-action(a); }
        show-startup-toggled(b) => { root.welcome-show-startup-toggled(b); }
    }
    ExamplesLayer {
        // an overlay: its frame sets no bounds on the window
        min-width: 0px;
        max-width: 100000px;
        min-height: 0px;
        max-height: 100000px;
        shown <=> root.examples-shown;
        topics: root.example-topics;
        topic: root.example-topic;
        rows: root.example-rows;
        pick-topic(i) => { root.example-topic-picked(i); }
        search(t) => { root.example-search(t); }
        open(i) => { root.example-open(i); }
    }
    SettingsLayer {
        // an overlay: its frame sets no bounds on the window
        min-width: 0px;
        max-width: 100000px;
        min-height: 0px;
        max-height: 100000px;
        shown <=> root.settings-shown;
        sections: root.settings-sections;
        section: root.settings-section;
        rows: root.settings-rows;
        pick(i) => { root.settings-pick(i); }
        set(i, v) => { return root.settings-set(i, v); }
    }
    ModalLayer {
        // an overlay: its frame sets no bounds on the window
        min-width: 0px;
        max-width: 100000px;
        min-height: 0px;
        max-height: 100000px;
        modal: root.modal;
        answer(i) => { root.modal-answer(i); }
    }
}
