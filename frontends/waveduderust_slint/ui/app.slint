import { Theme } from "theme.slint";
import { Command, Commands, NewItem, TreeKey, Pick, DropPlace, TransportAction, PreviewQuality } from "commands.slint";
// Selawik on every platform, Segoe UI's metric twin (docs/divergences.md, Font).
import "../../../crates/waveduderust/assets/fonts/Selawik-Regular.ttf";
import "../../../crates/waveduderust/assets/fonts/Selawik-Semibold.ttf";
import "../../../crates/waveduderust/assets/fonts/Selawik-Bold.ttf";
export { Palette } from "std-widgets.slint";
import { MenuIcons } from "menu-icons.slint";
import { EditKeys } from "edit-keys.slint";
import { DockArea, DockGroup, DockSplitter, DockMetrics, DockPlace, DockPreview, DockSide } from "@slint-dock/dock.slint";
import { ProjectTree, Tree, TreeRow, TreeKind, TreeWords } from "tree.slint";
import { Form, NumberParse } from "form.slint";
export { Form, NumberParse }
export { Log }
export { Playback } from "timeline.slint";
export { Tree, PropsHead } from "tree.slint";
export { Status, StatusLine } from "status.slint";
export { Words, ExportFileFormat } from "words.slint";
import { Properties } from "properties.slint";
import { Preview } from "preview.slint";
import { Canvas } from "canvas.slint";
import { Timeline, TransportBar, Playback, Transport, Bracket } from "timeline.slint";
import { StatusBar } from "status.slint";
import { Messages, Log, LogRow, LogLevel, LevelToggle } from "messages.slint";
import { ModalLayer, Modal, Message, Answer } from "modal.slint";
import { MemoryWarningLayer, MemoryWarningData, WarningAnswer } from "memory-warning.slint";
import { AboutLayer, AboutData } from "about.slint";
import { ExportLayer, ExportData, ExportReason } from "export-dialog.slint";
export { ExportData, ExportReason }
import { SettingsLayer, SettingsData, ColorTheme, Language, Scale, Search } from "settings.slint";
export { SettingsData, ColorTheme, Language, Scale, Search }
import { WelcomeLayer, Levers } from "welcome.slint";
import { RamBar, RamBarView } from "ram-bar.slint";
export { Levers }
import { ExamplesLayer, ExampleRow, ExampleTopic } from "examples.slint";

import { NumberSpec } from "number-box.slint";
export { NumberLogic, NumberSpec } from "number-box.slint";
export { ColorLogic, Hsv } from "color-picker.slint";
export { Canvas, EdgeLine, GraphBox, GraphTick, HandleData, HandleGlyph, HandleKey, HoverTip, LabelData, OverlayArt, Rect, TipKind } from "canvas.slint";
export { Command, Commands, Mine, NewItem, FolderAdd, TreeKey, Pick, DropPlace, TransportAction, PreviewQuality, RunState, RunStatus, ExportProgress } from "commands.slint";
export { MemoryWarningData, WarningAnswer, AboutData }
export { Theme, TreeRow, TreeKind, Transport, Bracket, LogRow, LogLevel, LevelToggle, Modal, Message, Answer, ExampleRow, ExampleTopic }


// A pane's content at its place in the dock, cut off below its content's size as Next's grid cells do.
component DockedPane inherits Rectangle {
    in property <DockPlace> place;
    x: root.place.x;
    y: root.place.y;
    width: root.place.width;
    height: root.place.height;
    visible: root.place.visible;
    background: Theme.tool-window-background;
    clip: true;
    VerticalLayout {
        @children
    }
}

// The main window (docs/ui/00, Main window): menu bar, panes around the preview, status bar.
export component AppWindow inherits Window {
    // the project's file: its name (empty without one), its full path, unsaved edits
    in property <string> file-name;
    in property <string> file-path;
    in property <bool> dirty;
    in property <bool> title-full-path;
    in property <Commands> commands;
    // The menu bar is Windows' native one (not `Platform.os`, which names a browser's host on the web).
    in property <bool> native-access-keys;
    // Newest first, full paths.
    in property <[string]> recent-files;
    in property <Modal> modal;
    in-out property <bool> examples-shown;
    in property <ExampleTopic> example-topic;
    in property <[ExampleRow]> example-rows;
    callback example-topic-picked(ExampleTopic);
    callback example-search(string);
    callback example-open(int);
    in-out property <bool> welcome-shown;
    // the memory, refreshed by `ram-refresh` while a view of it is shown
    in property <RamBar> ram;
    callback ram-refresh();
    in property <Levers> welcome-levers;
    in property <bool> welcome-show-startup;
    callback welcome-preset(PreviewQuality);
    callback welcome-show-startup-toggled(bool);
    in-out property <bool> settings-shown;
    in-out property <SettingsData> settings;
    in property <NumberSpec> undo-spec;
    callback settings-edited();
    callback modal-answer(Answer);
    in-out property <bool> about-shown;
    in property <AboutData> about;
    callback about-copy();
    callback about-link(string);
    in-out property <bool> export-shown;
    in-out property <ExportData> export-data;
    callback export-format(index: int);
    callback export-browse();
    callback export-browse-archive();
    callback export-ok();
    callback export-delete-codec();
    callback export-path-edited();
    in property <bool> memory-warning-shown;
    in property <MemoryWarningData> memory-warning;
    callback memory-warning-ticked(bool, bool, bool, bool);
    callback memory-warning-answer(WarningAnswer, bool);
    // The dock (src/docking.rs): its chrome's models, its size, and per pane whether it is shown and where its
    // content goes; the preview is the centre.
    in property <[DockGroup]> dock-groups;
    in property <[DockSplitter]> dock-splitters;
    in property <DockMetrics> dock-metrics;
    out property <length> dock-width: dock.width;
    out property <length> dock-height: dock.height;
    out property <length> dock-x: dock.absolute-position.x;
    out property <length> dock-y: dock.absolute-position.y;
    // a pointer press at `x`, `y` in the window, which Slint delivers too
    callback dock-pressed(x: length, y: length);
    callback dock-resized();
    callback dock-splitter-moved(index: int, x: length, y: length);
    callback dock-splitter-released();
    callback dock-move-to(pane: string, side: DockSide);
    callback dock-activate(pane: string);
    callback dock-drag-over(pane: string, group: bool, x: length, y: length) -> DockPreview;
    callback dock-dropped(pane: string, group: bool, x: length, y: length);
    callback dock-cancelled();
    out property <bool> dock-dragging: dock.dragging;
    // shows or hides pane `pane`
    callback pane-shown(pane: string, shown: bool);
    in property <bool> project-shown;
    in property <bool> properties-shown;
    in property <bool> messages-shown;
    in property <bool> performance-shown;
    in property <DockPlace> project-place;
    in property <DockPlace> properties-place;
    in property <DockPlace> messages-place;
    in property <DockPlace> performance-place;
    in property <DockPlace> preview-place;
    // the pane takes the focus when it opens; closed, it hands the focus back
    changed messages-shown => {
        if (!self.messages-shown) { keys.focus(); }
    }
    // a menu entry's, shortcut's or button's action (docs/ui/10)
    callback command(Command);
    callback add(NewItem);
    // a shortcut that binds nothing
    property <keys> no-keys;
    // the recent file at an index of `recent-files`
    callback open-recent(int);
    property <bool> overlay-open: root.welcome-shown || root.examples-shown || root.settings-shown || root.export-shown
        || root.about-shown || root.memory-warning-shown || root.modal.message != Message.none;
    // the main area takes the keys back once the last overlay closed
    changed overlay-open => {
        if (!self.overlay-open) {
            keys.focus();
        }
    }

    title: "WaveDude Rust - " + (root.title-full-path && root.file-path != "" ? root.file-path : root.file-name != "" ? root.file-name : @tr("Untitled")) + (root.dirty ? "*" : "");
    icon: @image-url("../assets/icon.svg");
    min-width: 800px;
    min-height: 500px;
    max-width: 100000px;
    max-height: 100000px;
    preferred-width: 1280px;
    preferred-height: 800px;
    background: Theme.window-background;
    default-font-family: "Selawik";
    default-font-size: Theme.font-size;

    // A menu title: Windows' native menu bar takes `&` access keys, Slint's own bar would draw them (docs/blockers.md).
    pure function menu-text(keyed: string, plain: string) -> string {
        root.native-access-keys ? keyed : plain
    }

    MenuBar {
        Menu {
            title: root.menu-text(@tr("&File"), @tr("File"));
            MenuItem { title: root.menu-text(@tr("&New Project"), @tr("New Project")); icon: MenuIcons.note-add; shortcut: @keys(Control + N); activated => { root.command(Command.new); } }
            MenuItem { title: root.menu-text(@tr("&Open Project..."), @tr("Open Project...")); icon: MenuIcons.folder-open; shortcut: @keys(Control + O); activated => { root.command(Command.open); } }
            Menu {
                title: root.menu-text(@tr("&Recent Projects"), @tr("Recent Projects")); icon: MenuIcons.history;
                for path[i] in root.recent-files: MenuItem { title: path; activated => { root.open-recent(i); } }
            }
            MenuItem { title: root.menu-text(@tr("Exam&ples"), @tr("Examples")); icon: MenuIcons.list-alt; activated => { root.command(Command.examples); } }
            MenuItem { title: root.menu-text(@tr("&Welcome Page..."), @tr("Welcome Page...")); icon: MenuIcons.waving-hand; activated => { root.command(Command.welcome); } }
            MenuItem { title: root.menu-text(@tr("Se&ttings..."), @tr("Settings...")); icon: MenuIcons.settings; shortcut: @keys(Control + ","); activated => { root.command(Command.settings); } }
            MenuSeparator { }
            MenuItem { title: root.menu-text(@tr("&Save"), @tr("Save")); icon: MenuIcons.save; shortcut: @keys(Control + S); activated => { root.command(Command.save); } }
            MenuItem { title: root.menu-text(@tr("Save &As..."), @tr("Save As...")); icon: MenuIcons.save-as; shortcut: @keys(Control + Shift + S); activated => { root.command(Command.save-as); } }
            MenuSeparator { }
            Menu {
                title: root.menu-text(@tr("&Export"), @tr("Export")); icon: MenuIcons.ios-share;
                MenuItem { title: root.menu-text(@tr("Export &field..."), @tr("Export field...")); enabled: root.commands.can-export; icon: MenuIcons.ios-share; shortcut: @keys(Control + Shift + E); activated => { root.command(Command.export-field); } }
                MenuItem { title: root.menu-text(@tr("Export &intensity..."), @tr("Export intensity...")); enabled: root.commands.can-export; icon: MenuIcons.ios-share; shortcut: @keys(Control + Shift + I); activated => { root.command(Command.export-intensity); } }
                MenuItem { title: root.menu-text(@tr("Export b&oth..."), @tr("Export both...")); enabled: root.commands.can-export; icon: MenuIcons.ios-share; shortcut: @keys(Control + Shift + B); activated => { root.command(Command.export-both); } }
                MenuSeparator { }
                MenuItem { title: root.menu-text(@tr("Export field f&rame..."), @tr("Export field frame...")); enabled: root.commands.can-export; icon: MenuIcons.image; shortcut: @keys(Control + Shift + F); activated => { root.command(Command.export-field-frame); } }
                MenuItem { title: root.menu-text(@tr("Export intensity fra&me..."), @tr("Export intensity frame...")); enabled: root.commands.can-export; icon: MenuIcons.image; shortcut: @keys(Control + Shift + G); activated => { root.command(Command.export-intensity-frame); } }
            }
            MenuItem { title: root.menu-text(@tr("Export &last"), @tr("Export last")); enabled: root.commands.can-export-last; icon: MenuIcons.repeat; shortcut: @keys(Control + E); activated => { root.command(Command.export-last); } }
            MenuSeparator { }
            MenuItem { title: root.menu-text(@tr("&Close Project"), @tr("Close Project")); enabled: root.commands.can-close; icon: MenuIcons.close; activated => { root.command(Command.close); } }
            MenuSeparator { }
            MenuItem { title: root.menu-text(@tr("E&xit"), @tr("Exit")); icon: MenuIcons.logout; activated => { root.command(Command.exit); } }
        }
        Menu {
            title: root.menu-text(@tr("&Edit"), @tr("Edit"));
            MenuItem { title: root.menu-text(@tr("&Undo"), @tr("Undo")); icon: MenuIcons.undo; enabled: root.commands.can-undo; shortcut: EditKeys.local ? root.no-keys : @keys(Control + Z); activated => { root.command(Command.undo); } }
            MenuItem { title: root.menu-text(@tr("&Redo"), @tr("Redo")); icon: MenuIcons.redo; enabled: root.commands.can-redo; shortcut: EditKeys.local ? root.no-keys : @keys(Control + Y); activated => { root.command(Command.redo); } }
            MenuSeparator { }
            MenuItem { title: root.menu-text(@tr("Cu&t"), @tr("Cut")); icon: MenuIcons.content-cut; enabled: root.commands.can-delete; shortcut: EditKeys.local ? root.no-keys : @keys(Control + X); activated => { root.command(Command.cut); } }
            MenuItem { title: root.menu-text(@tr("&Copy"), @tr("Copy")); icon: MenuIcons.content-copy; enabled: root.commands.can-copy; shortcut: EditKeys.local ? root.no-keys : @keys(Control + C); activated => { root.command(Command.copy); } }
            MenuItem { title: root.menu-text(@tr("&Paste"), @tr("Paste")); icon: MenuIcons.content-paste; enabled: true; shortcut: EditKeys.local ? root.no-keys : @keys(Control + V); activated => { root.command(Command.paste); } }
            MenuItem { title: root.menu-text(@tr("&Delete"), @tr("Delete")); icon: MenuIcons.delete; enabled: root.commands.can-delete; shortcut: EditKeys.local ? root.no-keys : @keys(Delete); activated => { root.command(Command.delete); } }
            MenuSeparator { }
            MenuItem { title: root.menu-text(@tr("Select &all"), @tr("Select all")); icon: MenuIcons.select-all; enabled: root.commands.can-select-all; shortcut: EditKeys.local ? root.no-keys : @keys(Control + A); activated => { root.command(Command.select-all); } }
        }
        Menu {
            title: root.menu-text(@tr("&View"), @tr("View"));
            Menu {
                title: root.menu-text(@tr("&Panes"), @tr("Panes")); icon: MenuIcons.view-sidebar;
                MenuItem { title: @tr("Project"); checkable: true; checked: root.project-shown; activated => { root.pane-shown("project", !root.project-shown); } }
                MenuItem { title: @tr("Properties"); checkable: true; checked: root.properties-shown; activated => { root.pane-shown("properties", !root.properties-shown); } }
                MenuItem { title: @tr("Messages"); checkable: true; checked: root.messages-shown; activated => { root.pane-shown("messages", !root.messages-shown); } }
                MenuItem { title: @tr("Performance"); checkable: true; checked: root.performance-shown; activated => { root.pane-shown("performance", !root.performance-shown); } }
            }
        }
        Menu {
            title: root.menu-text(@tr("&Simulation"), @tr("Simulation"));
            MenuItem { title: root.menu-text(@tr("&Run"), @tr("Run")); icon: MenuIcons.play-arrow; enabled: root.commands.can-run; shortcut: @keys(F5); activated => { root.command(Command.run); } }
            MenuItem { title: root.commands.paused ? root.menu-text(@tr("&Resume"), @tr("Resume")) : root.menu-text(@tr("&Pause"), @tr("Pause")); icon: MenuIcons.pause; enabled: root.commands.run-active; shortcut: @keys(F6); activated => { root.command(Command.pause); } }
            MenuItem { title: root.menu-text(@tr("S&top"), @tr("Stop")); icon: MenuIcons.stop; enabled: root.commands.can-stop; shortcut: @keys(Shift + F5); activated => { root.command(Command.stop); } }
            MenuItem { title: root.menu-text(@tr("&Discard frames"), @tr("Discard frames")); icon: MenuIcons.delete-sweep; enabled: root.commands.can-discard; activated => { root.command(Command.discard); } }
            MenuSeparator { }
            MenuItem {
                title: root.commands.playing ? root.menu-text(@tr("Pause pla&yback"), @tr("Pause playback")) : root.menu-text(@tr("Pla&y"), @tr("Play"));
                icon: root.commands.playing ? MenuIcons.pause : MenuIcons.play-arrow;
                enabled: root.commands.can-play;
                shortcut: @keys(F7);
                activated => { Playback.action(TransportAction.play); }
            }
        }
        Menu {
            title: root.menu-text(@tr("&Help"), @tr("Help"));
            MenuItem { title: root.menu-text(@tr("&About WaveDude Rust"), @tr("About WaveDude Rust")); icon: MenuIcons.info; shortcut: @keys(F1); activated => { root.command(Command.about); } }
            MenuItem { title: root.menu-text(@tr("&Project page on GitHub"), @tr("Project page on GitHub")); icon: MenuIcons.open-in-new; activated => { root.command(Command.github); } }
        }
    }

    // The editing keys a focused editor leaves unhandled (docs/ui/10, Edit): menu shortcuts would take them from
    // the text fields.
    keys := FocusScope {
        init => { self.focus(); }
        // a dock drag takes every key before the focused editor, so none edits the project or the layout; Esc
        // cancels it (the menu bar's shortcuts come first, docking.rs defers their layout changes)
        capture-key-pressed(e) => {
            if (!dock.dragging) { return reject; }
            if (e.text == Key.Escape) { dock.cancel(); }
            accept
        }
        key-pressed(e) => {
            if (e.text == Key.Escape && Canvas.dragging) { Canvas.cancel(); return accept; }
            if (e.text == Key.Escape && root.commands.can-stop) { root.command(Command.stop); return accept; }
            if (e.text == Key.Delete && !e.modifiers.control && !e.modifiers.shift) { root.command(Command.delete); return accept; }
            if (!e.modifiers.control || e.modifiers.alt) { return reject; }
            if (e.text == "z" && !e.modifiers.shift) { root.command(Command.undo); return accept; }
            if (e.text == "y" || (e.text == "z" && e.modifiers.shift)) { root.command(Command.redo); return accept; }
            if (e.text == "x") { root.command(Command.cut); return accept; }
            if (e.text == "c") { root.command(Command.copy); return accept; }
            if (e.text == "v") { root.command(Command.paste); return accept; }
            if (e.text == "a") { root.command(Command.select-all); return accept; }
            reject
        }
        VerticalLayout {

            HorizontalLayout {
                padding: 4px;
                padding-top: 0;
                // the dock's chrome, the panes' contents its children at their places
                Rectangle {
                    dock := DockArea {
                        groups: root.dock-groups;
                        splitters: root.dock-splitters;
                        metrics: root.dock-metrics;
                        style: {
                            font-size: Theme.font-size,
                            pane: Theme.tool-window-background,
                            title: Theme.window-background,
                            title-text: Theme.title-inactive-text,
                            grip: Theme.title-grip,
                            title-button-hover: Theme.title-button-hover,
                            title-active: Theme.accent,
                            title-active-text: Theme.selection-text,
                            grip-active: Theme.title-grip-active,
                            title-button-hover-active: Theme.title-button-hover-active,
                            tab-strip: Theme.window-background,
                            tab-border: Theme.border,
                            tab-text: Theme.tab-text,
                            tab-selected-text: Theme.tab-selected-text,
                            tab-hover-text: Theme.tab-hover-text,
                            splitter: Theme.window-background,
                            drop-fill: Theme.accent.with-alpha(96 / 255),
                            drop-border: Theme.accent,
                            label: Theme.accent,
                            label-text: Theme.selection-text,
                        };
                        words: {
                            position: @tr("Window position"),
                            left: @tr("Move to Left"),
                            right: @tr("Move to Right"),
                            top: @tr("Move to Top"),
                            bottom: @tr("Move to Bottom"),
                            close: @tr("Close"),
                        };
                        title(pane) => {
                            pane == "project" ? @tr("Project") : pane == "properties" ? @tr("Properties")
                                : pane == "messages" ? @tr("Messages") : pane == "performance" ? @tr("Performance") : pane
                        }
                        close(pane) => { root.pane-shown(pane, false); }
                        activate(pane) => { root.dock-activate(pane); }
                        splitter-moved(index, x, y) => { root.dock-splitter-moved(index, x, y); }
                        splitter-released => { root.dock-splitter-released(); }
                        move-to(pane, side) => { root.dock-move-to(pane, side); }
                        resized => { root.dock-resized(); }
                        drag-over(pane, group, x, y) => { root.dock-drag-over(pane, group, x, y) }
                        dropped(pane, group, x, y) => { root.dock-dropped(pane, group, x, y); }
                        cancelled => { root.dock-cancelled(); }
                        if root.project-shown: DockedPane {
                            place: root.project-place;
                            ProjectTree {
                                commands: root.commands;
                                act(c) => { root.command(c); }
                                add-item(item) => { root.add(item); }
                            }
                        }
                        if root.properties-shown: DockedPane {
                            place: root.properties-place;
                            Properties {
                                heading: TreeWords.label(Tree.head.kind, Tree.head.heading);
                                entries: Tree.head.entries;
                            }
                        }
                        if root.messages-shown: DockedPane {
                            place: root.messages-place;
                            Messages {
                            }
                        }
                        if root.performance-shown: DockedPane {
                            place: root.performance-place;
                            VerticalLayout {
                                padding: 8px;
                                RamBarView { ram: root.ram; }
                            }
                        }
                        DockedPane {
                            place: root.preview-place;
                            // Next's preview keys, its own even when the command cannot run; a click on the pictures
                            // focuses it
                            preview-keys := FocusScope {
                                key-pressed(e) => {
                                    if (e.modifiers.control || e.modifiers.alt || e.modifiers.meta || e.modifiers.shift) { return reject; }
                                    if (e.text == " ") { Playback.action(TransportAction.play); return accept; }
                                    if (e.text == ",") { Playback.action(TransportAction.prev); return accept; }
                                    if (e.text == ".") { Playback.action(TransportAction.next); return accept; }
                                    if (e.text == "i" || e.text == "I") { Playback.action(TransportAction.set-in); return accept; }
                                    if (e.text == "o" || e.text == "O") { Playback.action(TransportAction.set-out); return accept; }
                                    if (e.text == "x" || e.text == "X") { Playback.action(TransportAction.clear-range); return accept; }
                                    if (e.text == "l" || e.text == "L") { Playback.action(TransportAction.loop); return accept; }
                                    if (e.text == "f" || e.text == "F") { Playback.action(TransportAction.live); return accept; }
                                    if (e.text == Key.Home) { Playback.seek(Playback.transport.start); return accept; }
                                    if (e.text == Key.End) { Playback.seek(Playback.transport.end); return accept; }
                                    reject
                                }
                                VerticalLayout {
                                    Preview {
                                        can-export: root.commands.can-export;
                                        focus-lost => { preview-keys.focus(); }
                                        command(c) => { root.command(c); }
                                    }
                                    Timeline {
                                    }
                                    TransportBar {
                                        command(c) => { root.command(c); }
                                    }
                                }
                            }
                        }
                    }
                }
            }
            StatusBar {
                computing: Canvas.computing;
                position: Playback.transport.position;
                open-messages => { root.pane-shown("messages", true); }
            }
        }
    }
    WelcomeLayer {
        shown <=> root.welcome-shown;
        levers: root.welcome-levers;
        show-startup: root.welcome-show-startup;
        preset(i) => { root.welcome-preset(i); }
        command(c) => {
            root.welcome-shown = false;
            root.command(c);
        }
        show-startup-toggled(b) => { root.welcome-show-startup-toggled(b); }
    }
    ExamplesLayer {
        shown <=> root.examples-shown;
        topic: root.example-topic;
        rows: root.example-rows;
        pick-topic(i) => { root.example-topic-picked(i); }
        search(t) => { root.example-search(t); }
        open(i) => { root.example-open(i); }
        welcome => { root.command(Command.welcome); }
    }
    SettingsLayer {
        shown <=> root.settings-shown;
        data <=> root.settings;
        undo-spec: root.undo-spec;
        ram: root.ram;
        edited => { root.settings-edited(); }
        preset(q) => { root.welcome-preset(q); }
    }
    Timer {
        interval: 1s;
        running: root.performance-shown || root.settings-shown;
        triggered => { root.ram-refresh(); }
    }
    ExportLayer {
        shown <=> root.export-shown;
        data <=> root.export-data;
        format(i) => { root.export-format(i); }
        browse => { root.export-browse(); }
        browse-archive => { root.export-browse-archive(); }
        ok => { root.export-ok(); }
        delete-codec => { root.export-delete-codec(); }
        path-edited => { root.export-path-edited(); }
    }
    AboutLayer {
        shown <=> root.about-shown;
        data: root.about;
        copy => { root.about-copy(); }
        open-link(u) => { root.about-link(u); }
    }
    MemoryWarningLayer {
        shown: root.memory-warning-shown;
        data: root.memory-warning;
        ticked(c, r, f, s) => { root.memory-warning-ticked(c, r, f, s); }
        answer(answer, mute) => { root.memory-warning-answer(answer, mute); }
    }
    ModalLayer {
        modal: root.modal;
        answer(i) => { root.modal-answer(i); }
    }
}
