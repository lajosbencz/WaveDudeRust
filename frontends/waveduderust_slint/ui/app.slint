import { Theme } from "theme.slint";
import { Pane } from "pane.slint";
import { ProjectTree, TreeRow, TreeKind } from "tree.slint";
import { Properties, PropRow, PropKind } from "properties.slint";
import { Preview } from "preview.slint";
import { Timeline, TransportBar, Transport } from "timeline.slint";
import { Messages, LogRow, LogLevel, LevelToggle } from "messages.slint";
import { ModalLayer, Modal, ModalKind } from "modal.slint";

export { Theme, TreeRow, TreeKind, PropRow, PropKind, Transport, LogRow, LogLevel, LevelToggle, Modal, ModalKind }

// The main window (docs/ui/00, Main window): menu bar, panes around the preview, status bar.
export component AppWindow inherits Window {
    in property <string> window-title: "WaveDude Rust";
    in property <string> status-text;
    in property <bool> can-undo;
    in property <bool> can-redo;
    in property <bool> run-active;
    in property <[TreeRow]> tree-rows;
    callback tree-select(int);
    callback tree-toggle(int);
    callback tree-shift(int, int);
    callback tree-remove(int);
    in property <image> field;
    in property <image> intensity;
    in property <string> run-status;
    in property <Transport> transport;
    in property <Modal> modal;
    callback modal-answer(int);
    in property <[LogRow]> log-rows;
    in property <[LevelToggle]> log-levels;
    callback log-toggle(LogLevel);
    callback log-search(string);
    callback log-clear();
    callback seek(int);
    callback transport-action(string);
    callback transport-speed(string);
    in property <string> props-heading;
    in property <[PropRow]> props-rows;
    in property <string> props-error;
    callback props-set(int, string);
    in-out property <bool> project-shown: true;
    in-out property <bool> properties-shown: true;
    in-out property <bool> messages-shown: false;
    // A menu entry's action, by its id (docs/ui/10).
    callback menu(string);

    title: root.window-title;
    min-width: 800px;
    min-height: 500px;
    preferred-width: 1280px;
    preferred-height: 800px;
    background: Theme.window-background;
    default-font-size: Theme.font-size;

    MenuBar {
        Menu {
            title: @tr("File");
            MenuItem { title: @tr("New Project"); shortcut: @keys(Control + N); activated => { root.menu("new"); } }
            MenuItem { title: @tr("Open Project..."); shortcut: @keys(Control + O); activated => { root.menu("open"); } }
            Menu { title: @tr("Recent Projects"); }
            MenuItem { title: @tr("Examples..."); activated => { root.menu("examples"); } }
            MenuItem { title: @tr("Welcome Page..."); activated => { root.menu("welcome"); } }
            MenuItem { title: @tr("Settings..."); shortcut: @keys(Control + ","); activated => { root.menu("settings"); } }
            MenuSeparator { }
            MenuItem { title: @tr("Save"); shortcut: @keys(Control + S); activated => { root.menu("save"); } }
            MenuItem { title: @tr("Save As..."); shortcut: @keys(Control + Shift + S); activated => { root.menu("save-as"); } }
            MenuSeparator { }
            Menu {
                title: @tr("Export");
                MenuItem { title: @tr("Export field..."); shortcut: @keys(Control + Shift + E); activated => { root.menu("export-field"); } }
                MenuItem { title: @tr("Export intensity..."); shortcut: @keys(Control + Shift + I); activated => { root.menu("export-intensity"); } }
                MenuItem { title: @tr("Export both..."); shortcut: @keys(Control + Shift + B); activated => { root.menu("export-both"); } }
                MenuSeparator { }
                MenuItem { title: @tr("Export field frame..."); shortcut: @keys(Control + Shift + F); activated => { root.menu("export-field-frame"); } }
                MenuItem { title: @tr("Export intensity frame..."); shortcut: @keys(Control + Shift + G); activated => { root.menu("export-intensity-frame"); } }
            }
            MenuItem { title: @tr("Export last"); shortcut: @keys(Control + E); activated => { root.menu("export-last"); } }
            MenuSeparator { }
            MenuItem { title: @tr("Close Project"); activated => { root.menu("close"); } }
            MenuSeparator { }
            MenuItem { title: @tr("Exit"); activated => { root.menu("exit"); } }
        }
        Menu {
            title: @tr("Edit");
            MenuItem { title: @tr("Undo"); enabled: root.can-undo; shortcut: @keys(Control + Z); activated => { root.menu("undo"); } }
            MenuItem { title: @tr("Redo"); enabled: root.can-redo; shortcut: @keys(Control + Y); activated => { root.menu("redo"); } }
            MenuSeparator { }
            MenuItem { title: @tr("Cut"); shortcut: @keys(Control + X); activated => { root.menu("cut"); } }
            MenuItem { title: @tr("Copy"); shortcut: @keys(Control + C); activated => { root.menu("copy"); } }
            MenuItem { title: @tr("Paste"); shortcut: @keys(Control + V); activated => { root.menu("paste"); } }
            MenuItem { title: @tr("Delete"); shortcut: @keys(Delete); activated => { root.menu("delete"); } }
            MenuSeparator { }
            MenuItem { title: @tr("Select all"); shortcut: @keys(Control + A); activated => { root.menu("select-all"); } }
        }
        Menu {
            title: @tr("View");
            Menu {
                title: @tr("Panes");
                MenuItem { title: @tr("Project"); checkable: true; checked: root.project-shown; activated => { root.project-shown = !root.project-shown; } }
                MenuItem { title: @tr("Properties"); checkable: true; checked: root.properties-shown; activated => { root.properties-shown = !root.properties-shown; } }
                MenuItem { title: @tr("Messages"); checkable: true; checked: root.messages-shown; activated => { root.messages-shown = !root.messages-shown; } }
            }
        }
        Menu {
            title: @tr("Simulation");
            MenuItem { title: @tr("Run"); enabled: !root.transport.running; shortcut: @keys(F5); activated => { root.menu("run"); } }
            MenuItem { title: @tr("Pause / Resume"); enabled: root.run-active; shortcut: @keys(F6); activated => { root.menu("pause"); } }
            MenuItem { title: @tr("Stop"); enabled: root.transport.running; shortcut: @keys(Shift + F5); activated => { root.menu("stop"); } }
            MenuItem { title: @tr("Discard frames"); activated => { root.menu("discard"); } }
            MenuSeparator { }
            MenuItem { title: @tr("Play / Pause playback"); shortcut: @keys(F7); activated => { root.transport-action("play"); } }
        }
        Menu {
            title: @tr("Help");
            MenuItem { title: @tr("About WaveDude Rust"); activated => { root.menu("about"); } }
            MenuItem { title: @tr("Project page on GitHub"); shortcut: @keys(F1); activated => { root.menu("github"); } }
            MenuItem { title: @tr("Check for updates"); activated => { root.menu("updates"); } }
        }
    }

    VerticalLayout {
        HorizontalLayout {
            spacing: 4px;
            padding: 4px;
            if root.project-shown || root.properties-shown: VerticalLayout {
                horizontal-stretch: 1;
                spacing: 4px;
                if root.project-shown: Pane {
                    title: @tr("Project");
                    vertical-stretch: 1;
                    close => { root.project-shown = false; }
                    ProjectTree {
                        rows: root.tree-rows;
                        focused: true;
                        select(i) => { root.tree-select(i); }
                        toggle(i) => { root.tree-toggle(i); }
                        shift(i, by) => { root.tree-shift(i, by); }
                        remove(i) => { root.tree-remove(i); }
                    }
                }
                if root.properties-shown: Pane {
                    title: @tr("Properties");
                    vertical-stretch: 2;
                    close => { root.properties-shown = false; }
                    Properties {
                        heading: root.props-heading;
                        rows: root.props-rows;
                        error: root.props-error;
                        set(i, v) => { root.props-set(i, v); }
                    }
                }
            }
            VerticalLayout {
                horizontal-stretch: 3;
                spacing: 4px;
                Pane {
                    title: @tr("Preview");
                    active: true;
                    vertical-stretch: 3;
                    VerticalLayout {
                        Preview {
                            field: root.field;
                            intensity: root.intensity;
                        }
                        Timeline {
                            t: root.transport;
                            seek(f) => { root.seek(f); }
                            key(k) => { root.transport-action(k); }
                        }
                        TransportBar {
                            t: root.transport;
                            action(a) => { root.transport-action(a); }
                            speed(v) => { root.transport-speed(v); }
                        }
                    }
                }
                if root.messages-shown: Pane {
                    title: @tr("Messages");
                    vertical-stretch: 1;
                    close => { root.messages-shown = false; }
                    Messages {
                        rows: root.log-rows;
                        levels: root.log-levels;
                        toggle(l) => { root.log-toggle(l); }
                        search(t) => { root.log-search(t); }
                        clear => { root.log-clear(); }
                    }
                }
            }
        }
        Rectangle {
            height: Theme.status-height;
            background: Theme.status;
            TouchArea {
                double-clicked => { root.messages-shown = true; }
            }
            HorizontalLayout {
                padding-left: 4px;
                padding-right: 16px;
                Text {
                    text: root.status-text;
                    color: Theme.selection-text;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
                Text {
                    text: root.run-status;
                    color: Theme.selection-text;
                    vertical-alignment: center;
                }
            }
        }
    }
    ModalLayer {
        width: 100%;
        height: 100%;
        modal: root.modal;
        answer(i) => { root.modal-answer(i); }
    }
}
