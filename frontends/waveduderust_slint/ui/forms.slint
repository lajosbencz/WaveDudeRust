// The forms Properties shows per kind of object, bound to the Form global's data.
import { Button, LineEdit } from "std-widgets.slint";
import { SchemeCombo } from "scheme-combo.slint";
import { ColorSwatch } from "color-picker.slint";
import { Theme } from "theme.slint";
import { Form, FormSection, FormPanel, FormLabel, FormValue, FormReadout, Check, FormInt, FormFloat, FormCheck, FormText, FormNotes, FormDescription, FormLink } from "form.slint";
import { SceneModeChoice, EdgesChoice, StencilCheck, SourceModeChoice, PulseShapeChoice, DetectorChoice, LayerChoice, FieldMeasurementChoice, IntensityMeasurementChoice, ProbeKindChoice, BoxSizeChoice, ScaleModeChoice, YScaleChoice, ProfileChoice, TriangleTypeChoice, DivisionChoice, FacetPatternChoice, MetaLensTypeChoice, FiberEndsChoice, SchemeKindChoice } from "choices.slint";
import { FormKind, GateKind, PointData, SchemeChoice, SchemeEntry, SceneMode, SourceMode, ProbeDetector, ProbeKind, Layer, BoxSize, YScale, TriangleType, LayerData } from "data.slint";
import { Icon, IconButton } from "icons.slint";

export component ProjectForm inherits VerticalLayout {
    alignment: start;
    FormSection { text: @tr("General"); }
    FormPanel {
        Row {
            FormLabel { text: @tr("Format version"); tip: @tr("Version of the project file format."); }
            FormValue { text: Form.project.version; }
        }
        Row {
            FormLabel {
                text: @tr("Random seed");
                tip: @tr("Seed of all random decisions (emitter jitter, random gaps). The same seed reproduces the same frames.");
            }
            HorizontalLayout {
                spacing: 6px;
                horizontal-stretch: 1;
                FormInt {
                    value <=> Form.project.seed;
                    spec: { min: -2147483648, max: 2147483647, increment: 1, decimals: 0 };
                    tip: @tr("Seed of all random decisions (emitter jitter, random gaps). The same seed reproduces the same frames.");
                }
                Button { text: @tr("New seed"); clicked => { Form.new-seed(); } }
            }
        }
        Row {
            FormLabel { text: @tr("Description"); tip: @tr("Free-text notes about the project."); vertical-stretch: 0; }
            FormNotes { text <=> Form.project.description; tip: @tr("Free-text notes about the project."); }
        }
    }
}

export component SceneForm inherits VerticalLayout {
    property <bool> image: Form.scene.mode == SceneMode.image;
    property <bool> image-sources: Form.scene.image-sources;
    alignment: start;
    FormSection { text: @tr("Canvas"); }
    FormPanel {
        Row {
            FormLabel { text: @tr("Mode"); tip: @tr("Blank canvas of the given size, or a canvas built from the scene image."); }
            SceneModeChoice {
                value <=> Form.scene.mode;
                tip: @tr("Blank canvas of the given size, or a canvas built from the scene image.");
            }
        }
        // the image rows show for an image scene only
        if root.image: Row {
            FormLabel {
                text: @tr("Scene image");
                tip: @tr("Image the canvas is built from: red = refractive index (red 0 = a mirror), green = sources, blue = damping. The name of the embedded image, or a path relative to the project folder.");
            }
            FormText {
                text <=> Form.scene.image;
                tip: @tr("Image the canvas is built from: red = refractive index (red 0 = a mirror), green = sources, blue = damping. The name of the embedded image, or a path relative to the project folder.");
            }
        }
        if root.image: Row {
            FormLabel {
                text: @tr("Image file");
                tip: @tr("Where the embedded image came from; the embedded image is what is simulated, a missing file changes nothing. The file is watched while the project is open and re-embedded when it changes; on opening the project a changed file replaces the embedded image too.");
            }
            FormValue { text: Form.scene.image-path; color: Theme.text; }
        }
        if root.image: Row {
            FormLabel { text: @tr("Embedded image"); tip: @tr("Size of the embedded scene image; the canvas takes this size"); }
            FormValue {
                text: !Form.scene.embedded ? "" : !Form.scene.readable ? @tr("(unreadable)") : "\{Form.scene.image-width} \u{D7} \{Form.scene.image-height}, \{Form.scene.image-kb} KB";
                color: Theme.text;
            }
        }
        Row {
            FormLabel { text: @tr("Width"); tip: @tr("Width of a blank canvas in pixels."); }
            FormInt { value <=> Form.scene.width; spec: { min: 8, max: 16384, increment: 1, decimals: 0 }; enabled: !root.image; tip: @tr("Width of a blank canvas in pixels."); }
        }
        Row {
            FormLabel { text: @tr("Height"); tip: @tr("Height of a blank canvas in pixels."); }
            FormInt { value <=> Form.scene.height; spec: { min: 8, max: 16384, increment: 1, decimals: 0 }; enabled: !root.image; tip: @tr("Height of a blank canvas in pixels."); }
        }
        Row {
            FormLabel {
                text: @tr("Edges");
                tip: @tr("Open lets a wave leave the grid, as if the canvas sat in open space; Reflective is a hard wall, as in Wave Dude 2D.");
            }
            EdgesChoice {
                value <=> Form.scene.edges;
                tip: @tr("Open lets a wave leave the grid, as if the canvas sat in open space; Reflective is a hard wall, as in Wave Dude 2D.");
            }
        }
        Row {
            FormLabel {
                text: @tr("Damping edge");
                tip: @tr("Thickness in pixels of the absorbing frame: positive inside the canvas, where it shows as a dark margin; negative outside it, simulated but never shown. 0 turns it off.");
            }
            FormInt {
                value <=> Form.scene.damping-edge;
                spec: { min: -8192, max: 8192, increment: 1, decimals: 0 };
                tip: @tr("Thickness in pixels of the absorbing frame: positive inside the canvas, where it shows as a dark margin; negative outside it, simulated but never shown. 0 turns it off.");
            }
        }
        Row {
            FormLabel {
                text: @tr("Refractive index");
                tip: @tr("Refractive index of a blank canvas, 1.0 to 2.55. The wave speed is 1/n cells per step.");
            }
            FormFloat {
                value <=> Form.scene.refractive-index;
                spec: { min: 1, max: 2.55, increment: 0.01, decimals: -1 };
                tip: @tr("Refractive index of a blank canvas, 1.0 to 2.55. The wave speed is 1/n cells per step.");
            }
        }
    }
    FormSection { text: @tr("Sources from the image"); }
    FormPanel {
        Row {
            FormCheck {
                checked <=> Form.scene.image-sources;
                colspan: 2;
                text: @tr("Image sources");
                tip: @tr("Let the green channel of the scene image emit waves; the pixel value is the frequency level.");
            }
        }
        Row {
            FormLabel { text: @tr("Image source amplitude"); tip: @tr("Peak amplitude of the image sources."); }
            FormFloat {
                value <=> Form.scene.image-source-scale;
                spec: { min: 0, max: 1000, increment: 0.1, decimals: -1 };
                enabled: root.image-sources;
                tip: @tr("Peak amplitude of the image sources.");
            }
        }
        Row {
            FormCheck { checked <=> Form.scene.object-sources; colspan: 2; text: @tr("Object sources"); tip: @tr("Use the sources defined in the project."); }
        }
    }
}

export component SimulationForm inherits VerticalLayout {
    alignment: start;
    FormSection { text: @tr("SectionRun" => "Run"); }
    FormPanel {
        Row {
            FormLabel { text: @tr("Steps"); tip: @tr("Total number of simulation steps."); }
            FormInt { value <=> Form.simulation.steps; spec: { min: 1, max: 10000000, increment: 100, decimals: 0 }; tip: @tr("Total number of simulation steps."); }
        }
        Row {
            FormLabel {
                text: @tr("Visualize every");
                tip: @tr("Render a frame, export it and sample the probes every this many steps.");
            }
            FormInt {
                value <=> Form.simulation.visualize-every;
                spec: { min: 1, max: 1000, increment: 1, decimals: 0 };
                tip: @tr("Render a frame, export it and sample the probes every this many steps.");
            }
        }
    }
    FormSection { text: @tr("Solver"); }
    FormPanel {
        Row {
            StencilCheck {
                colspan: 2;
                value <=> Form.simulation.stencil;
                text: @tr("4th-order Laplacian");
                tip: @tr("Use the 4th-order stencil with sub-stepping instead of the 9-point stencil. More accurate, slower.");
            }
        }
        Row {
            FormLabel {
                text: @tr("Wave speed");
                tip: @tr("Nominal wave speed in pixels per step; only used to estimate wavelengths in the editor.");
            }
            FormFloat {
                value <=> Form.simulation.wave-speed;
                spec: { min: 0.000001, max: 1000000, increment: 0.01, decimals: -1 };
                tip: @tr("Nominal wave speed in pixels per step; only used to estimate wavelengths in the editor.");
            }
        }
        Row {
            FormLabel {
                text: @tr("Intensity time decay");
                tip: @tr("Averaging window factor of the intensity: the engine averages over this \u{D7} 100 / lowest source level steps.");
            }
            FormFloat {
                value <=> Form.simulation.time-decay;
                spec: { min: 1, max: 100, increment: 1, decimals: 1, drag-step: 0.1 };
                tip: @tr("Averaging window factor of the intensity: the engine averages over this \u{D7} 100 / lowest source level steps.");
            }
        }
        Row {
            FormLabel {
                text: @tr("Source frequency scale");
                tip: @tr("Multiplier of the level-to-frequency mapping: \u{3C9} = level / 255 \u{D7} 0.5 \u{D7} scale, in radians per step.");
            }
            FormFloat {
                value <=> Form.simulation.source-frequency-scale;
                spec: { min: 0, max: 1000, increment: 0.1, decimals: -1 };
                tip: @tr("Multiplier of the level-to-frequency mapping: \u{3C9} = level / 255 \u{D7} 0.5 \u{D7} scale, in radians per step.");
            }
        }
        Row {
            FormLabel { text: @tr("Intensity scale"); tip: @tr("Multiplier applied to the intensity values the engine produces."); }
            FormFloat {
                value <=> Form.simulation.intensity-scale;
                spec: { min: 0.0000001, max: 1000000, increment: 0.1, decimals: -1 };
                tip: @tr("Multiplier applied to the intensity values the engine produces.");
            }
        }
    }
}

// One output's display settings.
component DisplayLayerForm inherits FormPanel {
    in-out property <LayerData> layer;
    in property <Layer> output;
    in property <[SchemeChoice]> schemes;
    in property <int> scheme: -1;
    Row {
        FormLabel { text: @tr("Colour scheme"); tip: @tr("Name of the colour scheme mapped onto the values."); }
        SchemeCombo {
            choices: root.schemes;
            current: root.scheme;
            tip: @tr("Name of the colour scheme mapped onto the values.");
            picked(i) => {
                let choice = root.schemes[i];
                if (choice.entry == SchemeEntry.edit-copy) {
                    Form.edit-scheme-copy(root.output);
                } else if (choice.entry == SchemeEntry.remove-mine) {
                    Form.remove-my-scheme(root.output);
                } else if (choice.entry == SchemeEntry.scheme || choice.entry == SchemeEntry.project) {
                    root.layer.color-scheme = choice.name;
                    Form.edited(false);
                }
            }
        }
    }
    Row {
        FormLabel { text: @tr("Brightness"); tip: @tr("Gain applied to the values before the colour lookup."); }
        FormFloat {
            value <=> root.layer.brightness;
            spec: { min: 0.0001, max: 100000, increment: 1, decimals: -1, log: true };
            tip: @tr("Gain applied to the values before the colour lookup.");
        }
    }
    Row {
        FormLabel {
            text: @tr("Black level");
            tip: @tr("Offset applied before the colour lookup; values at or below it map to the first colour.");
        }
        FormFloat {
            value <=> root.layer.black-level;
            spec: { min: -10, max: 1, increment: 0.01, decimals: -1 };
            tip: @tr("Offset applied before the colour lookup; values at or below it map to the first colour.");
        }
    }
    Row {
        FormCheck { colspan: 2; checked <=> root.layer.preview; text: @tr("Preview"); tip: @tr("Show this output in the live preview."); }
    }
    Row {
        FormCheck {
            colspan: 2;
            checked <=> root.layer.overlay;
            text: @tr("Outline in the preview");
            tip: @tr("Lay the scene image's glowing-edges outline over this output in the preview.");
        }
    }
    Row {
        FormLabel {
            text: @tr("Outline brightness");
            tip: @tr("Multiplier of the outline: 1 as computed, higher lifts faint edges, 0 hides it.");
        }
        FormFloat {
            value <=> root.layer.overlay-gain;
            spec: { min: 0, max: 5, increment: 0.05, decimals: -1 };
            tip: @tr("Multiplier of the outline: 1 as computed, higher lifts faint edges, 0 hides it.");
        }
    }
    Row {
        FormCheck {
            colspan: 2;
            checked <=> root.layer.overlay-in-export;
            text: @tr("Outline in the export");
            tip: @tr("Bake the outline into exported frames and videos of this output.");
        }
    }
}

export component DisplayForm inherits VerticalLayout {
    alignment: start;
    FormSection { text: @tr("Field"); }
    DisplayLayerForm { layer <=> Form.field; output: Layer.field; schemes: Form.field-schemes; scheme: Form.field-scheme; }
    FormSection { text: @tr("Intensity"); }
    DisplayLayerForm { layer <=> Form.intensity; output: Layer.intensity; schemes: Form.intensity-schemes; scheme: Form.intensity-scheme; }
    FormSection { text: @tr("Preview"); }
    FormPanel {
        Row {
            FormCheck {
                checked <=> Form.display.handles-in-preview;
                colspan: 2;
                text: @tr("Handles in the preview");
                tip: @tr("Show the handles, lines, emitter dots and levers of every source, part and probe over the preview pictures. A selected object shows its own either way.");
            }
        }
        Row {
            FormCheck {
                checked <=> Form.display.labels-in-preview;
                colspan: 2;
                text: @tr("Labels in the preview");
                tip: @tr("Show the names beside the handles over the preview pictures. A selected object shows its own either way.");
            }
        }
    }
    FormSection { text: @tr("SectionExportRange" => "Export"); }
    FormPanel {
        Row {
            FormLabel { text: @tr("From step"); tip: @tr("First simulation step of the exported range; 0 is the start of the run."); }
            FormInt {
                value <=> Form.display.export-from;
                spec: { min: 0, max: 2147483647, increment: 1, decimals: 0 };
                tip: @tr("First simulation step of the exported range; 0 is the start of the run.");
            }
        }
        Row {
            FormLabel { text: @tr("To step"); tip: @tr("Last simulation step of the exported range; 0 means the end of the run."); }
            FormInt {
                value <=> Form.display.export-to;
                spec: { min: 0, max: 2147483647, increment: 1, decimals: 0 };
                tip: @tr("Last simulation step of the exported range; 0 means the end of the run.");
            }
        }
        Row {
            FormCheck {
                checked <=> Form.display.probe-graphs-in-export;
                colspan: 2;
                text: @tr("Probe graphs in the export");
                tip: @tr("Draw the probes' graph boxes over exported frames and videos.");
            }
        }
        Row {
            FormCheck {
                checked <=> Form.display.probe-markers-in-export;
                colspan: 2;
                text: @tr("Probe markers in the export");
                tip: @tr("Draw the probes' positions (crosses, the line of a line probe, the number) over exported frames and videos.");
            }
        }
        Row {
            FormCheck {
                checked <=> Form.display.source-markers-in-export;
                colspan: 2;
                text: @tr("Source markers in the export");
                tip: @tr("Draw the enabled sources (the marker, a composite source's emitter dots, the name) over exported frames and videos.");
            }
        }
    }
    FormSection { text: @tr("Video export"); }
    FormPanel {
        Row {
            FormLabel { text: @tr("Frame rate"); tip: @tr("Frames per second of the exported video."); }
            FormInt { value <=> Form.video.fps; spec: { min: 1, max: 240, increment: 1, decimals: 0 }; tip: @tr("Frames per second of the exported video."); }
        }
        Row {
            FormLabel { text: @tr("Quality"); tip: @tr("Encoder quality, 1 to 100."); }
            FormInt { value <=> Form.video.quality; spec: { min: 1, max: 100, increment: 1, decimals: 0 }; tip: @tr("Encoder quality, 1 to 100."); }
        }
    }
}

export component SourceForm inherits VerticalLayout {
    property <bool> pulsed: Form.source.mode == SourceMode.pulsed;
    property <bool> composite: Form.source.composite;
    alignment: start;
    FormSection { text: @tr("General"); }
    FormPanel {
        Row {
            FormLabel { text: @tr("Name"); tip: @tr("Name shown in the project tree and on the canvas."); }
            FormText { text <=> Form.source.name; tip: @tr("Name shown in the project tree and on the canvas."); }
        }
        Row {
            FormCheck { checked <=> Form.source.enabled; colspan: 2; text: @tr("Label.Source.Enabled" => "Enabled"); tip: @tr("Include the source in simulation runs."); }
        }
    }
    FormSection { text: @tr("Position"); }
    FormPanel {
        Row {
            FormLabel { text: @tr("X"); tip: @tr("X of the emitter, or of the array centre, in canvas pixels."); }
            FormFloat { value <=> Form.source.x; spec: { min: 0, max: 1000000000, increment: 1, decimals: -1 }; tip: @tr("X of the emitter, or of the array centre, in canvas pixels."); }
        }
        Row {
            FormLabel { text: @tr("Y"); tip: @tr("Y of the emitter, or of the array centre, in canvas pixels."); }
            FormFloat { value <=> Form.source.y; spec: { min: 0, max: 1000000000, increment: 1, decimals: -1 }; tip: @tr("Y of the emitter, or of the array centre, in canvas pixels."); }
        }
    }
    FormSection { text: @tr("Wave"); }
    FormPanel {
        Row {
            FormLabel {
                text: @tr("Frequency");
                tip: @tr("Frequency as a level up to 255, decimals allowed, the same scale as the green channel of image sources. Above 255 the grid cannot sample the wave.");
            }
            FormFloat {
                value <=> Form.source.frequency;
                spec: { min: 0.01, max: 255, increment: 1, decimals: 2, drag-step: 0.1 };
                tip: @tr("Frequency as a level up to 255, decimals allowed, the same scale as the green channel of image sources. Above 255 the grid cannot sample the wave.");
            }
        }
        Row {
            FormLabel { text: @tr("Amplitude"); tip: @tr("Amplitude in percent, 0 to 100, decimals allowed."); }
            FormFloat {
                value <=> Form.source.amplitude;
                spec: { min: 0, max: 100, increment: 1, decimals: 2, drag-step: 0.1 };
                tip: @tr("Amplitude in percent, 0 to 100, decimals allowed.");
            }
        }
        Row {
            FormLabel { text: @tr("Phase"); tip: @tr("Phase offset in degrees, -180 to 180."); }
            FormFloat { value <=> Form.source.phase; spec: { min: -180, max: 180, increment: 1, decimals: 2, drag-step: 0.5 }; tip: @tr("Phase offset in degrees, -180 to 180."); }
        }
        Row {
            FormLabel {
                text: @tr("Wavelength");
                tip: @tr("Estimated from the wave speed and the frequency (\u{3BB} = c / f): emitters one wavelength apart radiate in phase along that direction. Holds for the 4th-order Laplacian; the 9-point stencil's speed varies with the frequency");
            }
            // the 9-point stencil's figure is nominal
            Rectangle {
                horizontal-stretch: 1;
                FormValue {
                    x: 0;
                    color: Theme.text;
                    text: !Form.source.wavelength-known ? "\u{2013}" : "\u{2248} \{Form.source.wavelength.to-fixed(1)} px" + (Form.source.nine-point ? " " + @tr("(nominal)") : "");
                }
                Tooltip {
                    text: @markdown("\{@tr("Estimated from the wave speed and the frequency (\u{3BB} = c / f): emitters one wavelength apart radiate in phase along that direction. Holds for the 4th-order Laplacian; the 9-point stencil's speed varies with the frequency")}");
                }
            }
        }
    }
    FormSection { text: @tr("Timing"); }
    FormPanel {
        Row {
            FormLabel { text: @tr("Mode"); tip: @tr("Emit continuously or in bursts."); }
            SourceModeChoice { value <=> Form.source.mode; tip: @tr("Emit continuously or in bursts."); }
        }
        Row {
            FormLabel { text: @tr("Pulse shape"); tip: @tr("Envelope of each burst; pulsed mode only."); }
            PulseShapeChoice {
                value <=> Form.source.pulse-shape;
                enabled: root.pulsed;
                tip: @tr("Envelope of each burst; pulsed mode only.");
            }
        }
        Row {
            FormLabel { text: @tr("Pulse width"); tip: @tr("Length of each burst in cycles of the source frequency; pulsed mode only."); }
            FormInt {
                value <=> Form.source.pulse-width;
                spec: { min: 1, max: 1000000000, increment: 1, decimals: -1 };
                enabled: root.pulsed;
                tip: @tr("Length of each burst in cycles of the source frequency; pulsed mode only.");
            }
        }
        Row {
            FormLabel { text: @tr("Off width"); tip: @tr("Length of the gap between bursts in cycles; pulsed mode only."); }
            FormInt {
                value <=> Form.source.off-width;
                spec: { min: 1, max: 1000000000, increment: 1, decimals: -1 };
                enabled: root.pulsed;
                tip: @tr("Length of the gap between bursts in cycles; pulsed mode only.");
            }
        }
        Row {
            FormLabel {
                text: @tr("Detach after step");
                tip: @tr("Simulation step at which the source fades out; -1 keeps it on for the whole run.");
            }
            FormInt {
                value <=> Form.source.detach-after;
                spec: { min: -1, max: 1000000000, increment: 1, decimals: -1 };
                tip: @tr("Simulation step at which the source fades out; -1 keeps it on for the whole run.");
            }
        }
    }
    FormSection { text: @tr("Array"); }
    FormCheck {
        checked <=> Form.source.composite;
        text: @tr("Composite source");
        tip: @tr("Emit from an array of emitters instead of a single point.");
    }
    Rectangle { height: 4px; }
    FormPanel {
        Row {
            FormLabel {
                text: @tr("Columns");
                tip: @tr("Number of emitters across. Odd counts keep the centre emitter on the source position.");
            }
            FormInt {
                value <=> Form.array.size-x;
                spec: { min: 1, max: 1000000000, increment: 1, decimals: -1 };
                enabled: root.composite;
                tip: @tr("Number of emitters across. Odd counts keep the centre emitter on the source position.");
            }
        }
        Row {
            FormLabel { text: @tr("Rows"); tip: @tr("Number of emitters down."); }
            FormInt {
                value <=> Form.array.size-y;
                spec: { min: 1, max: 1000000000, increment: 1, decimals: -1 };
                enabled: root.composite;
                tip: @tr("Number of emitters down.");
            }
        }
        Row {
            FormLabel { text: @tr("Horizontal spacing"); tip: @tr("Distance between neighbouring columns in canvas pixels."); }
            FormInt { value <=> Form.array.spacing-x; enabled: root.composite; tip: @tr("Distance between neighbouring columns in canvas pixels."); }
        }
        Row {
            FormLabel { text: @tr("Vertical spacing"); tip: @tr("Distance between neighbouring rows in canvas pixels."); }
            FormInt { value <=> Form.array.spacing-y; enabled: root.composite; tip: @tr("Distance between neighbouring rows in canvas pixels."); }
        }
        Row {
            FormLabel {
                text: @tr("Rotation");
                tip: @tr("Rotation of the grid about the source position in degrees, counter-clockwise on the screen. 0 keeps the rows horizontal.");
            }
            FormFloat {
                value <=> Form.array.angle;
                spec: { min: -180, max: 180, increment: 5, decimals: 1, drag-step: 0.5 };
                enabled: root.composite;
                tip: @tr("Rotation of the grid about the source position in degrees, counter-clockwise on the screen. 0 keeps the rows horizontal.");
            }
        }
        Row {
            FormSection { colspan: 2; text: @tr("Random offsets, added per emitter"); }
        }
        Row {
            FormLabel { text: @tr("Frequency"); tip: @tr("Each emitter's level is offset by up to \u{B1} this amount. 0 turns it off."); }
            FormInt {
                value <=> Form.array.random-frequency;
                spec: { min: 0, max: 1000000000, increment: 1, decimals: -1 };
                enabled: root.composite;
                tip: @tr("Each emitter's level is offset by up to \u{B1} this amount. 0 turns it off.");
            }
        }
        Row {
            FormLabel { text: @tr("Phase"); tip: @tr("Each emitter's phase is offset by up to \u{B1} this many degrees. 0 turns it off."); }
            FormInt {
                value <=> Form.array.random-phase;
                spec: { min: 0, max: 1000000000, increment: 1, decimals: -1 };
                enabled: root.composite;
                tip: @tr("Each emitter's phase is offset by up to \u{B1} this many degrees. 0 turns it off.");
            }
        }
        Row {
            FormLabel {
                text: @tr("Off width");
                tip: @tr("Each gap between bursts is offset by up to \u{B1} this many cycles, re-drawn every period. 0 turns it off.");
            }
            FormInt {
                value <=> Form.array.random-off-width;
                spec: { min: 0, max: 1000000000, increment: 1, decimals: -1 };
                enabled: root.composite;
                tip: @tr("Each gap between bursts is offset by up to \u{B1} this many cycles, re-drawn every period. 0 turns it off.");
            }
        }
        Row {
            FormLabel {
                text: @tr("Position");
                tip: @tr("Each emitter is moved by up to \u{B1} this many pixels in X and in Y. 0 turns it off.");
            }
            FormInt {
                value <=> Form.array.random-position;
                spec: { min: 0, max: 1000000000, increment: 1, decimals: -1 };
                enabled: root.composite;
                tip: @tr("Each emitter is moved by up to \u{B1} this many pixels in X and in Y. 0 turns it off.");
            }
        }
    }
}

// a probabilistic detector is a line of the integrated intensity, so it fixes the layer, the
// measurement and the kind.
export component ProbeForm inherits VerticalLayout {
    property <bool> line: Form.probe.kind == ProbeKind.line;
    property <ProbeDetector> detector: Form.probe.detector;
    property <bool> standard: root.detector == ProbeDetector.standard;
    property <bool> field: Form.probe.layer == Layer.field;
    alignment: start;
    FormSection { text: @tr("General"); }
    FormPanel {
        Row {
            FormLabel { text: @tr("Name"); tip: @tr("Name shown in the project tree and in the graph title."); }
            FormText { text <=> Form.probe.name; tip: @tr("Name shown in the project tree and in the graph title."); }
        }
        Row {
            FormCheck { checked <=> Form.probe.active; colspan: 2; text: @tr("Active"); tip: @tr("Sample and draw this probe."); }
        }
        Row {
            FormLabel { text: @tr("Start after step"); tip: @tr("Step at which recording starts; 0 records from the first step."); }
            FormInt {
                value <=> Form.probe.start-after;
                spec: { min: 0, max: 1000000000, increment: 1, decimals: -1 };
                tip: @tr("Step at which recording starts; 0 records from the first step.");
            }
        }
    }
    FormSection { text: @tr("Measurement"); }
    FormPanel {
        Row {
            FormLabel {
                text: @tr("Detector");
                tip: @tr("A standard probe, or a probabilistic detector: counting, the detections of the whole line step by step over time, as a photomultiplier's pulses; or imaging, the detections at every point of the line added up over the run, as a SPAD array builds an image. A detector is a line probe of the integrated intensity.");
            }
            DetectorChoice {
                value <=> Form.probe.detector;
                tip: @tr("A standard probe, or a probabilistic detector: counting, the detections of the whole line step by step over time, as a photomultiplier's pulses; or imaging, the detections at every point of the line added up over the run, as a SPAD array builds an image. A detector is a line probe of the integrated intensity.");
            }
        }
        Row {
            FormLabel {
                text: @tr("Detector sensitivity");
                tip: @tr("Expected detections per unit of intensity per step at a point of the line: the detector's quantum efficiency and the scale from intensity to detections in one number. The detections are Poisson-distributed about intensity \u{D7} sensitivity; 0 detects nothing.");
            }
            FormFloat {
                value <=> Form.probe.sensitivity;
                spec: { min: 0, max: 1000000, increment: 1, decimals: 2, drag-step: 0.5 };
                enabled: !root.standard;
                tip: @tr("Expected detections per unit of intensity per step at a point of the line: the detector's quantum efficiency and the scale from intensity to detections in one number. The detections are Poisson-distributed about intensity \u{D7} sensitivity; 0 detects nothing.");
            }
        }
        Row {
            FormLabel {
                text: @tr("Bin size");
                tip: @tr("Pixels of the line per bin of an imaging detector's histogram, 1 to 20: the detections of a bin's pixels are added up, and the graph shows the bin's total across them. Wider bins fill faster and show less detail.");
            }
            FormInt {
                value <=> Form.probe.bin-size;
                spec: { min: 1, max: 20, increment: 1, decimals: -1 };
                enabled: root.detector == ProbeDetector.imaging;
                tip: @tr("Pixels of the line per bin of an imaging detector's histogram, 1 to 20: the detections of a bin's pixels are added up, and the graph shows the bin's total across them. Wider bins fill faster and show less detail.");
            }
        }
        Row {
            FormLabel { text: @tr("Layer"); tip: @tr("Output the probe samples and is drawn on."); }
            LayerChoice {
                value <=> Form.probe.layer;
                enabled: root.standard;
                tip: @tr("Output the probe samples and is drawn on.");
            }
        }
        Row {
            FormLabel {
                text: @tr("Label.Probe.Measurement" => "Measurement");
                tip: @tr("Recorded quantity. The field offers its amplitude only; the intensity layer its value, or the value integrated over the run.");
            }
            // the layer's own measurements
            if root.field: FieldMeasurementChoice {
                value <=> Form.probe.measurement;
                enabled: root.standard;
                tip: @tr("Recorded quantity. The field offers its amplitude only; the intensity layer its value, or the value integrated over the run.");
            }
            if !root.field: IntensityMeasurementChoice {
                value <=> Form.probe.measurement;
                enabled: root.standard;
                tip: @tr("Recorded quantity. The field offers its amplitude only; the intensity layer its value, or the value integrated over the run.");
            }
        }
        Row {
            FormLabel { text: @tr("Kind"); tip: @tr("A single point, or a line from A to B."); }
            ProbeKindChoice {
                value <=> Form.probe.kind;
                enabled: root.standard;
                tip: @tr("A single point, or a line from A to B.");
            }
        }
    }
    FormSection { text: @tr("Position"); }
    FormPanel {
        Row {
            FormLabel { text: @tr("A x"); tip: @tr("X of the probe pixel, or of the start of the line, in canvas pixels."); }
            FormInt { value <=> Form.probe.ax; spec: { min: 0, max: 1000000000, increment: 1, decimals: -1 }; tip: @tr("X of the probe pixel, or of the start of the line, in canvas pixels."); }
        }
        Row {
            FormLabel { text: @tr("A y"); tip: @tr("Y of the probe pixel, or of the start of the line, in canvas pixels."); }
            FormInt { value <=> Form.probe.ay; spec: { min: 0, max: 1000000000, increment: 1, decimals: -1 }; tip: @tr("Y of the probe pixel, or of the start of the line, in canvas pixels."); }
        }
        Row {
            FormLabel { text: @tr("B x"); tip: @tr("X of the end of the line in canvas pixels; line probes only."); }
            FormInt {
                value <=> Form.probe.bx;
                spec: { min: 0, max: 1000000000, increment: 1, decimals: -1 };
                enabled: root.line;
                tip: @tr("X of the end of the line in canvas pixels; line probes only.");
            }
        }
        Row {
            FormLabel { text: @tr("B y"); tip: @tr("Y of the end of the line in canvas pixels; line probes only."); }
            FormInt {
                value <=> Form.probe.by;
                spec: { min: 0, max: 1000000000, increment: 1, decimals: -1 };
                enabled: root.line;
                tip: @tr("Y of the end of the line in canvas pixels; line probes only.");
            }
        }
    }
    FormSection { text: @tr("Graph"); }
    FormPanel {
        Row {
            FormLabel {
                text: @tr("Box size");
                tip: @tr("Nominal size of the graph box drawn over the output; a box larger than the canvas is shrunk to fit it, aspect kept.");
            }
            BoxSizeChoice {
                value <=> Form.probe.box-size;
                tip: @tr("Nominal size of the graph box drawn over the output; a box larger than the canvas is shrunk to fit it, aspect kept.");
            }
        }
        Row {
            FormLabel {
                text: @tr("Box x");
                tip: @tr("Left edge of the graph box in canvas pixels. A box placed on the probe's point A moves with the probe; dragging it close snaps it on.");
            }
            FormInt {
                value <=> Form.probe.box-x;
                spec: { min: 0, max: 1000000000, increment: 1, decimals: -1 };
                tip: @tr("Left edge of the graph box in canvas pixels. A box placed on the probe's point A moves with the probe; dragging it close snaps it on.");
            }
        }
        Row {
            FormLabel {
                text: @tr("Box y");
                tip: @tr("Top edge of the graph box in canvas pixels. A box placed on the probe's point A moves with the probe; dragging it close snaps it on.");
            }
            FormInt {
                value <=> Form.probe.box-y;
                spec: { min: 0, max: 1000000000, increment: 1, decimals: -1 };
                tip: @tr("Top edge of the graph box in canvas pixels. A box placed on the probe's point A moves with the probe; dragging it close snaps it on.");
            }
        }
        Row {
            FormLabel {
                text: @tr("Box width");
                tip: @tr("Width of the graph box in canvas pixels; custom box size only. A box larger than the canvas is shrunk to fit it, aspect kept.");
            }
            FormInt {
                value <=> Form.probe.box-width;
                spec: { min: 60, max: 4096, increment: 10, decimals: -1 };
                enabled: Form.probe.box-size == BoxSize.custom;
                tip: @tr("Width of the graph box in canvas pixels; custom box size only. A box larger than the canvas is shrunk to fit it, aspect kept.");
            }
        }
        Row {
            FormLabel {
                text: @tr("Box height");
                tip: @tr("Height of the graph box in canvas pixels; custom box size only. A box larger than the canvas is shrunk to fit it, aspect kept.");
            }
            FormInt {
                value <=> Form.probe.box-height;
                spec: { min: 30, max: 4096, increment: 10, decimals: -1 };
                enabled: Form.probe.box-size == BoxSize.custom;
                tip: @tr("Height of the graph box in canvas pixels; custom box size only. A box larger than the canvas is shrunk to fit it, aspect kept.");
            }
        }
    }
    FormSection { text: @tr("Axes"); }
    FormPanel {
        Row {
            FormLabel { text: @tr("Step axis"); tip: @tr("Sliding window of the last steps, or the whole run; point probes and counting detectors only."); }
            ScaleModeChoice {
                value <=> Form.probe.scale-mode;
                enabled: !Form.probe.shows-profile;
                tip: @tr("Sliding window of the last steps, or the whole run; point probes and counting detectors only.");
            }
        }
        Row {
            FormLabel { text: @tr("Window"); tip: @tr("Width of the sliding step window, in steps."); }
            FormInt { value <=> Form.probe.window; spec: { min: 10, max: 1000000, increment: 10, decimals: -1 }; tip: @tr("Width of the sliding step window, in steps."); }
        }
        Row {
            FormCheck {
                checked <=> Form.probe.auto-scale-x;
                colspan: 2;
                text: @tr("Auto-scale steps");
                enabled: !Form.probe.shows-profile;
                tip: @tr("Let the step axis follow the samples recorded so far; point probes and counting detectors only.");
            }
        }
        Row {
            FormCheck {
                checked <=> Form.probe.auto-scale-y;
                colspan: 2;
                text: @tr("Auto-scale values");
                tip: @tr("Fit the value axis to the data instead of the fixed minimum and maximum.");
            }
        }
        Row {
            FormLabel {
                text: @tr("Value axis");
                tip: @tr("A linear or a logarithmic value axis; intensity probes only, the field is always linear.");
            }
            YScaleChoice {
                value <=> Form.probe.y-scale;
                enabled: !root.field;
                tip: @tr("A linear or a logarithmic value axis; intensity probes only, the field is always linear.");
            }
        }
        Row {
            FormLabel {
                text: @tr("Decades");
                tip: @tr("Decades a logarithmic value axis spans below its top; smaller values, zero included, sit on the bottom line.");
            }
            FormInt {
                value <=> Form.probe.decades;
                spec: { min: 1, max: 12, increment: 1, decimals: -1 };
                enabled: Form.probe.y-scale == YScale.logarithmic && !root.field;
                tip: @tr("Decades a logarithmic value axis spans below its top; smaller values, zero included, sit on the bottom line.");
            }
        }
        Row {
            FormLabel { text: @tr("Value minimum"); tip: @tr("Lower bound of the value axis when it is not auto-scaled."); }
            FormFloat { value <=> Form.probe.y-min; spec: { min: -1000000000, max: 1000000000, increment: 0.1, decimals: -1 }; tip: @tr("Lower bound of the value axis when it is not auto-scaled."); }
        }
        Row {
            FormLabel { text: @tr("Value maximum"); tip: @tr("Upper bound of the value axis when it is not auto-scaled."); }
            FormFloat { value <=> Form.probe.y-max; spec: { min: -1000000000, max: 1000000000, increment: 0.1, decimals: -1 }; tip: @tr("Upper bound of the value axis when it is not auto-scaled."); }
        }
    }
}

// what the kind is, then the members every part has.
component PartCommon inherits VerticalLayout {
    in property <string> description;
    FormDescription { text: root.description; }
    FormSection { text: @tr("General"); }
    FormPanel {
        Row {
            FormLabel { text: @tr("Name"); tip: @tr("Name shown in the project tree and on the canvas."); }
            FormText { text <=> Form.part.name; tip: @tr("Name shown in the project tree and on the canvas."); }
        }
        Row {
            FormCheck {
                checked <=> Form.part.enabled;
                colspan: 2;
                text: @tr("Label.OpticalPart.Enabled" => "Enabled");
                tip: @tr("Paint the part into the scene; a disabled part has no effect on a run.");
            }
        }
    }
    FormSection { text: @tr("Position"); }
    FormPanel {
        Row {
            FormLabel { text: @tr("X"); tip: @tr("X of the part's centre in canvas pixels."); }
            FormInt { value <=> Form.part.x; spec: { min: 0, max: 1000000000, increment: 1, decimals: -1 }; tip: @tr("X of the part's centre in canvas pixels."); }
        }
        Row {
            FormLabel { text: @tr("Y"); tip: @tr("Y of the part's centre in canvas pixels."); }
            FormInt { value <=> Form.part.y; spec: { min: 0, max: 1000000000, increment: 1, decimals: -1 }; tip: @tr("Y of the part's centre in canvas pixels."); }
        }
        Row {
            FormLabel {
                text: @tr("Angle");
                tip: @tr("Rotation about the centre in degrees, counter-clockwise on the screen. 0 points the part's axis to the right.");
            }
            FormFloat {
                value <=> Form.part.angle;
                spec: { min: -180, max: 180, increment: 5, decimals: 1, drag-step: 0.5 };
                tip: @tr("Rotation about the centre in degrees, counter-clockwise on the screen. 0 points the part's axis to the right.");
            }
        }
    }
}

// A material's rows: the caller's own first, then the anti-reflection band's (depth, profile, the faces it covers)
// and, with `absorption-shown`, the material's absorption; one grid, so the labels share a column.
component MaterialPanel inherits FormPanel {
    in property <bool> enabled: true;
    in property <bool> coating-shown: true;
    in property <bool> back-only;
    in property <bool> sides-hidden;
    in property <bool> absorption-shown;
    in property <string> coating-tip: @tr("Thickness in pixels of the anti-reflection band just inside the outline; 0 for none. A quarter-wave layer is \u{3BB} / (4 \u{221A}n) pixels thick, \u{3BB} being the wavelength the source form shows; a graded band is the better the thicker, from a wavelength on.");
    @children
    if root.coating-shown: Row {
        FormLabel { text: @tr("AR coating"); tip: root.coating-tip; }
        FormFloat {
            value <=> Form.coating.depth;
            spec: { min: 0, max: 50, increment: 1, decimals: -1 };
            enabled: root.enabled;
            tip: root.coating-tip;
        }
    }
    if root.coating-shown: Row {
        FormLabel {
            text: @tr("Coating profile");
            tip: @tr("How the index runs through the band: a layer at \u{221A}n, the quarter-wave idea, or a graded rise from the medium outside to the glass. A graded band reflects less than a layer once it is a wavelength thick or more, at any wavelength; a layer only at the wavelength it is cut for.");
        }
        ProfileChoice {
            value <=> Form.coating.profile;
            enabled: root.enabled;
            tip: @tr("How the index runs through the band: a layer at \u{221A}n, the quarter-wave idea, or a graded rise from the medium outside to the glass. A graded band reflects less than a layer once it is a wavelength thick or more, at any wavelength; a layer only at the wavelength it is cut for.");
        }
    }
    if root.coating-shown && !root.back-only: Row {
        FormCheck {
            checked <=> Form.coating.front;
            colspan: 2;
            text: @tr("Coat the front");
            enabled: root.enabled;
            tip: @tr("Put the band on the front: the faces turned toward a source on the left, a lens's first surface. Clear it to leave them bare, as the inner faces of a cavity are.");
        }
    }
    if root.coating-shown: Row {
        FormCheck {
            checked <=> Form.coating.back;
            colspan: 2;
            text: @tr("Coat the back");
            enabled: root.enabled;
            tip: @tr("Put the band on the back: the faces turned away from a source on the left, a lens's second surface. Clear it to leave them bare.");
        }
    }
    if root.coating-shown && !root.back-only && !root.sides-hidden: Row {
        FormCheck {
            checked <=> Form.coating.sides;
            colspan: 2;
            text: @tr("Coat the sides");
            enabled: root.enabled;
            tip: @tr("Put the band on the sides: the faces that are neither front nor back, a lens's rim, a slab's narrow ends. Clear it to leave them bare.");
        }
    }
    if root.absorption-shown: Row {
        FormLabel {
            text: @tr("Absorption");
            tip: @tr("How strongly the part absorbs waves, 0 (not at all) to 255, as the scene image's blue channel. It rises from nothing at the outline over the absorption ramp, so a wave enters the part instead of being reflected. A mirror ignores it.");
        }
        FormInt {
            value <=> Form.material.absorption;
            spec: { min: 0, max: 255, increment: 5, decimals: -1 };
            enabled: root.enabled;
            tip: @tr("How strongly the part absorbs waves, 0 (not at all) to 255, as the scene image's blue channel. It rises from nothing at the outline over the absorption ramp, so a wave enters the part instead of being reflected. A mirror ignores it.");
        }
    }
    if root.absorption-shown: Row {
        FormLabel {
            text: @tr("Absorption ramp");
            tip: @tr("Depth in pixels over which the absorption rises from nothing at the outline to its full value; the longer, the less of a wave is reflected. A part thinner than twice the ramp reaches its full absorption in its middle.");
        }
        FormInt {
            value <=> Form.material.absorption-ramp;
            spec: { min: 1, max: 400, increment: 5, decimals: -1 };
            enabled: root.enabled;
            tip: @tr("Depth in pixels over which the absorption rises from nothing at the outline to its full value; the longer, the less of a wave is reflected. A part thinner than twice the ramp reaches its full absorption in its middle.");
        }
    }
}

// The shared Material section: mirror or glass, the index, the coating and the absorption. A kind's form hides the
// coating rows it lacks.
component ShapeMaterial inherits VerticalLayout {
    in property <string> mirror-tip: @tr("Make the part a mirror instead of glass. The refractive index, the coating and the absorption are ignored then.");
    in property <bool> coating-shown: true;
    in property <bool> back-only;
    in property <bool> sides-hidden;
    property <bool> glass: !Form.material.mirror;
    FormSection { text: @tr("Material"); }
    MaterialPanel {
        enabled: root.glass;
        coating-shown: root.coating-shown;
        back-only: root.back-only;
        sides-hidden: root.sides-hidden;
        absorption-shown: true;
        Row {
            FormCheck {
                checked <=> Form.material.mirror;
                colspan: 2;
                text: @tr("Mirror");
                tip: root.mirror-tip;
            }
        }
        Row {
            FormLabel { text: @tr("Refractive index"); tip: @tr("Refractive index of the glass, 1.00 to 2.55 in steps of 0.01."); }
            FormFloat {
                value <=> Form.material.refractive-index;
                spec: { min: 1, max: 2.55, increment: 0.01, decimals: -1 };
                enabled: root.glass;
                tip: @tr("Refractive index of the glass, 1.00 to 2.55 in steps of 0.01.");
            }
        }
    }
}

// Length and width with the chain between them that keeps them equal.
component LinkedSides inherits FormPanel {
    in property <string> length-tip;
    in property <string> width-tip;
    in property <string> link-tip;
    Row {
        FormLabel { text: @tr("Length"); tip: root.length-tip; }
        FormInt { value <=> Form.sides.length; spec: { min: 1, max: 1000000000, increment: 10, decimals: -1 }; tip: root.length-tip; }
        Rectangle {
            rowspan: 2;
            width: 22px;
            FormLink { on <=> Form.sides.linked; y: (parent.height - self.height) / 2; tip: root.link-tip; }
        }
    }
    Row {
        FormLabel { text: @tr("Width"); tip: root.width-tip; }
        FormInt { value <=> Form.sides.width; spec: { min: 1, max: 1000000000, increment: 10, decimals: -1 }; tip: root.width-tip; }
    }
}

export component RectangleForm inherits VerticalLayout {
    alignment: start;
    PartCommon {
        description: @tr("A rectangle of glass or mirror, by length and width; linked, a square. A flat mirror is a long, narrow one.");
    }
    ShapeMaterial { }
    FormSection { text: @tr("Shape"); }
    LinkedSides {
        length-tip: @tr("Extent along the axis in pixels.");
        width-tip: @tr("Extent across the axis in pixels.");
        link-tip: @tr("Keep the width equal to the length: a square.");
    }
}

export component EllipseForm inherits VerticalLayout {
    alignment: start;
    PartCommon { description: @tr("An ellipse of glass or mirror, by the length and width of its box; linked, a circle."); }
    ShapeMaterial { }
    FormSection { text: @tr("Shape"); }
    LinkedSides {
        length-tip: @tr("Diameter along the axis in pixels.");
        width-tip: @tr("Diameter across the axis in pixels.");
        link-tip: @tr("Keep the width equal to the length: a circle.");
    }
}

// the presets fix the angles, A is typed for the isosceles and custom types, B for custom.
export component TriangleForm inherits VerticalLayout {
    property <TriangleType> type: Form.triangle.kind;
    alignment: start;
    PartCommon {
        description: @tr("A triangle of glass or mirror: the base across the axis, the apex along it, the base angles set by a preset or by hand.");
    }
    ShapeMaterial { }
    FormSection { text: @tr("Shape"); }
    FormPanel {
        Row {
            FormLabel {
                text: @tr("Type");
                tip: @tr("Equilateral, right isosceles (the 45\u{B0} prism), 30-60-90, isosceles with one typed angle, or custom with both typed.");
            }
            TriangleTypeChoice {
                value <=> Form.triangle.kind;
                tip: @tr("Equilateral, right isosceles (the 45\u{B0} prism), 30-60-90, isosceles with one typed angle, or custom with both typed.");
            }
        }
        Row {
            FormLabel { text: @tr("Base"); tip: @tr("Length of the base in pixels; the base lies across the axis, toward a source on the left."); }
            FormInt {
                value <=> Form.triangle.base;
                spec: { min: 2, max: 1000000000, increment: 10, decimals: -1 };
                tip: @tr("Length of the base in pixels; the base lies across the axis, toward a source on the left.");
            }
        }
        Row {
            FormLabel {
                text: @tr("Angle A");
                tip: @tr("Base angle at the first end of the base, in degrees. Typed for the isosceles and custom types; the presets fix it.");
            }
            FormFloat {
                value <=> Form.triangle.angle-a;
                spec: { min: 1, max: 178, increment: 1, decimals: 1, drag-step: 0.5 };
                enabled: root.type == TriangleType.isosceles || root.type == TriangleType.custom;
                tip: @tr("Base angle at the first end of the base, in degrees. Typed for the isosceles and custom types; the presets fix it.");
            }
        }
        Row {
            FormLabel {
                text: @tr("Angle B");
                tip: @tr("Base angle at the second end of the base, in degrees. Typed for the custom type; the others fix it.");
            }
            FormFloat {
                value <=> Form.triangle.angle-b;
                spec: { min: 1, max: 178, increment: 1, decimals: 1, drag-step: 0.5 };
                enabled: root.type == TriangleType.custom;
                tip: @tr("Base angle at the second end of the base, in degrees. Typed for the custom type; the others fix it.");
            }
        }
        Row {
            FormLabel { text: @tr("Apex angle"); tip: @tr("The angle at the apex: 180\u{B0} minus the two base angles"); }
            Rectangle {
                horizontal-stretch: 1;
                FormValue { x: 0; color: Theme.text; text: "\{round(Form.triangle.apex * 10) / 10}\u{B0}"; }
                Tooltip { text: @markdown("\{@tr("The angle at the apex: 180\u{B0} minus the two base angles")}"); }
            }
        }
    }
}

export component PolygonForm inherits VerticalLayout {
    alignment: start;
    PartCommon { description: @tr("A regular polygon of glass or mirror, by its number of sides and the side length."); }
    ShapeMaterial { }
    FormSection { text: @tr("Shape"); }
    FormPanel {
        Row {
            FormLabel { text: @tr("Number of sides"); tip: @tr("Number of sides, 3 to 64."); }
            FormInt { value <=> Form.polygon.sides; spec: { min: 3, max: 64, increment: 1, decimals: -1 }; tip: @tr("Number of sides, 3 to 64."); }
        }
        Row {
            FormLabel { text: @tr("Side length"); tip: @tr("Length of each side in pixels."); }
            FormInt { value <=> Form.polygon.side; spec: { min: 2, max: 1000000000, increment: 10, decimals: -1 }; tip: @tr("Length of each side in pixels."); }
        }
    }
}

// the lens's rows; a Fresnel lens has its zones in place of the Concave box.
component LensShape inherits VerticalLayout {
    in property <bool> zones;
    FormSection { text: @tr("Shape"); }
    FormPanel {
        Row {
            FormLabel { text: @tr("Diameter"); tip: @tr("Extent across the axis in pixels."); }
            FormInt { value <=> Form.lens.diameter; spec: { min: 2, max: 1000000000, increment: 10, decimals: -1 }; tip: @tr("Extent across the axis in pixels."); }
        }
        if !root.zones: Row {
            FormCheck {
                checked <=> Form.lens.concave;
                colspan: 2;
                text: @tr("Concave (diverging)");
                tip: @tr("Whether the lens diverges, its surfaces curving inward. Ticking it turns the lens around by flipping the sign of both radii; a flat surface stays flat.");
            }
        }
        Row {
            FormLabel {
                text: @tr("R1");
                tip: @tr("Radius of the first surface in pixels: positive bulges outward, negative is concave, 0 is flat. A radius too curved for the diameter and the centre thickness is raised to the smallest that fits.");
            }
            FormFloat {
                value <=> Form.lens.r1;
                spec: { min: -1000000000, max: 1000000000, increment: 10, decimals: -1 };
                tip: @tr("Radius of the first surface in pixels: positive bulges outward, negative is concave, 0 is flat. A radius too curved for the diameter and the centre thickness is raised to the smallest that fits.");
            }
        }
        Row {
            FormLabel {
                text: @tr("R2");
                tip: @tr("Radius of the second surface in pixels: negative bulges outward, positive is concave, 0 is flat. A radius too curved for the diameter and the centre thickness is raised to the smallest that fits.");
            }
            FormFloat {
                value <=> Form.lens.r2;
                spec: { min: -1000000000, max: 1000000000, increment: 10, decimals: -1 };
                tip: @tr("Radius of the second surface in pixels: negative bulges outward, positive is concave, 0 is flat. A radius too curved for the diameter and the centre thickness is raised to the smallest that fits.");
            }
        }
        Row {
            FormLabel { text: @tr("Centre thickness"); tip: @tr("Distance between the two surfaces on the axis in pixels."); }
            FormInt {
                value <=> Form.lens.thickness;
                spec: { min: 1, max: 1000000000, increment: 1, decimals: -1 };
                tip: @tr("Distance between the two surfaces on the axis in pixels.");
            }
        }
        if root.zones: Row {
            FormLabel {
                text: @tr("Zones");
                tip: @tr("Number of zones each curved surface is cut into, from the axis to the rim, equal in width or in depth as the zone division says. At each zone's inner edge the arc starts again at the vertex plane, so the plate stays thin; 1 is a plain lens.");
            }
            FormInt {
                value <=> Form.fresnel.zones;
                spec: { min: 1, max: 100, increment: 1, decimals: -1 };
                tip: @tr("Number of zones each curved surface is cut into, from the axis to the rim, equal in width or in depth as the zone division says. At each zone's inner edge the arc starts again at the vertex plane, so the plate stays thin; 1 is a plain lens.");
            }
        }
        if root.zones: Row {
            FormLabel {
                text: @tr("Zone division");
                tip: @tr("How the zones are divided from the axis to the rim: equal in width, the outer zone the deepest; or equal in depth, each zone cut to the same depth and the zones narrowing outward, as the elements of a lighthouse lens are.");
            }
            DivisionChoice {
                value <=> Form.fresnel.division;
                tip: @tr("How the zones are divided from the axis to the rim: equal in width, the outer zone the deepest; or equal in depth, each zone cut to the same depth and the zones narrowing outward, as the elements of a lighthouse lens are.");
            }
        }
        Row {
            FormLabel {
                text: @tr("Edge thickness");
                tip: @tr("Thickness at the rim: the centre thickness less what the convex surfaces take, plus what the concave ones add; 0 when the surfaces meet at the rim");
            }
            FormReadout {
                text: "\{round(Form.lens.edge * 10) / 10} px";
                tip: @tr("Thickness at the rim: the centre thickness less what the convex surfaces take, plus what the concave ones add; 0 when the surfaces meet at the rim");
            }
        }
    }
}

export component LensForm inherits VerticalLayout {
    alignment: start;
    PartCommon {
        description: @tr("A lens or a mirror: a strip of the diameter between two spherical surfaces, each bulging outward, flat or hollow by the sign of its radius, the centre thickness apart. As a mirror it reflects everything; as a lens it refracts by its index, with an anti-reflection coating and absorption if wanted.");
    }
    ShapeMaterial {
        mirror-tip: @tr("Make the part a mirror instead of a lens. The refractive index, the coating and the absorption are ignored then.");
    }
    LensShape { }
}

export component FresnelLensForm inherits VerticalLayout {
    alignment: start;
    PartCommon {
        description: @tr("A Fresnel lens: a lens whose curved surfaces are cut into zones from the axis to the rim, equal in width or in depth, each zone's arc starting again at the vertex plane, so a thin plate bends light as a thick lens would. The settings are the lens's, with the number of zones and their division; a flat surface stays flat.");
    }
    ShapeMaterial {
        mirror-tip: @tr("Make the part a mirror instead of a lens. The refractive index, the coating and the absorption are ignored then.");
    }
    LensShape { zones: true; }
}

// the outline's vertices, each with a remove button, and Add point.
component PointList inherits VerticalLayout {
    in property <string> hint;
    FormSection { text: @tr("Points"); }
    Text {
        text: root.hint;
        wrap: word-wrap;
        color: Theme.text-dim;
    }
    Rectangle { height: 4px; }
    HorizontalLayout {
        padding-bottom: 2px;
        spacing: 4px;
        Text { horizontal-stretch: 1; text: @tr("Label.PartPoint.X" => "X"); color: Theme.text; }
        Text { horizontal-stretch: 1; text: @tr("Label.PartPoint.Y" => "Y"); color: Theme.text; }
        Rectangle { width: 22px; }
    }
    for point[k] in Form.points: HorizontalLayout {
        padding-bottom: 4px;
        spacing: 4px;
        FormInt {
            value <=> point.x;
            tip: @tr("X relative to the part's centre in canvas pixels, before rotation.");
        }
        FormInt {
            value <=> point.y;
            tip: @tr("Y relative to the part's centre in canvas pixels, before rotation.");
        }
        Rectangle {
            width: 22px;
            IconButton {
                size: 18px;
                icon: @image-url("icons/next/tree-minus.svg");
                tip: @tr("Remove this point");
                clicked => { Form.remove-row(k); }
            }
        }
    }
    HorizontalLayout {
        padding-top: 2px;
        padding-bottom: 10px;
        alignment: start;
        Rectangle {
            width: add.preferred-width;
            height: add.preferred-height;
            add := Button {
                text: @tr("Add point");
                clicked => { Form.add-row(); }
            }
            Tooltip { text: @markdown("\{@tr("Append a point after the last one")}"); }
        }
    }
}

export component OutlineForm inherits VerticalLayout {
    alignment: start;
    PartCommon {
        description: @tr("A free outline of glass or mirror: a closed shape through the points you place and drag; fewer than three paint nothing.");
    }
    ShapeMaterial { }
    PointList { hint: @tr("Vertices of the outline relative to the centre, before rotation. Empty: the regular polygon above is used."); }
}

export component DiffuserForm inherits VerticalLayout {
    alignment: start;
    PartCommon {
        description: @tr("A diffuser: a plate of glass or mirror whose front face is rough, the back flat. The roughness is a spread of ripples about a centre wavelength, their phases random from the project's seed; it scatters what passes or reflects.");
    }
    ShapeMaterial { }
    FormSection { text: @tr("Shape"); }
    FormPanel {
        Row {
            FormLabel { text: @tr("Length"); tip: @tr("Extent along the axis in pixels: the plate's thickness at the mean of its rough face."); }
            FormInt {
                value <=> Form.diffuser.length;
                spec: { min: 1, max: 1000000000, increment: 10, decimals: 0 };
                tip: @tr("Extent along the axis in pixels: the plate's thickness at the mean of its rough face.");
            }
        }
        Row {
            FormLabel { text: @tr("Width"); tip: @tr("Extent across the axis in pixels: the width of the rough face."); }
            FormInt {
                value <=> Form.diffuser.width;
                spec: { min: 2, max: 1000000000, increment: 10, decimals: 0 };
                tip: @tr("Extent across the axis in pixels: the width of the rough face.");
            }
        }
    }
    FormSection { text: @tr("Roughness"); }
    FormPanel {
        Row {
            FormLabel {
                text: @tr("Centre wavelength");
                tip: @tr("The spatial wavelength in pixels at the middle of the roughness's spectrum: the ripple along the face that has the full amplitude. Two pixels at least.");
            }
            FormFloat {
                value <=> Form.diffuser.center-wavelength;
                spec: { min: 2, max: 10000, increment: 1, decimals: 2, drag-step: 0.1 };
                tip: @tr("The spatial wavelength in pixels at the middle of the roughness's spectrum: the ripple along the face that has the full amplitude. Two pixels at least.");
            }
        }
        Row {
            FormLabel {
                text: @tr("Amplitude");
                tip: @tr("The amplitude in pixels of the ripple at the centre wavelength. The other wavelengths of the spread get less, by their distance from the centre, and the face carries the sum of them all; 0 makes the face flat.");
            }
            FormFloat {
                value <=> Form.diffuser.amplitude;
                spec: { min: 0, max: 10000, increment: 1, decimals: 2, drag-step: 0.1 };
                tip: @tr("The amplitude in pixels of the ripple at the centre wavelength. The other wavelengths of the spread get less, by their distance from the centre, and the face carries the sum of them all; 0 makes the face flat.");
            }
        }
        Row {
            FormLabel {
                text: @tr("Sigma");
                tip: @tr("The spread of the roughness's wavelengths about the centre wavelength, in pixels: a wavelength gets the amplitude times the bell e^(\u{2212}(\u{3BB} \u{2212} centre)\u{B2} / 2\u{3C3}\u{B2}). 0 leaves the centre wavelength alone, a single regular ripple; the larger, the more wavelengths join in and the less regular the face.");
            }
            FormFloat {
                value <=> Form.diffuser.sigma;
                spec: { min: 0, max: 10000, increment: 1, decimals: 2, drag-step: 0.1 };
                tip: @tr("The spread of the roughness's wavelengths about the centre wavelength, in pixels: a wavelength gets the amplitude times the bell e^(\u{2212}(\u{3BB} \u{2212} centre)\u{B2} / 2\u{3C3}\u{B2}). 0 leaves the centre wavelength alone, a single regular ripple; the larger, the more wavelengths join in and the less regular the face.");
            }
        }
        Row {
            FormLabel { text: @tr("Profile height"); tip: @tr("The rough face from its highest point to its lowest: what the ripples add up to"); }
            FormReadout { text: "\{round(Form.diffuser.profile-height * 10) / 10} px"; tip: @tr("The rough face from its highest point to its lowest: what the ripples add up to"); }
        }
        Row {
            FormLabel {
                text: @tr("Ripples");
                tip: @tr("How many wavelengths make up the roughness: one at sigma 0, thirteen otherwise, those below two pixels left out");
            }
            FormReadout { text: Form.diffuser.ripples; tip: @tr("How many wavelengths make up the roughness: one at sigma 0, thirteen otherwise, those below two pixels left out"); }
        }
    }
}

export component ZonePlateForm inherits VerticalLayout {
    alignment: start;
    PartCommon {
        description: @tr("A zone plate: Fresnel zones cut for a design frequency and a focal length, every second zone an absorbing block, the central zone open or, inverted, a block. It focuses by diffraction; an optional mount stops light passing outside the diameter.");
    }
    FormSection { text: @tr("Design"); }
    FormPanel {
        Row {
            FormLabel {
                text: @tr("Target frequency");
                tip: @tr("The source frequency the plate is designed for, on the same scale as a source's frequency. The zones follow from the wavelength it gives, so the plate focuses this frequency at the focal length; other frequencies focus elsewhere.");
            }
            FormFloat {
                value <=> Form.zone-plate.design-frequency;
                spec: { min: 1, max: 255, increment: 1, decimals: 2, drag-step: 0.1 };
                tip: @tr("The source frequency the plate is designed for, on the same scale as a source's frequency. The zones follow from the wavelength it gives, so the plate focuses this frequency at the focal length; other frequencies focus elsewhere.");
            }
        }
        Row {
            FormLabel {
                text: @tr("Wavelength");
                tip: @tr("The wavelength the design frequency gives in a medium of index 1, with the simulation's source frequency scale");
            }
            FormReadout {
                text: Form.zone-plate.wavelength == 0 ? "\u{2013}" : "\u{2248} \{Form.zone-plate.wavelength.to-fixed(1)} px";
                tip: @tr("The wavelength the design frequency gives in a medium of index 1, with the simulation's source frequency scale");
            }
        }
        Row {
            FormLabel { text: @tr("Focal length"); tip: @tr("Distance in pixels from the plate to its focus, for a plane wave arriving along the axis."); }
            FormInt {
                value <=> Form.zone-plate.focal-length;
                spec: { min: 1, max: 1000000000, increment: 10, decimals: 0 };
                tip: @tr("Distance in pixels from the plate to its focus, for a plane wave arriving along the axis.");
            }
        }
        Row {
            FormCheck {
                checked <=> Form.zone-plate.inverse;
                colspan: 2;
                text: @tr("Inverse");
                tip: @tr("Exchange the zones: the central zone becomes a block, the first ring open, and so on. The focus stays where it is.");
            }
        }
    }
    FormSection { text: @tr("Shape"); }
    FormPanel {
        Row {
            FormLabel { text: @tr("Diameter"); tip: @tr("Extent across the axis in pixels; the zones fill it."); }
            FormInt {
                value <=> Form.zone-plate.diameter;
                spec: { min: 2, max: 1000000000, increment: 10, decimals: 0 };
                tip: @tr("Extent across the axis in pixels; the zones fill it.");
            }
        }
        Row {
            FormLabel {
                text: @tr("Thickness");
                tip: @tr("Extent along the axis in pixels: the depth of the blocks. It should leave room for the anti-reflection rise on both faces.");
            }
            FormInt {
                value <=> Form.zone-plate.thickness;
                spec: { min: 1, max: 1000000000, increment: 1, decimals: 0 };
                tip: @tr("Extent along the axis in pixels: the depth of the blocks. It should leave room for the anti-reflection rise on both faces.");
            }
        }
        Row {
            FormLabel {
                text: @tr("Anti-reflection");
                tip: @tr("Depth in pixels over which a block's absorption rises from nothing at its faces to its full strength, so the blocks reflect little; at most half the thickness takes effect.");
            }
            FormInt {
                value <=> Form.zone-plate.coating;
                spec: { min: 0, max: 400, increment: 1, decimals: 0 };
                tip: @tr("Depth in pixels over which a block's absorption rises from nothing at its faces to its full strength, so the blocks reflect little; at most half the thickness takes effect.");
            }
        }
        Row {
            FormCheck {
                checked <=> Form.zone-plate.mount;
                colspan: 2;
                text: @tr("Mount");
                tip: @tr("Surround the plate with an absorbing mount, so no light passes outside its diameter. Without it, that light meets the focused light on the axis and moves the focus further out, the more so the fewer zones the plate has.");
            }
        }
        Row {
            FormLabel { text: @tr("Mount width"); tip: @tr("Width in pixels of the absorbing mount on either side, beyond the diameter."); }
            FormInt {
                value <=> Form.zone-plate.mount-width;
                spec: { min: 1, max: 1000000000, increment: 10, decimals: 0 };
                enabled: Form.zone-plate.mount;
                tip: @tr("Width in pixels of the absorbing mount on either side, beyond the diameter.");
            }
        }
    }
    FormSection { text: @tr("Zones"); }
    FormPanel {
        Row {
            FormLabel {
                text: @tr("Number of zones");
                tip: @tr("The zones the plate gets within its diameter, and the width of the outermost whole one, which the grid must resolve (a few pixels at least)");
            }
            FormReadout { text: Form.zone-plate.zones == 0 ? "\u{2013}" : Form.zone-plate.zones; tip: @tr("The zones the plate gets within its diameter, and the width of the outermost whole one, which the grid must resolve (a few pixels at least)"); }
        }
        Row {
            FormLabel {
                text: @tr("Outermost zone");
                tip: @tr("The zones the plate gets within its diameter, and the width of the outermost whole one, which the grid must resolve (a few pixels at least)");
            }
            FormReadout {
                text: Form.zone-plate.zones == 0 ? "\u{2013}" : "\u{2248} \{Form.zone-plate.outer-zone.to-fixed(1)} px";
                tip: @tr("The zones the plate gets within its diameter, and the width of the outermost whole one, which the grid must resolve (a few pixels at least)");
            }
        }
    }
}

export component BraggReflectorForm inherits VerticalLayout {
    alignment: start;
    PartCommon {
        description: @tr("A Bragg reflector: pairs of layers of two indices stacked along the axis. It reflects strongly around the wavelength the layer thicknesses are tuned to, a quarter wave each, and passes others.");
    }
    FormSection { text: @tr("Layers"); }
    FormPanel {
        Row {
            FormLabel { text: @tr("Layer pairs"); tip: @tr("Number of layer pairs, 1 to 200."); }
            FormInt { value <=> Form.bragg.pairs; spec: { min: 1, max: 200, increment: 1, decimals: 0 }; tip: @tr("Number of layer pairs, 1 to 200."); }
        }
        Row {
            FormLabel {
                text: @tr("Thickness 1");
                tip: @tr("Thickness of the first layer of each pair in pixels. A quarter-wave layer is \u{3BB} / (4 n) pixels thick.");
            }
            FormInt {
                value <=> Form.bragg.thickness1;
                spec: { min: 1, max: 1000000000, increment: 1, decimals: 0 };
                tip: @tr("Thickness of the first layer of each pair in pixels. A quarter-wave layer is \u{3BB} / (4 n) pixels thick.");
            }
        }
        Row {
            FormLabel { text: @tr("Index 1"); tip: @tr("Refractive index of the first layer of each pair, 1.00 to 2.55 in steps of 0.01."); }
            FormFloat {
                value <=> Form.bragg.index1;
                spec: { min: 1, max: 2.55, increment: 0.01, decimals: -1 };
                tip: @tr("Refractive index of the first layer of each pair, 1.00 to 2.55 in steps of 0.01.");
            }
        }
        Row {
            FormLabel {
                text: @tr("Thickness 2");
                tip: @tr("Thickness of the second layer of each pair in pixels. A quarter-wave layer is \u{3BB} / (4 n) pixels thick.");
            }
            FormInt {
                value <=> Form.bragg.thickness2;
                spec: { min: 1, max: 1000000000, increment: 1, decimals: 0 };
                tip: @tr("Thickness of the second layer of each pair in pixels. A quarter-wave layer is \u{3BB} / (4 n) pixels thick.");
            }
        }
        Row {
            FormLabel { text: @tr("Index 2"); tip: @tr("Refractive index of the second layer of each pair, 1.00 to 2.55 in steps of 0.01."); }
            FormFloat {
                value <=> Form.bragg.index2;
                spec: { min: 1, max: 2.55, increment: 0.01, decimals: -1 };
                tip: @tr("Refractive index of the second layer of each pair, 1.00 to 2.55 in steps of 0.01.");
            }
        }
    }
    FormSection { text: @tr("Shape"); }
    FormPanel {
        Row {
            FormLabel { text: @tr("Width"); tip: @tr("Extent of the stack across the axis in pixels."); }
            FormInt { value <=> Form.bragg.width; spec: { min: 2, max: 1000000000, increment: 10, decimals: 0 }; tip: @tr("Extent of the stack across the axis in pixels."); }
        }
    }
}

export component GrinLensForm inherits VerticalLayout {
    alignment: start;
    PartCommon {
        description: @tr("A gradient-index lens: a rectangle whose index falls from the axis to the edge in a parabolic profile, so it focuses like a lens with flat faces.");
    }
    FormSection { text: @tr("Material"); }
    MaterialPanel {
        Row {
            FormLabel { text: @tr("Centre index"); tip: @tr("Refractive index on the axis, 1.00 to 2.55 in steps of 0.01."); }
            FormFloat {
                value <=> Form.grin.centre-index;
                spec: { min: 1, max: 2.55, increment: 0.01, decimals: -1 };
                tip: @tr("Refractive index on the axis, 1.00 to 2.55 in steps of 0.01.");
            }
        }
        Row {
            FormLabel {
                text: @tr("Edge index");
                tip: @tr("Refractive index at the edge, 1.00 to 2.55 in steps of 0.01. The profile between the axis and the edge is parabolic.");
            }
            FormFloat {
                value <=> Form.grin.edge-index;
                spec: { min: 1, max: 2.55, increment: 0.01, decimals: -1 };
                tip: @tr("Refractive index at the edge, 1.00 to 2.55 in steps of 0.01. The profile between the axis and the edge is parabolic.");
            }
        }
    }
    FormSection { text: @tr("Shape"); }
    FormPanel {
        Row {
            FormLabel { text: @tr("Length"); tip: @tr("Extent along the axis in pixels."); }
            FormInt { value <=> Form.grin.length; spec: { min: 1, max: 1000000000, increment: 10, decimals: 0 }; tip: @tr("Extent along the axis in pixels."); }
        }
        Row {
            FormLabel { text: @tr("Diameter"); tip: @tr("Extent across the axis in pixels."); }
            FormInt { value <=> Form.grin.diameter; spec: { min: 2, max: 1000000000, increment: 10, decimals: 0 }; tip: @tr("Extent across the axis in pixels."); }
        }
    }
}

export component SimpleGratingForm inherits VerticalLayout {
    alignment: start;
    PartCommon {
        description: @tr("A simple 2D grating: a lattice of round dots, so many columns along the axis by so many rows across, each direction with its own spacing, nothing between them. The dots are mirror, or glass with an index; a wave passing the lattice is diffracted into the orders the spacings set. One column makes a line grating.");
    }
    ShapeMaterial { coating-shown: false; }
    FormSection { text: @tr("Lattice"); }
    FormPanel {
        Row {
            FormLabel {
                text: @tr("Columns");
                tip: @tr("Number of dots along the axis. Odd counts keep the middle dot on the part's position; one column is a line grating across the axis.");
            }
            FormInt {
                value <=> Form.grating.columns;
                spec: { min: 1, max: 1000000000, increment: 1, decimals: 0 };
                tip: @tr("Number of dots along the axis. Odd counts keep the middle dot on the part's position; one column is a line grating across the axis.");
            }
        }
        Row {
            FormLabel { text: @tr("Rows"); tip: @tr("Number of dots across the axis. Odd counts keep the middle dot on the part's position."); }
            FormInt {
                value <=> Form.grating.rows;
                spec: { min: 1, max: 1000000000, increment: 1, decimals: 0 };
                tip: @tr("Number of dots across the axis. Odd counts keep the middle dot on the part's position.");
            }
        }
        Row {
            FormLabel {
                text: @tr("Column spacing");
                tip: @tr("Distance between neighbouring columns along the axis in pixels: the grating's period in that direction. The dots can be at most half the smaller spacing across.");
            }
            FormInt {
                value <=> Form.grating.column-spacing;
                spec: { min: 2, max: 1000000000, increment: 1, decimals: 0 };
                tip: @tr("Distance between neighbouring columns along the axis in pixels: the grating's period in that direction. The dots can be at most half the smaller spacing across.");
            }
        }
        Row {
            FormLabel {
                text: @tr("Row spacing");
                tip: @tr("Distance between neighbouring rows across the axis in pixels: the grating's period in that direction. The dots can be at most half the smaller spacing across.");
            }
            FormInt {
                value <=> Form.grating.row-spacing;
                spec: { min: 2, max: 1000000000, increment: 1, decimals: 0 };
                tip: @tr("Distance between neighbouring rows across the axis in pixels: the grating's period in that direction. The dots can be at most half the smaller spacing across.");
            }
        }
        Row {
            FormLabel {
                text: @tr("Dot diameter");
                tip: @tr("Diameter of each dot in pixels, at most half the smaller spacing. A dot of 2 pixels on a whole-pixel position covers a square of 2 \u{D7} 2 pixels; a mirror dot under 2 pixels covers no pixel centre and paints nothing.");
            }
            FormInt {
                value <=> Form.grating.diameter;
                spec: { min: 1, max: Form.grating.max-diameter, increment: 1, decimals: 0 };
                tip: @tr("Diameter of each dot in pixels, at most half the smaller spacing. A dot of 2 pixels on a whole-pixel position covers a square of 2 \u{D7} 2 pixels; a mirror dot under 2 pixels covers no pixel centre and paints nothing.");
            }
        }
    }
}

export component FacettedGratingForm inherits VerticalLayout {
    alignment: start;
    PartCommon {
        description: @tr("A facetted grating: a plate of glass or mirror whose front face carries a periodic relief, a sawtooth, a square wave or a sinusoid repeated every pitch, the back flat. A diffuser of one wavelength: the pitch and the wavelength set the angles the orders leave at.");
    }
    ShapeMaterial { back-only: true; }
    FormSection { text: @tr("Shape"); }
    FormPanel {
        Row {
            FormLabel { text: @tr("Length"); tip: @tr("Extent along the axis in pixels: the plate's thickness at the mean of its facetted face."); }
            FormInt {
                value <=> Form.facets.length;
                spec: { min: 1, max: 1000000000, increment: 10, decimals: 0 };
                tip: @tr("Extent along the axis in pixels: the plate's thickness at the mean of its facetted face.");
            }
        }
        Row {
            FormLabel { text: @tr("Width"); tip: @tr("Extent across the axis in pixels: the width of the facetted face."); }
            FormInt {
                value <=> Form.facets.width;
                spec: { min: 2, max: 1000000000, increment: 10, decimals: 0 };
                tip: @tr("Extent across the axis in pixels: the width of the facetted face.");
            }
        }
    }
    FormSection { text: @tr("Facets"); }
    FormPanel {
        Row {
            FormLabel {
                text: @tr("Pattern");
                tip: @tr("The facets' shape over each pitch: a sawtooth, a ramp then a step; a square wave, a crest and a trough of half a pitch each; or a sinusoid.");
            }
            FacetPatternChoice {
                value <=> Form.facets.pattern;
                tip: @tr("The facets' shape over each pitch: a sawtooth, a ramp then a step; a square wave, a crest and a trough of half a pitch each; or a sinusoid.");
            }
        }
        Row {
            FormLabel {
                text: @tr("Pitch");
                tip: @tr("The period of the facets across the face in pixels: the grating's pitch, which with the wavelength sets the diffraction angles. Two pixels at least.");
            }
            FormFloat {
                value <=> Form.facets.pitch;
                spec: { min: 2, max: 10000, increment: 1, decimals: 2, drag-step: 0.1 };
                tip: @tr("The period of the facets across the face in pixels: the grating's pitch, which with the wavelength sets the diffraction angles. Two pixels at least.");
            }
        }
        Row {
            FormLabel {
                text: @tr("Amplitude");
                tip: @tr("The relief's height either side of the mean face in pixels: the facets run from this far out to this far in, twice it from crest to trough. 0 makes the face flat.");
            }
            FormFloat {
                value <=> Form.facets.amplitude;
                spec: { min: 0, max: 10000, increment: 1, decimals: 2, drag-step: 0.1 };
                tip: @tr("The relief's height either side of the mean face in pixels: the facets run from this far out to this far in, twice it from crest to trough. 0 makes the face flat.");
            }
        }
    }
}

// A pixel read-out as Next's Pixels converter writes it; 0 is none.
component PixelReadout inherits FormReadout {
    in property <float> pixels;
    text: root.pixels == 0 ? "\u{2013}" : "\{round(root.pixels * 10) / 10} px";
}

// The meta lens, prism and axicon: one plate and pattern, the design's section by the form's kind.
export component MetaSurfaceForm inherits VerticalLayout {
    property <bool> lens: Form.kind == FormKind.meta-lens;
    property <bool> prism: Form.kind == FormKind.meta-prism;
    property <bool> axicon: Form.kind == FormKind.meta-axicon;
    alignment: start;
    PartCommon {
        description: root.lens ? @tr("A meta lens: a carrier plate with a sub-wavelength pattern on its front, a ridge of its own index in every cell, whose fill is computed from the target frequency and the focal length so the cells delay the wave as a lens would, zone by zone. Converging or diverging; the pattern's tops and the plate's back can carry an anti-reflection coating.")
            : root.prism ? @tr("A meta prism: a carrier plate with a sub-wavelength pattern on its front whose cells delay the wave in a line across the face, so a wave arriving along the axis leaves turned by a set angle, as a blazed grating's first order. Cut for a target frequency; the pattern's tops and the plate's back can carry an anti-reflection coating.")
            : @tr("A meta axicon: a carrier plate with a sub-wavelength pattern on its front whose cells delay the wave in proportion to the distance from the axis, so the two halves of a wave arriving along the axis are turned toward it by a set angle and cross along a line behind the surface rather than at a point. Cut for a target frequency; the pattern's tops and the plate's back can carry an anti-reflection coating.");
    }
    ShapeMaterial { sides-hidden: true; }
    FormSection { text: @tr("Shape"); }
    FormPanel {
        Row {
            FormLabel { text: @tr("Length"); tip: @tr("Thickness of the carrier plate along the axis in pixels; the pattern stands on its front, outside it."); }
            FormInt {
                value <=> Form.meta.length;
                spec: { min: 1, max: 1000000000, increment: 10, decimals: 0 };
                tip: @tr("Thickness of the carrier plate along the axis in pixels; the pattern stands on its front, outside it.");
            }
        }
        Row {
            FormLabel { text: @tr("Width"); tip: @tr("Width of the plate and its pattern across the axis in pixels."); }
            FormInt {
                value <=> Form.meta.width;
                spec: { min: 2, max: 1000000000, increment: 10, decimals: 0 };
                tip: @tr("Width of the plate and its pattern across the axis in pixels.");
            }
        }
    }
    FormSection { text: root.lens ? @tr("Lens") : root.prism ? @tr("Prism") : @tr("Axicon"); }
    FormPanel {
        Row {
            FormLabel {
                text: @tr("Target frequency");
                tip: @tr("The source frequency the surface is designed for, on the same scale as a source's frequency. The cells' fill follows from the wavelength it gives, so the surface does its work at this frequency: a lens focuses it at the focal length, a prism turns it by its angle, an axicon by its cone angle. Another frequency sees another surface.");
            }
            FormFloat {
                value <=> Form.meta.design-frequency;
                spec: { min: 1, max: 255, increment: 1, decimals: 2, drag-step: 0.1 };
                tip: @tr("The source frequency the surface is designed for, on the same scale as a source's frequency. The cells' fill follows from the wavelength it gives, so the surface does its work at this frequency: a lens focuses it at the focal length, a prism turns it by its angle, an axicon by its cone angle. Another frequency sees another surface.");
            }
        }
        Row {
            FormLabel {
                text: @tr("Wavelength");
                tip: @tr("The wavelength the design frequency gives in a medium of index 1, with the simulation's source frequency scale");
            }
            PixelReadout {
                pixels: Form.meta.wavelength;
                tip: @tr("The wavelength the design frequency gives in a medium of index 1, with the simulation's source frequency scale");
            }
        }
        if root.lens: Row {
            FormLabel {
                text: @tr("Focal length");
                tip: @tr("Distance in pixels from the lens to its focus, for a plane wave arriving along the axis; a diverging lens spreads the wave as if from a focus that far behind it.");
            }
            FormInt {
                value <=> Form.meta.focal-length;
                spec: { min: 1, max: 1000000000, increment: 10, decimals: 0 };
                tip: @tr("Distance in pixels from the lens to its focus, for a plane wave arriving along the axis; a diverging lens spreads the wave as if from a focus that far behind it.");
            }
        }
        if root.lens: Row {
            FormLabel {
                text: @tr("Lens type");
                tip: @tr("Converging, the fill greatest at the centre and falling outward within each zone, as a convex lens's glass thins; or diverging, the fill growing outward.");
            }
            MetaLensTypeChoice {
                value <=> Form.meta.lens-type;
                tip: @tr("Converging, the fill greatest at the centre and falling outward within each zone, as a convex lens's glass thins; or diverging, the fill growing outward.");
            }
        }
        if root.prism: Row {
            FormLabel {
                text: @tr("Deflection");
                tip: @tr("The angle in degrees by which a wave arriving along the axis is turned, counter-clockwise on the screen for a positive angle; 0 turns nothing. The steeper, the narrower the zones, which must stay a few cells wide.");
            }
            FormFloat {
                value <=> Form.meta.deflection;
                spec: { min: -89, max: 89, increment: 1, decimals: 2, drag-step: 0.5 };
                tip: @tr("The angle in degrees by which a wave arriving along the axis is turned, counter-clockwise on the screen for a positive angle; 0 turns nothing. The steeper, the narrower the zones, which must stay a few cells wide.");
            }
        }
        if root.axicon: Row {
            FormLabel {
                text: @tr("Cone angle");
                tip: @tr("The angle in degrees by which each half of a wave arriving along the axis is turned toward it. The steeper, the shorter the line of focus behind the surface and the narrower the zones, which must stay a few cells wide.");
            }
            FormFloat {
                value <=> Form.meta.cone-angle;
                spec: { min: 0.1, max: 89, increment: 1, decimals: 2, drag-step: 0.5 };
                tip: @tr("The angle in degrees by which each half of a wave arriving along the axis is turned toward it. The steeper, the shorter the line of focus behind the surface and the narrower the zones, which must stay a few cells wide.");
            }
        }
        if root.axicon: Row {
            FormLabel {
                text: @tr("Line of focus");
                tip: @tr("How far behind the surface the line of focus reaches: half the width over the tangent of the cone angle, where the rim's rays cross the axis");
            }
            PixelReadout {
                pixels: Form.meta.line-length;
                tip: @tr("How far behind the surface the line of focus reaches: half the width over the tangent of the cone angle, where the rim's rays cross the axis");
            }
        }
        if !root.lens: Row {
            FormLabel {
                text: @tr("Zone width");
                tip: @tr("The width of a zone across the face, a full turn of phase: the wavelength over the sine of the deflection");
            }
            PixelReadout {
                pixels: Form.meta.zone-width;
                tip: @tr("The width of a zone across the face, a full turn of phase: the wavelength over the sine of the deflection");
            }
        }
        Row {
            FormLabel {
                text: @tr("Zones");
                tip: @tr("The zones from the centre to the rim, each a full turn of phase, the last one cut by the rim");
            }
            FormReadout {
                text: Form.meta.zones;
                tip: @tr("The zones from the centre to the rim, each a full turn of phase, the last one cut by the rim");
            }
        }
    }
    FormSection { text: @tr("Pattern"); }
    FormPanel {
        Row {
            FormLabel {
                text: @tr("Pattern index");
                tip: @tr("Refractive index of the ridges, 1.00 to 2.55 in steps of 0.01, usually above the plate's. The higher, the lower the pattern can be.");
            }
            FormFloat {
                value <=> Form.meta.pattern-index;
                spec: { min: 1, max: 2.55, increment: 0.01, decimals: -1 };
                tip: @tr("Refractive index of the ridges, 1.00 to 2.55 in steps of 0.01, usually above the plate's. The higher, the lower the pattern can be.");
            }
        }
        Row {
            FormLabel {
                text: @tr("Pitch");
                tip: @tr("The width of a cell of the pattern across the face in pixels, one ridge per cell. Well below the wavelength, so the wave sees each cell as a mean index rather than diffracting at it.");
            }
            FormFloat {
                value <=> Form.meta.pitch;
                spec: { min: 1, max: 10000, increment: 1, decimals: 2, drag-step: 0.1 };
                tip: @tr("The width of a cell of the pattern across the face in pixels, one ridge per cell. Well below the wavelength, so the wave sees each cell as a mean index rather than diffracting at it.");
            }
        }
        Row {
            FormLabel {
                text: @tr("Height");
                tip: @tr("The height of the ridges in front of the plate in pixels. A full turn of phase, which the zones need, takes a height of the wavelength over the pattern index less one; a lower pattern cannot delay enough and its fill saturates.");
            }
            FormFloat {
                value <=> Form.meta.height;
                spec: { min: 1, max: 10000, increment: 1, decimals: 2, drag-step: 0.1 };
                tip: @tr("The height of the ridges in front of the plate in pixels. A full turn of phase, which the zones need, takes a height of the wavelength over the pattern index less one; a lower pattern cannot delay enough and its fill saturates.");
            }
        }
        Row {
            FormLabel {
                text: @tr("Full-turn height");
                tip: @tr("The pattern height at which a filled cell delays by a whole turn, the wavelength over the pattern index less one; a lower pattern saturates");
            }
            PixelReadout {
                pixels: Form.meta.full-turn-height;
                tip: @tr("The pattern height at which a filled cell delays by a whole turn, the wavelength over the pattern index less one; a lower pattern saturates");
            }
        }
    }
}

// An output's light by the gate's kind: what it gives for the inputs 00, 10, 01, 11.
component GateOutputCheck inherits FormCheck {
    // the upper output, else the lower
    in property <bool> upper;
    property <GateKind> kind: Form.gate.kind;
    property <bool> xor: root.upper ? root.kind == GateKind.xor : root.kind == GateKind.and;
    property <bool> and: root.upper ? root.kind == GateKind.and : root.kind == GateKind.xor;
    text: root.xor ? @tr("XOR: dark with both on") : root.and ? @tr("AND: 4 \u{D7} as bright with both on")
        : root.upper ? @tr("OR: as bright for one as for two") : @tr("Remainder: 3 \u{D7} with both on");
}

// A logic gate's layout value; a dash without a design.
component GateReadout inherits FormReadout {
    tip: GateTips.layout;
}

// The tips the Layout and Ports panels give each row, label and value.
global GateTips {
    out property <string> layout: @tr("Computed from the design wavelength and the indices with the simulator's own wave equation (the 4th-order Laplacian)");
    out property <string> ports: @tr("Canvas pixels. Feed the inputs with equal waves (the same frequency, amplitude and phase); a missing wave is a logical 0. The outputs line up with the inputs of gates set a port spacing above and below, one length on");
}

// A port's place; a dash without a design.
component PortReadout inherits FormReadout {
    in property <PointData> port;
    text: Form.gate.designed ? "(\{root.port.x}, \{root.port.y})" : "\u{2013}";
    tip: GateTips.ports;
}

export component LogicGateForm inherits VerticalLayout {
    property <bool> designed: Form.gate.designed;
    alignment: start;
    PartCommon {
        description: Form.gate.kind == GateKind.xor ? @tr("An optical XOR gate: two input waveguides, a phase section putting the lower input a quarter period ahead, and a coupler whose upper output carries their difference. It lights when one input is lit, not both, for coherent inputs at the design frequency.")
            : Form.gate.kind == GateKind.and ? @tr("An optical AND gate: the same coupler with the lower input a quarter period behind, so the upper output carries the sum. It is brightest with both inputs lit, about four times a single one; a passive linear gate has no truer AND.")
            : @tr("An optical OR gate: the same coupler with the lower input a twelfth of a period ahead, so the upper output carries half the power of either input and of both. It lights with one input or both.");
    }
    FormSection { text: @tr("Design"); }
    FormPanel {
        Row {
            FormLabel {
                text: @tr("Design frequency");
                tip: @tr("The source frequency the gate is designed for, on the same scale as a source's frequency: the frequency of the sources that drive it. The wavelength, and from it the core width, the coupler and the phase section, follow from it, so the gate works at this frequency only.");
            }
            FormFloat {
                value <=> Form.gate.design-frequency;
                spec: { min: 1, max: 255, increment: 1, decimals: 2, drag-step: 0.1 };
                tip: @tr("The source frequency the gate is designed for, on the same scale as a source's frequency: the frequency of the sources that drive it. The wavelength, and from it the core width, the coupler and the phase section, follow from it, so the gate works at this frequency only.");
            }
        }
        Row {
            FormLabel {
                text: @tr("Wavelength");
                tip: @tr("The wavelength the design frequency gives in a medium of index 1, with the simulation's source frequency scale");
            }
            FormReadout {
                text: Form.gate.wavelength == 0 ? "\u{2013}" : "\u{2248} \{Form.gate.wavelength.to-fixed(1)} px";
                tip: @tr("The wavelength the design frequency gives in a medium of index 1, with the simulation's source frequency scale");
            }
        }
    }
    FormSection { text: @tr("Material"); }
    FormPanel {
        Row {
            FormLabel {
                text: @tr("Core index");
                tip: @tr("Refractive index of the waveguide cores, 1.00 to 2.55 in steps of 0.01. It must be above the cladding's; the larger the difference, the narrower the cores and the tighter the bends.");
            }
            FormFloat {
                value <=> Form.gate.core-index;
                spec: { min: 1, max: 2.55, increment: 0.01, decimals: -1 };
                tip: @tr("Refractive index of the waveguide cores, 1.00 to 2.55 in steps of 0.01. It must be above the cladding's; the larger the difference, the narrower the cores and the tighter the bends.");
            }
        }
        Row {
            FormLabel { text: @tr("Cladding index"); tip: @tr("Refractive index of the cladding around the cores, 1.00 to 2.55 in steps of 0.01."); }
            FormFloat {
                value <=> Form.gate.cladding-index;
                spec: { min: 1, max: 2.55, increment: 0.01, decimals: -1 };
                tip: @tr("Refractive index of the cladding around the cores, 1.00 to 2.55 in steps of 0.01.");
            }
        }
        Row {
            FormLabel {
                text: @tr("AR coating");
                tip: @tr("Thickness in pixels of the anti-reflection band at the ends ticked below, with the index \u{221A}n of the core and of the cladding; 0 for none. A quarter-wave band, the least reflecting, is \u{3BB} / (4 \u{221A}n) pixels thick; the form shows it for the core.");
            }
            FormFloat {
                value <=> Form.gate.coating;
                spec: { min: 0, max: 50, increment: 1, decimals: 0 };
                tip: @tr("Thickness in pixels of the anti-reflection band at the ends ticked below, with the index \u{221A}n of the core and of the cladding; 0 for none. A quarter-wave band, the least reflecting, is \u{3BB} / (4 \u{221A}n) pixels thick; the form shows it for the core.");
            }
        }
        Row {
            FormCheck {
                checked <=> Form.gate.input-coated;
                colspan: 2;
                text: @tr("AR on input side");
                tip: @tr("Put the anti-reflection band on the input end. Switch it off where the gate takes its light from a gate before it, so the wave passes through the junction.");
            }
        }
        Row {
            FormCheck {
                checked <=> Form.gate.output-coated;
                colspan: 2;
                text: @tr("AR on output side");
                tip: @tr("Put the anti-reflection band on the output end. Switch it off where the gate hands its light to a gate after it, so the wave passes through the junction.");
            }
        }
        Row {
            FormLabel { text: @tr("Quarter-wave coating"); tip: @tr("The thickness of the least reflecting coating on the core, \u{3BB} / (4 \u{221A}n)"); }
            FormReadout {
                text: root.designed ? "\u{2248} \{Form.gate.quarter-wave.to-fixed(1)} px" : "\u{2013}";
                tip: @tr("The thickness of the least reflecting coating on the core, \u{3BB} / (4 \u{221A}n)");
            }
        }
    }
    FormSection { text: @tr("Shape"); }
    FormPanel {
        Row {
            FormLabel {
                text: @tr("Port spacing");
                tip: @tr("Distance between the two inputs, and between the two outputs, in pixels. A value below what the design needs to keep the arms apart is raised to it, and the box shows the spacing used.");
            }
            FormInt {
                value <=> Form.gate.port-spacing;
                spec: { min: 2, max: 2000, increment: 2, decimals: 0 };
                tip: @tr("Distance between the two inputs, and between the two outputs, in pixels. A value below what the design needs to keep the arms apart is raised to it, and the box shows the spacing used.");
            }
        }
    }
    FormSection { text: @tr("Outputs active"); }
    FormPanel {
        Row {
            FormLabel {
                text: @tr("Upper output");
                tip: @tr("Let the upper output's light leave the gate. Switched off, an absorber with a soft rise takes it in the last stretch of the arm.");
            }
            GateOutputCheck {
                upper: true;
                checked <=> Form.gate.upper-output-active;
                tip: @tr("Let the upper output's light leave the gate. Switched off, an absorber with a soft rise takes it in the last stretch of the arm.");
            }
        }
        Row {
            FormLabel {
                text: @tr("Lower output");
                tip: @tr("Let the lower output's light leave the gate. Switched off, an absorber with a soft rise takes it in the last stretch of the arm.");
            }
            GateOutputCheck {
                upper: false;
                checked <=> Form.gate.lower-output-active;
                tip: @tr("Let the lower output's light leave the gate. Switched off, an absorber with a soft rise takes it in the last stretch of the arm.");
            }
        }
    }
    FormSection { text: @tr("Layout"); }
    FormPanel {
        Row {
            FormLabel { text: @tr("Core width"); tip: GateTips.layout; }
            GateReadout { text: root.designed ? "\{Form.gate.core-width} px" : "\u{2013}"; }
        }
        Row {
            FormLabel { text: @tr("Coupler gap"); tip: GateTips.layout; }
            GateReadout { text: root.designed ? "\{Form.gate.gap} px" : "\u{2013}"; }
        }
        Row {
            FormLabel { text: @tr("Coupler length"); tip: GateTips.layout; }
            GateReadout { text: root.designed ? "\{Form.gate.coupler-length} px" : "\u{2013}"; }
        }
        Row {
            FormLabel { text: @tr("Total length"); tip: GateTips.layout; }
            GateReadout { text: root.designed ? "\{Form.gate.length} px" : "\u{2013}"; }
        }
    }
    FormSection { text: @tr("Ports"); }
    FormPanel {
        Row {
            FormLabel { text: @tr("Input A"); tip: GateTips.ports; }
            PortReadout { port: Form.gate.input-a; }
        }
        Row {
            FormLabel { text: @tr("Input B"); tip: GateTips.ports; }
            PortReadout { port: Form.gate.input-b; }
        }
        Row {
            FormLabel { text: @tr("Upper output"); tip: GateTips.ports; }
            PortReadout { port: Form.gate.upper-out; }
        }
        Row {
            FormLabel { text: @tr("Lower output"); tip: GateTips.ports; }
            PortReadout { port: Form.gate.lower-out; }
        }
    }
}

// An interference filter's layers, the outermost first: a row each with a grip to drag it by, its number, thickness
// and index, up, down and remove. A drag moves the row on release, one undo step.
component LayerList inherits VerticalLayout {
    // the row a grip drags and where it would land; -1 while none is dragged
    property <int> dragged: -1;
    property <int> target: -1;
    // the row an arrow moved a layer to, which takes the focus on that arrow (the other at a list end)
    property <int> refocus: -1;
    property <bool> refocus-up;
    function move(k: int, to: int) {
        root.refocus = to;
        root.refocus-up = to < k;
        Form.move-row(k, to);
    }
    FormSection { text: @tr("Layers"); }
    Text {
        text: @tr("The layers lie on the plate's front, the first in the list outermost. Drag a row by its grip or move it with the arrows.");
        wrap: word-wrap;
        color: Theme.text-dim;
    }
    Rectangle { height: 4px; }
    HorizontalLayout {
        padding-bottom: 2px;
        spacing: 4px;
        Rectangle { width: 38px; }
        Text { horizontal-stretch: 1; text: @tr("Thickness"); color: Theme.text; }
        Text { horizontal-stretch: 1; text: @tr("Index"); color: Theme.text; }
        Rectangle { width: 66px; }
    }
    for layer[k] in Form.layers: Rectangle {
        property <bool> refocused: root.refocus == k;
        changed refocused => {
            if (self.refocused) {
                root.refocus = -1;
                if (root.refocus-up == (k > 0) || k == Form.layers.length - 1) {
                    up.take-focus();
                } else {
                    down.take-focus();
                }
            }
        }
        background: root.dragged == k ? Theme.button-hover : transparent;
        HorizontalLayout {
            padding-bottom: 4px;
            spacing: 4px;
            Rectangle {
                width: 14px;
                Icon {
                    width: 10px;
                    height: 9px;
                    source: @image-url("icons/next/grip.svg");
                    ink: Theme.text-dim;
                }
                grip := TouchArea {
                    mouse-cursor: MouseCursor.ns-resize;
                    // rows are the height of this one
                    pointer-event(e) => {
                        if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left) {
                            root.dragged = k;
                            root.target = k;
                        } else if (e.kind == PointerEventKind.up && e.button == PointerEventButton.left && root.dragged == k) {
                            if (root.target != k) {
                                Form.move-row(k, root.target);
                            }
                            root.dragged = -1;
                            root.target = -1;
                        } else if (e.kind == PointerEventKind.cancel) {
                            root.dragged = -1;
                            root.target = -1;
                        }
                    }
                    moved => {
                        if (root.dragged == k) {
                            root.target = clamp(k + round((self.mouse-y - self.pressed-y) / (parent.height + 4px)), 0, Form.layers.length - 1);
                        }
                    }
                }
                Tooltip { text: @markdown("\{@tr("Drag to move this layer through the list")}"); }
            }
            Text {
                width: 20px;
                text: "\{k + 1}";
                vertical-alignment: center;
                color: Theme.text-dim;
            }
            FormFloat {
                value <=> layer.thickness;
                spec: { min: 0, max: 1000, increment: 1, decimals: 2, drag-step: 0.1 };
                tip: @tr("The layer's thickness in pixels, to two decimals: a quarter wave is the wavelength divided by four times the index. A layer under half a pixel hardly shows on the grid; 0 leaves it out.");
            }
            FormFloat {
                value <=> layer.refractive-index;
                spec: { min: 1, max: 2.55, increment: 0.01, decimals: -1 };
                tip: @tr("The layer's refractive index, 1 to 2.55.");
            }
            HorizontalLayout {
                width: 66px;
                alignment: start;
                up := IconButton {
                    size: 22px;
                    icon: @image-url("icons/next/chevron-up.svg");
                    enabled: k > 0;
                    tip: @tr("Move this layer up, outwards");
                    clicked => { root.move(k, k - 1); }
                }
                down := IconButton {
                    size: 22px;
                    icon: @image-url("icons/next/chevron-down.svg");
                    enabled: k < Form.layers.length - 1;
                    tip: @tr("Move this layer down, towards the plate");
                    clicked => { root.move(k, k + 1); }
                }
                IconButton {
                    size: 22px;
                    icon: @image-url("icons/next/tree-minus.svg");
                    tip: @tr("Remove this layer");
                    clicked => { Form.remove-row(k); }
                }
            }
        }
        // where the dragged row lands: above this row going up, below it going down
        if root.dragged >= 0 && root.target == k && root.target != root.dragged: Rectangle {
            y: root.target < root.dragged ? -3px : parent.height - 3px;
            height: 2px;
            background: Theme.accent;
        }
    }
    HorizontalLayout {
        padding-top: 2px;
        padding-bottom: 10px;
        spacing: 6px;
        alignment: start;
        Rectangle {
            width: add.preferred-width;
            height: add.preferred-height;
            add := Button {
                text: @tr("Add layer");
                clicked => { Form.add-row(); }
            }
            Tooltip { text: @markdown("\{@tr("Append a copy of the last layer")}"); }
        }
        Rectangle {
            width: clear.preferred-width;
            height: clear.preferred-height;
            clear := Button {
                text: @tr("Remove all");
                enabled: Form.layers.length > 0;
                clicked => { Form.clear-rows(); }
            }
            Tooltip { text: @markdown("\{@tr("Remove every layer, to build another stack from nothing; Undo brings them back")}"); }
        }
    }
}

export component InterferenceFilterForm inherits VerticalLayout {
    alignment: start;
    PartCommon {
        description: @tr("An interference filter: a plate of glass or mirror with a stack of thin layers on its front, each with its own thickness and index. Waves reflected at the layers' boundaries interfere, so the stack reflects some wavelengths and passes others; a new filter is a quarter-wave stack for a wavelength of 16 pixels.");
    }
    ShapeMaterial { back-only: true; }
    FormSection { text: @tr("Shape"); }
    FormPanel {
        Row {
            FormLabel { text: @tr("Length"); tip: @tr("Extent of the plate along the axis in pixels, without the layers, which lie on its front."); }
            FormInt {
                value <=> Form.filter.length;
                spec: { min: 1, max: 1000000000, increment: 10, decimals: 0 };
                tip: @tr("Extent of the plate along the axis in pixels, without the layers, which lie on its front.");
            }
        }
        Row {
            FormLabel { text: @tr("Width"); tip: @tr("Extent across the axis in pixels, of the plate and the layers alike."); }
            FormInt {
                value <=> Form.filter.width;
                spec: { min: 1, max: 1000000000, increment: 10, decimals: 0 };
                tip: @tr("Extent across the axis in pixels, of the plate and the layers alike.");
            }
        }
        Row {
            FormLabel { text: @tr("Stack thickness"); tip: @tr("The layers' thicknesses added up: how far the stack stands out of the plate's front"); }
            FormReadout {
                text: "\{Form.filter.stack-thickness} px";
                tip: @tr("The layers' thicknesses added up: how far the stack stands out of the plate's front");
            }
        }
    }
    LayerList { }
}

// A fibre's path nodes: a block each of the node, its in- and out-handle, with Smooth and remove; Add node below.
component NodeList inherits VerticalLayout {
    FormSection { text: @tr("Nodes"); }
    Text {
        text: @tr("Nodes of the path relative to the centre, before rotation, each with the in- and out-handle of the segments meeting there, as offsets from the node. Fewer than two nodes paint nothing.");
        wrap: word-wrap;
        color: Theme.text-dim;
    }
    Rectangle { height: 4px; }
    HorizontalLayout {
        padding-bottom: 2px;
        spacing: 4px;
        Rectangle { width: 36px; }
        Text { horizontal-stretch: 1; text: @tr("Label.FiberNode.X" => "X"); color: Theme.text; }
        Text { horizontal-stretch: 1; text: @tr("Label.FiberNode.Y" => "Y"); color: Theme.text; }
        Rectangle { width: smooth-width.preferred-width; }
    }
    for node[k] in Form.nodes: GridLayout {
        spacing-horizontal: 4px;
        spacing-vertical: 2px;
        padding-bottom: 6px;
        Row {
            Text { width: 36px; overflow: elide; text: @tr("Node"); vertical-alignment: center; color: Theme.text; }
            FormInt { value <=> node.x; tip: @tr("X relative to the part's centre in canvas pixels, before rotation."); }
            FormInt { value <=> node.y; tip: @tr("Y relative to the part's centre in canvas pixels, before rotation."); }
            HorizontalLayout {
                horizontal-stretch: 0;
                spacing: 4px;
                FormCheck {
                    checked <=> node.smooth;
                    text: @tr("Smooth");
                    tip: @tr("Keep the two handles opposite each other through the node, so the path runs smoothly through it. Switching it on lines them up at once; afterwards moving or typing one handle turns the other with it, keeping its length. Off, the node may be a corner.");
                }
                Rectangle {
                    width: 22px;
                    IconButton {
                        size: 18px;
                        icon: @image-url("icons/next/tree-minus.svg");
                        tip: @tr("Remove this node");
                        clicked => { Form.remove-row(k); }
                    }
                }
            }
        }
        Row {
            Text { width: 36px; overflow: elide; text: @tr("In"); vertical-alignment: center; color: Theme.text; }
            FormInt {
                value <=> node.in-x;
                tip: @tr("X of the in-handle relative to the node, in canvas pixels before rotation. It shapes the segment arriving from the previous node; zero makes that segment straight at this end.");
            }
            FormInt { value <=> node.in-y; tip: @tr("Y of the in-handle relative to the node, in canvas pixels before rotation."); }
        }
        Row {
            Text { width: 36px; overflow: elide; text: @tr("Out"); vertical-alignment: center; color: Theme.text; }
            FormInt {
                value <=> node.out-x;
                tip: @tr("X of the out-handle relative to the node, in canvas pixels before rotation. It shapes the segment leaving to the next node; zero makes that segment straight at this end.");
            }
            FormInt { value <=> node.out-y; tip: @tr("Y of the out-handle relative to the node, in canvas pixels before rotation."); }
        }
    }
    // the Smooth column's width, for the heading
    smooth-width := HorizontalLayout {
        visible: false;
        height: 0;
        spacing: 4px;
        Check { text: @tr("Smooth"); }
        Rectangle { width: 22px; }
    }
    HorizontalLayout {
        padding-top: 2px;
        padding-bottom: 10px;
        alignment: start;
        Rectangle {
            width: add.preferred-width;
            height: add.preferred-height;
            add := Button {
                text: @tr("Add node");
                clicked => { Form.add-row(); }
            }
            Tooltip { text: @markdown("\{@tr("Append a node beyond the last one, continuing the path")}"); }
        }
    }
}

export component FiberForm inherits VerticalLayout {
    alignment: start;
    PartCommon {
        description: @tr("A fibre: a core of higher index inside a cladding, along a smooth path of B\u{E9}zier segments through its nodes, with flat or round ends. A wave coupled into the core is guided along the path; the cladding can absorb stray light at its rim.");
    }
    FormSection { text: @tr("Core"); }
    FormPanel {
        Row {
            FormLabel { text: @tr("Core index"); tip: @tr("Refractive index of the core, 1.00 to 2.55 in steps of 0.01."); }
            FormFloat {
                value <=> Form.fiber.core-index;
                spec: { min: 1, max: 2.55, increment: 0.01, decimals: -1 };
                tip: @tr("Refractive index of the core, 1.00 to 2.55 in steps of 0.01.");
            }
        }
        Row {
            FormLabel { text: @tr("Core diameter"); tip: @tr("Diameter of the core in pixels."); }
            FormInt {
                value <=> Form.fiber.core-diameter;
                spec: { min: 2, max: 2147483647, increment: 1, decimals: -1 };
                tip: @tr("Diameter of the core in pixels.");
            }
        }
    }
    FormSection { text: @tr("Cladding"); }
    MaterialPanel {
        coating-tip: @tr("Thickness in pixels of the anti-reflection band just inside the outer boundary and the end faces; 0 for none. A quarter-wave layer is \u{3BB} / (4 \u{221A}n) pixels thick, \u{3BB} being the wavelength the source form shows; a graded band is the better the thicker, from a wavelength on.");
        Row {
            FormLabel {
                text: @tr("Cladding index");
                tip: @tr("Refractive index of the cladding, 1.00 to 2.55 in steps of 0.01. Below the core's index, the fibre guides.");
            }
            FormFloat {
                value <=> Form.fiber.cladding-index;
                spec: { min: 1, max: 2.55, increment: 0.01, decimals: -1 };
                tip: @tr("Refractive index of the cladding, 1.00 to 2.55 in steps of 0.01. Below the core's index, the fibre guides.");
            }
        }
        Row {
            FormLabel { text: @tr("Cladding thickness"); tip: @tr("Thickness of the cladding around the core in pixels; 0 for a bare core."); }
            FormInt {
                value <=> Form.fiber.cladding-thickness;
                spec: { min: 0, max: 2147483647, increment: 1, decimals: -1 };
                tip: @tr("Thickness of the cladding around the core in pixels; 0 for a bare core.");
            }
        }
        Row {
            FormLabel {
                text: @tr("Cladding absorption");
                tip: @tr("Peak absorption of the cladding's absorbing band, 0 (not at all) to 255, as the scene image's blue channel: a hump in the outer part of the cladding, rising over the band width from nothing, peaking, and falling to nothing at the outer edge, so the guided wave's tail stays untouched and stray light is absorbed from either side. Nothing on a bare core.");
            }
            FormInt {
                value <=> Form.fiber.absorption;
                spec: { min: 0, max: 255, increment: 5, decimals: -1 };
                tip: @tr("Peak absorption of the cladding's absorbing band, 0 (not at all) to 255, as the scene image's blue channel: a hump in the outer part of the cladding, rising over the band width from nothing, peaking, and falling to nothing at the outer edge, so the guided wave's tail stays untouched and stray light is absorbed from either side. Nothing on a bare core.");
            }
        }
        Row {
            FormLabel {
                text: @tr("Absorption band");
                tip: @tr("Half the absorbing band's width in pixels: the absorption rises over this many pixels to its peak and falls over as many to the outer edge. A band wider than the cladding is squeezed into it.");
            }
            FormInt {
                value <=> Form.fiber.absorption-ramp;
                spec: { min: 1, max: 400, increment: 1, decimals: -1 };
                tip: @tr("Half the absorbing band's width in pixels: the absorption rises over this many pixels to its peak and falls over as many to the outer edge. A band wider than the cladding is squeezed into it.");
            }
        }
    }
    FormSection { text: @tr("Shape"); }
    FormPanel {
        Row {
            FormLabel {
                text: @tr("Ends");
                tip: @tr("How the two ends are cut: flat, straight across the path like a cleaved fibre, or rounded with the outer radius. The AR coating follows a flat end face.");
            }
            FiberEndsChoice {
                value <=> Form.fiber.ends;
                tip: @tr("How the two ends are cut: flat, straight across the path like a cleaved fibre, or rounded with the outer radius. The AR coating follows a flat end face.");
            }
        }
    }
    NodeList { }
}

// A colour as #RRGGBB, applied on Enter or when the box loses the focus.
component HexField inherits Rectangle {
    in-out property <string> text;
    in property <string> tip;
    horizontal-stretch: 1;
    min-height: max(Theme.row-height, edit.min-height);
    min-width: 60px;
    edit := LineEdit {
        width: parent.width;
        height: parent.height;
        text: root.text;
        // typing breaks the binding above
        property <string> shown: root.text;
        changed shown => { self.text = self.shown; }
        accepted => { root.commit(); }
        changed has-focus => {
            if (!self.has-focus && self.text != root.text) {
                root.commit();
            }
        }
    }
    function commit() {
        root.text = edit.text;
        Form.edited(false);
    }
    if root.tip != "": Tooltip { text: @markdown("\{root.tip}"); }
}

// A marker under a stop: a triangle from its tip at the gradient.
component StopMarker inherits Path {
    in property <color> stop-color;
    in property <bool> selected;
    width: 13px;
    height: 9px;
    viewbox-width: 13;
    viewbox-height: 9;
    commands: "M 6.5 0.5 L 12.5 8.5 L 0.5 8.5 Z";
    fill: root.selected ? Theme.accent : root.stop-color;
    stroke: root.selected ? Theme.accent : Theme.text;
    stroke-width: 1px;
}

// A colour scheme's gradient with a marker under each stop, half a marker's room left and right of it. A marker
// dragged moves its stop, pulled away above or below it goes at the release, double-clicked it goes; a press on the
// gradient adds a stop there and drags it. With the focus Left and Right move the selected stop (Shift ten times),
// Page Up and Page Down select the stop before or after it, Del removes it.
component GradientBar inherits FocusScope {
    property <length> inset: 8px;
    property <length> gradient-height: 18px;
    // how far left and right of its tip, and up into the gradient, a press takes a marker
    property <length> reach: 7px;
    property <length> reach-up: 4px;
    property <length> pull-away: 24px;
    // the gradient's pixel columns: 0 at the centre of the first, 1 at the centre of the last
    property <length> left: root.inset + 0.5px;
    property <length> span: max(1px, root.width - 2 * root.inset - 1px);
    property <int> selected: -1;
    property <bool> dragging;
    property <bool> moved;
    property <bool> pulled-away;
    // the pointer's distance from the marker's tip at the press
    property <length> grab;
    property <length> press-x;
    // the gesture the edits of a press, or of the arrow keys while the bar has the focus, join: one undo step
    property <int> gesture;
    property <int> keys-gesture;
    // the last press, whose second, soon after and close by, is a double click's: no stop added, no drag
    property <duration> pressed-at;
    property <length> pressed-x: -1000px;
    function next-gesture() -> int {
        Form.gestures += 1;
        Form.gestures
    }
    function x-of(at: float) -> length {
        root.left + clamp(at, 0, 1) * root.span
    }
    function at-of(x: length) -> float {
        clamp((x - root.left) / root.span, 0, 1)
    }
    function marker-at(x: length, y: length) -> int {
        y < root.gradient-height - root.reach-up ? -1 : Form.marker-at((x - root.left) / root.span, root.reach / root.span, root.selected)
    }
    function current() -> int {
        root.selected >= 0 && root.selected < Form.stops.length ? root.selected : Form.stop-beside(-1, 0)
    }
    changed has-focus => {
        if (self.has-focus) {
            root.keys-gesture = root.next-gesture();
            if (root.selected < 0) {
                root.selected = Form.stop-beside(-1, 0);
            }
        }
    }
    // another scheme, or these stops replaced: the selected one may be gone
    property <int> object: Form.object;
    changed object => { root.selected = -1; }
    property <int> replaced: Form.stops-replaced;
    changed replaced => { root.selected = -1; }
    height: root.gradient-height + 11px;
    accessible-role: slider;
    accessible-label: @tr("Gradient");
    key-pressed(e) => {
        if (Form.stops.length == 0 || e.modifiers.control || e.modifiers.alt || e.modifiers.meta) {
            return reject;
        }
        let k = root.current();
        if (e.text == Key.LeftArrow || e.text == Key.RightArrow) {
            let step = (e.modifiers.shift ? 0.1 : 0.01) * (e.text == Key.LeftArrow ? -1 : 1);
            root.selected = Form.move-stop(k, Form.stops[k].at + step, root.keys-gesture);
            return accept;
        }
        if (e.modifiers.shift) {
            return reject;
        }
        if (e.text == Key.PageUp || e.text == Key.PageDown) {
            root.selected = Form.stop-beside(k, e.text == Key.PageUp ? -1 : 1);
            return accept;
        }
        // handled whether or not a stop goes: Del never reaches the tree's, which removes the scheme
        if (e.text == Key.Delete) {
            root.selected = Form.remove-stop(k, 0);
            return accept;
        }
        reject
    }
    Rectangle {
        x: root.inset;
        y: 0;
        width: root.width - 2 * root.inset;
        height: root.gradient-height;
        border-width: 1px;
        border-color: root.has-focus ? Theme.accent : Theme.border;
        Image {
            x: 1px;
            y: 1px;
            width: parent.width - 2px;
            height: parent.height - 2px;
            source: Form.gradient;
            image-fit: fill;
        }
    }
    // the markers in the list's order, a later one over an earlier, the selected one over all
    for stop[k] in Form.stops: StopMarker {
        x: root.x-of(stop.at) - 6.5px;
        y: root.gradient-height + 0.5px;
        stop-color: stop.color;
        visible: k != root.selected;
    }
    if root.selected >= 0 && root.selected < Form.stops.length: StopMarker {
        x: root.x-of(Form.stops[root.selected].at) - 6.5px;
        y: root.gradient-height + 0.5px;
        stop-color: Form.stops[root.selected].color;
        selected: true;
        opacity: root.pulled-away ? 0.35 : 1;
    }
    TouchArea {
        mouse-cursor: root.dragging || root.marker-at(self.mouse-x, self.mouse-y) >= 0 ? MouseCursor.ew-resize : MouseCursor.default;
        double-clicked => {
            let k = root.marker-at(self.mouse-x, self.mouse-y);
            if (k >= 0) {
                root.selected = Form.remove-stop(k, 0);
            }
        }
        pointer-event(e) => {
            if (e.button == PointerEventButton.left && e.kind == PointerEventKind.down) {
                root.focus();
                let x = self.mouse-x;
                let y = self.mouse-y;
                let second = animation-tick() - root.pressed-at < 500ms && abs(x - root.pressed-x) < 4px;
                root.pressed-at = animation-tick();
                root.pressed-x = x;
                let hit = root.marker-at(x, y);
                if (second) {
                    if (hit >= 0) {
                        root.selected = hit;
                    }
                    return;
                }
                root.gesture = root.next-gesture();
                root.grab = hit >= 0 ? x - root.x-of(Form.stops[hit].at) : 0;
                let on-gradient = y < root.gradient-height && x >= root.inset && x <= root.width - root.inset;
                let k = hit < 0 && on-gradient ? Form.add-stop-at(root.at-of(x), root.gesture) : hit;
                if (k >= 0) {
                    root.selected = k;
                    root.press-x = x;
                    root.moved = false;
                    root.dragging = true;
                }
            } else if (e.button == PointerEventButton.left && e.kind == PointerEventKind.up && root.dragging) {
                root.dragging = false;
                if (root.pulled-away) {
                    root.pulled-away = false;
                    root.selected = Form.remove-stop(root.selected, root.gesture);
                }
            } else if (e.kind == PointerEventKind.cancel) {
                root.dragging = false;
                root.pulled-away = false;
            }
        }
        moved => {
            if (root.dragging) {
                root.moved = root.moved || self.mouse-x != root.press-x;
                root.pulled-away = Form.stops.length > 1 && (self.mouse-y < -root.pull-away || self.mouse-y > root.height + root.pull-away);
                if (root.moved) {
                    root.selected = Form.move-stop(root.selected, root.at-of(self.mouse-x - root.grab), root.gesture);
                }
            }
        }
    }
    Tooltip {
        text: @markdown("\{@tr("Drag a marker to move its stop; drag it away from the gradient or double-click it to remove the stop; a click on the gradient adds a stop there. With keyboard focus Left and Right move the selected stop by a hundredth, a tenth with Shift, Page Up and Page Down select the stop before or after it, and Del removes it")}");
    }
}

export component SchemeForm inherits VerticalLayout {
    alignment: start;
    FormSection { text: @tr("General"); }
    FormPanel {
        Row {
            FormLabel { text: @tr("Label.ColorScheme.Name" => "Name"); tip: @tr("Name the display settings refer to."); }
            FormText { text <=> Form.scheme.name; tip: @tr("Name the display settings refer to."); }
        }
        Row {
            FormLabel { text: @tr("Label.ColorScheme.Kind" => "Kind"); tip: @tr("Output the scheme is meant for; the pickers list it for that output only."); }
            SchemeKindChoice { value <=> Form.scheme.kind; tip: @tr("Output the scheme is meant for; the pickers list it for that output only."); }
        }
        Row {
            FormLabel { text: @tr("Label.ColorScheme.Description" => "Description"); tip: @tr("Free text: what the scheme is, where it comes from."); }
            FormText { text <=> Form.scheme.description; tip: @tr("Free text: what the scheme is, where it comes from."); }
        }
        if Form.mine >= 0: Row {
            Rectangle { }
            HorizontalLayout {
                alignment: start;
                Button {
                    text: Form.mine == 1 ? @tr("Remove from my schemes") : @tr("Add to my schemes");
                    clicked => { Form.toggle-mine(); }
                }
            }
        }
    }
    FormSection { text: @tr("Stops"); }
    FormPanel {
        Row {
            FormLabel { text: @tr("Based on"); tip: @tr("Copy the stops of an existing scheme into this one, then change them"); }
            SchemeCombo {
                choices: Form.bases;
                current: Form.based-on;
                tip: @tr("Copy the stops of an existing scheme into this one, then change them");
                picked(i) => { Form.base-on(i); }
            }
        }
    }
    // as wide as the fields with the markers' room outside them
    Rectangle {
        height: bar.height;
        bar := GradientBar { x: -8px; width: parent.width + 16px; }
    }
    for stop[k] in Form.stops: HorizontalLayout {
        padding-bottom: 4px;
        spacing: 4px;
        FormFloat {
            width: 72px;
            horizontal-stretch: 0;
            value <=> stop.at;
            spec: { min: 0, max: 1, increment: 0.01, decimals: 3 };
            tip: @tr("Position along the gradient: 0 at the lowest value, 1 at the highest");
        }
        ColorSwatch {
            color: stop.color;
            tip: @tr("Pick the colour: Space opens the picker, Enter keeps it, Escape puts the old colour back");
            recolour(c, gesture) => { Form.recolour-stop(k, c, gesture); }
            next-gesture => {
                Form.gestures += 1;
                Form.gestures
            }
        }
        HexField { text <=> stop.hex; tip: @tr("Colour as #RRGGBB; Enter applies it"); }
        Rectangle {
            width: 22px;
            IconButton {
                size: 18px;
                icon: @image-url("icons/next/tree-minus.svg");
                enabled: Form.stops.length > 1;
                tip: @tr("Remove this stop");
                clicked => { Form.remove-row(k); }
            }
        }
    }
    HorizontalLayout {
        padding-top: 2px;
        padding-bottom: 10px;
        alignment: start;
        Rectangle {
            width: add.preferred-width;
            height: add.preferred-height;
            add := Button {
                text: @tr("Add stop");
                clicked => { Form.add-row(); }
            }
            Tooltip { text: @markdown("\{@tr("Insert a stop in the widest gap, with the gradient's colour there")}"); }
        }
    }
}
