// The forms of the project's settings objects (Next's Views/ProjectView, SceneView, SimulationView, DisplayView and
// DisplayLayerView): labels and hints are Next's Label.* and Hint.* strings.
import { Button } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { Form, FormSection, FormPanel, FormLabel, FormValue, FormNumber, FormCheck, FormChoice, FormText, FormNotes } from "form.slint";

export component ProjectForm inherits VerticalLayout {
    // draws a fresh seed (Next's ProjectView.Reseed)
    callback new-seed();
    alignment: start;
    FormSection { text: @tr("General"); }
    FormPanel {
        Row {
            FormLabel { text: @tr("Format version"); tip: @tr("Version of the project file format."); }
            FormValue { text: Form.value(Form.revision, "Version"); }
        }
        Row {
            FormLabel {
                text: @tr("Random seed");
                tip: @tr("Seed of all random decisions (emitter jitter, random gaps). The same seed reproduces the same frames.");
            }
            HorizontalLayout {
                spacing: 6px;
                horizontal-stretch: 1;
                FormNumber {
                    path: "Seed";
                    spec: { min: -2147483648, max: 2147483647, increment: 1, decimals: 0 };
                    tip: @tr("Seed of all random decisions (emitter jitter, random gaps). The same seed reproduces the same frames.");
                }
                Button { text: @tr("New seed"); clicked => { root.new-seed(); } }
            }
        }
        Row {
            FormLabel { text: @tr("Description"); tip: @tr("Free-text notes about the project."); vertical-stretch: 0; }
            FormNotes { path: "Description"; tip: @tr("Free-text notes about the project."); }
        }
    }
}

export component SceneForm inherits VerticalLayout {
    property <bool> image: Form.value(Form.revision, "Mode") == "Image";
    property <bool> image-sources: Form.value(Form.revision, "ImageSources") == "true";
    alignment: start;
    FormSection { text: @tr("Canvas"); }
    FormPanel {
        Row {
            FormLabel { text: @tr("Mode"); tip: @tr("Blank canvas of the given size, or a canvas built from the scene image."); }
            FormChoice {
                path: "Mode";
                words: ["Canvas", "Image"];
                titles: [@tr("Canvas"), @tr("Image")];
                tip: @tr("Blank canvas of the given size, or a canvas built from the scene image.");
            }
        }
        // the image rows show for an image scene only
        if root.image: Row {
            FormLabel {
                text: @tr("Scene image");
                tip: @tr("Image the canvas is built from: red = refractive index (red 0 = a mirror), green = sources, blue = damping. The name of the embedded image, or a path relative to the project folder.");
            }
            FormText {
                path: "Image";
                tip: @tr("Image the canvas is built from: red = refractive index (red 0 = a mirror), green = sources, blue = damping. The name of the embedded image, or a path relative to the project folder.");
            }
        }
        if root.image: Row {
            FormLabel {
                text: @tr("Image file");
                tip: @tr("Where the embedded image came from; the embedded image is what is simulated, a missing file changes nothing. The file is watched while the project is open and re-embedded when it changes; on opening the project a changed file replaces the embedded image too.");
            }
            FormValue { text: Form.value(Form.revision, "ImagePath"); color: Theme.text; }
        }
        if root.image: Row {
            FormLabel { text: @tr("Embedded image"); tip: @tr("Size of the embedded scene image; the canvas takes this size"); }
            FormValue { text: Form.value(Form.revision, "EmbeddedImage"); color: Theme.text; }
        }
        Row {
            FormLabel { text: @tr("Width"); tip: @tr("Width of a blank canvas in pixels."); enabled: !root.image; }
            FormNumber { path: "Width"; spec: { min: 8, max: 16384, increment: 1, decimals: 0 }; enabled: !root.image; tip: @tr("Width of a blank canvas in pixels."); }
        }
        Row {
            FormLabel { text: @tr("Height"); tip: @tr("Height of a blank canvas in pixels."); enabled: !root.image; }
            FormNumber { path: "Height"; spec: { min: 8, max: 16384, increment: 1, decimals: 0 }; enabled: !root.image; tip: @tr("Height of a blank canvas in pixels."); }
        }
        Row {
            FormLabel {
                text: @tr("Edges");
                tip: @tr("Open lets a wave leave the grid, as if the canvas sat in open space; Reflective is a hard wall, as in Wave Dude 2D.");
            }
            FormChoice {
                path: "Edges";
                words: ["Open", "Reflective"];
                titles: [@tr("Open"), @tr("Reflective")];
                tip: @tr("Open lets a wave leave the grid, as if the canvas sat in open space; Reflective is a hard wall, as in Wave Dude 2D.");
            }
        }
        Row {
            FormLabel {
                text: @tr("Damping edge");
                tip: @tr("Thickness in pixels of the absorbing frame: positive inside the canvas, where it shows as a dark margin; negative outside it, simulated but never shown. 0 turns it off.");
            }
            FormNumber {
                path: "DampingEdge";
                spec: { min: -8192, max: 8192, increment: 1, decimals: 0 };
                tip: @tr("Thickness in pixels of the absorbing frame: positive inside the canvas, where it shows as a dark margin; negative outside it, simulated but never shown. 0 turns it off.");
            }
        }
        Row {
            FormLabel {
                text: @tr("Refractive index");
                tip: @tr("Refractive index of a blank canvas, 1.0 to 2.55. The wave speed is 1/n cells per step.");
            }
            FormNumber {
                path: "RefractiveIndex";
                spec: { min: 1, max: 2.55, increment: 0.01, decimals: -1 };
                tip: @tr("Refractive index of a blank canvas, 1.0 to 2.55. The wave speed is 1/n cells per step.");
            }
        }
    }
    FormSection { text: @tr("Sources from the image"); }
    FormPanel {
        Row {
            FormCheck {
                colspan: 2;
                path: "ImageSources";
                text: @tr("Image sources");
                tip: @tr("Let the green channel of the scene image emit waves; the pixel value is the frequency level.");
            }
        }
        Row {
            FormLabel { text: @tr("Image source amplitude"); tip: @tr("Peak amplitude of the image sources."); enabled: root.image-sources; }
            FormNumber {
                path: "ImageSourceScale";
                spec: { min: 0, max: 1000, increment: 0.1, decimals: -1 };
                enabled: root.image-sources;
                tip: @tr("Peak amplitude of the image sources.");
            }
        }
        Row {
            FormCheck { colspan: 2; path: "ObjectSources"; text: @tr("Object sources"); tip: @tr("Use the sources defined in the project."); }
        }
    }
}

export component SimulationForm inherits VerticalLayout {
    alignment: start;
    FormSection { text: @tr("SectionRun" => "Run"); }
    FormPanel {
        Row {
            FormLabel { text: @tr("Steps"); tip: @tr("Total number of simulation steps."); }
            FormNumber { path: "Steps"; spec: { min: 1, max: 10000000, increment: 100, decimals: 0 }; tip: @tr("Total number of simulation steps."); }
        }
        Row {
            FormLabel {
                text: @tr("Visualize every");
                tip: @tr("Render a frame, export it and sample the probes every this many steps.");
            }
            FormNumber {
                path: "VisualizeEvery";
                spec: { min: 1, max: 1000, increment: 1, decimals: 0 };
                tip: @tr("Render a frame, export it and sample the probes every this many steps.");
            }
        }
    }
    FormSection { text: @tr("Solver"); }
    FormPanel {
        Row {
            FormCheck {
                colspan: 2;
                path: "Stencil";
                on: "FourthOrder";
                off: "NinePoint";
                text: @tr("4th-order Laplacian");
                tip: @tr("Use the 4th-order stencil with sub-stepping instead of the 9-point stencil. More accurate, slower.");
            }
        }
        Row {
            FormLabel {
                text: @tr("Wave speed");
                tip: @tr("Nominal wave speed in pixels per step; only used to estimate wavelengths in the editor.");
            }
            FormNumber {
                path: "WaveSpeed";
                spec: { min: 0.000001, max: 1000000, increment: 0.01, decimals: -1 };
                tip: @tr("Nominal wave speed in pixels per step; only used to estimate wavelengths in the editor.");
            }
        }
        Row {
            FormLabel {
                text: @tr("Intensity time decay");
                tip: @tr("Averaging window factor of the intensity: the engine averages over this \u{D7} 100 / lowest source level steps.");
            }
            FormNumber {
                path: "TimeDecay";
                spec: { min: 1, max: 100, increment: 1, decimals: 1, drag-step: 0.1 };
                tip: @tr("Averaging window factor of the intensity: the engine averages over this \u{D7} 100 / lowest source level steps.");
            }
        }
        Row {
            FormLabel {
                text: @tr("Source frequency scale");
                tip: @tr("Multiplier of the level-to-frequency mapping: \u{3C9} = level / 255 \u{D7} 0.5 \u{D7} scale, in radians per step.");
            }
            FormNumber {
                path: "SourceFrequencyScale";
                spec: { min: 0, max: 1000, increment: 0.1, decimals: -1 };
                tip: @tr("Multiplier of the level-to-frequency mapping: \u{3C9} = level / 255 \u{D7} 0.5 \u{D7} scale, in radians per step.");
            }
        }
        Row {
            FormLabel { text: @tr("Intensity scale"); tip: @tr("Multiplier applied to the intensity values the engine produces."); }
            FormNumber {
                path: "IntensityScale";
                spec: { min: 0.0000001, max: 1000000, increment: 0.1, decimals: -1 };
                tip: @tr("Multiplier applied to the intensity values the engine produces.");
            }
        }
    }
}

// One output's settings (Next's DisplayLayerView); `layer` is "Field" or "Intensity".
component DisplayLayerForm inherits FormPanel {
    in property <string> layer;
    Row {
        FormLabel { text: @tr("Colour scheme"); tip: @tr("Name of the colour scheme mapped onto the values."); }
        FormText { path: root.layer + ".ColorScheme"; tip: @tr("Name of the colour scheme mapped onto the values."); }
    }
    Row {
        FormLabel { text: @tr("Brightness"); tip: @tr("Gain applied to the values before the colour lookup."); }
        FormNumber {
            path: root.layer + ".Brightness";
            spec: { min: 0.0001, max: 100000, increment: 1, decimals: -1, log: true };
            tip: @tr("Gain applied to the values before the colour lookup.");
        }
    }
    Row {
        FormLabel {
            text: @tr("Black level");
            tip: @tr("Offset applied before the colour lookup; values at or below it map to the first colour.");
        }
        FormNumber {
            path: root.layer + ".BlackLevel";
            spec: { min: -10, max: 1, increment: 0.01, decimals: -1 };
            tip: @tr("Offset applied before the colour lookup; values at or below it map to the first colour.");
        }
    }
    Row {
        FormCheck { colspan: 2; path: root.layer + ".Preview"; text: @tr("Preview"); tip: @tr("Show this output in the live preview."); }
    }
    Row {
        FormCheck {
            colspan: 2;
            path: root.layer + ".Overlay";
            text: @tr("Outline in the preview");
            tip: @tr("Lay the scene image's glowing-edges outline over this output in the preview.");
        }
    }
    Row {
        FormLabel {
            text: @tr("Outline brightness");
            tip: @tr("Multiplier of the outline: 1 as computed, higher lifts faint edges, 0 hides it.");
        }
        FormNumber {
            path: root.layer + ".OverlayGain";
            spec: { min: 0, max: 5, increment: 0.05, decimals: -1 };
            tip: @tr("Multiplier of the outline: 1 as computed, higher lifts faint edges, 0 hides it.");
        }
    }
    Row {
        FormCheck {
            colspan: 2;
            path: root.layer + ".OverlayInExport";
            text: @tr("Outline in the export");
            tip: @tr("Bake the outline into exported frames and videos of this output.");
        }
    }
}

export component DisplayForm inherits VerticalLayout {
    alignment: start;
    FormSection { text: @tr("Field"); }
    DisplayLayerForm { layer: "Field"; }
    FormSection { text: @tr("Intensity"); }
    DisplayLayerForm { layer: "Intensity"; }
    FormSection { text: @tr("Preview"); }
    FormPanel {
        Row {
            FormCheck {
                colspan: 2;
                path: "HandlesInPreview";
                text: @tr("Handles in the preview");
                tip: @tr("Show the handles, lines, emitter dots and levers of every source, part and probe over the preview pictures. A selected object shows its own either way.");
            }
        }
        Row {
            FormCheck {
                colspan: 2;
                path: "LabelsInPreview";
                text: @tr("Labels in the preview");
                tip: @tr("Show the names beside the handles over the preview pictures. A selected object shows its own either way.");
            }
        }
    }
    FormSection { text: @tr("SectionExportRange" => "Export"); }
    FormPanel {
        Row {
            FormLabel { text: @tr("From step"); tip: @tr("First simulation step of the exported range; 0 is the start of the run."); }
            FormNumber {
                path: "ExportFrom";
                spec: { min: 0, max: 2147483647, increment: 1, decimals: 0 };
                tip: @tr("First simulation step of the exported range; 0 is the start of the run.");
            }
        }
        Row {
            FormLabel { text: @tr("To step"); tip: @tr("Last simulation step of the exported range; 0 means the end of the run."); }
            FormNumber {
                path: "ExportTo";
                spec: { min: 0, max: 2147483647, increment: 1, decimals: 0 };
                tip: @tr("Last simulation step of the exported range; 0 means the end of the run.");
            }
        }
        Row {
            FormCheck {
                colspan: 2;
                path: "ProbeGraphsInExport";
                text: @tr("Probe graphs in the export");
                tip: @tr("Draw the probes' graph boxes over exported frames and videos.");
            }
        }
        Row {
            FormCheck {
                colspan: 2;
                path: "ProbeMarkersInExport";
                text: @tr("Probe markers in the export");
                tip: @tr("Draw the probes' positions (crosses, the line of a line probe, the number) over exported frames and videos.");
            }
        }
        Row {
            FormCheck {
                colspan: 2;
                path: "SourceMarkersInExport";
                text: @tr("Source markers in the export");
                tip: @tr("Draw the enabled sources (the marker, a composite source's emitter dots, the name) over exported frames and videos.");
            }
        }
    }
    FormSection { text: @tr("Video export"); }
    FormPanel {
        Row {
            FormLabel { text: @tr("Frame rate"); tip: @tr("Frames per second of the exported video."); }
            FormNumber { path: "Video.Fps"; spec: { min: 1, max: 240, increment: 1, decimals: 0 }; tip: @tr("Frames per second of the exported video."); }
        }
        Row {
            FormLabel { text: @tr("Quality"); tip: @tr("Encoder quality, 1 to 100."); }
            FormNumber { path: "Video.Quality"; spec: { min: 1, max: 100, increment: 1, decimals: 0 }; tip: @tr("Encoder quality, 1 to 100."); }
        }
    }
}

// Next's SourceView.
export component SourceForm inherits VerticalLayout {
    property <bool> pulsed: Form.value(Form.revision, "Mode") == "Pulsed";
    property <bool> composite: Form.value(Form.revision, "IsComposite") == "true";
    property <string> wavelength: Form.value(Form.revision, "Wavelength");
    alignment: start;
    FormSection { text: @tr("General"); }
    FormPanel {
        Row {
            FormLabel { text: @tr("Name"); tip: @tr("Name shown in the project tree and on the canvas."); }
            FormText { path: "Name"; tip: @tr("Name shown in the project tree and on the canvas."); }
        }
        Row {
            FormCheck { colspan: 2; path: "Enabled"; text: @tr("Label.Source.Enabled" => "Enabled"); tip: @tr("Include the source in simulation runs."); }
        }
    }
    FormSection { text: @tr("Position"); }
    FormPanel {
        Row {
            FormLabel { text: @tr("X"); tip: @tr("X of the emitter, or of the array centre, in canvas pixels."); }
            FormNumber { path: "X"; spec: { min: 0, max: 1000000000, increment: 1, decimals: -1 }; tip: @tr("X of the emitter, or of the array centre, in canvas pixels."); }
        }
        Row {
            FormLabel { text: @tr("Y"); tip: @tr("Y of the emitter, or of the array centre, in canvas pixels."); }
            FormNumber { path: "Y"; spec: { min: 0, max: 1000000000, increment: 1, decimals: -1 }; tip: @tr("Y of the emitter, or of the array centre, in canvas pixels."); }
        }
    }
    FormSection { text: @tr("Wave"); }
    FormPanel {
        Row {
            FormLabel {
                text: @tr("Frequency");
                tip: @tr("Frequency as a level up to 255, decimals allowed, the same scale as the green channel of image sources. Above 255 the grid cannot sample the wave.");
            }
            FormNumber {
                path: "Frequency";
                spec: { min: 0.01, max: 255, increment: 1, decimals: 2, drag-step: 0.1 };
                tip: @tr("Frequency as a level up to 255, decimals allowed, the same scale as the green channel of image sources. Above 255 the grid cannot sample the wave.");
            }
        }
        Row {
            FormLabel { text: @tr("Amplitude"); tip: @tr("Amplitude in percent, 0 to 100, decimals allowed."); }
            FormNumber {
                path: "Amplitude";
                spec: { min: 0, max: 100, increment: 1, decimals: 2, drag-step: 0.1 };
                tip: @tr("Amplitude in percent, 0 to 100, decimals allowed.");
            }
        }
        Row {
            FormLabel { text: @tr("Phase"); tip: @tr("Phase offset in degrees, -180 to 180."); }
            FormNumber { path: "Phase"; spec: { min: -180, max: 180, increment: 1, decimals: 2, drag-step: 0.5 }; tip: @tr("Phase offset in degrees, -180 to 180."); }
        }
        Row {
            FormLabel {
                text: @tr("Wavelength");
                tip: @tr("Estimated from the wave speed and the frequency (\u{3BB} = c / f): emitters one wavelength apart radiate in phase along that direction. Holds for the 4th-order Laplacian; the 9-point stencil's speed varies with the frequency");
            }
            // Next's WavelengthConverter: the 9-point stencil's figure is nominal
            Rectangle {
                horizontal-stretch: 1;
                FormValue {
                    x: 0;
                    color: Theme.text;
                    text: root.wavelength == "" ? "\u{2013}" : "\u{2248} \{root.wavelength} px" + (Form.value(Form.revision, "NinePoint") == "true" ? " " + @tr("(nominal)") : "");
                }
                Tooltip {
                    text: @markdown("\{@tr("Estimated from the wave speed and the frequency (\u{3BB} = c / f): emitters one wavelength apart radiate in phase along that direction. Holds for the 4th-order Laplacian; the 9-point stencil's speed varies with the frequency")}");
                }
            }
        }
    }
    FormSection { text: @tr("Timing"); }
    FormPanel {
        Row {
            FormLabel { text: @tr("Mode"); tip: @tr("Emit continuously or in bursts."); }
            FormChoice { path: "Mode"; words: ["Continuous", "Pulsed"]; titles: [@tr("Continuous"), @tr("Pulsed")]; tip: @tr("Emit continuously or in bursts."); }
        }
        Row {
            FormLabel { text: @tr("Pulse shape"); tip: @tr("Envelope of each burst; pulsed mode only."); enabled: root.pulsed; }
            FormChoice {
                path: "PulseShape";
                words: ["Gaussian", "SmoothedSquare"];
                titles: [@tr("Gaussian"), @tr("Smoothed square")];
                enabled: root.pulsed;
                tip: @tr("Envelope of each burst; pulsed mode only.");
            }
        }
        Row {
            FormLabel { text: @tr("Pulse width"); tip: @tr("Length of each burst in cycles of the source frequency; pulsed mode only."); enabled: root.pulsed; }
            FormNumber {
                path: "PulseWidth";
                spec: { min: 1, max: 1000000000, increment: 1, decimals: -1 };
                enabled: root.pulsed;
                tip: @tr("Length of each burst in cycles of the source frequency; pulsed mode only.");
            }
        }
        Row {
            FormLabel { text: @tr("Off width"); tip: @tr("Length of the gap between bursts in cycles; pulsed mode only."); enabled: root.pulsed; }
            FormNumber {
                path: "OffWidth";
                spec: { min: 1, max: 1000000000, increment: 1, decimals: -1 };
                enabled: root.pulsed;
                tip: @tr("Length of the gap between bursts in cycles; pulsed mode only.");
            }
        }
        Row {
            FormLabel {
                text: @tr("Detach after step");
                tip: @tr("Simulation step at which the source fades out; -1 keeps it on for the whole run.");
            }
            FormNumber {
                path: "DetachAfter";
                spec: { min: -1, max: 1000000000, increment: 1, decimals: -1 };
                tip: @tr("Simulation step at which the source fades out; -1 keeps it on for the whole run.");
            }
        }
    }
    FormSection { text: @tr("Array"); }
    FormCheck {
        path: "IsComposite";
        text: @tr("Composite source");
        tip: @tr("Emit from an array of emitters instead of a single point.");
    }
    Rectangle { height: 4px; }
    FormPanel {
        Row {
            FormLabel {
                text: @tr("Columns");
                tip: @tr("Number of emitters across. Odd counts keep the centre emitter on the source position.");
                enabled: root.composite;
            }
            FormNumber {
                path: "Array.SizeX";
                spec: { min: 1, max: 1000000000, increment: 1, decimals: -1 };
                enabled: root.composite;
                tip: @tr("Number of emitters across. Odd counts keep the centre emitter on the source position.");
            }
        }
        Row {
            FormLabel { text: @tr("Rows"); tip: @tr("Number of emitters down."); enabled: root.composite; }
            FormNumber {
                path: "Array.SizeY";
                spec: { min: 1, max: 1000000000, increment: 1, decimals: -1 };
                enabled: root.composite;
                tip: @tr("Number of emitters down.");
            }
        }
        Row {
            FormLabel { text: @tr("Horizontal spacing"); tip: @tr("Distance between neighbouring columns in canvas pixels."); enabled: root.composite; }
            FormNumber { path: "Array.SpacingX"; enabled: root.composite; tip: @tr("Distance between neighbouring columns in canvas pixels."); }
        }
        Row {
            FormLabel { text: @tr("Vertical spacing"); tip: @tr("Distance between neighbouring rows in canvas pixels."); enabled: root.composite; }
            FormNumber { path: "Array.SpacingY"; enabled: root.composite; tip: @tr("Distance between neighbouring rows in canvas pixels."); }
        }
        Row {
            FormLabel {
                text: @tr("Rotation");
                tip: @tr("Rotation of the grid about the source position in degrees, counter-clockwise on the screen. 0 keeps the rows horizontal.");
                enabled: root.composite;
            }
            FormNumber {
                path: "Array.Angle";
                spec: { min: -180, max: 180, increment: 5, decimals: 1, drag-step: 0.5 };
                enabled: root.composite;
                tip: @tr("Rotation of the grid about the source position in degrees, counter-clockwise on the screen. 0 keeps the rows horizontal.");
            }
        }
        Row {
            FormSection { colspan: 2; text: @tr("Random offsets, added per emitter"); }
        }
        Row {
            FormLabel { text: @tr("Frequency"); tip: @tr("Each emitter's level is offset by up to \u{B1} this amount. 0 turns it off."); enabled: root.composite; }
            FormNumber {
                path: "Array.RandomFrequency";
                spec: { min: 0, max: 1000000000, increment: 1, decimals: -1 };
                enabled: root.composite;
                tip: @tr("Each emitter's level is offset by up to \u{B1} this amount. 0 turns it off.");
            }
        }
        Row {
            FormLabel { text: @tr("Phase"); tip: @tr("Each emitter's phase is offset by up to \u{B1} this many degrees. 0 turns it off."); enabled: root.composite; }
            FormNumber {
                path: "Array.RandomPhase";
                spec: { min: 0, max: 1000000000, increment: 1, decimals: -1 };
                enabled: root.composite;
                tip: @tr("Each emitter's phase is offset by up to \u{B1} this many degrees. 0 turns it off.");
            }
        }
        Row {
            FormLabel {
                text: @tr("Off width");
                tip: @tr("Each gap between bursts is offset by up to \u{B1} this many cycles, re-drawn every period. 0 turns it off.");
                enabled: root.composite;
            }
            FormNumber {
                path: "Array.RandomOffWidth";
                spec: { min: 0, max: 1000000000, increment: 1, decimals: -1 };
                enabled: root.composite;
                tip: @tr("Each gap between bursts is offset by up to \u{B1} this many cycles, re-drawn every period. 0 turns it off.");
            }
        }
        Row {
            FormLabel {
                text: @tr("Position");
                tip: @tr("Each emitter is moved by up to \u{B1} this many pixels in X and in Y. 0 turns it off.");
                enabled: root.composite;
            }
            FormNumber {
                path: "Array.RandomPosition";
                spec: { min: 0, max: 1000000000, increment: 1, decimals: -1 };
                enabled: root.composite;
                tip: @tr("Each emitter is moved by up to \u{B1} this many pixels in X and in Y. 0 turns it off.");
            }
        }
    }
}

// Next's ProbeView: a probabilistic detector is a line of the integrated intensity, so it fixes the layer, the
// measurement and the kind.
export component ProbeForm inherits VerticalLayout {
    property <bool> line: Form.value(Form.revision, "Kind") == "Line";
    property <string> detector: Form.value(Form.revision, "Detector");
    property <bool> standard: root.detector == "Standard";
    property <bool> field: Form.value(Form.revision, "Layer") == "Field";
    alignment: start;
    FormSection { text: @tr("General"); }
    FormPanel {
        Row {
            FormLabel { text: @tr("Name"); tip: @tr("Name shown in the project tree and in the graph title."); }
            FormText { path: "Name"; tip: @tr("Name shown in the project tree and in the graph title."); }
        }
        Row {
            FormCheck { colspan: 2; path: "Active"; text: @tr("Active"); tip: @tr("Sample and draw this probe."); }
        }
        Row {
            FormLabel { text: @tr("Start after step"); tip: @tr("Step at which recording starts; 0 records from the first step."); }
            FormNumber {
                path: "StartAfter";
                spec: { min: 0, max: 1000000000, increment: 1, decimals: -1 };
                tip: @tr("Step at which recording starts; 0 records from the first step.");
            }
        }
    }
    FormSection { text: @tr("Measurement"); }
    FormPanel {
        Row {
            FormLabel {
                text: @tr("Detector");
                tip: @tr("A standard probe, or a probabilistic detector: counting, the detections of the whole line step by step over time, as a photomultiplier's pulses; or imaging, the detections at every point of the line added up over the run, as a SPAD array builds an image. A detector is a line probe of the integrated intensity.");
            }
            FormChoice {
                path: "Detector";
                words: ["Standard", "Counting", "Imaging"];
                titles: [@tr("Standard"), @tr("Counting"), @tr("Imaging")];
                tip: @tr("A standard probe, or a probabilistic detector: counting, the detections of the whole line step by step over time, as a photomultiplier's pulses; or imaging, the detections at every point of the line added up over the run, as a SPAD array builds an image. A detector is a line probe of the integrated intensity.");
            }
        }
        Row {
            FormLabel {
                text: @tr("Detector sensitivity");
                tip: @tr("Expected detections per unit of intensity per step at a point of the line: the detector's quantum efficiency and the scale from intensity to detections in one number. The detections are Poisson-distributed about intensity \u{D7} sensitivity; 0 detects nothing.");
                enabled: !root.standard;
            }
            FormNumber {
                path: "Sensitivity";
                spec: { min: 0, max: 1000000, increment: 1, decimals: 2, drag-step: 0.5 };
                enabled: !root.standard;
                tip: @tr("Expected detections per unit of intensity per step at a point of the line: the detector's quantum efficiency and the scale from intensity to detections in one number. The detections are Poisson-distributed about intensity \u{D7} sensitivity; 0 detects nothing.");
            }
        }
        Row {
            FormLabel {
                text: @tr("Bin size");
                tip: @tr("Pixels of the line per bin of an imaging detector's histogram, 1 to 20: the detections of a bin's pixels are added up, and the graph shows the bin's total across them. Wider bins fill faster and show less detail.");
                enabled: root.detector == "Imaging";
            }
            FormNumber {
                path: "BinSize";
                spec: { min: 1, max: 20, increment: 1, decimals: -1 };
                enabled: root.detector == "Imaging";
                tip: @tr("Pixels of the line per bin of an imaging detector's histogram, 1 to 20: the detections of a bin's pixels are added up, and the graph shows the bin's total across them. Wider bins fill faster and show less detail.");
            }
        }
        Row {
            FormLabel { text: @tr("Layer"); tip: @tr("Output the probe samples and is drawn on."); enabled: root.standard; }
            FormChoice {
                path: "Layer";
                words: ["Field", "Intensity"];
                titles: [@tr("Field"), @tr("Intensity")];
                enabled: root.standard;
                tip: @tr("Output the probe samples and is drawn on.");
            }
        }
        Row {
            FormLabel {
                text: @tr("Label.Probe.Measurement" => "Measurement");
                tip: @tr("Recorded quantity. The field offers its amplitude only; the intensity layer its value, or the value integrated over the run.");
                enabled: root.standard;
            }
            // the layer's own measurements (Next's MeasurementsForLayerConverter)
            if root.field: FormChoice {
                path: "Measurement";
                words: ["Amplitude"];
                titles: [@tr("Amplitude")];
                enabled: root.standard;
                tip: @tr("Recorded quantity. The field offers its amplitude only; the intensity layer its value, or the value integrated over the run.");
            }
            if !root.field: FormChoice {
                path: "Measurement";
                words: ["Value", "IntegratedValue"];
                titles: [@tr("Value"), @tr("Integrated value")];
                offset: 1;
                enabled: root.standard;
                tip: @tr("Recorded quantity. The field offers its amplitude only; the intensity layer its value, or the value integrated over the run.");
            }
        }
        Row {
            FormLabel { text: @tr("Kind"); tip: @tr("A single point, or a line from A to B."); enabled: root.standard; }
            FormChoice {
                path: "Kind";
                words: ["Point", "Line"];
                titles: [@tr("Point"), @tr("Line")];
                enabled: root.standard;
                tip: @tr("A single point, or a line from A to B.");
            }
        }
    }
    FormSection { text: @tr("Position"); }
    FormPanel {
        Row {
            FormLabel { text: @tr("A x"); tip: @tr("X of the probe pixel, or of the start of the line, in canvas pixels."); }
            FormNumber { path: "Ax"; spec: { min: 0, max: 1000000000, increment: 1, decimals: -1 }; tip: @tr("X of the probe pixel, or of the start of the line, in canvas pixels."); }
        }
        Row {
            FormLabel { text: @tr("A y"); tip: @tr("Y of the probe pixel, or of the start of the line, in canvas pixels."); }
            FormNumber { path: "Ay"; spec: { min: 0, max: 1000000000, increment: 1, decimals: -1 }; tip: @tr("Y of the probe pixel, or of the start of the line, in canvas pixels."); }
        }
        Row {
            FormLabel { text: @tr("B x"); tip: @tr("X of the end of the line in canvas pixels; line probes only."); enabled: root.line; }
            FormNumber {
                path: "Bx";
                spec: { min: 0, max: 1000000000, increment: 1, decimals: -1 };
                enabled: root.line;
                tip: @tr("X of the end of the line in canvas pixels; line probes only.");
            }
        }
        Row {
            FormLabel { text: @tr("B y"); tip: @tr("Y of the end of the line in canvas pixels; line probes only."); enabled: root.line; }
            FormNumber {
                path: "By";
                spec: { min: 0, max: 1000000000, increment: 1, decimals: -1 };
                enabled: root.line;
                tip: @tr("Y of the end of the line in canvas pixels; line probes only.");
            }
        }
    }
    FormSection { text: @tr("Graph"); }
    FormPanel {
        Row {
            FormLabel {
                text: @tr("Box size");
                tip: @tr("Nominal size of the graph box drawn over the output; a box larger than the canvas is shrunk to fit it, aspect kept.");
            }
            FormChoice {
                path: "BoxSize";
                words: ["Tiny", "Small", "Medium", "Large", "ExtraLarge", "Custom"];
                titles: [@tr("Tiny"), @tr("Small"), @tr("Medium"), @tr("Large"), @tr("Extra large"), @tr("Custom")];
                tip: @tr("Nominal size of the graph box drawn over the output; a box larger than the canvas is shrunk to fit it, aspect kept.");
            }
        }
        Row {
            FormLabel {
                text: @tr("Box x");
                tip: @tr("Left edge of the graph box in canvas pixels. A box placed on the probe's point A moves with the probe; dragging it close snaps it on.");
            }
            FormNumber {
                path: "BoxX";
                spec: { min: 0, max: 1000000000, increment: 1, decimals: -1 };
                tip: @tr("Left edge of the graph box in canvas pixels. A box placed on the probe's point A moves with the probe; dragging it close snaps it on.");
            }
        }
        Row {
            FormLabel {
                text: @tr("Box y");
                tip: @tr("Top edge of the graph box in canvas pixels. A box placed on the probe's point A moves with the probe; dragging it close snaps it on.");
            }
            FormNumber {
                path: "BoxY";
                spec: { min: 0, max: 1000000000, increment: 1, decimals: -1 };
                tip: @tr("Top edge of the graph box in canvas pixels. A box placed on the probe's point A moves with the probe; dragging it close snaps it on.");
            }
        }
        Row {
            FormLabel {
                text: @tr("Box width");
                tip: @tr("Width of the graph box in canvas pixels; custom box size only. A box larger than the canvas is shrunk to fit it, aspect kept.");
                enabled: Form.value(Form.revision, "BoxSize") == "Custom";
            }
            FormNumber {
                path: "BoxWidth";
                spec: { min: 60, max: 4096, increment: 10, decimals: -1 };
                enabled: Form.value(Form.revision, "BoxSize") == "Custom";
                tip: @tr("Width of the graph box in canvas pixels; custom box size only. A box larger than the canvas is shrunk to fit it, aspect kept.");
            }
        }
        Row {
            FormLabel {
                text: @tr("Box height");
                tip: @tr("Height of the graph box in canvas pixels; custom box size only. A box larger than the canvas is shrunk to fit it, aspect kept.");
                enabled: Form.value(Form.revision, "BoxSize") == "Custom";
            }
            FormNumber {
                path: "BoxHeight";
                spec: { min: 30, max: 4096, increment: 10, decimals: -1 };
                enabled: Form.value(Form.revision, "BoxSize") == "Custom";
                tip: @tr("Height of the graph box in canvas pixels; custom box size only. A box larger than the canvas is shrunk to fit it, aspect kept.");
            }
        }
    }
    FormSection { text: @tr("Axes"); }
    FormPanel {
        Row {
            FormLabel { text: @tr("Step axis"); tip: @tr("Sliding window of the last steps, or the whole run; point probes only."); enabled: !root.line; }
            FormChoice {
                path: "ScaleMode";
                words: ["Running", "Full"];
                titles: [@tr("Enum.ProbeScaleMode.Running" => "Running"), @tr("Enum.ProbeScaleMode.Full" => "Full")];
                enabled: !root.line;
                tip: @tr("Sliding window of the last steps, or the whole run; point probes only.");
            }
        }
        Row {
            FormLabel { text: @tr("Window"); tip: @tr("Width of the sliding step window, in steps."); }
            FormNumber { path: "Window"; spec: { min: 10, max: 1000000, increment: 10, decimals: -1 }; tip: @tr("Width of the sliding step window, in steps."); }
        }
        Row {
            FormCheck {
                colspan: 2;
                path: "AutoScaleX";
                text: @tr("Auto-scale steps");
                enabled: !root.line;
                tip: @tr("Let the step axis follow the samples recorded so far; point probes only.");
            }
        }
        Row {
            FormCheck {
                colspan: 2;
                path: "AutoScaleY";
                text: @tr("Auto-scale values");
                tip: @tr("Fit the value axis to the data instead of the fixed minimum and maximum.");
            }
        }
        Row {
            FormLabel {
                text: @tr("Value axis");
                tip: @tr("A linear or a logarithmic value axis; intensity probes only, the field is always linear.");
                enabled: !root.field;
            }
            FormChoice {
                path: "YScale";
                words: ["Linear", "Logarithmic"];
                titles: [@tr("Linear"), @tr("Logarithmic")];
                enabled: !root.field;
                tip: @tr("A linear or a logarithmic value axis; intensity probes only, the field is always linear.");
            }
        }
        Row {
            FormLabel {
                text: @tr("Decades");
                tip: @tr("Decades a logarithmic value axis spans below its top; smaller values, zero included, sit on the bottom line.");
                enabled: Form.value(Form.revision, "YScale") == "Logarithmic" && !root.field;
            }
            FormNumber {
                path: "Decades";
                spec: { min: 1, max: 12, increment: 1, decimals: -1 };
                enabled: Form.value(Form.revision, "YScale") == "Logarithmic" && !root.field;
                tip: @tr("Decades a logarithmic value axis spans below its top; smaller values, zero included, sit on the bottom line.");
            }
        }
        Row {
            FormLabel { text: @tr("Value minimum"); tip: @tr("Lower bound of the value axis when it is not auto-scaled."); }
            FormNumber { path: "YMin"; spec: { min: -1000000000, max: 1000000000, increment: 0.1, decimals: -1 }; tip: @tr("Lower bound of the value axis when it is not auto-scaled."); }
        }
        Row {
            FormLabel { text: @tr("Value maximum"); tip: @tr("Upper bound of the value axis when it is not auto-scaled."); }
            FormNumber { path: "YMax"; spec: { min: -1000000000, max: 1000000000, increment: 0.1, decimals: -1 }; tip: @tr("Upper bound of the value axis when it is not auto-scaled."); }
        }
    }
}
