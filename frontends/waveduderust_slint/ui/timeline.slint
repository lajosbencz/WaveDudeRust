import { Command, TransportAction } from "commands.slint";
import { Theme } from "theme.slint";
import { Icon, IconButton } from "icons.slint";
import { EditKeys } from "edit-keys.slint";

// The playback state the timeline and transport bar show.
export struct Transport {
    frames: int,
    position: int,
    made: int,
    start: int,
    end: int,
    ranged: bool,
    playing: bool,
    live: bool,
    looping: bool,
    running: bool,
    // the run is paused (F6)
    paused: bool,
    // no enabled source: nothing to simulate, the timeline and playback are off
    empty: bool,
    step: string,
    // Display > Field / Intensity > Preview
    field-shown: bool,
    intensity-shown: bool,
}

// The in or the out point of the range.
export enum Bracket { start, end }


// The preview's frames and their playback: filled and served by src/wire/transport.rs.
export global Playback {
    in property <Transport> transport;
    in property <image> field;
    in property <image> intensity;
    // field above intensity, else side by side
    in-out property <bool> stacked: true;
    callback seek(frame: int);
    // the bracket dragged to `frame`
    callback bracket(bracket: Bracket, frame: int);
    callback action(action: TransportAction);
    // the typed speed; the text to show (the speed kept, as text)
    callback speed(text: string) -> string;
}

// The scrub bar (docs/ui/50, Timeline): tick labels, frames made, the in/out range, the playhead; click or drag to
// scrub, drag a bracket to move the range.
export component Timeline inherits Rectangle {
    property <Transport> t: Playback.transport;
    opacity: t.empty ? 0.5 : 1;
    accessible-role: slider;
    accessible-label: @tr("Timeline");
    accessible-enabled: !t.empty;
    accessible-value: t.position;
    accessible-value-minimum: 0;
    accessible-value-maximum: root.last;
    accessible-value-step: 1;
    accessible-action-increment => { Playback.seek(t.position + 1); }
    accessible-action-decrement => { Playback.seek(t.position - 1); }

    property <float> last: max(1, t.frames - 1);
    // inside the outline: 5 px to its first column, one to its last
    property <length> inner: self.width - 11px;
    // frame 0 on the first column inside the outline, the last frame on the last
    pure function x-of(frame: int) -> length { 5px + round(root.inner * frame / root.last / 1px) * 1px }
    pure function frame-at(x: length) -> int { round((x - 5px) / root.inner * root.last) }
    // the labels' interval: 1, 2, 5, 10, 20, 50 ... frames, at least 64 px apart
    property <int> interval: root.pick(64px / max(root.inner, 1px) * root.last);
    // the smallest 1, 2 or 5 times a power of ten at least `frames`
    pure function pick(frames: float) -> int {
        let decade = pow(10, floor(log(max(frames, 1), 10)));
        let m = frames / decade;
        round(decade * (m <= 1 ? 1 : m <= 2 ? 2 : m <= 5 ? 5 : 10))
    }
    // a single frame has no ticks past 0
    property <int> span: t.frames <= 1 ? 0 : root.last;
    // minor ticks every fifth of the interval, when that is whole
    property <int> minor: mod(root.interval, 5) == 0 ? root.interval / 5 : root.interval;
    // the bracket under a press: 0 none, 1 in, 2 out
    property <int> dragging;

    height: 36px;
    background: Theme.window-background;
    focus := FocusScope {
        key-pressed(e) => {
            if (e.text == Key.LeftArrow) { Playback.seek(t.position - 1); return accept; }
            if (e.text == Key.RightArrow) { Playback.seek(t.position + 1); return accept; }
            if (e.text == Key.PageUp) { Playback.seek(t.position + 10); return accept; }
            if (e.text == Key.PageDown) { Playback.seek(t.position - 10); return accept; }
            if (e.text == Key.Home) { Playback.seek(t.start); return accept; }
            if (e.text == Key.End) { Playback.seek(t.end); return accept; }
            if (e.text == " ") { Playback.action(TransportAction.play); return accept; }
            reject
        }
    }
    // ticks and labels over the label row
    for i in floor(root.span / root.minor) + 1: Rectangle {
        property <bool> major: mod(i * root.minor, root.interval) == 0;
        x: root.x-of(i * root.minor);
        y: 14px - self.height;
        width: 1px;
        height: self.major ? 6px : 3px;
        background: Theme.text-dim;
    }
    for i in floor(root.span / root.interval) + 1: Text {
        x: min(root.x-of(i * root.interval) + 2px, root.width - 4px - self.width);
        y: 0px;
        height: 10px;
        text: i * root.interval;
        color: Theme.text-dim;
        font-size: 9px;
    }
    bar := Rectangle {
        x: 4px;
        width: root.width - 8px;
        y: 14px;
        height: 22px - 2px;
        background: Theme.input-background;
        border-width: 1px;
        border-color: focus.has-focus ? Theme.accent : Theme.border;
    }
    if t.made >= 0: Rectangle {
        x: 5px;
        width: root.x-of(t.made) + 1px - self.x;
        y: bar.y + 1px;
        height: bar.height - 2px;
        background: Theme.accent.transparentize(0.6);
    }
    if t.ranged: Rectangle {
        x: root.x-of(t.start);
        width: root.x-of(t.end) + 1px - self.x;
        y: bar.y + 1px;
        height: bar.height - 2px;
        background: Theme.accent.transparentize(0.8);
    }
    // the brackets: a 2 px bar, 6 px feet into the range
    if t.ranged: Path {
        x: root.x-of(t.start);
        y: bar.y;
        width: 8px;
        height: bar.height;
        viewbox-width: 8;
        viewbox-height: bar.height / 1px;
        fill: Theme.accent;
        commands: "M 0 0 L 8 0 L 8 2 L 2 2 L 2 \{bar.height / 1px - 2} L 8 \{bar.height / 1px - 2} L 8 \{bar.height / 1px} L 0 \{bar.height / 1px} Z";
    }
    if t.ranged: Path {
        x: root.x-of(t.end) + 1px - 8px;
        y: bar.y;
        width: 8px;
        height: bar.height;
        viewbox-width: 8;
        viewbox-height: bar.height / 1px;
        fill: Theme.accent;
        commands: "M 8 0 L 0 0 L 0 2 L 6 2 L 6 \{bar.height / 1px - 2} L 0 \{bar.height / 1px - 2} L 0 \{bar.height / 1px} L 8 \{bar.height / 1px} Z";
    }
    if touch.has-hover: Rectangle {
        x: root.x-of(root.frame-at(touch.mouse-x));
        y: bar.y;
        width: 1px;
        height: bar.height;
        background: Theme.text-dim;
    }
    // the playhead: a line, a 10 x 6 triangle on top and the frame number beside it over a patch of the bar's colour
    Rectangle {
        x: root.x-of(t.position);
        y: bar.y;
        width: 1px;
        height: bar.height;
        background: Theme.text;
    }
    Path {
        x: root.x-of(t.position) - 4.5px;
        y: bar.y - 6px;
        width: 10px;
        height: 6px;
        viewbox-width: 10;
        viewbox-height: 6;
        fill: Theme.text;
        commands: "M 0 0 L 10 0 L 5 6 Z";
    }
    number := Rectangle {
        x: min(root.x-of(t.position) + 8px, root.width - self.width - 2px);
        y: 0px;
        width: label.preferred-width + 4px;
        height: 12px;
        background: Theme.window-background;
        label := Text {
            text: t.position;
            color: Theme.text;
            font-size: 10px;
        }
    }
    touch := TouchArea {
        enabled: !root.t.empty;
        y: bar.y;
        height: bar.height;
        mouse-cursor: root.dragging > 0 || root.near-bracket(self.mouse-x) > 0 ? MouseCursor.ew-resize : MouseCursor.pointer;
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left) {
                focus.focus();
                root.dragging = root.near-bracket(self.mouse-x);
                if (root.dragging == 0) { Playback.seek(root.frame-at(self.mouse-x)); }
            } else if (e.kind == PointerEventKind.up) {
                root.dragging = 0;
            }
        }
        moved => {
            if (!self.pressed) { return; }
            if (root.dragging > 0) {
                Playback.bracket(root.dragging == 2 ? Bracket.end : Bracket.start, root.frame-at(self.mouse-x));
            } else {
                Playback.seek(root.frame-at(self.mouse-x));
            }
        }
        scroll-event(e) => {
            Playback.seek(t.position + (e.delta-y > 0 ? 1 : -1));
            accept
        }
    }
    // a bracket within 5 px of `x`, the nearer one: 0 none, 1 in, 2 out
    pure function near-bracket(x: length) -> int {
        if (!t.ranged) { return 0; }
        let in = abs(x - root.x-of(t.start));
        let out = abs(x - root.x-of(t.end));
        // coincident brackets: the side of the pointer picks
        min(in, out) > 5px ? 0 : in < out ? 1 : out < in ? 2 : x > root.x-of(t.start) ? 2 : 1
    }
}

component Divider inherits Rectangle {
    width: 1px;
    background: Theme.border;
}

// The transport bar (docs/ui/50, Transport bar).
export component TransportBar inherits Rectangle {
    property <Transport> t: Playback.transport;
    callback command(Command);

    height: 28px;
    background: Theme.window-background;
    HorizontalLayout {
        padding: 3px;
        spacing: 1px;
        IconButton { icon: t.running ? @image-url("icons/next/stop.svg") : @image-url("icons/next/run.svg"); enabled: t.running || !t.empty; tip: t.running ? @tr("Stop the simulation; the frames so far stay (Esc)") : @tr("Run the simulation from the start (F5)"); clicked => { root.command(t.running ? Command.stop : Command.run); } }
        IconButton { icon: @image-url("icons/next/pause-run.svg"); tip: t.paused ? @tr("Resume the simulation (F6)") : @tr("Pause the simulation (F6)"); enabled: t.running; clicked => { Playback.action(TransportAction.pause-run); } }
        Divider { }
        IconButton { icon: @image-url("icons/next/play.svg"); tip: @tr("Play (Space)"); enabled: !t.playing && !t.empty; clicked => { Playback.action(TransportAction.play); } }
        IconButton { icon: @image-url("icons/next/pause.svg"); tip: @tr("Pause (Space)"); enabled: t.playing; clicked => { Playback.action(TransportAction.play); } }
        IconButton { icon: @image-url("icons/next/step-back.svg"); tip: @tr("Previous frame (,)"); enabled: !t.empty; clicked => { Playback.action(TransportAction.prev); } }
        IconButton { icon: @image-url("icons/next/step-forward.svg"); tip: @tr("Next frame (.)"); enabled: !t.empty; clicked => { Playback.action(TransportAction.next); } }
        Divider { }
        IconButton { icon: @image-url("icons/next/set-in.svg"); tip: @tr("Start the export range at this frame (I)"); enabled: !t.empty; clicked => { Playback.action(TransportAction.set-in); } }
        IconButton { icon: @image-url("icons/next/set-out.svg"); tip: @tr("End the export range at this frame (O)"); enabled: !t.empty; clicked => { Playback.action(TransportAction.set-out); } }
        IconButton { icon: @image-url("icons/next/clear-range.svg"); tip: @tr("Clear the export range: the whole run is exported (X)"); enabled: t.ranged; clicked => { Playback.action(TransportAction.clear-range); } }
        IconButton { icon: @image-url("icons/next/loop.svg"); tip: @tr("Loop playback over the export range (L)"); checked: t.looping; enabled: !t.empty; clicked => { Playback.action(TransportAction.loop); } }
        IconButton { icon: @image-url("icons/next/live.svg"); tip: @tr("Follow the newest frame while the run is in progress (F)"); checked: t.live; enabled: t.running; clicked => { Playback.action(TransportAction.live); } }
        Divider { }
        // as wide as the widest readout of the run, so playing does not shift what follows
        Rectangle {
            width: max(frame.preferred-width, widest.preferred-width);
            widest := Text {
                visible: false;
                text: "8" + max(0, t.frames - 1) + " / " + max(0, t.frames - 1);
            }
            frame := Text {
                text: t.position + " / " + max(0, t.frames - 1);
                vertical-alignment: center;
                color: Theme.text;
            }
            Tooltip { text: @markdown("\{@tr("Frame shown / last frame")}"); }
        }
        Rectangle {
            width: step.preferred-width + 6px;
            step := Text {
                x: 6px;
                text: t.step;
                vertical-alignment: center;
                color: Theme.text-dim;
            }
            Tooltip { text: @markdown("\{@tr("Simulation step of the frame shown")}"); }
        }
        Rectangle { horizontal-stretch: 1; }
        Text {
            text: @tr("Speed");
            vertical-alignment: center;
            color: Theme.text;
        }
        // an editable combo (docs/ui/50, #11): typed 0.01..100 or a preset; its text keeps Space from Play
        Rectangle {
            width: 64px;
            border-width: 1px;
            border-color: speed-box.has-focus ? Theme.accent : Theme.border;
            Tooltip { text: @markdown("\{@tr("Playback speed: pick a factor or type one")}"); }
            HorizontalLayout {
                padding-left: 4px;
                speed-box := TextInput {
                    text: "1";
                    accessible-label: @tr("Playback speed");
                    vertical-alignment: center;
                    color: Theme.text;
                    single-line: true;
                    accepted => { self.text = Playback.speed(self.text); }
                    changed has-focus => {
                        EditKeys.local = self.has-focus;
                        if (!self.has-focus) { self.text = Playback.speed(self.text); }
                    }
                }
                Rectangle {
                    width: 16px;
                    background: drop.has-hover ? Theme.button-hover : transparent;
                    Icon { source: @image-url("icons/next/chevron-down.svg"); }
                    drop := TouchArea { clicked => { presets.show(); } }
                }
            }
            presets := PopupWindow {
                // six 22 px rows, padding and edge
                height: 138px;
                x: 0;
                y: -self.height;
                close-policy: close-on-click-outside;
                width: 64px;
                Rectangle {
                    background: Theme.window-background;
                    border-width: 1px;
                    border-color: Theme.border;
                    VerticalLayout {
                        padding: 2px;
                        for preset in ["0.25", "0.5", "1", "1.5", "2", "4"]: Rectangle {
                            height: 22px;
                            background: pick.has-hover ? Theme.button-hover : transparent;
                            Text {
                                x: 6px;
                                text: preset;
                                vertical-alignment: center;
                                color: Theme.text;
                            }
                            pick := TouchArea { clicked => { speed-box.text = Playback.speed(preset); } }
                        }
                    }
                }
            }
        }
        Divider { }
        IconButton { icon: @image-url("icons/next/field.svg"); tip: @tr("Show the field picture"); checked: root.t.field-shown; clicked => { Playback.action(TransportAction.show-field); } }
        IconButton { icon: @image-url("icons/next/intensity.svg"); tip: @tr("Show the intensity picture"); checked: root.t.intensity-shown; clicked => { Playback.action(TransportAction.show-intensity); } }
        Divider { }
        IconButton { icon: @image-url("icons/next/side-by-side.svg"); tip: @tr("Field and intensity side by side"); checked: !Playback.stacked; clicked => { Playback.stacked = false; Playback.action(TransportAction.layout); } }
        IconButton { icon: @image-url("icons/next/stacked.svg"); tip: @tr("Field above intensity"); checked: Playback.stacked; clicked => { Playback.stacked = true; Playback.action(TransportAction.layout); } }
    }
}
