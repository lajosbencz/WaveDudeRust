import { ListView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { Icon, IconButton } from "icons.slint";
import { MenuIcons } from "menu-icons.slint";

// An add menu's entry: an id for `tree::add`.
struct AddKind {
    title: string,
    icon: image,
    id: string,
}

// Next's menus of part and probe kinds (ProjectTree.xaml PartKindMenu, ProbeKindMenu), shared by the toolbar's menus
// and the rows' menu. Slint's menu entries take no tooltip, so the kinds' descriptions are not shown
// (docs/divergences.md, Add menus).
global AddKinds {
    out property <[AddKind]> parts: [
        { title: @tr("Lens/Mirror"), icon: MenuIcons.next-lens, id: "part:lens" },
        { title: @tr("Fresnel lens"), icon: MenuIcons.next-fresnel-lens, id: "part:fresnel-lens" },
        { title: @tr("Fibre"), icon: MenuIcons.next-fiber, id: "part:fiber" },
        { title: @tr("Bragg reflector"), icon: MenuIcons.next-bragg-reflector, id: "part:bragg-reflector" },
        { title: @tr("GRIN lens"), icon: MenuIcons.next-grin-lens, id: "part:grin-lens" },
        { title: @tr("Zone plate"), icon: MenuIcons.next-zone-plate, id: "part:zone-plate" },
        { title: @tr("Diffuser"), icon: MenuIcons.next-diffuser, id: "part:diffuser" },
        { title: @tr("Interference filter"), icon: MenuIcons.next-interference-filter, id: "part:interference-filter" },
    ];
    out property <[AddKind]> gratings: [
        { title: @tr("Simple 2D grating"), icon: MenuIcons.next-simple-grating, id: "part:simple-grating" },
        { title: @tr("Facetted grating"), icon: MenuIcons.next-facetted-grating, id: "part:facetted-grating" },
    ];
    out property <[AddKind]> meta: [
        { title: @tr("Meta lens"), icon: MenuIcons.next-meta-lens, id: "part:meta-lens" },
        { title: @tr("Meta prism"), icon: MenuIcons.next-meta-prism, id: "part:meta-prism" },
        { title: @tr("Meta axicon"), icon: MenuIcons.next-meta-axicon, id: "part:meta-axicon" },
    ];
    out property <[AddKind]> shapes: [
        { title: @tr("Polygon"), icon: MenuIcons.next-polygon, id: "part:polygon" },
        { title: @tr("Rectangle"), icon: MenuIcons.next-rectangle, id: "part:rectangle" },
        { title: @tr("Ellipse"), icon: MenuIcons.next-ellipse, id: "part:ellipse" },
        { title: @tr("Triangle"), icon: MenuIcons.next-triangle, id: "part:triangle" },
        { title: @tr("Outline"), icon: MenuIcons.next-outline, id: "part:outline" },
    ];
    out property <[AddKind]> logic: [
        { title: @tr("XOR (Mach-Zehnder)"), icon: MenuIcons.next-xor-gate, id: "part:xor-gate" },
        { title: @tr("AND"), icon: MenuIcons.next-and-gate, id: "part:and-gate" },
        { title: @tr("OR"), icon: MenuIcons.next-or-gate, id: "part:or-gate" },
    ];
    out property <[AddKind]> detectors: [
        { title: @tr("Counting detector"), icon: MenuIcons.next-counting-detector, id: "probe:counting" },
        { title: @tr("Imaging detector"), icon: MenuIcons.next-imaging-detector, id: "probe:imaging" },
    ];
}

// The menu of part kinds; a click on its owner or a right click opens it under the owner.
component PartMenu {
    // off: no right click opens it
    in property <bool> enabled: true;
    callback add(string);
    public function open() { menu.show({ x: 0, y: root.height }); }
    menu := ContextMenuArea {
        enabled: root.enabled;
        Menu {
            for kind in AddKinds.parts: MenuItem { title: kind.title; icon: kind.icon; activated => { root.add(kind.id); } }
            Menu {
                title: @tr("Diffraction gratings");
                icon: MenuIcons.next-diffraction-gratings;
                for kind in AddKinds.gratings: MenuItem { title: kind.title; icon: kind.icon; activated => { root.add(kind.id); } }
            }
            Menu {
                title: @tr("Meta surfaces");
                icon: MenuIcons.next-meta-surfaces;
                for kind in AddKinds.meta: MenuItem { title: kind.title; icon: kind.icon; activated => { root.add(kind.id); } }
            }
            MenuSeparator { }
            for kind in AddKinds.shapes: MenuItem { title: kind.title; icon: kind.icon; activated => { root.add(kind.id); } }
            MenuSeparator { }
            Menu {
                title: @tr("Optical logic");
                icon: MenuIcons.next-optical-logic;
                for kind in AddKinds.logic: MenuItem { title: kind.title; icon: kind.icon; activated => { root.add(kind.id); } }
            }
        }
    }
}

// The menu of probe kinds, opened as the parts' is.
component ProbeMenu {
    in property <bool> enabled: true;
    callback add(string);
    public function open() { menu.show({ x: 0, y: root.height }); }
    menu := ContextMenuArea {
        enabled: root.enabled;
        Menu {
            MenuItem { title: @tr("Standard probe"); icon: MenuIcons.next-probe; activated => { root.add("probe:standard"); } }
            Menu {
                title: @tr("Probabilistic");
                icon: MenuIcons.next-counting-detector;
                for kind in AddKinds.detectors: MenuItem { title: kind.title; icon: kind.icon; activated => { root.add(kind.id); } }
            }
        }
    }
}

// A toolbar's add button (Next's TextButton): the folder's drawing with the plus badge, the label, and the drop-down
// arrow when it opens a menu of kinds.
component AddButton inherits Rectangle {
    in property <image> icon;
    in property <string> text;
    in property <string> tip;
    in property <bool> drop-down;
    callback clicked();

    height: 22px;
    background: area.has-hover ? Theme.button-hover : transparent;
    border-width: 1px;
    border-color: focus.has-focus ? Theme.accent : transparent;
    accessible-role: button;
    accessible-label: tip;
    accessible-action-default => { root.clicked(); }
    HorizontalLayout {
        padding-left: 4px;
        padding-right: 4px;
        spacing: 4px;
        Rectangle {
            width: 16px;
            Icon { source: root.icon; }
            Icon { source: @image-url("icons/next/plus-badge.svg"); }
        }
        Text { text: root.text; vertical-alignment: center; color: Theme.text; }
        if root.drop-down: Icon {
            source: @image-url("icons/next/drop-down.svg");
            width: 7px;
        }
    }
    // under the touch area, as IconButton's
    focus := FocusScope {
        focus-on-click: false;
        key-pressed(e) => {
            if (e.text == " " || e.text == Key.Return) {
                root.clicked();
                return accept;
            }
            reject
        }
    }
    area := TouchArea {
        clicked => { root.clicked(); }
    }
    Tooltip { text: @markdown("\{root.tip}"); }
}

export enum TreeKind { project, settings, folder, source, part, probe, scheme }

export struct TreeRow {
    kind: TreeKind,
    depth: int,
    label: string,
    checkable: bool,
    checked: bool,
    selected: bool,
    icon: image,
    // a folder's plus: "source", "part", "probe" or "scheme"; empty for other rows
    add: string,
    // has children, and shows them
    expandable: bool,
    expanded: bool,
    // a colour scheme's gradient
    strip: image,
}

// The project tree (docs/ui/20): fixed rows, folders and item rows with their check box and row buttons.
export component ProjectTree inherits Rectangle {
    in property <[TreeRow]> rows;
    // the current row's index, -1 when hidden
    in property <int> current-row;
    // the row and how: 0 alone, 1 toggled (Ctrl), 2 range (Shift), 3 current in the group kept (right click)
    callback select(int, int);
    callback toggle(int);
    callback expand(int);
    callback shift(int, int);
    callback remove(int);
    in property <bool> can-move-up;
    in property <bool> can-move-down;
    in property <bool> can-remove;
    in property <bool> can-copy;
    in property <bool> can-select-all;
    // the current row can be switched on and off and join a group
    in property <bool> can-toggle;
    // a command on the current row ("move-up", "move-down", "delete") or an add ("add:<what>")
    callback act(string);

    // the tree takes the focus with a command on it (Next's rule)
    function run(id: string) {
        tree-keys.focus();
        root.act(id);
    }
    property <bool> focused: tree-keys.has-focus;

    background: Theme.tool-window-background;
    VerticalLayout {
        // Next's pane toolbar: source, probe, then part; move and remove act on the current row
        Rectangle {
            border-width: 0px;
            HorizontalLayout {
                padding: 2px;
                alignment: start;
                AddButton {
                    icon: @image-url("icons/next/source.svg");
                    text: @tr("Source");
                    tip: @tr("Add a source (appended at the end)");
                    clicked => { root.run("add:source"); }
                }
                AddButton {
                    icon: @image-url("icons/next/probe.svg");
                    text: @tr("Probe");
                    tip: @tr("Add a probe: a standard probe, or a probabilistic detector (appended at the end)");
                    drop-down: true;
                    clicked => { probes.open(); }
                    probes := ProbeMenu { add(id) => { root.run("add:" + id); } }
                }
                AddButton {
                    icon: @image-url("icons/next/part.svg");
                    text: @tr("Part");
                    tip: @tr("Add an optical part (a menu of kinds; appended at the end)");
                    drop-down: true;
                    clicked => { parts.open(); }
                    parts := PartMenu { add(id) => { root.run("add:" + id); } }
                }
                Rectangle { width: 9px; Rectangle { x: 4px; width: 1px; height: parent.height - 4px; background: Theme.border; } }
                IconButton { icon: @image-url("icons/next/tree-chevron-up.svg"); tip: @tr("Move up (Alt+Up); drag to reorder"); enabled: root.can-move-up; clicked => { root.run("move-up"); } }
                IconButton { icon: @image-url("icons/next/tree-chevron-down.svg"); tip: @tr("Move down (Alt+Down); drag to reorder"); enabled: root.can-move-down; clicked => { root.run("move-down"); } }
                IconButton { icon: @image-url("icons/next/tree-minus.svg"); tip: @tr("Remove (Del)"); enabled: root.can-remove; clicked => { root.run("delete"); } }
            }
            Rectangle { y: parent.height - 1px; height: 1px; background: Theme.border; }
        }
        // Next's TreeView keys, only while the tree has focus
        tree-keys := FocusScope {
            key-pressed(e) => {
                if (e.modifiers.alt && !e.modifiers.control && e.text == Key.UpArrow) { root.act("move-up"); return accept; }
                if (e.modifiers.alt && !e.modifiers.control && e.text == Key.DownArrow) { root.act("move-down"); return accept; }
                if (e.modifiers.control && !e.modifiers.alt && e.text == "d") { root.act("duplicate"); return accept; }
                if (e.modifiers.control && !e.modifiers.alt && e.text == " ") { root.act("toggle-selected"); return accept; }
                if (e.modifiers.alt || e.modifiers.control) { return reject; }
                if (e.text == " ") { root.act("toggle-enabled"); return accept; }
                if (e.text == Key.Insert) { root.act("toggle-selected"); return accept; }
                if (e.text == Key.Menu || (e.modifiers.shift && e.text == Key.F10)) {
                    rows-menu.show({
                        x: list.absolute-position.x + 24px - menu-anchor.absolute-position.x,
                        y: list.absolute-position.y + list.viewport-y + (max(root.current-row, 0) + 1) * Theme.row-height - menu-anchor.absolute-position.y,
                    });
                    return accept;
                }
                reject
            }
            // Next's row menu (ProjectTree.xaml ItemContainerStyle ContextMenu), opened by a row's right press, Menu or
            // Shift+F10: a ContextMenuArea over the rows would take that press. Its commands act on the selection, whose
            // current row the right-clicked one becomes; one outside it is selected alone (Explorer's rule). No access keys or key hints: Slint draws context menus
            // without mnemonics, and a menu shortcut would bind its key window-wide.
            menu-anchor := Rectangle {
                width: 0px;
                height: 0px;
                rows-menu := ContextMenuArea {
                    Menu {
                        MenuItem { title: @tr("Add source"); icon: MenuIcons.add; activated => { root.run("add:source"); } }
                        Menu {
                            title: @tr("Add part");
                            icon: MenuIcons.add;
                            for kind in AddKinds.parts: MenuItem { title: kind.title; icon: kind.icon; activated => { root.run("add:" + kind.id); } }
                            Menu {
                                title: @tr("Diffraction gratings");
                                icon: MenuIcons.next-diffraction-gratings;
                                for kind in AddKinds.gratings: MenuItem { title: kind.title; icon: kind.icon; activated => { root.run("add:" + kind.id); } }
                            }
                            Menu {
                                title: @tr("Meta surfaces");
                                icon: MenuIcons.next-meta-surfaces;
                                for kind in AddKinds.meta: MenuItem { title: kind.title; icon: kind.icon; activated => { root.run("add:" + kind.id); } }
                            }
                            MenuSeparator { }
                            for kind in AddKinds.shapes: MenuItem { title: kind.title; icon: kind.icon; activated => { root.run("add:" + kind.id); } }
                            MenuSeparator { }
                            Menu {
                                title: @tr("Optical logic");
                                icon: MenuIcons.next-optical-logic;
                                for kind in AddKinds.logic: MenuItem { title: kind.title; icon: kind.icon; activated => { root.run("add:" + kind.id); } }
                            }
                        }
                        Menu {
                            title: @tr("Add probe");
                            icon: MenuIcons.add;
                            MenuItem { title: @tr("Standard probe"); icon: MenuIcons.next-probe; activated => { root.run("add:probe:standard"); } }
                            Menu {
                                title: @tr("Probabilistic");
                                icon: MenuIcons.next-counting-detector;
                                for kind in AddKinds.detectors: MenuItem { title: kind.title; icon: kind.icon; activated => { root.run("add:" + kind.id); } }
                            }
                        }
                        MenuSeparator { }
                        MenuItem { title: @tr("Add to or remove from selection"); icon: MenuIcons.checklist; enabled: root.can-toggle; activated => { root.run("toggle-selected"); } }
                        MenuItem { title: @tr("Select all"); icon: MenuIcons.select-all; enabled: root.can-select-all; activated => { root.run("select-all"); } }
                        MenuSeparator { }
                        MenuItem { title: @tr("Enabled"); icon: MenuIcons.check-box; enabled: root.can-toggle; activated => { root.run("toggle-enabled"); } }
                        MenuItem { title: @tr("Duplicate"); icon: MenuIcons.control-point-duplicate; enabled: root.can-remove; activated => { root.run("duplicate"); } }
                        MenuItem { title: @tr("Cut"); icon: MenuIcons.content-cut; enabled: root.can-remove; activated => { root.run("cut"); } }
                        MenuItem { title: @tr("Copy"); icon: MenuIcons.content-copy; enabled: root.can-copy; activated => { root.run("copy"); } }
                        MenuItem { title: @tr("Paste"); icon: MenuIcons.content-paste; enabled: true; activated => { root.run("paste"); } }
                        MenuItem { title: @tr("Remove"); icon: MenuIcons.delete; enabled: root.can-remove; activated => { root.run("delete"); } }
                        MenuSeparator { }
                        MenuItem { title: @tr("Move up"); icon: MenuIcons.arrow-upward; enabled: root.can-move-up; activated => { root.run("move-up"); } }
                        MenuItem { title: @tr("Move down"); icon: MenuIcons.arrow-downward; enabled: root.can-move-down; activated => { root.run("move-down"); } }
                    }
                }
            }
            list := ListView {
                for row[i] in root.rows: Rectangle {
                    height: Theme.row-height;
                    background: row.selected ? (root.focused ? Theme.selection : Theme.inactive-selection) : area.has-hover ? Theme.row-hover : transparent;
                    area := TouchArea {
                        // the press's modifiers: `clicked` carries none
                        property <int> pick;
                        pointer-event(e) => {
                            if (e.kind == PointerEventKind.down) {
                                self.pick = e.modifiers.control ? 1 : e.modifiers.shift ? 2 : 0;
                                if (e.button == PointerEventButton.right) {
                                    tree-keys.focus();
                                    root.select(i, row.selected ? 3 : 0);
                                    rows-menu.show({
                                        x: self.absolute-position.x + self.mouse-x - menu-anchor.absolute-position.x,
                                        y: self.absolute-position.y + self.mouse-y - menu-anchor.absolute-position.y,
                                    });
                                }
                            }
                        }
                        clicked => {
                            tree-keys.focus();
                            root.select(i, self.pick);
                        }
                    }
                    HorizontalLayout {
                        padding-left: 4px + row.depth * 16px;
                        padding-right: 4px;
                        spacing: 4px;
                        // the expander column (Next's TreeView chevron); all rows expanded at first
                        Rectangle {
                            width: 10px;
                            if row.expandable: Icon {
                                source: row.expanded ? @image-url("icons/next/chevron-down.svg") : @image-url("icons/next/chevron-right.svg");
                                ink: row.selected && root.focused ? Theme.selection-text : Theme.text;
                            }
                            if row.expandable: TouchArea {
                                clicked => { root.expand(i); }
                            }
                        }
                        if row.checkable: Rectangle {
                            width: 13px;
                            height: 13px;
                            y: (parent.height - self.height) / 2;
                            border-width: 1px;
                            border-color: Theme.check-border;
                            background: Theme.input-background;
                            if row.checked: Icon {
                                source: @image-url("icons/next/check.svg");
                            }
                            TouchArea {
                                clicked => { root.toggle(i); }
                            }
                            Tooltip {
                                text: @markdown("\{row.kind == TreeKind.source ? @tr("Include the source in runs (Space on the row toggles it)") : row.kind == TreeKind.part ? @tr("Paint the part into the scene (Space on the row toggles it)") : @tr("Sample this probe (Space on the row toggles it)")}");
                            }
                        }
                        // a colour scheme's gradient (Next's 36 x 10 strip)
                        if row.kind == TreeKind.scheme: Rectangle {
                            width: 36px;
                            height: 10px;
                            y: (parent.height - self.height) / 2;
                            Image { source: row.strip; width: parent.width; height: parent.height; image-fit: fill; }
                            // Next's 0.5 px stroke, over the gradient
                            Rectangle { border-width: 0.5px; border-color: Theme.border; }
                        }
                        if row.kind != TreeKind.scheme: Icon {
                            source: row.icon;
                            ink: row.selected && root.focused ? Theme.selection-text : row.checked ? Theme.text : Theme.text-disabled;
                        }
                        Text {
                            text: row.label;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                            color: row.selected && root.focused ? Theme.selection-text : row.checked ? Theme.text : Theme.text-disabled;
                        }
                        if row.add != "": IconButton {
                            size: 18px;
                            focusable: false;
                            y: (parent.height - self.height) / 2;
                            icon: @image-url("icons/next/tree-plus.svg");
                            tip: @tr("Add an item to this folder");
                            clicked => {
                                if (row.add == "part") { kinds.open(); } else if (row.add == "probe") { probe-kinds.open(); } else { root.run("add:" + row.add); }
                            }
                            kinds := PartMenu { enabled: row.add == "part"; add(id) => { root.run("add:" + id); } }
                            probe-kinds := ProbeMenu { enabled: row.add == "probe"; add(id) => { root.run("add:" + id); } }
                        }
                        if row.depth == 2: HorizontalLayout {
                            spacing: 0px;
                            IconButton { size: 18px; focusable: false; y: (parent.height - self.height) / 2; icon: @image-url("icons/next/tree-chevron-up.svg"); tip: @tr("Move up (Alt+Up); drag to reorder"); clicked => { root.shift(i, -1); } }
                            IconButton { size: 18px; focusable: false; y: (parent.height - self.height) / 2; icon: @image-url("icons/next/tree-chevron-down.svg"); tip: @tr("Move down (Alt+Down); drag to reorder"); clicked => { root.shift(i, 1); } }
                            IconButton { size: 18px; focusable: false; y: (parent.height - self.height) / 2; icon: @image-url("icons/next/tree-minus.svg"); tip: @tr("Remove (Del)"); clicked => { root.remove(i); } }
                        }
                    }
                }
            }
        }
    }
}
