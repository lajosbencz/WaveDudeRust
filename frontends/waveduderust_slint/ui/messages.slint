import { ListView, LineEdit, Button } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { MenuIcons } from "menu-icons.slint";

export enum LogLevel { trace, debug, info, warn, error }

export struct LogRow {
    time: string,
    level: LogLevel,
    source: string,
    // the logger's full name
    logger: string,
    message: string,
    selected: bool,
}

export struct LevelToggle {
    level: LogLevel,
    label: string,
    shown: bool,
}

// A toolbar toggle: pressed while `on`.
component Toggle inherits Rectangle {
    in property <string> text;
    in property <color> ink: Theme.text;
    in property <bool> on;
    in property <string> tip;
    callback toggled();
    width: label.preferred-width + 10px;
    background: root.on ? Theme.button-background : area.has-hover ? Theme.button-hover : transparent;
    border-width: 1px;
    border-color: Theme.border;
    label := Text {
        text: root.text;
        color: root.ink;
        opacity: root.on ? 1 : 0.5;
    }
    area := TouchArea {
        clicked => { root.toggled(); }
    }
    Tooltip { text: @markdown("\{root.tip}"); }
}

// The Messages pane (docs/ui/70, Messages pane): level toggles with counts, search, Regex, Auto-scroll, Clear,
// the log lines with Copy, Copy all and Clear.
export component Messages inherits Rectangle {
    in property <[LogRow]> rows;
    in property <[LevelToggle]> levels;
    // moves with each line added
    in property <int> added;
    callback toggle(LogLevel);
    callback search(string);
    callback regex(bool);
    callback clear();
    // row `row` pressed with Control or Shift held
    callback select(row: int, control: bool, shift: bool);
    // the selected lines (`all`: every visible line) to the clipboard; false with none
    callback copy(all: bool) -> bool;

    property <bool> regex-on;
    property <bool> follow: true;
    property <length> row-height: 18px;

    pure function colour(level: LogLevel) -> color {
        if level == LogLevel.trace { return Theme.level-trace; }
        if level == LogLevel.debug { return Theme.level-debug; }
        if level == LogLevel.warn { return Theme.level-warn; }
        if level == LogLevel.error { return Theme.level-error; }
        Theme.level-info
    }
    pure function level-name(level: LogLevel) -> string {
        level == LogLevel.trace ? "TRACE" : level == LogLevel.debug ? "DEBUG" : level == LogLevel.warn ? "WARN"
            : level == LogLevel.error ? "ERROR" : "INFO"
    }
    function newest() {
        list.content-y = min(0px, list.visible-height - root.rows.length * root.row-height);
    }
    changed added => {
        if (root.follow) { root.newest(); }
    }
    // opens on the newest line, the list focused
    init => {
        root.newest();
        keys.focus();
    }

    background: Theme.tool-window-background;
    VerticalLayout {
        HorizontalLayout {
            padding: 2px;
            spacing: 4px;
            height: Theme.row-height + 4px;
            for l in root.levels: Toggle {
                text: l.label;
                ink: root.colour(l.level);
                on: l.shown;
                tip: @tr("Show or hide this level");
                toggled => { root.toggle(l.level); }
            }
            LineEdit {
                placeholder-text: @tr("Search");
                edited(t) => { root.search(t); }
            }
            Toggle {
                text: @tr("Regex");
                on: root.regex-on;
                tip: @tr("Treat the search text as a regular expression");
                toggled => {
                    root.regex-on = !root.regex-on;
                    root.regex(root.regex-on);
                }
            }
            Toggle {
                text: @tr("Auto-scroll");
                on: root.follow;
                tip: @tr("Follow new messages");
                toggled => {
                    root.follow = !root.follow;
                    if (root.follow) { root.newest(); }
                }
            }
            Button {
                text: @tr("Clear");
                icon: MenuIcons.clear-all;
                colorize-icon: true;
                clicked => { root.clear(); }
                Tooltip { text: @markdown("\{@tr("Clear all messages")}"); }
            }
        }
        // the column headers
        HorizontalLayout {
            spacing: 8px;
            padding-left: 4px;
            height: root.row-height;
            Text { text: @tr("Time"); width: 80px; color: Theme.text-dim; }
            Text { text: @tr("Level"); width: 40px; color: Theme.text-dim; }
            Text { text: @tr("Source"); width: 96px; color: Theme.text-dim; }
            Text { text: @tr("Message"); color: Theme.text-dim; horizontal-stretch: 1; }
        }
        keys := FocusScope {
            key-pressed(e) => {
                // with no line selected the app copies its items
                if (e.modifiers.control && (e.text == "c" || e.text == "C")) {
                    return root.copy(false) ? accept : reject;
                }
                reject
            }
            ContextMenuArea {
                Menu {
                    MenuItem { title: @tr("Copy"); icon: MenuIcons.content-copy; activated => { root.copy(false); } }
                    MenuItem { title: @tr("Copy all"); icon: MenuIcons.select-all; activated => { root.copy(true); } }
                    MenuSeparator { }
                    MenuItem { title: @tr("Clear"); icon: MenuIcons.clear-all; activated => { root.clear(); } }
                }
                list := ListView {
                    for row[i] in root.rows: line := Rectangle {
                        height: root.row-height;
                        background: row.selected ? (keys.has-focus ? Theme.accent : Theme.button-background) : transparent;
                        property <color> ink: row.selected && keys.has-focus ? Theme.selection-text : root.colour(row.level);
                        HorizontalLayout {
                            spacing: 8px;
                            padding-left: 4px;
                            Text { text: row.time; width: 80px; color: line.ink; }
                            Text { text: root.level-name(row.level); width: 40px; color: line.ink; }
                            Rectangle {
                                width: 96px;
                                Text { width: 100%; text: row.source; overflow: elide; color: line.ink; }
                                Tooltip { text: @markdown("\{row.logger}"); }
                            }
                            Text { text: row.message; overflow: elide; color: line.ink; horizontal-stretch: 1; }
                        }
                        TouchArea {
                            pointer-event(e) => {
                                if (e.kind == PointerEventKind.down && (e.button == PointerEventButton.left || !row.selected)) {
                                    keys.focus();
                                    root.select(i, e.modifiers.control, e.modifiers.shift);
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
