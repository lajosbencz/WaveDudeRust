import { ListView, LineEdit, Button } from "std-widgets.slint";
import { Theme } from "theme.slint";

export enum LogLevel { trace, debug, info, warn, error }

export struct LogRow {
    time: string,
    level: LogLevel,
    source: string,
    message: string,
}

export struct LevelToggle {
    level: LogLevel,
    label: string,
    shown: bool,
}

// The Messages pane (docs/ui/70, Messages pane): level toggles with counts, search, clear, the log lines.
export component Messages inherits Rectangle {
    in property <[LogRow]> rows;
    in property <[LevelToggle]> levels;
    callback toggle(LogLevel);
    callback search(string);
    callback clear();

    pure function colour(level: LogLevel) -> color {
        if level == LogLevel.trace { return Theme.level-trace; }
        if level == LogLevel.debug { return Theme.level-debug; }
        if level == LogLevel.warn { return Theme.level-warn; }
        if level == LogLevel.error { return Theme.level-error; }
        Theme.level-info
    }

    background: Theme.tool-window-background;
    VerticalLayout {
        HorizontalLayout {
            padding: 2px;
            spacing: 4px;
            height: Theme.row-height + 4px;
            for l in root.levels: Rectangle {
                width: label.preferred-width + 10px;
                background: l.shown ? Theme.button-background : transparent;
                border-width: 1px;
                border-color: Theme.border;
                label := Text {
                    text: l.label;
                    color: root.colour(l.level);
                    opacity: l.shown ? 1 : 0.5;
                }
                TouchArea {
                    clicked => { root.toggle(l.level); }
                }
            }
            LineEdit {
                placeholder-text: @tr("Search");
                edited(t) => { root.search(t); }
            }
            Button {
                text: @tr("Clear");
                clicked => { root.clear(); }
            }
        }
        ListView {
            for row in root.rows: HorizontalLayout {
                spacing: 8px;
                padding-left: 4px;
                height: 18px;
                Text { text: row.time; width: 56px; color: root.colour(row.level); }
                Text { text: row.source; width: 96px; overflow: elide; color: root.colour(row.level); }
                Text { text: row.message; overflow: elide; color: root.colour(row.level); horizontal-stretch: 1; }
            }
        }
    }
}
