// The model's words and the forms' data as Slint types; src/form.rs converts them to and from the model.

export enum SceneMode { canvas, image }
export enum Edges { open, reflective }
export enum Stencil { nine-point, fourth-order }
export enum SourceMode { continuous, pulsed }
export enum PulseShape { gaussian, smoothed-square }
export enum Layer { field, intensity }
export enum Measurement { amplitude, value, integrated-value }
export enum ProbeKind { point, line }
export enum ProbeDetector { standard, counting, imaging }
export enum BoxSize { tiny, small, medium, large, extra-large, custom }
export enum ScaleMode { running, full }
export enum YScale { linear, logarithmic }
export enum CoatingProfile { layer, graded }
export enum TriangleType { equilateral, right-isosceles, thirty-sixty-ninety, isosceles, custom }
export enum ZoneDivision { equal-width, equal-depth }
export enum FacetPattern { sawtooth, square-wave, sinusoidal }
export enum FiberEnds { flat, round }
export enum SchemeKind { unspecified, field, intensity }
export enum MetaLensType { converging, diverging }
export enum GateKind { xor, and, or }

// Which form Properties shows; `none` for the generic rows.
export enum FormKind { none, project, scene, simulation, display, source, probe, rectangle, ellipse, triangle, polygon, lens, fresnel-lens, outline, diffuser, zone-plate, bragg-reflector, grin-lens, simple-grating, facetted-grating, meta-lens, meta-prism, meta-axicon, logic-gate, interference-filter, fiber, scheme }

export struct ProjectData {
    seed: int,
    description: string,
    version: int,
}

export struct SceneData {
    mode: SceneMode,
    image: string,
    image-path: string,
    // the embedded image: present, readable, its size in pixels and kilobytes
    embedded: bool,
    readable: bool,
    image-width: int,
    image-height: int,
    image-kb: int,
    width: int,
    height: int,
    damping-edge: int,
    edges: Edges,
    refractive-index: float,
    image-sources: bool,
    image-source-scale: float,
    object-sources: bool,
}

export struct SimulationData {
    steps: int,
    visualize-every: int,
    stencil: Stencil,
    wave-speed: float,
    time-decay: float,
    source-frequency-scale: float,
    intensity-scale: float,
}

export struct LayerData {
    color-scheme: string,
    brightness: float,
    black-level: float,
    preview: bool,
    overlay: bool,
    overlay-gain: float,
    overlay-in-export: bool,
}

export struct VideoData {
    fps: int,
    quality: int,
}

export struct DisplayData {
    export-from: int,
    export-to: int,
    probe-graphs-in-export: bool,
    probe-markers-in-export: bool,
    source-markers-in-export: bool,
    handles-in-preview: bool,
    labels-in-preview: bool,
}

export struct SourceData {
    name: string,
    enabled: bool,
    x: float,
    y: float,
    frequency: float,
    amplitude: float,
    phase: float,
    mode: SourceMode,
    pulse-shape: PulseShape,
    pulse-width: int,
    off-width: int,
    // below 0: never detached
    detach-after: int,
    // an array of emitters instead of one
    composite: bool,
    // the wavelength in pixels the frequency gives, when finite; nominal on the 9-point stencil
    wavelength: float,
    wavelength-known: bool,
    nine-point: bool,
}

export struct ArrayData {
    size-x: int,
    size-y: int,
    spacing-x: int,
    spacing-y: int,
    angle: float,
    random-frequency: int,
    random-phase: int,
    random-off-width: int,
    random-position: int,
}

export struct ProbeData {
    name: string,
    active: bool,
    start-after: int,
    detector: ProbeDetector,
    sensitivity: float,
    bin-size: int,
    layer: Layer,
    measurement: Measurement,
    kind: ProbeKind,
    ax: int,
    ay: int,
    bx: int,
    by: int,
    box-size: BoxSize,
    box-x: int,
    box-y: int,
    box-width: int,
    box-height: int,
    scale-mode: ScaleMode,
    window: int,
    auto-scale-x: bool,
    auto-scale-y: bool,
    y-scale: YScale,
    decades: int,
    y-min: float,
    y-max: float,
    // read-out: a line plotted along its length rather than over the steps
    shows-profile: bool,
}

export struct PartData {
    name: string,
    enabled: bool,
    x: int,
    y: int,
    angle: float,
}

export struct MaterialData {
    mirror: bool,
    refractive-index: float,
    absorption: int,
    absorption-ramp: int,
}

export struct CoatingData {
    depth: float,
    profile: CoatingProfile,
    front: bool,
    back: bool,
    sides: bool,
}

// A rectangle's or ellipse's sides.
export struct SidesData {
    length: int,
    width: int,
    linked: bool,
}

export struct TriangleData {
    base: int,
    kind: TriangleType,
    angle-a: float,
    angle-b: float,
    // read-out: 180 degrees less the base angles the type gives
    apex: float,
}

export struct PolygonData {
    sides: int,
    side: int,
}

export struct LensData {
    diameter: int,
    r1: float,
    r2: float,
    thickness: int,
    // diverging; ticking it flips both radii
    concave: bool,
    // read-out: the thickness at the rim, the radii fitted
    edge: float,
}

export struct FresnelData {
    zones: int,
    division: ZoneDivision,
}

export struct DiffuserData {
    length: int,
    width: int,
    center-wavelength: float,
    amplitude: float,
    sigma: float,
    // read-outs: the rough face's peak to valley in pixels, the number of ripples
    profile-height: float,
    ripples: int,
}

export struct ZonePlateData {
    mount: bool,
    mount-width: int,
    diameter: int,
    thickness: int,
    coating: int,
    design-frequency: float,
    focal-length: int,
    inverse: bool,
    // read-outs, 0 without a wavelength: the design frequency's wavelength in pixels, the zones within the diameter,
    // the outermost whole zone's width
    wavelength: float,
    zones: int,
    outer-zone: float,
}

export struct BraggData {
    pairs: int,
    thickness1: int,
    index1: float,
    thickness2: int,
    index2: float,
    width: int,
}

export struct GrinData {
    centre-index: float,
    edge-index: float,
    length: int,
    diameter: int,
}

export struct GratingData {
    columns: int,
    rows: int,
    column-spacing: int,
    row-spacing: int,
    diameter: int,
    // read-out: the dot diameter's bound, half the smaller spacing
    max-diameter: int,
}

export struct FacetData {
    length: int,
    width: int,
    pattern: FacetPattern,
    pitch: float,
    amplitude: float,
}

// A meta surface's plate and pattern, then its design's fields: a lens's, a prism's or an axicon's.
export struct MetaData {
    length: int,
    width: int,
    design-frequency: float,
    pattern-index: float,
    pitch: float,
    height: float,
    focal-length: int,
    lens-type: MetaLensType,
    deflection: float,
    cone-angle: float,
    // read-outs in pixels, 0 without a wavelength or for another design
    wavelength: float,
    full-turn-height: float,
    zone-width: float,
    line-length: float,
    zones: int,
}

export struct SchemeData {
    name: string,
    kind: SchemeKind,
    description: string,
}

// A stop and its colour as #RRGGBB, which an edit of either follows.
export struct StopData {
    at: float,
    color: color,
    hex: string,
}

// A scheme to pick: its name and its gradient as a strip.
// a scheme picker's row: a scheme (the project's own tagged), a name no scheme has, or an action
export enum SchemeEntry { scheme, project, missing, load, edit-copy, remove-mine }

export struct SchemeChoice {
    name: string,
    strip: image,
    entry: SchemeEntry,
}

export struct FiberData {
    core-index: float,
    core-diameter: int,
    cladding-index: float,
    cladding-thickness: int,
    absorption: int,
    absorption-ramp: int,
    ends: FiberEnds,
}

// A path node and its handles, offsets from it.
export struct FiberNodeData {
    x: int,
    y: int,
    in-x: int,
    in-y: int,
    out-x: int,
    out-y: int,
    smooth: bool,
}

// The stack thickness in pixels to 0.1, a read-out.
export struct FilterData {
    length: int,
    width: int,
    stack-thickness: float,
}

export struct FilterLayerData {
    thickness: float,
    refractive-index: float,
}

export struct PointData {
    x: int,
    y: int,
}

// A logic gate's inputs, then the layout its design gives; `designed` false when the design frequency gives none.
export struct GateData {
    kind: GateKind,
    design-frequency: float,
    core-index: float,
    cladding-index: float,
    coating: float,
    input-coated: bool,
    output-coated: bool,
    // the spacing the design uses
    port-spacing: int,
    upper-output-active: bool,
    lower-output-active: bool,
    // read-outs in pixels; the wavelength 0 for none
    wavelength: float,
    designed: bool,
    quarter-wave: float,
    core-width: int,
    gap: int,
    coupler-length: int,
    length: int,
    // the ports in canvas pixels
    input-a: PointData,
    input-b: PointData,
    upper-out: PointData,
    lower-out: PointData,
}
