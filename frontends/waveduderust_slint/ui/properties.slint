import { ScrollView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { Form } from "form.slint";
import { FormKind } from "data.slint";
import { ProjectForm, SceneForm, SimulationForm, DisplayForm, SourceForm, ProbeForm, RectangleForm, EllipseForm, TriangleForm, PolygonForm, LensForm, FresnelLensForm, OutlineForm, DiffuserForm, ZonePlateForm, BraggReflectorForm, GrinLensForm, SimpleGratingForm, FacettedGratingForm, MetaSurfaceForm, LogicGateForm, InterferenceFilterForm, FiberForm, SchemeForm } from "forms.slint";

// The properties pane (docs/ui/30): the selected object's form.
export component Properties inherits Rectangle {
    in property <string> heading;
    // a folder's item count (Next's CollectionView); -1 for an object
    in property <int> entries: -1;

    background: Theme.tool-window-background;
    scroll := ScrollView {
        content-width: self.visible-width;
        content-height: content.preferred-height;
        content := VerticalLayout {
            width: scroll.visible-width;
            padding: Form.kind != FormKind.none ? 8px : 6px;
            spacing: 2px;
            alignment: start;
            if Form.kind == FormKind.project: ProjectForm { }
            if Form.kind == FormKind.scene: SceneForm { }
            if Form.kind == FormKind.simulation: SimulationForm { }
            if Form.kind == FormKind.display: DisplayForm { }
            if Form.kind == FormKind.source: SourceForm { }
            if Form.kind == FormKind.probe: ProbeForm { }
            if Form.kind == FormKind.rectangle: RectangleForm { }
            if Form.kind == FormKind.ellipse: EllipseForm { }
            if Form.kind == FormKind.triangle: TriangleForm { }
            if Form.kind == FormKind.polygon: PolygonForm { }
            if Form.kind == FormKind.lens: LensForm { }
            if Form.kind == FormKind.fresnel-lens: FresnelLensForm { }
            if Form.kind == FormKind.outline: OutlineForm { }
            if Form.kind == FormKind.diffuser: DiffuserForm { }
            if Form.kind == FormKind.zone-plate: ZonePlateForm { }
            if Form.kind == FormKind.bragg-reflector: BraggReflectorForm { }
            if Form.kind == FormKind.grin-lens: GrinLensForm { }
            if Form.kind == FormKind.simple-grating: SimpleGratingForm { }
            if Form.kind == FormKind.facetted-grating: FacettedGratingForm { }
            if Form.kind == FormKind.interference-filter: InterferenceFilterForm { }
            if Form.kind == FormKind.fiber: FiberForm { }
            if Form.kind == FormKind.scheme: SchemeForm { }
            if Form.kind == FormKind.logic-gate: LogicGateForm { }
            if Form.kind == FormKind.meta-lens || Form.kind == FormKind.meta-prism || Form.kind == FormKind.meta-axicon: MetaSurfaceForm { }
            if Form.kind == FormKind.none: Text {
                text: root.heading;
                font-weight: 700;
                color: Theme.text;
            }
            if root.entries >= 0: Text {
                text: root.entries == 0 ? @tr("No entries") : root.entries == 1 ? @tr("1 entry") : @tr("{} entries", root.entries);
                color: Theme.text;
            }
            if Form.invalid != "": Text {
                text: @tr("Not a number: {}", Form.invalid);
                color: Theme.status-error;
                wrap: word-wrap;
            }
        }
    }
}
