import { LineEdit, CheckBox, ComboBox, ScrollView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { NumberBox, NumberSpec } from "number-box.slint";
import { ProjectForm, SceneForm, SimulationForm, DisplayForm, SourceForm, ProbeForm, RectangleForm, EllipseForm, TriangleForm, PolygonForm } from "forms.slint";

export enum PropKind { text, int, float, bool, choice }

export struct PropRow {
    label: string,
    kind: PropKind,
    value: string,
    choices: [string],
    current: int,
    spec: NumberSpec,
    // The shown form's token (src/main.rs, sync), handed back with an edit: a commit when an editor loses the
    // focus may come after its form was replaced.
    form: int,
}

// The properties pane (docs/ui/30): one labelled editor per field of the selected object.
export component Properties inherits Rectangle {
    // the shown object's form (ui/forms.slint), "" for the rows below
    in property <string> form;
    // a form's button: "new-seed"
    callback action(id: string);
    in property <string> heading;
    // a folder's item count (Next's CollectionView); -1 for an object
    in property <int> entries: -1;
    in property <[PropRow]> rows;
    in property <string> error;
    // Sets row `row` of form `form`; whether the field took the text.
    callback set(form: int, row: int, text: string) -> bool;
    // The text typed into row `row` of form `form`, not yet committed.
    callback typed(form: int, row: int, text: string);

    background: Theme.tool-window-background;
    scroll := ScrollView {
        content-width: self.visible-width;
        content-height: content.preferred-height;
        content := VerticalLayout {
            width: scroll.visible-width;
            padding: root.form != "" ? 8px : 6px;
            spacing: 2px;
            alignment: start;
            if root.form == "project": ProjectForm { new-seed => { root.action("new-seed"); } }
            if root.form == "scene": SceneForm { }
            if root.form == "simulation": SimulationForm { }
            if root.form == "display": DisplayForm { }
            if root.form == "source": SourceForm { }
            if root.form == "probe": ProbeForm { }
            if root.form == "rectangle": RectangleForm { }
            if root.form == "ellipse": EllipseForm { }
            if root.form == "triangle": TriangleForm { }
            if root.form == "polygon": PolygonForm { }
            if root.form == "": Text {
                text: root.heading;
                font-weight: 700;
                color: Theme.text;
            }
            if root.entries >= 0: Text {
                text: root.entries == 0 ? @tr("No entries") : root.entries == 1 ? @tr("1 entry") : @tr("{} entries", root.entries);
                color: Theme.text;
            }
            for row[i] in root.rows: HorizontalLayout {
                spacing: 6px;
                min-height: Theme.row-height;
                Text {
                    text: row.label;
                    width: min(120px, scroll.visible-width * 40%);
                    vertical-alignment: center;
                    overflow: elide;
                    color: Theme.text;
                }
                if row.kind == PropKind.bool: CheckBox {
                    checked: row.value == "true";
                    toggled => { root.set(row.form, i, self.checked ? "true" : "false"); }
                }
                if row.kind == PropKind.choice: ComboBox {
                    min-width: 40px;
                    horizontal-stretch: 1;
                    model: row.choices;
                    current-index: row.current;
                    selected(v) => { root.set(row.form, i, v); }
                }
                if row.kind == PropKind.int || row.kind == PropKind.float: NumberBox {
                    value: row.value;
                    spec: row.spec;
                    edited(t) => { return root.set(row.form, i, t); }
                    typed(t) => { root.typed(row.form, i, t); }
                }
                if row.kind == PropKind.text: LineEdit {
                    min-width: 40px;
                    horizontal-stretch: 1;
                    text: row.value;
                    // typing breaks the binding above
                    property <string> value: row.value;
                    changed value => { self.text = self.value; }
                    accepted(t) => { root.set(row.form, i, t); }
                    edited(t) => { root.typed(row.form, i, t); }
                    changed has-focus => {
                        if (!self.has-focus && self.text != row.value) {
                            root.set(row.form, i, self.text);
                        }
                    }
                }
            }
            if root.error != "": Text {
                text: root.error;
                color: Theme.status-error;
                wrap: word-wrap;
            }
        }
    }
}
