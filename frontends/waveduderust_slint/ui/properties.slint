import { LineEdit, CheckBox, ComboBox, ScrollView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { NumberBox, NumberSpec } from "number-box.slint";
import { Form } from "form.slint";
import { FormKind } from "data.slint";
import { ProjectForm, SceneForm, SimulationForm, DisplayForm, SourceForm, ProbeForm, RectangleForm, EllipseForm, TriangleForm, PolygonForm, LensForm, FresnelLensForm, OutlineForm, DiffuserForm, ZonePlateForm, BraggReflectorForm, GrinLensForm, SimpleGratingForm, FacettedGratingForm, MetaSurfaceForm, LogicGateForm, InterferenceFilterForm, FiberForm } from "forms.slint";

export enum PropKind { text, int, float, bool, choice }

export struct PropRow {
    label: string,
    kind: PropKind,
    value: string,
    choices: [string],
    current: int,
    spec: NumberSpec,
    // The shown form's token (src/main.rs, sync), handed back with an edit: a commit when an editor loses the
    // focus may come after its form was replaced.
    form: int,
}

// The properties pane (docs/ui/30): one labelled editor per field of the selected object.
export component Properties inherits Rectangle {
    in property <string> heading;
    // a folder's item count (Next's CollectionView); -1 for an object
    in property <int> entries: -1;
    in property <[PropRow]> rows;
    in property <string> error;
    // Sets row `row` of form `form`; whether the field took the text.
    callback set(form: int, row: int, text: string) -> bool;
    // The text typed into row `row` of form `form`, not yet committed.
    callback typed(form: int, row: int, text: string);

    background: Theme.tool-window-background;
    scroll := ScrollView {
        content-width: self.visible-width;
        content-height: content.preferred-height;
        content := VerticalLayout {
            width: scroll.visible-width;
            padding: Form.kind != FormKind.none ? 8px : 6px;
            spacing: 2px;
            alignment: start;
            if Form.kind == FormKind.project: ProjectForm { }
            if Form.kind == FormKind.scene: SceneForm { }
            if Form.kind == FormKind.simulation: SimulationForm { }
            if Form.kind == FormKind.display: DisplayForm { }
            if Form.kind == FormKind.source: SourceForm { }
            if Form.kind == FormKind.probe: ProbeForm { }
            if Form.kind == FormKind.rectangle: RectangleForm { }
            if Form.kind == FormKind.ellipse: EllipseForm { }
            if Form.kind == FormKind.triangle: TriangleForm { }
            if Form.kind == FormKind.polygon: PolygonForm { }
            if Form.kind == FormKind.lens: LensForm { }
            if Form.kind == FormKind.fresnel-lens: FresnelLensForm { }
            if Form.kind == FormKind.outline: OutlineForm { }
            if Form.kind == FormKind.diffuser: DiffuserForm { }
            if Form.kind == FormKind.zone-plate: ZonePlateForm { }
            if Form.kind == FormKind.bragg-reflector: BraggReflectorForm { }
            if Form.kind == FormKind.grin-lens: GrinLensForm { }
            if Form.kind == FormKind.simple-grating: SimpleGratingForm { }
            if Form.kind == FormKind.facetted-grating: FacettedGratingForm { }
            if Form.kind == FormKind.interference-filter: InterferenceFilterForm { }
            if Form.kind == FormKind.fiber: FiberForm { }
            if Form.kind == FormKind.logic-gate: LogicGateForm { }
            if Form.kind == FormKind.meta-lens || Form.kind == FormKind.meta-prism || Form.kind == FormKind.meta-axicon: MetaSurfaceForm { }
            if Form.kind == FormKind.none: Text {
                text: root.heading;
                font-weight: 700;
                color: Theme.text;
            }
            if root.entries >= 0: Text {
                text: root.entries == 0 ? @tr("No entries") : root.entries == 1 ? @tr("1 entry") : @tr("{} entries", root.entries);
                color: Theme.text;
            }
            for row[i] in root.rows: HorizontalLayout {
                spacing: 6px;
                min-height: Theme.row-height;
                Text {
                    text: row.label;
                    width: min(120px, scroll.visible-width * 40%);
                    vertical-alignment: center;
                    overflow: elide;
                    color: Theme.text;
                }
                if row.kind == PropKind.bool: CheckBox {
                    checked: row.value == "true";
                    toggled => { root.set(row.form, i, self.checked ? "true" : "false"); }
                }
                if row.kind == PropKind.choice: ComboBox {
                    min-width: 40px;
                    horizontal-stretch: 1;
                    model: row.choices;
                    current-index: row.current;
                    selected(v) => { root.set(row.form, i, v); }
                }
                if row.kind == PropKind.int || row.kind == PropKind.float: NumberBox {
                    value: row.value;
                    spec: row.spec;
                    token: row.form;
                    edited(t) => { return root.set(row.form, i, t); }
                    typed(t) => { root.typed(row.form, i, t); }
                }
                if row.kind == PropKind.text: LineEdit {
                    min-width: 40px;
                    horizontal-stretch: 1;
                    text: row.value;
                    // typing breaks the binding above
                    property <string> value: row.value;
                    changed value => { self.text = self.value; }
                    accepted(t) => { root.set(row.form, i, t); }
                    edited(t) => { root.typed(row.form, i, t); }
                    changed has-focus => {
                        if (!self.has-focus && self.text != row.value) {
                            root.set(row.form, i, self.text);
                        }
                    }
                }
            }
            if Form.invalid != "": Text {
                text: @tr("Not a number: {}", Form.invalid);
                color: Theme.status-error;
                wrap: word-wrap;
            }
            if root.error != "": Text {
                text: root.error;
                color: Theme.status-error;
                wrap: word-wrap;
            }
        }
    }
}
