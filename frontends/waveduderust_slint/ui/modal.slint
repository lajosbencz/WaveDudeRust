import { Button } from "std-widgets.slint";
import { Theme } from "theme.slint";

// The messages the app shows; `none` while none is.
export enum Message { none, save-changes, discard-frames, about, open-failed, save-failed, export-failed }

// A message and the one value its text names: a file's name or path, or the version.
export struct Modal {
    message: Message,
    arg: string,
}

export enum Answer { ok, save, discard, cancel, yes, no }

// One of a message's buttons.
struct Choice {
    text: string,
    answer: Answer,
}

// The app's own message window (docs/ui/70, Message window), modal over the main window.
export component ModalLayer inherits Rectangle {
    in property <Modal> modal;
    callback answer(Answer);

    // a destructive question: No is the default
    property <bool> confirms: modal.message == Message.discard-frames;
    property <bool> asks: modal.message == Message.save-changes || root.confirms;
    property <bool> fails: modal.message == Message.open-failed || modal.message == Message.save-failed || modal.message == Message.export-failed;
    property <[Choice]> choices: root.confirms ? [{ text: @tr("Yes"), answer: Answer.yes }, { text: @tr("No"), answer: Answer.no }]
        : root.asks ? [{ text: @tr("Save"), answer: Answer.save }, { text: @tr("Don't save"), answer: Answer.discard }, { text: @tr("Cancel"), answer: Answer.cancel }]
        : [{ text: modal.message == Message.about ? @tr("Close") : @tr("OK"), answer: Answer.ok }];

    visible: modal.message != Message.none;
    background: #00000080;
    TouchArea { }
    focus := FocusScope {
        key-pressed(e) => {
            if (e.text == Key.Escape) { root.answer(root.confirms ? Answer.no : root.asks ? Answer.cancel : Answer.ok); return accept; }
            if (e.text == Key.Return) { root.answer(root.choices[root.confirms ? 1 : 0].answer); return accept; }
            reject
        }
    }
    changed visible => { if (self.visible) { focus.focus(); } }
    Rectangle {
        width: 440px;
        height: box.preferred-height;
        background: Theme.window-background;
        border-width: 1px;
        border-color: Theme.accent;
        box := VerticalLayout {
            padding: 12px;
            spacing: 12px;
            Text {
                text: modal.message == Message.about ? @tr("About WaveDude Rust") : "WaveDude Rust";
                font-weight: 700;
                color: Theme.text;
            }
            HorizontalLayout {
                spacing: 12px;
                if root.asks || root.fails: Rectangle {
                    width: 32px;
                    height: 32px;
                    border-radius: 16px;
                    background: root.fails ? Theme.status-error : Theme.accent;
                    Text {
                        text: root.fails ? "!" : "?";
                        color: #ffffff;
                        font-weight: 700;
                    }
                }
                Text {
                    text: modal.message == Message.save-changes ? @tr("Save the changes to {}?", modal.arg)
                        : modal.message == Message.discard-frames ? @tr("Discard the frames of the run?")
                        : modal.message == Message.open-failed ? @tr("Could not open '{}'.", modal.arg)
                        : modal.message == Message.save-failed ? @tr("Could not save '{}'.", modal.arg)
                        : modal.message == Message.export-failed ? @tr("The export failed.")
                        : modal.message == Message.about ? "WaveDude Rust \{modal.arg}\n" + @tr("A 2D wave simulator") + "\n\n"
                            + @tr("Based on the work of WaveDude Next; Jeroen Vleggaar, Huygens Optics, author of Wave Dude 2D, Copyright (C) 2026; 0x23 (Diffraction Limited), author of WaveSimulator2D.")
                            + "\n\n" + @tr("This program is free software under the GNU General Public License, version 3 or later.")
                        : "";
                    wrap: word-wrap;
                    color: Theme.text;
                    horizontal-stretch: 1;
                }
            }
            HorizontalLayout {
                alignment: end;
                spacing: 6px;
                for choice[i] in root.choices: Button {
                    text: choice.text;
                    primary: i == (root.confirms ? 1 : 0);
                    clicked => { root.answer(choice.answer); }
                }
            }
        }
    }
}
