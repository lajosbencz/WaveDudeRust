// The pictures' overlays (docs/ui/40, Handles and overlays): rows the app builds from the project and the
// selection, in canvas pixels, and what the handles report.

import { Layer } from "data.slint";

export struct Rect { x: float, y: float, width: float, height: float }

export enum HandleGlyph { source, lever, part, grip, point, bezier, probe }

// a graph box's tick label, its top-left in the box
export struct GraphTick { label: string, x: float, y: float }

// a probe graph box (docs/ui/40): its corner in canvas pixels, the rest in logical pixels of the box
export struct GraphBox {
    // the probe's index
    probe: int,
    x: float,
    y: float,
    width: float,
    height: float,
    has-plot: bool,
    plot: Rect,
    // SVG path commands in the box
    grid: string,
    zero: string,
    curve: string,
    // the curve is one point
    dot: bool,
    line-width: float,
    y-ticks: [GraphTick],
    x-ticks: [GraphTick],
    title: string,
    readout: string,
    selected: bool,
}

// what a handle or graph box under the pointer does (Next's Tip*Format strings)
export enum TipKind { none, marker, lever, grip, point, node, in-handle, out-handle, graph, graph-corner }

// the tooltip of what is under the pointer: its kind, its item's name and the point or node index
export struct HoverTip { kind: TipKind, name: string, index: int }

// what a wave meets at the canvas edge
export enum EdgeLine { open, wall, rim }

// keys on a picture: the focus arriving by Tab, Tab, Shift+Tab, arrows
export enum HandleKey { enter, next, previous, left, right, up, down }

export struct HandleData {
    x: float,
    y: float,
    glyph: HandleGlyph,
    selected: bool,
    // has the keyboard focus while its picture does
    focused: bool,
}

export struct LabelData {
    text: string,
    x: float,
    y: float,
    // below the handle rather than to its right
    below: bool,
    selected: bool,
}

// SVG path commands in canvas pixels
export struct OverlayArt {
    lines: string,
    selected-lines: string,
    outlines: string,
    dots: string,
    selected-dots: string,
}

export global Canvas {
    // canvas pixels
    in property <int> width: 1;
    in property <int> height: 1;
    in property <[HandleData]> field-handles;
    in property <[LabelData]> field-labels;
    in property <OverlayArt> field-art;
    in property <[HandleData]> intensity-handles;
    in property <[LabelData]> intensity-labels;
    in property <OverlayArt> intensity-art;
    // the pictures' zoom over fitting (1..64) and the canvas point at their centres; kept across projects
    in-out property <float> zoom: 1;
    in-out property <float> centre-x;
    in-out property <float> centre-y;
    // a marquee drag, in canvas pixels
    in property <bool> marquee-shown;
    in property <Layer> marquee-layer;
    in property <Rect> marquee;
    // a handle drag or a marquee is under way: Esc cancels it
    in property <bool> dragging;
    callback cancel();
    // logical pixels per canvas pixel of a layer's picture
    callback rescaled(layer: Layer, scale: float);
    // a press at canvas pixel (x, y)
    callback press(layer: Layer, x: float, y: float, control: bool, shift: bool);
    // canvas pixels from the press; `shift` snaps a lever
    callback drag(dx: float, dy: float, shift: bool);
    callback release();
    in property <EdgeLine> edge;
    // the graph box with the keyboard focus: its probe's index (-1: none), picture, and whether its grip has it
    in property <int> focus-box: -1;
    in property <Layer> focus-layer;
    in property <bool> focus-grip;
    // the graph box under the pointer: its probe's index (-1: none) and picture
    in property <int> hover-box: -1;
    in property <Layer> hover-layer;
    in property <HoverTip> hover-tip;
    // the pointer over a picture at canvas pixel (x, y)
    callback hover(layer: Layer, x: float, y: float);
    callback export-probe-csv(probe: int);
    in property <[GraphBox]> field-graphs;
    in property <[GraphBox]> intensity-graphs;
    // the run computes the frame wanted, not stored yet
    in property <bool> computing;
    // the layers' brightness (Display), its edits and Auto
    in property <float> field-brightness: 1;
    in property <float> intensity-brightness: 1;
    callback brightness(layer: Layer, value: float);
    callback auto(layer: Layer);
    // a key on `layer`'s picture, Shift held; whether it was taken
    callback key(layer: Layer, key: HandleKey, shift: bool) -> bool;
}
