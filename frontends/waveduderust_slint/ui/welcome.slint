import { Button, CheckBox } from "std-widgets.slint";
import { MenuIcons } from "menu-icons.slint";
import { Theme } from "theme.slint";
import { IconButton } from "icons.slint";
import { Command, PreviewQuality } from "commands.slint";
import { Overlay } from "overlay.slint";

// The Welcome page (docs/ui/70, Welcome page).
// The preview levers as set: the resolution and frame divisors, the bits per sample.
export struct Levers {
    resolution: int,
    frames: int,
    bits: int,
    // the preset they match: 0 Low, 1 Medium, 2 High; -1 none
    preset: int,
}

// The Welcome page's data and requests, filled and served by Rust.
export global Welcome {
    in-out property <bool> shown;
    in property <Levers> levers;
    in property <bool> show-startup;
    callback preset(quality: PreviewQuality);
    callback show-startup-toggled(on: bool);
}

export component WelcomeLayer inherits Overlay {
    callback command(Command);

    visible: Welcome.shown;
    focus := FocusScope {
        key-pressed(e) => {
            if (e.text == Key.Escape) { Welcome.shown = false; return accept; }
            if (e.text == Key.Return) { root.command(Command.examples); return accept; }
            reject
        }
    }
    changed visible => { if (self.visible) { focus.focus(); } }
    Rectangle {
        width: min(560px, root.width - 40px);
        height: box.preferred-height;
        background: Theme.window-background;
        border-width: 1px;
        border-color: Theme.accent;
        box := VerticalLayout {
            padding: 16px;
            spacing: 10px;
            HorizontalLayout {
                Text {
                    text: @tr("Welcome to WaveDude Rust");
                    font-size: 16px;
                    font-weight: 700;
                    color: Theme.text;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
                IconButton {
                    icon: MenuIcons.close;
                    tip: @tr("Close");
                    focusable: false;
                    clicked => { Welcome.shown = false; }
                }
            }
            HorizontalLayout {
                spacing: 6px;
                alignment: start;
                Text {
                    text: @tr("Preview quality");
                    font-weight: 700;
                    color: Theme.text;
                    vertical-alignment: center;
                }
                Rectangle {
                    width: 16px;
                    height: 16px;
                    Image {
                        source: MenuIcons.info;
                        width: 100%;
                        height: 100%;
                        colorize: Theme.text-dim;
                    }
                    TouchArea { }
                    Tooltip {
                        text: @markdown("\{@tr("It sets the resolution, frames and samples of the preview runs; the frames past the RAM cache go to disk.")}");
                    }
                }
            }
            HorizontalLayout {
                spacing: 6px;
                alignment: start;
                Button { text: @tr("Low"); primary: Welcome.levers.preset == 0; clicked => { Welcome.preset(PreviewQuality.low); } }
                Button { text: @tr("Medium"); primary: Welcome.levers.preset == 1; clicked => { Welcome.preset(PreviewQuality.medium); } }
                Button { text: @tr("High"); primary: Welcome.levers.preset == 2; clicked => { Welcome.preset(PreviewQuality.high); } }
                Button { text: @tr("Auto"); clicked => { Welcome.preset(PreviewQuality.auto); } }
            }
            Text {
                text: @tr("{}, {}, {}-bit samples",
                    Welcome.levers.resolution == 1 ? @tr("Full resolution") : @tr("1/{} resolution", Welcome.levers.resolution),
                    Welcome.levers.frames == 1 ? @tr("every frame") : Welcome.levers.frames == 2 ? @tr("every 2nd frame") : @tr("every {}th frame", Welcome.levers.frames),
                    Welcome.levers.bits);
                color: Theme.text-dim;
            }
            HorizontalLayout {
                alignment: end;
                CheckBox {
                    text: @tr("Show this page at each launch");
                    checked: Welcome.show-startup;
                    toggled => { Welcome.show-startup-toggled(self.checked); }
                }
            }
            HorizontalLayout {
                spacing: 6px;
                Button {
                    text: @tr("Settings...");
                    clicked => { root.command(Command.settings); }
                }
                Rectangle { horizontal-stretch: 1; }
                Button {
                    text: @tr("Open Project...");
                    clicked => { root.command(Command.open); }
                }
                Button {
                    text: @tr("Random Example");
                    clicked => { root.command(Command.random-example); }
                }
                Button {
                    text: @tr("Examples...");
                    primary: true;
                    clicked => { root.command(Command.examples); }
                }
            }
        }
    }
}
