// The export dialog (docs/ui/70, Export Save dialog; port: in-window, a path box with "..." for the platform dialog;
// in the browser file names alone, decision 0025).

import { Button } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { Choice, Check } from "form.slint";
import { EditLine } from "edit-keys.slint";
import { Overlay } from "overlay.slint";

// Why the browser cannot start the export.
export enum ExportReason { none, no-storage, no-webcodecs, no-profile, probing }

export struct ExportData {
    title: string,
    formats: [string],
    // per format, whether it can be picked; empty: all
    format-enabled: [bool],
    format: int,
    // the chosen path; both layers' outputs are named from it with their suffixes
    path: string,
    // the outputs the path writes, when they differ from it
    outputs: string,
    mp4: bool,
    // the export writes more than one file: it may go into one ZIP archive
    several: bool,
    archive: bool,
    archive-path: string,
    // OpenH264 compiled in: no consent row
    codec-built-in: bool,
    codec-installed: bool,
    use-openh264: bool,
    profile: int,
    error: string,
    // the browser's dialog: file names alone, an export of several files always archived
    browser: bool,
    reason: ExportReason,
    // per H.264 profile, whether the encoder encodes it (OpenH264 natively, the browser's); empty until it answered
    profile-supported: [bool],
}

// The export dialog's data and requests, filled and served by Rust.
export global Export {
    in-out property <bool> shown;
    in-out property <ExportData> data;
    callback format(index: int);
    callback browse();
    callback browse-archive();
    callback ok();
    callback delete-codec();
    callback path-edited();
}

export component ExportLayer inherits Overlay {
    property <bool> shown: Export.shown;
    property <bool> can-ok: Export.data.path != "" && (!Export.data.mp4 || Export.data.codec-built-in || Export.data.use-openh264)
        && !(Export.data.several && Export.data.archive && Export.data.archive-path.is-empty) && Export.data.reason == ExportReason.none;

    visible: Export.shown;
    focus := FocusScope {
        key-pressed(e) => {
            if (e.text == Key.Escape) { Export.shown = false; return accept; }
            if (e.text == Key.Return && root.can-ok) { Export.ok(); return accept; }
            reject
        }
    }
    changed shown => {
        if (self.shown) { path.focus(); }
    }
    Rectangle {
        width: min(640px, root.width - 40px);
        height: min(box.preferred-height, root.height - 40px);
        background: Theme.window-background;
        border-width: 1px;
        border-color: Theme.accent;
        box := VerticalLayout {
            padding: 12px;
            spacing: 8px;
            Text { text: Export.data.title; font-weight: 700; color: Theme.text; }
            HorizontalLayout {
                spacing: 8px;
                Text { text: @tr("Format"); color: Theme.text; vertical-alignment: center; min-width: 70px; }
                Choice {
                    titles: Export.data.formats;
                    item-enabled: Export.data.format-enabled;
                    index: Export.data.format;
                    picked(i) => { Export.format(i); }
                }
            }
            HorizontalLayout {
                spacing: 8px;
                Text { text: @tr("File"); color: Theme.text; vertical-alignment: center; min-width: 70px; }
                path := EditLine {
                    text <=> Export.data.path;
                    edited => { Export.path-edited(); }
                    key-pressed(e) => {
                        if (e.text == Key.Escape) { Export.shown = false; return accept; }
                        if (e.text == Key.Return && root.can-ok) { Export.ok(); return accept; }
                        reject
                    }
                }
                if !Export.data.browser: Button { text: "..."; clicked => { Export.browse(); } }
            }
            if Export.data.outputs != "": Text {
                text: @tr("Writes {}", Export.data.outputs);
                color: Theme.text-dim;
                wrap: word-wrap;
            }
            if Export.data.several: Check {
                text: @tr("Archive into one ZIP file");
                enabled: !Export.data.browser;
                checked <=> Export.data.archive;
            }
            if Export.data.several && Export.data.archive: HorizontalLayout {
                spacing: 8px;
                Text { text: @tr("Archive"); color: Theme.text; vertical-alignment: center; min-width: 70px; }
                EditLine {
                    text <=> Export.data.archive-path;
                    key-pressed(e) => {
                        if (e.text == Key.Escape) { Export.shown = false; return accept; }
                        if (e.text == Key.Return && root.can-ok) { Export.ok(); return accept; }
                        reject
                    }
                }
                if !Export.data.browser: Button { text: "..."; clicked => { Export.browse-archive(); } }
            }
            if Export.data.mp4 && !Export.data.codec-built-in: VerticalLayout {
                spacing: 4px;
                Text { text: @tr("OpenH264 Video Codec provided by Cisco Systems, Inc."); color: Theme.text; }
                HorizontalLayout {
                    spacing: 8px;
                    Check {
                        text: @tr("Use Cisco's OpenH264 codec (downloaded from Cisco at the first MP4 export)");
                        checked <=> Export.data.use-openh264;
                    }
                    if Export.data.codec-installed: Button {
                        text: @tr("Delete the downloaded codec");
                        clicked => { Export.delete-codec(); }
                    }
                }
            }
            if Export.data.mp4: HorizontalLayout {
                spacing: 8px;
                Text { text: @tr("H.264 profile"); color: Theme.text; vertical-alignment: center; min-width: 70px; }
                Choice {
                    titles: ["Baseline", "Main", "High"];
                    item-enabled: Export.data.profile-supported;
                    index: Export.data.profile;
                    picked(i) => { Export.data.profile = i; }
                }
            }
            // a remembered profile the encoder lacks: the export uses its best
            if Export.data.mp4 && !Export.data.browser && Export.data.profile != 0: Text {
                text: @tr("OpenH264 encodes Baseline only; the export uses Baseline.");
                color: Theme.text-dim;
                wrap: word-wrap;
            }
            if Export.data.mp4 && Export.data.browser && Export.data.reason == ExportReason.none
                && !Export.data.profile-supported[Export.data.profile]: Text {
                text: @tr("not supported by this browser");
                color: Theme.text-dim;
                wrap: word-wrap;
            }
            if Export.data.reason != ExportReason.none: Text {
                text: Export.data.reason == ExportReason.no-storage
                    ? @tr("This browser has no private file storage to write the export to; frames and probe data still export.")
                    : Export.data.reason == ExportReason.no-webcodecs ? @tr("This browser has no video encoder (WebCodecs).")
                    : Export.data.reason == ExportReason.no-profile
                    ? @tr("This browser encodes no H.264 profile at this picture size and frame rate.")
                    : @tr("Asking the browser which H.264 profiles it encodes...");
                color: Theme.status-error;
                wrap: word-wrap;
            }
            if Export.data.error != "": Text {
                text: Export.data.error;
                color: Theme.status-error;
                wrap: word-wrap;
            }
            HorizontalLayout {
                alignment: end;
                spacing: 8px;
                Button {
                    text: @tr("OK");
                    primary: true;
                    enabled: root.can-ok;
                    clicked => { Export.ok(); }
                }
                Button { text: @tr("Cancel"); clicked => { Export.shown = false; } }
            }
        }
    }
}
