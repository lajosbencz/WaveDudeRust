import { Theme } from "theme.slint";

component Picture inherits VerticalLayout {
    in property <string> title;
    in property <image> source;
    horizontal-stretch: 1;
    vertical-stretch: 1;
    Rectangle {
        height: Theme.row-height;
        background: Theme.window-background;
        Text {
            x: 6px;
            text: root.title;
            color: Theme.text;
            vertical-alignment: center;
        }
    }
    Rectangle {
        background: #000000;
        Image {
            width: 100%;
            height: 100%;
            source: root.source;
            image-fit: contain;
        }
    }
}

// The preview's pictures (docs/ui/40): field above intensity, or side by side.
export component Preview inherits Rectangle {
    in property <image> field;
    in property <image> intensity;
    in property <bool> stacked: true;
    if root.stacked: VerticalLayout {
        spacing: 4px;
        Picture { title: @tr("Field"); source: root.field; }
        Picture { title: @tr("Intensity"); source: root.intensity; }
    }
    if !root.stacked: HorizontalLayout {
        spacing: 4px;
        Picture { title: @tr("Field"); source: root.field; }
        Picture { title: @tr("Intensity"); source: root.intensity; }
    }
}
