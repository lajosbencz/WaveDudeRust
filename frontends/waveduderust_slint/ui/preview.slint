import { Theme } from "theme.slint";
import { Layer } from "data.slint";
import { Canvas, EdgeLine, GraphBox, HandleData, HandleGlyph, HandleKey, LabelData, OverlayArt } from "canvas.slint";
import { Command } from "commands.slint";
import { Button } from "std-widgets.slint";
import { NumberBox, NumberSpec } from "number-box.slint";
import { NumberParse } from "form.slint";
import { MenuIcons } from "menu-icons.slint";

// The handle glyphs, 21 px with the point on the centre pixel (docs/ui/40, Handles and overlays).
global Glyphs {
    out property <string> ticks: "M 10.5 0 V 4 M 10.5 17 V 21 M 0 10.5 H 4 M 17 10.5 H 21 ";
    out property <string> dot: "M 9.5 10.5 a 1 1 0 1 0 2 0 a 1 1 0 1 0 -2 0 ";
    public pure function of(glyph: HandleGlyph) -> string {
        if (glyph == HandleGlyph.source) { return self.ticks + "M 4.5 10.5 a 6 6 0 1 0 12 0 a 6 6 0 1 0 -12 0 " + self.dot; }
        if (glyph == HandleGlyph.part) {
            return self.ticks + "M 3.5 10.5 a 7 7 0 1 0 14 0 a 7 7 0 1 0 -14 0 M 7.5 10.5 a 3 3 0 1 0 6 0 a 3 3 0 1 0 -6 0";
        }
        if (glyph == HandleGlyph.probe) { return self.ticks + "M 5 5 H 16 V 16 H 5 Z " + self.dot; }
        if (glyph == HandleGlyph.lever) { return "M 5.5 10.5 a 5 5 0 1 0 10 0 a 5 5 0 1 0 -10 0 M 8 8 L 13 13 M 13 8 L 8 13"; }
        if (glyph == HandleGlyph.grip) { return "M 4 4 H 17 V 17 H 4 Z"; }
        if (glyph == HandleGlyph.point) { return "M 6.5 10.5 a 4 4 0 1 0 8 0 a 4 4 0 1 0 -8 0"; }
        "M 7.5 10.5 a 3 3 0 1 0 6 0 a 3 3 0 1 0 -6 0"
    }
}

component HandleView inherits Rectangle {
    in property <HandleData> handle;
    in property <float> scale;
    in property <bool> focus-shown;
    property <bool> filled: root.handle.glyph == HandleGlyph.grip || root.handle.glyph == HandleGlyph.bezier;
    property <color> ink: root.handle.selected ? Theme.picture-selection : Theme.picture-handle;
    x: root.handle.x * root.scale * 1px - 10.5px;
    y: root.handle.y * root.scale * 1px - 10.5px;
    width: 21px;
    height: 21px;
    Path {
        width: 100%;
        height: 100%;
        viewbox-width: 21;
        viewbox-height: 21;
        commands: Glyphs.of(root.handle.glyph);
        stroke: Theme.picture-halo;
        stroke-width: 3.5px;
        fill: root.filled ? Theme.picture-halo : transparent;
    }
    Path {
        width: 100%;
        height: 100%;
        viewbox-width: 21;
        viewbox-height: 21;
        commands: Glyphs.of(root.handle.glyph);
        stroke: root.ink;
        stroke-width: 1.5px;
        fill: root.filled ? root.ink : transparent;
    }
    if root.focus-shown && root.handle.focused: Rectangle {
        x: -2px;
        y: -2px;
        width: parent.width + 4px;
        height: parent.height + 4px;
        border-width: 1px;
        border-color: Theme.picture-selection;
    }
}

component LabelView inherits Text {
    in property <LabelData> label;
    in property <float> scale;
    x: root.label.below ? root.label.x * root.scale * 1px - self.width / 2 : root.label.x * root.scale * 1px + 13px;
    y: root.label.below ? root.label.y * root.scale * 1px + 12px : root.label.y * root.scale * 1px - self.height / 2;
    text: root.label.text;
    font-size: 11px;
    color: root.label.selected ? Theme.picture-selection : Theme.picture-handle;
    stroke: Theme.picture-halo;
    stroke-width: 2px;
    stroke-style: outside;
}

// A three-quarter ring turning once a second.
component Spinner inherits Rectangle {
    width: 32px;
    height: 32px;
    Path {
        viewbox-width: 32;
        viewbox-height: 32;
        commands: "M 16 3 A 13 13 0 1 1 3 16";
        stroke: #ffffff;
        stroke-width: 3px;
        transform-rotation: mod(animation-tick() / 1ms, 1000) * 0.36deg;
    }
}

// A probe's graph box; fixed colours, as an export draws it (view::graph).
component GraphBoxView inherits Rectangle {
    in property <GraphBox> graph;
    in property <float> scale;
    in property <bool> hovered;
    x: round(root.graph.x * root.scale) * 1px;
    y: round(root.graph.y * root.scale) * 1px;
    width: root.graph.width * 1px;
    height: root.graph.height * 1px;
    background: #0e1016eb;
    border-width: 1px;
    border-color: root.graph.selected ? Theme.picture-selection : root.hovered ? #ffffffe0 : #c8c8d2aa;
    clip: true;
    if root.graph.has-plot: Path {
        viewbox-width: root.graph.width;
        viewbox-height: root.graph.height;
        commands: root.graph.grid;
        stroke: #ffffff2e;
        stroke-width: 1px;
    }
    if root.graph.has-plot && root.graph.zero != "": Path {
        viewbox-width: root.graph.width;
        viewbox-height: root.graph.height;
        commands: root.graph.zero;
        stroke: #ffffff78;
        stroke-width: 1px;
    }
    if root.graph.has-plot: Rectangle {
        x: root.graph.plot.x * 1px;
        y: root.graph.plot.y * 1px;
        width: root.graph.plot.width * 1px;
        height: root.graph.plot.height * 1px;
        border-width: 1px;
        border-color: #c8c8d282;
        clip: true;
        if root.graph.curve != "": Path {
            viewbox-x: root.graph.plot.x;
            viewbox-y: root.graph.plot.y;
            viewbox-width: root.graph.plot.width;
            viewbox-height: root.graph.plot.height;
            commands: root.graph.curve;
            stroke: root.graph.dot ? transparent : #ffd040;
            fill: root.graph.dot ? #ffd040 : transparent;
            stroke-width: root.graph.line-width * 1px;
        }
    }
    for t in root.graph.y-ticks: Text { x: t.x * 1px; y: t.y * 1px; text: t.label; font-size: 11px; color: #e1e1e6e1; }
    for t in root.graph.x-ticks: Text { x: t.x * 1px; y: t.y * 1px; text: t.label; font-size: 11px; color: #e1e1e6e1; }
    // the resize grip: two diagonal bands in the bottom-right 12 px cell (view::graph GRIP_BANDS)
    if root.hovered || root.graph.selected: Path {
        x: root.width - 12px;
        y: root.height - 12px;
        width: 12px;
        height: 12px;
        viewbox-width: 12;
        viewbox-height: 12;
        commands: "M 11 1 L 11 3 L 3 11 L 1 11 Z M 11 6 L 11 8 L 8 11 L 6 11 Z";
        fill: root.hovered ? #ffffff : #ffffffa0;
    }
    // the title strip: the readout right-aligned in the curve's colour, the title elided in what remains
    HorizontalLayout {
        x: 6px;
        y: 3px;
        width: root.width - 14px;
        height: 14px;
        spacing: 8px;
        Text { text: root.graph.title; font-size: 11px; color: #f0f0f5f0; overflow: elide; horizontal-stretch: 1; min-width: 0; }
        if root.graph.readout != "": Text { text: root.graph.readout; font-size: 11px; color: #ffd040; }
    }
}

// Canvas-pixel paths over the picture.
component Art inherits Path {
    viewbox-width: Canvas.width;
    viewbox-height: Canvas.height;
}

component Picture inherits VerticalLayout {
    // the Display form's
    out property <NumberSpec> brightness-spec: { min: 0.0001, max: 100000, increment: 1, decimals: -1, log: true };
    in property <string> title;
    in property <image> source;
    in property <Layer> layer;
    in property <[HandleData]> handles;
    in property <[LabelData]> labels;
    in property <OverlayArt> art;
    in property <[GraphBox]> graphs;
    in property <bool> can-export;
    // dimmed, a frame being computed for a while
    in property <bool> busy;
    callback command(Command);
    horizontal-stretch: 1;
    vertical-stretch: 1;
    // the header strip (docs/ui/40): title, then the layer's brightness and Auto at the far end
    HorizontalLayout {
        padding-left: 6px;
        padding-bottom: 4px;
        spacing: 4px;
        Text {
            text: root.title;
            color: Theme.text;
            font-weight: 600;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
            min-width: 0;
        }
        Rectangle { width: 8px; }
        Text {
            text: @tr("Brightness");
            color: Theme.text;
            vertical-alignment: center;
        }
        brightness := NumberBox {
            width: 64px;
            value: "\{root.layer == Layer.field ? Canvas.field-brightness : Canvas.intensity-brightness}";
            spec: root.brightness-spec;
            edited(t) => {
                let parsed = NumberParse.float(self.spec, t);
                if (parsed.ok) {
                    Canvas.brightness(root.layer, parsed.value);
                }
                parsed.ok
            }
        }
        Button {
            text: @tr("Auto");
            clicked => { Canvas.auto(root.layer); }
        }
    }
    cell := Rectangle {
        background: #000000;
        clip: true;
        // logical pixels per canvas pixel: fitted, then zoomed
        property <float> fit: max(0.001, min(self.width / (Canvas.width * 1px), self.height / (Canvas.height * 1px)));
        property <float> scale: self.fit * Canvas.zoom;
        // the picture's corner in the cell: centred while it fits, else around the shared centre, no empty area
        property <length> left: self.place(self.width, Canvas.width * self.scale * 1px, Canvas.centre-x);
        property <length> top: self.place(self.height, Canvas.height * self.scale * 1px, Canvas.centre-y);
        pure function place(room: length, size: length, centre: float) -> length {
            size <= room ? (room - size) / 2 : clamp(room / 2 - centre * self.scale * 1px, room - size, 0px)
        }
        changed scale => { Canvas.rescaled(root.layer, self.scale); }
        init => { Canvas.rescaled(root.layer, self.scale); }
        Rectangle {
            x: cell.left;
            y: cell.top;
            width: Canvas.width * cell.scale * 1px;
            height: Canvas.height * cell.scale * 1px;
            Image {
                x: 0;
                y: 0;
                width: 100%;
                height: 100%;
                source: root.source;
                image-fit: fill;
            }
            if root.art.dots != "": Art { commands: root.art.dots; fill: Theme.picture-handle; }
            if root.art.selected-dots != "": Art { commands: root.art.selected-dots; fill: Theme.picture-selection; }
            if root.art.lines != "": Art { commands: root.art.lines; stroke: Theme.picture-handle; stroke-width: 1px; }
            if root.art.selected-lines != "": Art {
                commands: root.art.selected-lines;
                stroke: Theme.picture-selection;
                stroke-width: 1px;
            }
            if root.art.outlines != "": Art { commands: root.art.outlines; stroke: Theme.picture-selection; stroke-width: 1px; }
            for label in root.labels: LabelView { label: label; scale: cell.scale; }
            for handle in root.handles: HandleView { handle: handle; scale: cell.scale; focus-shown: keys.has-focus; }
            for graph in root.graphs: GraphBoxView {
                graph: graph;
                scale: cell.scale;
                hovered: touch.has-hover && touch.mouse-x >= cell.left + self.x && touch.mouse-x < cell.left + self.x + self.width
                    && touch.mouse-y >= cell.top + self.y && touch.mouse-y < cell.top + self.y + self.height;
            }
            if Canvas.marquee-shown && Canvas.marquee-layer == root.layer: Rectangle {
                x: Canvas.marquee.x * cell.scale * 1px;
                y: Canvas.marquee.y * cell.scale * 1px;
                width: Canvas.marquee.width * cell.scale * 1px;
                height: Canvas.marquee.height * cell.scale * 1px;
                background: Theme.selection.with-alpha(0.15);
                border-width: 1px;
                border-color: Theme.selection;
            }
        }
        // the picture's visible area in the cell
        property <length> view-x: max(cell.left, 0px);
        property <length> view-y: max(cell.top, 0px);
        property <length> view-width: min(cell.width, cell.left + Canvas.width * cell.scale * 1px) - self.view-x;
        property <length> view-height: min(cell.height, cell.top + Canvas.height * cell.scale * 1px) - self.view-y;
        // fixed colours, not themed (docs/ui/40, Edge line), round the visible picture
        if Canvas.edge != EdgeLine.open: Rectangle {
            x: cell.view-x - 1px;
            y: cell.view-y - 1px;
            width: cell.view-width + 2px;
            height: cell.view-height + 2px;
            border-width: 1px;
            border-color: Canvas.edge == EdgeLine.rim ? #0000ff : #ff0000;
        }
        if root.busy: Rectangle {
            x: cell.view-x;
            y: cell.view-y;
            width: cell.view-width;
            height: cell.view-height;
            background: #00000073;
            Spinner { }
        }
        // the handles' keys: Tab walks them, arrows move the focused one; Del is the window's
        keys := FocusScope {
            focus-gained(reason) => {
                // either direction: Slint does not say which
                if (reason == FocusReason.tab-navigation) {
                    self.take(HandleKey.enter, false);
                }
            }
            function take(key: HandleKey, shift: bool) -> bool {
                Canvas.key(root.layer, key, shift)
            }
            key-pressed(e) => {
                if (e.modifiers.control || e.modifiers.alt) {
                    return reject;
                }
                if (e.text == Key.Menu || (e.modifiers.shift && e.text == Key.F10)) {
                    menu.show({ x: cell.width / 2, y: cell.height / 2 });
                    return accept;
                }
                let key = e.text == Key.Tab ? HandleKey.next : e.text == Key.Backtab ? HandleKey.previous
                    : e.text == Key.LeftArrow ? HandleKey.left : e.text == Key.RightArrow ? HandleKey.right
                    : e.text == Key.UpArrow ? HandleKey.up : e.text == Key.DownArrow ? HandleKey.down : HandleKey.next;
                let known = e.text == Key.Tab || e.text == Key.Backtab || e.text == Key.LeftArrow
                    || e.text == Key.RightArrow || e.text == Key.UpArrow || e.text == Key.DownArrow;
                known && self.take(key, e.modifiers.shift) ? accept : reject
            }
            // Next's picture menu (PreviewPane.xaml ContextMenu)
            menu := ContextMenuArea {
                Menu {
                    MenuItem { title: @tr("Brightness"); icon: MenuIcons.brightness-6; activated => { brightness.focus(); } }
                    MenuItem { title: @tr("Auto brightness"); icon: MenuIcons.brightness-6; activated => { Canvas.auto(root.layer); } }
                    MenuSeparator { }
                    MenuItem {
                        title: @tr("Export this frame...");
                        icon: MenuIcons.image;
                        enabled: root.can-export;
                        activated => { root.command(root.layer == Layer.field ? Command.export-field-frame : Command.export-intensity-frame); }
                    }
                    MenuSeparator { }
                    MenuItem { title: @tr("Export field..."); icon: MenuIcons.ios-share; enabled: root.can-export; activated => { root.command(Command.export-field); } }
                    MenuItem { title: @tr("Export intensity..."); icon: MenuIcons.ios-share; enabled: root.can-export; activated => { root.command(Command.export-intensity); } }
                    MenuItem { title: @tr("Export both..."); icon: MenuIcons.ios-share; enabled: root.can-export; activated => { root.command(Command.export-both); } }
                }
                // one area for the whole picture: the drawings take no pointer, the app finds the handle under a press
                touch := TouchArea {
                    property <length> from-x;
                    property <length> from-y;
                    // a middle-button pan: where it started and the centre then
                    property <bool> panning;
                    property <length> pan-x;
                    property <length> pan-y;
                    property <float> centre-x;
                    property <float> centre-y;
                    scroll-event(e) => {
                        // a zoom mid-gesture would move what the gesture measures from
                        if (e.delta-y == 0 || self.pressed || self.panning) {
                            return reject;
                        }
                        // the canvas point under the pointer stays there
                        let at-x = (self.mouse-x - cell.left) / (cell.scale * 1px);
                        let at-y = (self.mouse-y - cell.top) / (cell.scale * 1px);
                        Canvas.zoom = clamp(Canvas.zoom * (e.delta-y > 0 ? 1.25 : 0.8), 1, 64);
                        let s = cell.fit * Canvas.zoom * 1px;
                        Canvas.centre-x = at-x - (self.mouse-x - cell.width / 2) / s;
                        Canvas.centre-y = at-y - (self.mouse-y - cell.height / 2) / s;
                        accept
                    }
                    pointer-event(e) => {
                        if (e.kind == PointerEventKind.cancel) {
                            self.panning = false;
                            Canvas.cancel();
                            return;
                        }
                        if (e.kind == PointerEventKind.move) {
                            if (self.panning) {
                                // held where the picture's edge stops it, so a drag back moves it at once
                                let half-x = cell.width / 2 / (cell.scale * 1px);
                                let half-y = cell.height / 2 / (cell.scale * 1px);
                                Canvas.centre-x = clamp(self.centre-x - (self.mouse-x - self.pan-x) / (cell.scale * 1px), half-x, max(half-x, Canvas.width - half-x));
                                Canvas.centre-y = clamp(self.centre-y - (self.mouse-y - self.pan-y) / (cell.scale * 1px), half-y, max(half-y, Canvas.height - half-y));
                            } else if (self.pressed) {
                                Canvas.drag(
                                    (self.mouse-x - self.from-x) / (cell.scale * 1px),
                                    (self.mouse-y - self.from-y) / (cell.scale * 1px),
                                    e.modifiers.shift);
                            }
                            return;
                        }
                        if (e.button == PointerEventButton.middle) {
                            self.panning = e.kind == PointerEventKind.down && Canvas.zoom > 1 && !self.pressed;
                            self.pan-x = self.mouse-x;
                            self.pan-y = self.mouse-y;
                            // the centre shown, which a fitted picture does not hold
                            self.centre-x = (cell.width / 2 - cell.left) / (cell.scale * 1px);
                            self.centre-y = (cell.height / 2 - cell.top) / (cell.scale * 1px);
                            return;
                        }
                        if (e.button != PointerEventButton.left) {
                            return;
                        }
                        if (e.kind == PointerEventKind.down) {
                            keys.focus();
                            self.from-x = self.mouse-x;
                            self.from-y = self.mouse-y;
                            Canvas.press(
                                root.layer,
                                (self.mouse-x - cell.left) / (cell.scale * 1px),
                                (self.mouse-y - cell.top) / (cell.scale * 1px),
                                e.modifiers.control,
                                e.modifiers.shift);
                        } else if (e.kind == PointerEventKind.up) {
                            Canvas.release();
                        }
                    }
                }
            }
        }
    }
}

// The preview's pictures (docs/ui/40): field above intensity, or side by side.
export component Preview inherits Rectangle {
    // the dim lifts as the frame arrives
    changed busy-wanted => {
        if (!self.busy-wanted) {
            self.busy = false;
        }
    }
    property <bool> busy-wanted: Canvas.computing;
    in property <image> field;
    in property <image> intensity;
    in property <bool> stacked: true;
    in property <bool> can-export;
    // a frame computed for 150 ms dims the pictures
    property <bool> busy;
    Timer {
        interval: 150ms;
        running: Canvas.computing && !root.busy;
        triggered => { root.busy = Canvas.computing; }
    }
    callback command(Command);
    if root.stacked: VerticalLayout {
        spacing: 4px;
        Picture {
            title: @tr("Field");
            source: root.field;
            layer: Layer.field;
            handles: Canvas.field-handles;
            labels: Canvas.field-labels;
            art: Canvas.field-art;
            graphs: Canvas.field-graphs;
            can-export: root.can-export;
            busy: root.busy;
            command(c) => { root.command(c); }
        }
        Picture {
            title: @tr("Intensity");
            source: root.intensity;
            layer: Layer.intensity;
            handles: Canvas.intensity-handles;
            labels: Canvas.intensity-labels;
            art: Canvas.intensity-art;
            graphs: Canvas.intensity-graphs;
            can-export: root.can-export;
            busy: root.busy;
            command(c) => { root.command(c); }
        }
    }
    if !root.stacked: HorizontalLayout {
        spacing: 4px;
        Picture {
            title: @tr("Field");
            source: root.field;
            layer: Layer.field;
            handles: Canvas.field-handles;
            labels: Canvas.field-labels;
            art: Canvas.field-art;
            graphs: Canvas.field-graphs;
            can-export: root.can-export;
            busy: root.busy;
            command(c) => { root.command(c); }
        }
        Picture {
            title: @tr("Intensity");
            source: root.intensity;
            layer: Layer.intensity;
            handles: Canvas.intensity-handles;
            labels: Canvas.intensity-labels;
            art: Canvas.intensity-art;
            graphs: Canvas.intensity-graphs;
            can-export: root.can-export;
            busy: root.busy;
            command(c) => { root.command(c); }
        }
    }
}
