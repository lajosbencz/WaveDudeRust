import { LineEdit, Button, ListView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { EditKeys } from "edit-keys.slint";
import { Overlay } from "overlay.slint";

// The examples' topics, in tab order.
export enum ExampleTopic { sources, lenses, gratings, metasurfaces, guides, detectors }

struct Tab {
    topic: ExampleTopic,
    title: string,
}

export struct ExampleRow {
    title: string,
    description: string,
}

// The Examples dialog (docs/ui/70, Examples dialog): topic tabs, search, the topic's examples, Open and Cancel.
export component ExamplesLayer inherits Overlay {
    in-out property <bool> shown;
    in property <ExampleTopic> topic;
    in property <[ExampleRow]> rows;
    in-out property <int> current: 0;
    callback pick-topic(ExampleTopic);

    property <[Tab]> tabs: [
        { topic: ExampleTopic.sources, title: @tr("Sources and coherence") },
        { topic: ExampleTopic.lenses, title: @tr("Lenses and imaging") },
        { topic: ExampleTopic.gratings, title: @tr("Gratings and filters") },
        { topic: ExampleTopic.metasurfaces, title: @tr("Metasurfaces and diffusers") },
        { topic: ExampleTopic.guides, title: @tr("Guides, cavities and logic") },
        { topic: ExampleTopic.detectors, title: @tr("Detectors and statistics") },
    ];
    // the shown topic's tab
    property <int> shown-tab: root.topic == ExampleTopic.sources ? 0 : root.topic == ExampleTopic.lenses ? 1
        : root.topic == ExampleTopic.gratings ? 2 : root.topic == ExampleTopic.metasurfaces ? 3
        : root.topic == ExampleTopic.guides ? 4 : 5;
    callback search(string);
    callback open(int);
    // the Welcome page in place of the dialog
    callback welcome();

    visible: shown;
    focus := FocusScope {
        key-pressed(e) => {
            if (e.text == Key.Escape) { root.shown = false; return accept; }
            if (e.text == Key.Return) { root.open(root.current); return accept; }
            if (e.text == Key.UpArrow) { root.current = max(0, root.current - 1); return accept; }
            if (e.text == Key.DownArrow) { root.current = min(root.rows.length - 1, root.current + 1); return accept; }
            if (e.text == Key.LeftArrow) { root.pick-topic(root.tabs[max(0, root.shown-tab - 1)].topic); return accept; }
            if (e.text == Key.RightArrow) { root.pick-topic(root.tabs[min(root.tabs.length - 1, root.shown-tab + 1)].topic); return accept; }
            reject
        }
    }
    changed visible => { if (self.visible) { focus.focus(); } }
    Rectangle {
        width: min(860px, root.width - 40px);
        height: min(560px, root.height - 40px);
        background: Theme.window-background;
        border-width: 1px;
        border-color: Theme.accent;
        VerticalLayout {
            padding: 12px;
            spacing: 8px;
            Text {
                text: @tr("Examples");
                font-weight: 700;
                color: Theme.text;
            }
            HorizontalLayout {
                spacing: 2px;
                for t in root.tabs: Rectangle {
                    height: Theme.row-height;
                    width: label.preferred-width + 16px;
                    background: t.topic == root.topic ? Theme.accent : tab.has-hover ? Theme.button-hover : transparent;
                    label := Text {
                        text: t.title;
                        color: t.topic == root.topic ? Theme.selection-text : Theme.text;
                    }
                    tab := TouchArea {
                        clicked => { root.pick-topic(t.topic); root.current = 0; }
                    }
                }
            }
            LineEdit {
                changed has-focus => { EditKeys.local = self.has-focus; }
                placeholder-text: @tr("Search");
                edited(t) => { root.search(t); root.current = 0; }
            }
            ListView {
                for row[i] in root.rows: Rectangle {
                    background: i == root.current ? Theme.selection : area.has-hover ? Theme.row-hover : transparent;
                    VerticalLayout {
                        padding: 4px;
                        Text {
                            text: row.title;
                            color: i == root.current ? Theme.selection-text : Theme.text;
                        }
                        Text {
                            text: row.description;
                            wrap: word-wrap;
                            color: i == root.current ? Theme.selection-text : Theme.text-dim;
                        }
                    }
                    area := TouchArea {
                        clicked => { root.current = i; }
                        double-clicked => { root.open(i); }
                    }
                }
            }
            HorizontalLayout {
                spacing: 6px;
                Button {
                    text: @tr("Welcome page...");
                    clicked => {
                        root.shown = false;
                        root.welcome();
                    }
                }
                Rectangle { horizontal-stretch: 1; }
                Button {
                    text: @tr("Open");
                    primary: true;
                    enabled: root.rows.length > 0;
                    clicked => { root.open(root.current); }
                }
                Button {
                    text: @tr("Cancel");
                    clicked => { root.shown = false; }
                }
            }
        }
    }
}
