import { Button } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { NumberSpec } from "number-box.slint";
import { FormPanel, FormLabel, IntField, Check, Choice } from "form.slint";
import { PreviewQuality } from "commands.slint";

export enum ColorTheme { system, light, dark }
// `system`: the system's language when a table has it, else English
export enum Language { system, en, de, fr, nl }
// a preview lever: every value, every 2nd, every 4th
export enum Scale { full, half, quarter }

export struct SettingsData {
    theme: ColorTheme,
    language: Language,
    title-full-path: bool,
    show-startup: bool,
    undo-steps: int,
    preview-resolution: Scale,
    preview-frames: Scale,
    // 8-bit palette index rather than 16-bit float
    preview-index: bool,
    // 0 off, then 10, 12, 14, 16 bits per channel
    preview-dither: int,
    // the memory free now and the machine's; empty in the browser
    ram-available: string,
    ram-physical: string,
    use-gpu: bool,
    auto-rerun: bool,
    warn-ram: bool,
    check-updates: bool,
}

component ThemeChoice inherits Choice {
    in-out property <ColorTheme> value;
    titles: [@tr("System"), @tr("Light"), @tr("Dark")];
    index: root.value == ColorTheme.system ? 0 : root.value == ColorTheme.light ? 1 : 2;
    picked(i) => { root.value = i == 0 ? ColorTheme.system : i == 1 ? ColorTheme.light : ColorTheme.dark; }
}

// the languages by their own names
component LanguageChoice inherits Choice {
    in-out property <Language> value;
    titles: [@tr("System"), "English", "Deutsch", "Fran\u{e7}ais", "Nederlands"];
    index: root.value == Language.system ? 0 : root.value == Language.en ? 1 : root.value == Language.de ? 2 : root.value == Language.fr ? 3 : 4;
    picked(i) => {
        root.value = i == 0 ? Language.system : i == 1 ? Language.en : i == 2 ? Language.de : i == 3 ? Language.fr : Language.nl;
    }
}

component ScaleChoice inherits Choice {
    in-out property <Scale> value;
    titles: [@tr("Full"), @tr("Half"), @tr("Quarter")];
    index: root.value == Scale.full ? 0 : root.value == Scale.half ? 1 : 2;
    picked(i) => { root.value = i == 0 ? Scale.full : i == 1 ? Scale.half : Scale.quarter; }
}

// The Settings window (docs/ui/70, Settings): sections on the left, the section's rows on the right; each change
// applies and is saved at once.
export component SettingsLayer inherits Rectangle {
    in-out property <bool> shown;
    in-out property <SettingsData> data;
    in property <NumberSpec> undo-spec;
    callback edited();
    callback preset(PreviewQuality);

    property <[string]> sections: [@tr("General"), @tr("Preview and memory"), @tr("Simulation"), @tr("Updates")];
    property <int> section;
    property <string> invalid;

    visible: shown;
    background: #00000080;
    TouchArea { }
    focus := FocusScope {
        key-pressed(e) => {
            if (e.text == Key.Escape) { root.shown = false; return accept; }
            reject
        }
    }
    changed visible => {
        root.invalid = "";
        if (self.visible) { focus.focus(); }
    }
    Rectangle {
        width: min(760px, root.width - 40px);
        height: min(520px, root.height - 40px);
        background: Theme.window-background;
        border-width: 1px;
        border-color: Theme.accent;
        VerticalLayout {
            padding: 12px;
            spacing: 8px;
            Text {
                text: @tr("Settings");
                font-weight: 700;
                color: Theme.text;
            }
            HorizontalLayout {
                spacing: 8px;
                VerticalLayout {
                    width: 180px;
                    alignment: start;
                    for name[i] in root.sections: Rectangle {
                        height: Theme.row-height;
                        background: i == root.section ? Theme.selection : area.has-hover ? Theme.row-hover : transparent;
                        Text {
                            x: 6px;
                            text: name;
                            color: i == root.section ? Theme.selection-text : Theme.text;
                            vertical-alignment: center;
                        }
                        area := TouchArea {
                            clicked => {
                                root.section = i;
                                root.invalid = "";
                            }
                        }
                    }
                }
                VerticalLayout {
                    alignment: start;
                    spacing: 6px;
                    Text {
                        text: root.sections[root.section];
                        font-weight: 700;
                        color: Theme.text;
                    }
                    if root.section == 0: FormPanel {
                        Row {
                            FormLabel { text: @tr("Theme"); }
                            ThemeChoice { value <=> root.data.theme; committed => { root.edited(); } }
                        }
                        Row {
                            FormLabel { text: @tr("Language"); }
                            LanguageChoice { value <=> root.data.language; committed => { root.edited(); } }
                        }
                        Row {
                            Check { colspan: 2; text: @tr("Full path in the title"); checked <=> root.data.title-full-path; committed => { root.edited(); } }
                        }
                        Row {
                            Check { colspan: 2; text: @tr("Show the welcome page at each launch"); checked <=> root.data.show-startup; committed => { root.edited(); } }
                        }
                        Row {
                            FormLabel { text: @tr("Undo steps"); }
                            IntField {
                                value <=> root.data.undo-steps;
                                spec: root.undo-spec;
                                committed => { root.invalid = ""; root.edited(); }
                                invalid(t) => { root.invalid = t; }
                            }
                        }
                    }
                    if root.section == 1: FormPanel {
                        if root.data.ram-physical != "": Row {
                            FormLabel { text: @tr("RAM"); }
                            Text {
                                text: @tr("{} available of {}", root.data.ram-available, root.data.ram-physical);
                                color: Theme.text;
                                vertical-alignment: center;
                            }
                        }
                        Row {
                            FormLabel { text: @tr("Preset"); }
                            HorizontalLayout {
                                spacing: 6px;
                                Button { text: @tr("Low"); clicked => { root.preset(PreviewQuality.low); } }
                                Button { text: @tr("Medium"); clicked => { root.preset(PreviewQuality.medium); } }
                                Button { text: @tr("High"); clicked => { root.preset(PreviewQuality.high); } }
                                Button { text: @tr("Auto"); clicked => { root.preset(PreviewQuality.auto); } }
                            }
                        }
                        Row {
                            FormLabel { text: @tr("Preview resolution"); }
                            ScaleChoice { value <=> root.data.preview-resolution; committed => { root.edited(); } }
                        }
                        Row {
                            FormLabel { text: @tr("Preview frames"); }
                            ScaleChoice { value <=> root.data.preview-frames; committed => { root.edited(); } }
                        }
                        Row {
                            FormLabel { text: @tr("Preview samples"); }
                            Choice {
                                titles: [@tr("16-bit float"), @tr("8-bit palette index (brightness fixed when the run starts)")];
                                index: root.data.preview-index ? 1 : 0;
                                picked(i) => { root.data.preview-index = i == 1; }
                                committed => { root.edited(); }
                            }
                        }
                        Row {
                            FormLabel { text: @tr("Preview dithering"); }
                            Choice {
                                titles: [@tr("Off"), "10", "12", "14", "16"];
                                enabled: !root.data.preview-index;
                                index: root.data.preview-dither;
                                picked(i) => { root.data.preview-dither = i; }
                                committed => { root.edited(); }
                            }
                        }
                        Row {
                            Check { colspan: 2; text: @tr("Use the GPU"); checked <=> root.data.use-gpu; committed => { root.edited(); } }
                        }
                    }
                    if root.section == 2: FormPanel {
                        Row {
                            Check { colspan: 2; text: @tr("Re-run automatically after edits"); checked <=> root.data.auto-rerun; committed => { root.edited(); } }
                        }
                        Row {
                            Check { colspan: 2; text: @tr("Warn when the RAM cache is too small"); checked <=> root.data.warn-ram; committed => { root.edited(); } }
                        }
                    }
                    if root.section == 3: FormPanel {
                        Row {
                            Check { colspan: 2; text: @tr("Check for updates at start"); checked <=> root.data.check-updates; committed => { root.edited(); } }
                        }
                    }
                    if root.invalid != "": Text {
                        text: @tr("Not a number: {}", root.invalid);
                        color: Theme.status-error;
                    }
                }
            }
            HorizontalLayout {
                alignment: end;
                Button {
                    text: @tr("Close");
                    primary: true;
                    clicked => { root.shown = false; }
                }
            }
        }
    }
}
