import { Button, CheckBox, ComboBox, LineEdit } from "std-widgets.slint";
import { Icon, IconButton } from "icons.slint";
import { Theme } from "theme.slint";
import { NumberBox, NumberSpec } from "number-box.slint";
import { FormKind, ProjectData, SceneData, SimulationData, DisplayData, LayerData, VideoData, SourceData, ArrayData, ProbeData, PartData, MaterialData, CoatingData, SidesData, TriangleData, PolygonData, LensData, FresnelData, DiffuserData, ZonePlateData, BraggData, GrinData, GratingData, FacetData, MetaData, GateData, FilterData, FilterLayerData, FiberData, FiberNodeData, SchemeData, StopData, SchemeChoice, PointData, Layer } from "data.slint";
import { EditKeys } from "edit-keys.slint";

// Whether the current scheme is among the user's; hidden: not a scheme, or no store to keep them.
export enum Mine { hidden, no, yes }

// The shown object's form data, typed (ui/data.slint); editors bind two-way to its fields and report each commit.
export global Form {
    // the first item from `from` on, a `step` apart, that `enabled` lets pick among `count`; -1 when none
    pure callback next-enabled(enabled: [bool], count: int, from: int, step: int) -> int;
    in property <FormKind> kind;
    // changes with the object shown, dropping text typed into the last one's boxes
    in property <int> token;
    in-out property <ProjectData> project;
    in-out property <SceneData> scene;
    in-out property <SimulationData> simulation;
    in-out property <DisplayData> display;
    in-out property <LayerData> field;
    in-out property <LayerData> intensity;
    in-out property <VideoData> video;
    in-out property <SourceData> source;
    in-out property <ArrayData> array;
    in-out property <ProbeData> probe;
    in-out property <PartData> part;
    in-out property <MaterialData> material;
    in-out property <CoatingData> coating;
    in-out property <SidesData> sides;
    in-out property <TriangleData> triangle;
    in-out property <PolygonData> polygon;
    in-out property <LensData> lens;
    in-out property <FresnelData> fresnel;
    in-out property <DiffuserData> diffuser;
    in-out property <ZonePlateData> zone-plate;
    in-out property <BraggData> bragg;
    in-out property <GrinData> grin;
    in-out property <GratingData> grating;
    in-out property <FacetData> facets;
    in-out property <MetaData> meta;
    in-out property <GateData> gate;
    in-out property <FilterData> filter;
    in property <[PointData]> points;
    in property <[FilterLayerData]> layers;
    in-out property <FiberData> fiber;
    in property <[FiberNodeData]> nodes;
    in-out property <SchemeData> scheme;
    in property <[StopData]> stops;
    // the scheme's gradient as a strip
    in property <image> gradient;
    // the schemes Based on offers
    in property <[SchemeChoice]> bases;
    // the Display layers' scheme pickers and the row each shows
    in property <[SchemeChoice]> field-schemes;
    in property <int> field-scheme: -1;
    in property <[SchemeChoice]> intensity-schemes;
    in property <int> intensity-scheme: -1;
    // copies the layer's scheme into the project, points the layer at the copy and selects it
    callback edit-scheme-copy(layer: Layer);
    // asks for a colour scheme file, adds its scheme to the project and points the layer at it
    callback load-scheme-file(layer: Layer);
    // removes the user's scheme the layer names
    callback remove-my-scheme(layer: Layer);
    // the scheme shown among the user's
    in property <Mine> mine;
    // keeps the scheme shown among the user's, or removes the user's of its name
    callback toggle-mine();
    callback base-on(index: int);
    // the scheme Based on copied last, shown until another object is; -1 for none
    in property <int> based-on: -1;
    // changes with the object shown, not with its edits
    in property <int> object;
    // The gradient bar's edits, each giving the index of the stop selected after it. The edits of one gesture share
    // `gesture`, one undo step; 0 for an edit of its own.
    callback add-stop-at(at: float, gesture: int) -> int;
    callback move-stop(index: int, at: float, gesture: int) -> int;
    callback remove-stop(index: int, gesture: int) -> int;
    callback recolour-stop(index: int, color: color, gesture: int);
    // the gestures counted, so each has its own number
    in-out property <int> gestures;
    // changes when the stops change other than through the bar, which then drops its selection
    in property <int> stops-replaced;
    // The stop whose marker is nearest `at`, within `reach`, both along the gradient 0..1; the selected one when as
    // near; -1 for none.
    pure callback marker-at(at: float, reach: float, selected: int) -> int;
    // The stop `step` places after stop `index` along the gradient, clamped to the ends; from -1, the first.
    pure callback stop-beside(index: int, step: int) -> int;
    // text a number box could not read, shown until the next edit or another object
    in-out property <string> invalid;
    // the data changed; `typing`: a keystroke in a text box, one undo step with the next ones
    callback edited(typing: bool);
    callback new-seed();
    // file dialogs open: the scene image's pick and save buttons show
    in property <bool> pick-files;
    // the scene image: pick and embed a file, save the embedded bytes, drop it
    callback pick-image();
    callback save-image();
    callback drop-image();
    // the shown object's list: an outline's points, a filter's layers, a fibre's nodes, a scheme's stops
    callback add-row();
    callback remove-row(index: int);
    callback move-row(from: int, to: int);
    callback clear-rows();
    // whether a part's form shows its kind's description, one setting for every kind
    in-out property <bool> described: true;
    // the form's first box takes the keyboard focus, its text selected (Enter on the tree, a new item)
    in-out property <bool> focus-pending;
    callback describe(open: bool);
}

// A section header: the name over a rule.
export component FormSection inherits VerticalLayout {
    in property <string> text;
    padding-top: 2px;
    padding-bottom: 6px;
    spacing: 2px;
    Text {
        text: root.text;
        font-weight: 600;
        color: Theme.text;
    }
    Rectangle { height: 1px; background: Theme.border; }
}

// Rows of a label and its editor, the label column as wide as its widest label, 110 px at least;
// 10 px after the group.
export component FormPanel inherits GridLayout {
    spacing-horizontal: 8px;
    spacing-vertical: 4px;
    padding-bottom: 10px;
}

// A row's label with the editor's hint as its tip; it stays as it is while its editor is disabled.
export component FormLabel inherits Rectangle {
    in property <string> text;
    in property <string> tip;
    min-width: max(110px, label.preferred-width);
    preferred-width: self.min-width;
    horizontal-stretch: 0;
    min-height: Theme.row-height;
    label := Text {
        x: 0;
        width: parent.width;
        text: root.text;
        vertical-alignment: center;
        overflow: elide;
        color: Theme.text;
    }
    if root.tip != "": Tooltip { text: @markdown("\{root.tip}"); }
}

// A grey read-only value.
export component FormValue inherits Text {
    horizontal-stretch: 1;
    vertical-alignment: center;
    overflow: elide;
    color: Theme.text-dim;
}

// A computed value in the text colour, its tip on the value.
export component FormReadout inherits Rectangle {
    in property <string> text;
    in property <string> tip;
    horizontal-stretch: 1;
    min-height: Theme.row-height;
    FormValue { x: 0; color: Theme.text; text: root.text; }
    if root.tip != "": Tooltip { text: @markdown("\{root.tip}"); }
}

// The number box's parsing (src/number.rs): text to a value clamped and rounded to the box's spec.
export struct ParsedInt { ok: bool, value: int }
export struct ParsedFloat { ok: bool, value: float }
export global NumberParse {
    pure callback int(spec: NumberSpec, text: string) -> ParsedInt;
    pure callback float(spec: NumberSpec, text: string) -> ParsedFloat;
}

// A whole number field; `blank` shows no number. `committed` follows each change, `invalid` gets text it could
// not read.
export component IntField inherits Rectangle {
    in-out property <int> value;
    in property <NumberSpec> spec: { min: -2147483648, max: 2147483647, increment: 1, decimals: 0 };
    in property <bool> enabled: true;
    in property <bool> blank;
    in property <string> tip;
    // changes with the object shown, dropping text typed for the last one
    in property <int> token;
    callback committed();
    callback invalid(text: string);
    horizontal-stretch: 1;
    min-height: max(Theme.row-height, box.min-height);
    min-width: box.min-width;
    preferred-width: box.preferred-width;
    box := NumberBox {
        width: parent.width;
        height: parent.height;
        enabled: root.enabled;
        spec: root.spec;
        token: root.token;
        value: root.blank ? "" : "\{root.value}";
        edited(t) => {
            let parsed = NumberParse.int(root.spec, t);
            if (!parsed.ok) {
                root.invalid(t);
            } else {
                root.value = parsed.value;
                root.committed();
            }
            parsed.ok
        }
    }
    if root.tip != "": Tooltip { text: @markdown("\{root.tip}"); }
}

export component FormInt inherits IntField {
    token: Form.token;
    committed => { Form.edited(false); }
    invalid(t) => { Form.invalid = t; }
}

// A decimal field.
export component FormFloat inherits Rectangle {
    in-out property <float> value;
    in property <NumberSpec> spec: { min: -1000000000, max: 1000000000, increment: 1, decimals: -1 };
    in property <bool> enabled: true;
    in property <string> tip;
    horizontal-stretch: 1;
    min-height: max(Theme.row-height, box.min-height);
    min-width: box.min-width;
    preferred-width: box.preferred-width;
    box := NumberBox {
        width: parent.width;
        height: parent.height;
        enabled: root.enabled;
        spec: root.spec;
        token: Form.token;
        value: "\{root.value}";
        edited(t) => {
            let parsed = NumberParse.float(root.spec, t);
            if (!parsed.ok) {
                Form.invalid = t;
            } else {
                root.value = parsed.value;
                Form.edited(false);
            }
            parsed.ok
        }
    }
    if root.tip != "": Tooltip { text: @markdown("\{root.tip}"); }
}

// A full-width check box, its label as its text.
export component Check inherits Rectangle {
    in-out property <bool> checked;
    in property <string> text;
    in property <string> tip;
    in property <bool> enabled: true;
    callback committed();
    min-height: max(Theme.row-height, check.min-height);
    min-width: check.min-width;
    check := CheckBox {
        x: 0;
        height: parent.height;
        text: root.text;
        enabled: root.enabled;
        checked <=> root.checked;
        toggled => { root.committed(); }
    }
    if root.tip != "": Tooltip { text: @markdown("\{root.tip}"); }
}

export component FormCheck inherits Check {
    committed => { Form.edited(false); }
}

// A combo box of `titles`; a kind's choice maps its words to `index` and back in `picked`.
export component Choice inherits Rectangle {
    in property <int> index;
    in property <[string]> titles;
    // per title, whether it can be picked; empty: all
    in property <[bool]> item-enabled;
    in property <string> tip;
    in property <bool> enabled: true;
    callback picked(index: int);
    callback committed();
    // a pick assigns `current-index`, ending its binding to `index`: the index is put back on each change
    changed index => { combo.current-index = root.index; }
    function pick(i: int) {
        // arrows and the wheel step past a greyed item the way they moved
        let to = Form.next-enabled(root.item-enabled, root.titles.length, i, i < root.index ? -1 : 1);
        if (to < 0 || to == root.index) {
            combo.current-index = root.index;
            return;
        }
        combo.current-index = to;
        root.picked(to);
        root.committed();
    }
    horizontal-stretch: 1;
    min-height: max(Theme.row-height, combo.min-height);
    min-width: combo.min-width;
    preferred-width: combo.preferred-width;
    // with greyed items, Return and Space open the menu that greys them instead of the combo box's popup
    keys := FocusScope {
        capture-key-pressed(e) => {
            if (root.item-enabled.length > 0 && combo.has-focus && (e.text == Key.Return || e.text == " ")) {
                menu.show({ x: 0, y: root.height });
                return accept;
            }
            reject
        }
    combo := ComboBox {
        width: root.width;
        height: root.height;
        enabled: root.enabled;
        model: root.titles;
        current-index: root.index;
        selected => { root.pick(self.current-index); }
    }
    }
    // the combo box greys no item: a click opens a menu that does
    if root.item-enabled.length > 0 && root.enabled: TouchArea {
        clicked => {
            combo.focus();
            menu.show({ x: 0, y: root.height });
        }
    }
    menu := ContextMenuArea {
        enabled: false;
        Menu {
            for title[i] in root.titles: MenuItem {
                title: title;
                enabled: root.item-enabled.length == 0 || root.item-enabled[i];
                checkable: true;
                checked: i == root.index;
                activated => { root.pick(i); }
            }
        }
    }
    if root.tip != "": Tooltip { text: @markdown("\{root.tip}"); }
}

export component FormChoice inherits Choice {
    committed => { Form.edited(false); }
}

// A text box, applied per keystroke.
export component FormText inherits Rectangle {
    in-out property <string> text;
    in property <string> tip;
    in property <bool> enabled: true;
    // the box Form.focus-pending focuses
    in property <bool> first;
    function take() {
        if (root.first && Form.focus-pending) {
            Form.focus-pending = false;
            edit.focus();
            edit.select-all();
        }
    }
    init => { self.take(); }
    property <bool> pending: Form.focus-pending;
    changed pending => { self.take(); }
    horizontal-stretch: 1;
    min-height: max(Theme.row-height, edit.min-height);
    min-width: edit.min-width;
    preferred-width: edit.preferred-width;
    edit := LineEdit {
        changed has-focus => { EditKeys.local = self.has-focus; }
        width: parent.width;
        height: parent.height;
        enabled: root.enabled;
        text <=> root.text;
        edited => { Form.edited(true); }
    }
    if root.tip != "": Tooltip { text: @markdown("\{root.tip}"); }
}

// A wrapping multi-line text box, Enter a new line, 60 px at least.
export component FormNotes inherits Rectangle {
    in-out property <string> text;
    in property <string> tip;
    // the box's height, which the grip at its bottom drags
    in-out property <length> size: 80px;
    horizontal-stretch: 1;
    min-height: 40px;
    preferred-height: self.size;
    background: Theme.input-background;
    border-width: 1px;
    border-color: edit.has-focus ? Theme.accent : Theme.border;
    clip: true;
    view := Flickable {
        x: 1px;
        y: 1px;
        width: parent.width - 2px;
        height: parent.height - 2px;
        content-height: max(self.height, edit.preferred-height);
        edit := TextInput {
            changed has-focus => { EditKeys.local = self.has-focus; }
            x: 4px;
            y: 2px;
            width: view.width - 8px;
            single-line: false;
            wrap: word-wrap;
            color: Theme.text;
            selection-background-color: Theme.selection;
            text <=> root.text;
            edited => { Form.edited(true); }
            // keeps the cursor line in view
            cursor-position-changed(p) => {
                if (p.y + self.y + view.content-y < 0) {
                    view.content-y = -(p.y + self.y);
                } else if (p.y + self.y + Theme.row-height + view.content-y > view.height) {
                    view.content-y = view.height - p.y - self.y - Theme.row-height;
                }
            }
        }
    }
    // the grip: drags the box's height
    TouchArea {
        y: parent.height - 5px;
        height: 5px;
        mouse-cursor: row-resize;
        property <length> grabbed;
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down) { self.grabbed = root.size - self.mouse-y; }
        }
        moved => { root.size = max(40px, self.grabbed + self.mouse-y); }
    }
    if root.tip != "": Tooltip { text: @markdown("\{root.tip}"); }
}

// A part kind's description under a header whose chevron turns while open; Space or a click toggles it.
export component FormDescription inherits VerticalLayout {
    in property <string> text;
    spacing: 0;
    header := FocusScope {
        accessible-role: button;
        accessible-label: @tr("Show or hide what this kind of part is");
        min-height: Theme.row-height;
        key-pressed(e) => {
            if (e.text == " ") {
                Form.described = !Form.described;
                Form.describe(Form.described);
                return accept;
            }
            reject
        }
        TouchArea {
            clicked => {
                header.focus();
                Form.described = !Form.described;
                Form.describe(Form.described);
            }
        }
        HorizontalLayout {
            padding-top: 2px;
            padding-bottom: 2px;
            spacing: 7px;
            Icon {
                width: 6px;
                height: 11px;
                y: (parent.height - self.height) / 2;
                source: @image-url("icons/next/chevron-right.svg");
                transform-rotation: Form.described ? 90deg : 0deg;
            }
            Text {
                text: @tr("Description");
                font-weight: 600;
                color: Theme.text;
                vertical-alignment: center;
            }
        }
        Rectangle {
            y: parent.height - 1px;
            height: 1px;
            background: header.has-focus ? Theme.accent : Theme.border;
        }
        Tooltip { text: @markdown("\{@tr("Show or hide what this kind of part is")}"); }
    }
    Rectangle { height: 6px; }
    if Form.described: Text {
        text: root.text;
        wrap: word-wrap;
        color: Theme.text;
    }
    if Form.described: Rectangle { height: 10px; }
}

// A chain toggle between two number boxes that keeps them equal: the rings part when off, the accent while linked.
export component FormLink inherits FocusScope {
    in-out property <bool> on;
    in property <string> tip;
    width: 22px;
    height: 22px;
    accessible-role: checkbox;
    accessible-checked: root.on;
    accessible-label: root.tip;
    function toggle() {
        root.on = !root.on;
        Form.edited(false);
    }
    key-pressed(e) => {
        if (e.text == " ") {
            root.toggle();
            return accept;
        }
        reject
    }
    Rectangle {
        background: area.has-hover ? Theme.button-hover : transparent;
        border-width: 1px;
        border-color: root.has-focus ? Theme.accent : transparent;
        Icon {
            width: 18px;
            height: 16px;
            source: root.on ? @image-url("icons/next/chain-linked.svg") : @image-url("icons/next/chain-parted.svg");
            ink: root.on ? Theme.accent : Theme.text-dim;
        }
    }
    area := TouchArea {
        clicked => {
            root.focus();
            root.toggle();
        }
    }
    Tooltip { text: @markdown("\{root.tip}"); }
}

// The remove button of list row `index`, in its 22px column.
export component RowRemove inherits Rectangle {
    in property <int> index;
    in property <string> tip;
    in property <bool> enabled: true;
    in property <length> size: 18px;
    width: 22px;
    IconButton {
        size: root.size;
        icon: @image-url("icons/next/tree-minus.svg");
        enabled: root.enabled;
        tip: root.tip;
        clicked => { Form.remove-row(root.index); }
    }
}

// A button under a list, with its tooltip.
export component ListButton inherits Rectangle {
    in property <string> text;
    in property <string> tip;
    in property <bool> enabled: true;
    callback clicked();
    width: button.preferred-width;
    height: button.preferred-height;
    button := Button {
        text: root.text;
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
    Tooltip { text: @markdown("\{root.tip}"); }
}

// A list's footer: the Add button appending a row, then the buttons placed in it.
export component RowAdd inherits HorizontalLayout {
    in property <string> text;
    in property <string> tip;
    padding-top: 2px;
    padding-bottom: 10px;
    spacing: 6px;
    alignment: start;
    ListButton {
        text: root.text;
        tip: root.tip;
        clicked => { Form.add-row(); }
    }
    @children
}
