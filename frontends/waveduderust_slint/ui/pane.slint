import { Theme } from "theme.slint";
import { IconButton } from "icons.slint";

// A dock pane: title bar over its content (docs/ui/00, Panes and default arrangement).
export component Pane inherits Rectangle {
    in property <string> title;
    in property <bool> active;
    callback close();

    background: Theme.tool-window-background;
    VerticalLayout {
        Rectangle {
            height: Theme.row-height;
            background: root.active ? Theme.accent : Theme.window-background;
            HorizontalLayout {
                padding-left: 6px;
                padding-right: 2px;
                spacing: 4px;
                Text {
                    text: root.title;
                    vertical-alignment: center;
                    font-size: Theme.font-size;
                    color: root.active ? Theme.selection-text : Theme.text;
                }
                Rectangle {
                    horizontal-stretch: 1;
                    height: 4px;
                    y: (parent.height - self.height) / 2;
                    border-width: 1px;
                    border-color: root.active ? #9fd0f5 : Theme.title-grip;
                }
                IconButton {
                    size: 16px;
                    focusable: false;
                    y: (parent.height - self.height) / 2;
                    icon: @image-url("icons/next/close.svg");
                    ink: root.active ? Theme.selection-text : Theme.text;
                    pressable: false;
                    hover-background: root.active ? #1c97ea : Theme.dark ? #3e3e40 : #f7f7f9;
                    tip: @tr("Close");
                    clicked => { root.close(); }
                }
            }
        }
        @children
    }
}
