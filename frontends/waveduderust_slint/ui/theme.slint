// Colours of the original's Themes/Dark.xaml and Themes/Light.xaml under the names the components use, and the
// metrics (docs/ui/00, Look).
import { Palette } from "std-widgets.slint";
export global Theme {
    // Follows the settings' theme, which src/main.rs sets on the std-widgets' palette too.
    out property <bool> dark: Palette.color-scheme == ColorScheme.dark;
    // WindowBackground, WindowForeground, GrayText, ControlBorder, Accent, ToolWindowBackground
    out property <color> window-background: dark ? #2d2d30 : #eeeef2;
    out property <color> text: dark ? #f1f1f1 : #1e1e1e;
    out property <color> text-disabled: dark ? #999999 : #a2a4a5;
    out property <color> border: dark ? #3f3f46 : #cccedb;
    out property <color> accent: #007acc;
    out property <color> tool-window-background: dark ? #252526 : #f5f5f5;
    // MenuGlyph: secondary text
    out property <color> text-dim: dark ? #999999 : #717171;
    // Foreground on the accent, the selection and the status bar
    out property <color> selection-text: #ffffff;
    // TitleBar*: the pane headers
    out property <color> title-inactive-text: dark ? #d0d0d0 : #444444;
    out property <color> title-grip: dark ? #46464a : #999999;
    out property <color> title-grip-active: #59a8de;
    out property <color> title-button-hover: dark ? #3e3e40 : #f7f7f9;
    out property <color> title-button-hover-active: #1c97ea;
    // TreeViewItem*: rows of lists
    out property <color> selection: #3399ff;
    // the pictures' handles and names, the selected item's, and the halo under them (both themes)
    out property <color> picture-handle: #d8d8d8;
    out property <color> picture-selection: #ffe000;
    out property <color> picture-halo: #000000c0;
    out property <color> inactive-selection: dark ? #3f3f46 : #cccedb;
    out property <color> row-hover: dark ? #3e3e40 : #e5e5e5;
    // Button*, TextBox*, CheckBox*
    out property <color> button-background: dark ? #3f3f46 : #ececf0;
    out property <color> button-hover: dark ? #4f4f56 : #c9def5;
    out property <color> input-background: dark ? #333337 : #ffffff;
    out property <color> check-border: dark ? #6d6d70 : #9a9a9e;
    // StatusBar*
    out property <color> status: #007acc;
    out property <color> status-error: #b4211d;
    // Log*: the Messages pane's levels
    out property <color> level-trace: dark ? #808080 : #8a8a8a;
    out property <color> level-debug: dark ? #9b9b9b : #6e6e6e;
    out property <color> level-info: dark ? #f1f1f1 : #1e1e1e;
    out property <color> level-warn: dark ? #e5c07b : #bf8700;
    out property <color> level-error: dark ? #f14c4c : #c50500;
    out property <length> font-size: 12px;
    out property <length> row-height: 23px;
    out property <length> status-height: 22px;
}
