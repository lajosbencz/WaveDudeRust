// The chrome of a `slint_dock::Dock` layout, drawn from models its Rust side fills: each group's title bar and tab
// strip, and the splitters. Slint cannot instantiate a pane's content from a model, so the app keeps every content
// as its own element, a child of `DockArea`, and places it at the rectangle the Rust side computes for it, over its
// group; a drag's preview and label draw over the children.

// Sizes of the chrome; `title` and `splitter` are the Rust side's `Metrics`.
export struct DockMetrics {
    title: length,
    tab: length,
    splitter: length,
}

// Colours and font of the chrome.
export struct DockStyle {
    font-size: length,
    // a group's background
    pane: brush,
    title: brush,
    title-text: brush,
    grip: brush,
    title-button-hover: brush,
    // the title bar of the active group
    title-active: brush,
    title-active-text: brush,
    grip-active: brush,
    title-button-hover-active: brush,
    // the strip; the selected tab takes `pane` and a `tab-border` round it but along the content
    tab-strip: brush,
    tab-border: brush,
    tab-text: brush,
    tab-selected-text: brush,
    tab-hover-text: brush,
    splitter: brush,
    // a drag's drop area and its 2 px border
    drop-fill: brush,
    drop-border: brush,
    // the label with the dragged pane's title at the pointer
    label: brush,
    label-text: brush,
}

// A shown pane of a group; `active` is the one its group shows.
export struct DockTab {
    pane: string,
    active: bool,
}

// A shown group: its rectangle, title bar included, in the area; its active pane, whose title the title bar shows;
// its panes, a tab strip under the content from two on; `active` lights its title bar.
export struct DockGroup {
    x: length,
    y: length,
    width: length,
    height: length,
    pane: string,
    active: bool,
    tabs: [DockTab],
}

// A splitter bar; `rows` when it moves vertically.
export struct DockSplitter {
    x: length,
    y: length,
    width: length,
    height: length,
    rows: bool,
}

// Where the app places a pane's content in the area; `visible` when it is its group's active pane.
export struct DockPlace {
    x: length,
    y: length,
    width: length,
    height: length,
    visible: bool,
}

// The room a drop takes in the area; `shown` while the pointer is over a target.
export struct DockPreview {
    shown: bool,
    x: length,
    y: length,
    width: length,
    height: length,
}

// A press that becomes a drag once the pointer leaves `threshold` of it, a click otherwise. Slint sends the moves
// and the release to the TouchArea pressed wherever the pointer goes, so the drag needs nothing from what it
// crosses; positions are the window's.
component Grip inherits TouchArea {
    in property <length> threshold;
    // the press became a drag
    out property <bool> dragged;
    callback click();
    callback started();
    callback dragging(x: length, y: length);
    callback released(x: length, y: length);
    // the grab was lost before a release
    callback cancelled();

    pointer-event(e) => {
        if (e.button == PointerEventButton.left && e.kind == PointerEventKind.down) {
            self.dragged = false;
        }
        if (e.button == PointerEventButton.left && e.kind == PointerEventKind.up && self.dragged) {
            root.released(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
        }
        if (e.kind == PointerEventKind.cancel && self.dragged) {
            root.cancelled();
        }
    }
    moved => {
        if (!self.dragged && max(abs(self.mouse-x - self.pressed-x), abs(self.mouse-y - self.pressed-y)) > self.threshold) {
            self.dragged = true;
            root.started();
        }
        if (self.dragged) {
            root.dragging(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
        }
    }
    // a press that dragged is no click
    clicked => {
        if (!self.dragged) { root.click(); }
    }
}

component CloseButton inherits Rectangle {
    in property <brush> ink;
    in property <brush> hover-background;
    in property <string> tip;
    callback clicked();

    width: 16px;
    height: 16px;
    background: area.has-hover ? root.hover-background : transparent;
    accessible-role: button;
    accessible-label: root.tip;
    accessible-action-default => { root.clicked(); }
    Path {
        width: 8px;
        height: 8px;
        viewbox-width: 8;
        viewbox-height: 8;
        commands: "M0,1 L1,0 L4,3 L7,0 L8,1 L5,4 L8,7 L7,8 L4,5 L1,8 L0,7 L3,4 Z";
        fill: root.ink;
    }
    area := TouchArea {
        clicked => { root.clicked(); }
    }
    if root.tip != "": Tooltip {
        text: @markdown("\{root.tip}");
    }
}

component TitleBar inherits Rectangle {
    in property <DockStyle> style;
    in property <string> title;
    in property <bool> active;
    in property <string> close-tip;
    in property <length> drag-threshold;
    callback close();
    callback clicked();
    callback drag-started();
    callback dragging(x: length, y: length);
    callback released(x: length, y: length);
    callback cancelled();

    background: root.active ? root.style.title-active : root.style.title;
    Grip {
        threshold: root.drag-threshold;
        click => { root.clicked(); }
        started => { root.drag-started(); }
        dragging(x, y) => { root.dragging(x, y); }
        released(x, y) => { root.released(x, y); }
        cancelled => { root.cancelled(); }
    }
    HorizontalLayout {
        padding-left: 6px;
        padding-right: 2px;
        spacing: 4px;
        Text {
            text: root.title;
            vertical-alignment: center;
            font-size: root.style.font-size;
            color: root.active ? root.style.title-active-text : root.style.title-text;
        }
        Rectangle {
            horizontal-stretch: 1;
            height: 4px;
            y: (parent.height - self.height) / 2;
            border-width: 1px;
            border-color: root.active ? root.style.grip-active : root.style.grip;
        }
        CloseButton {
            y: (parent.height - self.height) / 2;
            ink: root.active ? root.style.title-active-text : root.style.title-text;
            hover-background: root.active ? root.style.title-button-hover-active : root.style.title-button-hover;
            tip: root.close-tip;
            clicked => { root.close(); }
        }
    }
}

component TabStrip inherits Rectangle {
    in property <DockStyle> style;
    in property <[DockTab]> tabs;
    in property <length> drag-threshold;
    pure callback title(pane: string) -> string;
    callback activate(pane: string);
    callback drag-started(pane: string);
    callback dragging(x: length, y: length);
    callback released(x: length, y: length);
    callback cancelled();

    background: root.style.tab-strip;
    clip: true;
    HorizontalLayout {
        alignment: start;
        for tab in root.tabs: Rectangle {
            background: tab.active ? root.style.pane : transparent;
            // its top border is cut off: the tab joins the content above it
            Rectangle {
                y: -1px;
                height: parent.height + 1px;
                border-width: 1px;
                border-color: tab.active ? root.style.tab-border : transparent;
            }
            HorizontalLayout {
                padding-left: 10px;
                padding-right: 10px;
                Text {
                    text: root.title(tab.pane);
                    vertical-alignment: center;
                    font-size: root.style.font-size;
                    color: tab.active ? root.style.tab-selected-text
                        : area.has-hover ? root.style.tab-hover-text : root.style.tab-text;
                }
            }
            area := Grip {
                threshold: root.drag-threshold;
                click => { root.activate(tab.pane); }
                started => { root.drag-started(tab.pane); }
                dragging(x, y) => { root.dragging(x, y); }
                released(x, y) => { root.released(x, y); }
                cancelled => { root.cancelled(); }
            }
        }
    }
}

// The groups' chrome and the splitters, in the coordinates of the area this fills; its children, the panes'
// contents, draw over them and under a drag's preview and label.
//
// Dragging a title bar moves its group, a tab its pane: `drag-over` answers the preview for the pointer, `dropped`
// reports the release. A drag takes no focus; `cancel()` ends it without a drop, for the app's Esc.
export component DockArea inherits Rectangle {
    in property <[DockGroup]> groups;
    in property <[DockSplitter]> splitters;
    in property <DockMetrics> metrics: { title: 23px, tab: 23px, splitter: 4px };
    in property <DockStyle> style: {
        font-size: 12px,
        pane: #f5f5f5,
        title: #eeeef2,
        title-text: #444444,
        grip: #999999,
        title-button-hover: #f7f7f9,
        title-active: #007acc,
        title-active-text: #ffffff,
        grip-active: #59a8de,
        title-button-hover-active: #1c97ea,
        tab-strip: #eeeef2,
        tab-border: #cccedb,
        tab-text: #444444,
        tab-selected-text: #0e70c0,
        tab-hover-text: #1c97ea,
        splitter: #eeeef2,
        drop-fill: #007acc60,
        drop-border: #007acc,
        label: #007acc,
        label-text: #ffffff,
    };
    // how far the pointer moves from a press on a title bar or tab before it drags
    in property <length> drag-threshold: 4px;
    // the close buttons' tooltip
    in property <string> close-tip;
    pure callback title(pane: string) -> string;
    callback close(pane: string);
    // a tab or a title bar was clicked
    callback activate(pane: string);
    // the bar at `index` of `splitters` dragged, the pointer at `x`, `y`
    callback splitter-moved(index: int, x: length, y: length);
    callback resized(width: length, height: length);
    // where `pane`, or its whole group with `group`, would drop with the pointer at `x`, `y`
    callback drag-over(pane: string, group: bool, x: length, y: length) -> DockPreview;
    callback dropped(pane: string, group: bool, x: length, y: length);
    // a drag ended without a drop
    callback cancelled();

    out property <bool> dragging;
    property <string> drag-pane;
    property <bool> drag-group;
    property <length> drag-x;
    property <length> drag-y;
    property <DockPreview> preview;

    function start(pane: string, group: bool) {
        root.dragging = true;
        root.drag-pane = pane;
        root.drag-group = group;
        root.preview = { };
    }
    function over(x: length, y: length) {
        if (!root.dragging) { return; }
        root.drag-x = x - root.absolute-position.x;
        root.drag-y = y - root.absolute-position.y;
        root.preview = root.drag-over(root.drag-pane, root.drag-group, root.drag-x, root.drag-y);
    }
    function release(x: length, y: length) {
        if (!root.dragging) { return; }
        root.over(x, y);
        root.dragging = false;
        root.preview = { };
        root.dropped(root.drag-pane, root.drag-group, root.drag-x, root.drag-y);
    }
    // ends a drag without a drop
    public function cancel() {
        if (!root.dragging) { return; }
        root.dragging = false;
        root.preview = { };
        root.cancelled();
    }

    changed width => { root.resized(self.width, self.height); }
    changed height => { root.resized(self.width, self.height); }

    for group in root.groups: Rectangle {
        x: group.x;
        y: group.y;
        width: group.width;
        height: group.height;
        background: root.style.pane;
        clip: true;
        TitleBar {
            y: 0;
            height: root.metrics.title;
            style: root.style;
            title: root.title(group.pane);
            active: group.active;
            close-tip: root.close-tip;
            drag-threshold: root.drag-threshold;
            close => { root.close(group.pane); }
            clicked => { root.activate(group.pane); }
            drag-started => { root.start(group.pane, true); }
            dragging(x, y) => { root.over(x, y); }
            released(x, y) => { root.release(x, y); }
            cancelled => { root.cancel(); }
        }
        if group.tabs.length > 1: TabStrip {
            y: parent.height - root.metrics.tab;
            height: root.metrics.tab;
            style: root.style;
            tabs: group.tabs;
            drag-threshold: root.drag-threshold;
            title(pane) => { root.title(pane) }
            activate(pane) => { root.activate(pane); }
            drag-started(pane) => { root.start(pane, false); }
            dragging(x, y) => { root.over(x, y); }
            released(x, y) => { root.release(x, y); }
            cancelled => { root.cancel(); }
        }
    }
    for bar[index] in root.splitters: Rectangle {
        x: bar.x;
        y: bar.y;
        width: bar.width;
        height: bar.height;
        background: root.style.splitter;
        TouchArea {
            mouse-cursor: bar.rows ? MouseCursor.row-resize : MouseCursor.col-resize;
            // the pointer reported as if the press had been on the bar's middle, so the bar keeps its grab offset
            moved => {
                root.splitter-moved(index, parent.x + self.mouse-x - (self.pressed-x - parent.width / 2),
                    parent.y + self.mouse-y - (self.pressed-y - parent.height / 2));
            }
        }
    }
    @children
    if root.preview.shown: Rectangle {
        x: root.preview.x;
        y: root.preview.y;
        width: root.preview.width;
        height: root.preview.height;
        background: root.style.drop-fill;
        border-width: 2px;
        border-color: root.style.drop-border;
    }
    if root.dragging: Rectangle {
        x: root.drag-x + 14px;
        y: root.drag-y + 14px;
        width: label.width + 16px;
        height: label.height + 6px;
        background: root.style.label;
        border-radius: 2px;
        label := Text {
            x: 8px;
            y: 3px;
            width: self.preferred-width;
            height: self.preferred-height;
            text: root.title(root.drag-pane);
            font-size: root.style.font-size;
            color: root.style.label-text;
        }
    }
}
