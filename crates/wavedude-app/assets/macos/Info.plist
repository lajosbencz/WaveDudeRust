<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Merged over cargo-packager's Info.plist (Cargo.toml, packager.macos): the file types this app defines, and the
     document types naming them, which replace the extension-only ones cargo-packager writes. -->
<plist version="1.0">
<dict>
	<key>UTExportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>io.github.lajosbencz.wavedude-rust.project</string>
			<key>UTTypeDescription</key>
			<string>WaveDude project</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.xml</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>wdproj</string>
				</array>
				<key>public.mime-type</key>
				<array>
					<string>application/x-wavedude-project+xml</string>
				</array>
			</dict>
		</dict>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>io.github.lajosbencz.wavedude-rust.color-scheme</string>
			<key>UTTypeDescription</key>
			<string>WaveDude colour scheme</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.xml</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>wdscheme</string>
				</array>
				<key>public.mime-type</key>
				<array>
					<string>application/x-wavedude-scheme+xml</string>
				</array>
			</dict>
		</dict>
	</array>
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>WaveDude project</string>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>LSHandlerRank</key>
			<string>Owner</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>io.github.lajosbencz.wavedude-rust.project</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleTypeName</key>
			<string>WaveDude colour scheme</string>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>LSHandlerRank</key>
			<string>Owner</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>io.github.lajosbencz.wavedude-rust.color-scheme</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
