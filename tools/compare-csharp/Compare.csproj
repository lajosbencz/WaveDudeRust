<Project Sdk="Microsoft.NET.Sdk">

  <!-- Dumps the C# WaveDudeNext CPU engine's scene, fields and probes for `wavedude-cli compare`; needs WAVEDUDE_NEXT_DIR, a checkout of graealex/WaveDudeNext -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>compare-csharp</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="$(WAVEDUDE_NEXT_DIR)/WaveDudeNext/WaveDudeNext.csproj" />
  </ItemGroup>

  <Target Name="RequireWaveDudeNext" BeforeTargets="CollectPackageReferences;ResolveProjectReferences">
    <Error Condition="'$(WAVEDUDE_NEXT_DIR)' == ''" Text="Set WAVEDUDE_NEXT_DIR to a checkout of graealex/WaveDudeNext." />
  </Target>

</Project>
