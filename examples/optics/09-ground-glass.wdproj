	<Source Name="Lamp (plain)" X="120" Y="450" Frequency="100" />
	<Rectangle Name="Wall" X="640" Y="300" RefractiveIndex="1" Absorption="16" AbsorptionRamp="50" Length="1300" Width="140" />
	<Diffuser Name="Ground glass" X="400" Y="150" Coating="3" FrontCoated="false" SidesCoated="false" Length="20" Width="260" CenterWavelength="24" Amplitude="6" Sigma="8" />
