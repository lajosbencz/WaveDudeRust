<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE Project [
	<!ELEMENT Project (Description?, Scene?, Simulation?, Display?, Source*, (Lens|FresnelLens|Polygon|Rectangle|Ellipse|Triangle|Outline|Diffuser|InterferenceFilter|SimpleGrating|FacettedGrating|MetaLens|MetaPrism|MetaAxicon|Fiber|BraggReflector|GrinLens|XorGate|AndGate|OrGate|ZonePlate)*, Probe*, ColorScheme*)>
